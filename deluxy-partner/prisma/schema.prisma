// Deluxy Partner — schema dati
// Sostituisce PARTNER.xlsx (Database clienti 2026): ogni foglio/blocco Excel
// diventa un'entità normalizzata. Le colonne "DA NON TOCCARE FORMULA" del
// foglio (commissioni, dovuto, saldi, rolling) qui sono SEMPRE calcolate dal
// motore in src/lib/calc.ts, mai memorizzate a mano.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) in produzione
  directUrl = env("DIRECT_URL") // connessione diretta per migrazioni/db push
}

// Partner commerciale (foglio "Database clienti 2026", colonne A-N)
model Partner {
  id                     String   @id @default(cuid())
  nome                   String   @unique
  ragioneSociale         String?
  // GRUPPO DI PAGAMENTO: più schede che vengono pagate (o che pagano) da un'unica
  // sede centrale. Caso vero: CHANEL FIRENZE, CHANEL MILANO e CHANEL ROMA sono
  // tre negozi distinti, ma la fattura la salda l'amministrazione unica — e
  // sollecitarli tre volte significa scrivere tre volte alla stessa persona.
  //
  // È un'etichetta scritta A MANO di proposito: dedurla dal nome unirebbe le
  // cinque «PASTICCERIA …» in elenco, che sono aziende diverse fra loro.
  gruppo                 String?
  categoria              String? // Pasticceria, Fiori, Boutique, Ristorante...
  citta                  String?
  servizi                String? // etichette: Vendor, Consegne, Magazzino...
  clienteAnno            String? // P.P. | Nuovo | Dismesso
  feePercent             Float? // % commissione su vendite come vendor
  debiti2025             Float    @default(0) // situazione debitoria al 31.12.2025
  pdrDebito              String? // piano di rientro debito
  crediti2025            Float    @default(0) // situazione creditizia al 31.12.2025
  ggPagamento            Int      @default(0) // giorni pagamento fattura (0 = vista fattura)
  compensazione          Boolean  @default(false) // crediti servizi compensati dagli incassi vendite
  commissioniADetrazione Boolean  @default(false) // commissioni detratte dal pagamento incassi
  addebitoDiretto        Boolean  @default(false)
  cartaCreditoApp        Boolean  @default(false)
  iban                   String? // per bonifici SEPA
  // A CHI è intestato il conto: è il nome a cui esce il bonifico, e non è
  // sempre l'insegna né la ragione sociale (ditte individuali, società che
  // incassano per il negozio). La banca controlla che intestatario e IBAN
  // combacino: col nome sbagliato il pagamento viene rifiutato. Fonte di
  // verità nel registro Anagrafiche (`intestatarioConto`); qui è la copia
  // operativa che serve a generare i SEPA, come già per l'IBAN.
  intestatarioConto      String?
  email                  String?
  telefono               String?
  // Referente amministrativo (chi paga le fatture): destinatario predefinito di
  // solleciti e pro-forma. Si può importare dal registro Anagrafiche.
  ammNome                String?
  ammEmail               String?
  ammTelefono            String?
  ammRuolo               String? // es. "Amministrazione", "Contabilità"
  note                   String?
  // Chiave di join con il registro Deluxy Anagrafiche (id del partner lì).
  // Popolata una volta per riconciliazione; è la "lingua comune di id" tra le app.
  anagraficaId           String?  @unique
  attivo                 Boolean  @default(true)
  fatture                FatturaServizio[]
  vendite                VenditaVendor[]
  saldi                  SaldoMensile[]
  transazioni            TransazioneBancaria[]
  proforme               ProForma[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Utente dell'app con account personale (email + password). Serve a chi NON
// entra dal portale Hub: senza, l'unico ingresso è la password di team, che non
// ha un nome e rende il registro accessi cieco su chi sia la persona.
// La password non è salvata: si salva `passwordHash`, prodotto con scrypt
// (formato `scrypt$N$r$p$salt$hash`, vedi src/lib/utenti.ts).
model UtenteApp {
  id            String    @id @default(cuid())
  email         String    @unique // sempre in minuscolo: è la chiave di accesso
  nome          String
  ruolo         String    @default("sola_lettura") // admin | sola_lettura
  passwordHash  String
  attivo        Boolean   @default(true)
  ultimoAccesso DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([attivo])
}

// Richiesta di pagamento LIBERA: non legata al saldo di un partner né a un
// ordine, ma a una spesa qualsiasi (un fornitore, un affitto, una consulenza).
// Qui resta la traccia di quello che è stato chiesto; il denaro esce solo da
// **deluxy-transactions**, dopo l'autorizzazione di una persona.
//
// `categoria` è una CATEGORIA DI COSTO di deluxy-budgets: la stessa con cui si
// classificano le spese in `/spese`. Sceglierla al momento della richiesta vuol
// dire che la spesa nasce già collocata nel conto economico, invece di doverla
// rincorrere dopo, quando dall'estratto conto si legge solo un nome di banca.
model RichiestaPagamento {
  id             String    @id @default(cuid())
  beneficiario   String
  iban           String
  importo        Float
  causale        String // quella che arriva in banca: max 140 caratteri (SEPA)
  categoriaId    String? // id della categoria in Budgets
  categoriaNome  String? // etichetta al momento della richiesta
  categoriaTipoPL String? // COGS | ADV | PERSONALE | STRUTTURA | ESCLUSA
  note           String?
  scadenza       DateTime?
  partnerId      String? // se il beneficiario è un partner in anagrafica
  partnerNome    String?
  richiedente    String? // chi l'ha chiesta (dalla sessione)
  // esito lato Transactions
  riferimento    String? // TRX-2026-000123
  stato          String    @default("in_attesa")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stato, createdAt])
}

// Registro degli ACCESSI: chi è ENTRATO nell'app, quando, come e da dove.
// Diverso da RegistroModifica, che annota cosa è stato cambiato: qui si annota
// l'ingresso, compresi i tentativi con password sbagliata (per accorgersi di
// chi prova a entrare).
//
// ⚠️ LIMITE VERO, da tenere presente leggendo questa tabella: l'app entra con
// una password di TEAM. Chi la usa non ha un nome — si registra «Accesso a
// password» e nient'altro. Il nome della persona c'è solo per chi entra dal
// Hub (SSO), che porta con sé nome e uid. Finché la password è condivisa,
// questa tabella dice QUANTI ingressi e DA DOVE, non chi è la persona.
model AccessoApp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  utente    String // nome dal SSO del Hub, oppure l'etichetta del profilo
  utenteId  String? // uid del Hub, se l'ingresso è passato dal portale
  ruolo     String? // admin | sola_lettura
  via       String // sso | password
  esito     String   @default("ok") // ok | fallito (password sbagliata)
  ip        String? // primo indirizzo di x-forwarded-for (lo mette Vercel)
  agente    String? // user agent del browser, per distinguere i dispositivi

  @@index([createdAt])
  @@index([utente, createdAt])
}

// Registro delle modifiche (audit log): ogni cambiamento fatto nell'app da un
// operatore. `utente` è il nome di chi ha fatto l'azione (dal SSO del Hub, o
// l'etichetta del profilo per l'accesso a password); `azione` è una frase
// leggibile, `entita`/`entitaId` collegano alla cosa toccata per la ricerca.
model RegistroModifica {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  utente    String // nome operatore o etichetta del profilo
  utenteId  String? // uid del Hub, se disponibile
  ruolo     String? // admin | sola_lettura
  azione    String // frase leggibile: "Fattura 474/2026 segnata saldata"
  categoria String // area: partner | fatture | vendite | pagamenti | impostazioni | …
  entita    String? // tipo dell'oggetto: partner | fattura | vendita | …
  entitaId  String? // id dell'oggetto toccato (per filtrare la sua storia)
  partner   String? // nome del partner coinvolto, se pertinente (per la ricerca)
  dettaglio String? // testo libero con i particolari (importi, prima/dopo…)

  @@index([createdAt])
  @@index([categoria, createdAt])
  @@index([entita, entitaId])
}

// Movimento dell'estratto conto importato da CSV/XLSX.
// hash = impronta di (data, importo, descrizione) per non duplicare
// ricaricando lo stesso estratto o periodi sovrapposti.
model TransazioneBancaria {
  id          String   @id @default(cuid())
  data        DateTime
  importo     Float // > 0 accredito, < 0 addebito
  divisa      String   @default("EUR")
  descrizione String
  controparte String?
  ibanControparte String? // IBAN del beneficiario/ordinante (bonifici SEPA), se nell'estratto
  hash        String   @unique
  fonte       String? // nome del file importato
  stato       String   @default("nuova") // nuova | registrata | ignorata
  esito       String? // annotazione dell'azione fatta (es. "fattura 181/2026 saldata")
  partnerId   String?
  partner     Partner? @relation(fields: [partnerId], references: [id])
  // CATEGORIA DI COSTO (solo per le uscite). L'elenco delle categorie NON vive
  // qui: è di **deluxy-budgets**, che fa il bilancio, e si legge via API
  // (`GET /api/v1/categorie`). Qui si salva solo l'ASSEGNAZIONE, con nome e
  // tipoPL copiati accanto all'id: servono a mostrare la riga anche quando
  // Budgets è irraggiungibile, e a non perdere il senso storico di un
  // movimento se domani la categoria viene rinominata.
  categoriaId     String? // id della categoria in Budgets
  categoriaNome   String? // etichetta al momento dell'assegnazione
  categoriaTipoPL String? // COGS | ADV | PERSONALE | STRUTTURA | ESCLUSA
  categoriaDa     String? // manuale | regola | ai (chi ha deciso)
  categoriaNota   String? // perché: motivo dell'AI o confidenza. Serve a rivedere
  //                         una proposta senza doverla indovinare a ritroso.
  categoriaIl     DateTime?
  createdAt   DateTime @default(now())

  @@index([stato, data])
  @@index([partnerId])
  @@index([importo])
  @@index([categoriaId])
}

// Tipologia di servizio (aree del foglio "Piano Per Area")
model TipologiaServizio {
  id      String            @id @default(cuid())
  nome    String            @unique
  ordine  Int               @default(0)
  fatture FatturaServizio[]
}

// Servizi a fatturazione: fattura a credito emessa da Deluxy verso il partner
// (blocco mensile "Servizi A Fatturazione")
model FatturaServizio {
  id            String             @id @default(cuid())
  partnerId     String
  partner       Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tipologiaId   String
  tipologia     TipologiaServizio  @relation(fields: [tipologiaId], references: [id])
  anno          Int
  mese          Int // 1-12, mese di competenza
  numero        String? // n° fattura FattureInCloud (es. 68/2026)
  emissione     DateTime?
  scadenza      DateTime?
  imponibile    Float // netto IVA
  aliquotaIva   Float              @default(22)
  pagata        Boolean            @default(false)
  // Incasso PARZIALE già ricevuto su questa fattura, IVA inclusa. 0 = niente
  // incassato; quando raggiunge il totale IVATO la fattura è saldata (pagata).
  // Il residuo da incassare è (totale IVATO − incassato).
  incassato     Float              @default(0)
  // In compensazione: la fattura NON viene pagata in banca, ma scalata dai
  // prossimi importi dovuti al partner finché non è coperta.
  compensata    Boolean            @default(false)
  // true se "Saldata" ha registrato in automatico l'incasso (IVATO) sul saldo
  // del mese: serve per stornarlo correttamente se si riapre la fattura.
  incassoRegistrato Boolean        @default(false)
  dataPagamento DateTime?
  descrizione   String?
  sollecitoInviatoIl DateTime? // ultimo sollecito di pagamento inviato
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([partnerId, anno, mese])
  @@index([pagata, scadenza])
  @@index([anno])
  @@index([tipologiaId])
}

// Servizi come vendor: vendite fatte da Deluxy per conto del partner
// (blocco mensile "Servizi come VENDOR"). La commissione e il dovuto al
// partner sono calcolati: commissione = incasso * fee%; dovuto = incasso -
// commissione * (1 + IVA).
model VenditaVendor {
  id           String   @id @default(cuid())
  partnerId    String
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  anno         Int
  mese         Int // 1-12, mese di competenza
  data         DateTime?
  descrizione  String?
  incassoLordo Float // importo venduto/incassato da Deluxy
  feePercent   Float // snapshot della fee del partner al momento della vendita
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([partnerId, anno, mese])
  @@index([anno])
}

// Chiusura mensile partner (blocchi "Extra" + "Saldi" del foglio):
// extra monetari, fattura commissioni, bonifico e note.
// Il saldo in compensazione e il residuo sono calcolati dal motore.
model SaldoMensile {
  id              String    @id @default(cuid())
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  anno            Int
  mese            Int // 1-12
  commFattEmessa  Boolean   @default(false) // fattura commissioni emessa
  commFattNumero  String? // n° fattura commissioni FattureInCloud
  aggiunte        Float     @default(0) // importi extra a favore del partner
  detrazioni      Float     @default(0) // importi da scalare al partner
  dataPagamento   DateTime? // data in cui risulta saldato / incassato
  bonificoImporto Float? // >0 inviato al partner, <0 ricevuto dal partner
  bonificoData    DateTime?
  chiuso          Boolean   @default(false)
  // RICHIESTA DI PAGAMENTO mandata a **deluxy-transactions** (l'unica app da cui
  // può uscire denaro). Qui NON c'è un bonifico eseguito: c'è la traccia di
  // averlo chiesto. `bonificoImporto` sopra si compila solo quando Transactions
  // notifica che è stato davvero pagato — o quando lo si annota a mano.
  richiestaRif    String? // TRX-2026-000123
  richiestaStato  String? // in_attesa | sospesa | approvata | in_lotto | pagata | rifiutata | annullata
  richiestaIl     DateTime?
  // Quante volte si è chiesto per questo mese. Serve a poter RICHIEDERE dopo un
  // rifiuto o un annullamento: Transactions è idempotente sulla coppia
  // (app, riferimentoEsterno), quindi rimandare lo stesso riferimento
  // restituirebbe per sempre la vecchia richiesta annullata.
  richiestaTentativi Int   @default(0)
  note            String?
  // Quando la nota è stata scritta/modificata l'ultima volta: serve al recap AI
  // per capire se quello che dice è ancora attuale (updatedAt cambia anche per
  // i pagamenti, quindi non basta).
  noteAggiornateIl DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([partnerId, anno, mese])
  @@index([anno])
}

// Voce extra del mese (blocco "Extra"): importo con segno — >0 aggiunta a favore
// del partner, <0 detrazione. Sono le singole voci; i totali aggiunte/detrazioni
// su SaldoMensile restano come cache sincronizzata (per non cambiare i calcoli).
model ExtraSaldo {
  id          String   @id @default(cuid())
  partnerId   String
  anno        Int
  mese        Int // 1-12
  descrizione String?
  importo     Float // >0 aggiunta, <0 detrazione
  createdAt   DateTime @default(now())

  @@index([partnerId, anno, mese])
}

// Pro-forma: documento non fiscale inviato al partner prima della fattura vera.
// Numerazione progressiva per anno (PF 1/2026, PF 2/2026…). Ciclo di vita:
// bozza → inviata → fatturata (con n° della fattura definitiva) oppure annullata.
// I totali (imponibile, IVA, totale documento) sono sempre calcolati dalle righe.
model ProForma {
  id            String    @id @default(cuid())
  numero        Int // progressivo nell'anno
  anno          Int // anno della numerazione
  partnerId     String
  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  data          DateTime // data del documento
  scadenza      DateTime? // termine di pagamento proposto
  oggetto       String? // causale in testa al documento
  note          String? // note in calce (condizioni, coordinate, ecc.)
  stato         String    @default("bozza") // bozza | inviata | fatturata | annullata
  inviataIl     DateTime?
  inviataA      String? // destinatario dell'ultimo invio
  fatturaNumero String? // n° fattura definitiva (quando stato = fatturata)
  fatturataIl   DateTime?
  annullataIl   DateTime?
  righe         ProFormaRiga[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([anno, numero])
  @@index([stato, data])
  @@index([partnerId])
}

// Riga di dettaglio della pro-forma: importo riga = quantita * prezzoUnitario.
model ProFormaRiga {
  id            String   @id @default(cuid())
  proFormaId    String
  proForma      ProForma @relation(fields: [proFormaId], references: [id], onDelete: Cascade)
  ordine        Int      @default(0)
  descrizione   String
  quantita      Float    @default(1)
  prezzoUnitario Float // netto IVA
  aliquotaIva   Float    @default(22)

  @@index([proFormaId])
}

// Richiesta di pagamento al fornitore per uno specifico ordine Shopify: importo
// + come pagarlo (IBAN/beneficiario per bonifico, oppure un link di pagamento,
// oppure una nota libera). Quando la si segna "pagata" diventa il costo
// fornitore dell'ordine. Un ordine può avere più richieste (storico).
model RichiestaPagamentoOrdine {
  id            String        @id @default(cuid())
  ordineId      String
  ordine        OrdineShopify @relation(fields: [ordineId], references: [id], onDelete: Cascade)
  importo       Float
  beneficiario  String? // a chi va pagato (fioraio/fornitore)
  iban          String?
  bic           String?
  linkPagamento String? // URL di pagamento (Stripe/PayPal/altro), in alternativa all'IBAN
  note          String?
  stato         String        @default("richiesto") // richiesto | pagato | annullato
  pagatoIl      DateTime?
  createdAt     DateTime      @default(now())

  @@index([ordineId])
  @@index([stato])
}

// Esito della riconciliazione di un cliente Fatture in Cloud con un partner /
// registro Anagrafiche. Traccia cosa è stato confermato (e inviato al registro)
// o ignorato, per non riproporlo e per audit. Chiave = nome cliente FIC.
model RiconciliazioneAnagrafica {
  id           String   @id @default(cuid())
  ficNome      String   @unique
  partnerId    String?
  anagraficaId String?
  stato        String // confermata | ignorata
  campiInviati String? // riepilogo dei campi proposti al registro
  esito        String? // ok | messaggio d'errore dell'ultimo invio
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Negozio Shopify collegato (uno per brand). Il token Admin (shpat_...) è
// salvato qui e usato server-side per scaricare gli ordini via Admin API.
model NegozioShopify {
  id        String          @id @default(cuid())
  brand     String          @unique // es. deluxyflowers.com
  dominio   String // es. fb72b1-2.myshopify.com
  // Due modi di autenticare, in alternativa:
  //  A) token statico shpat_... (app legacy / custom app "vecchio stile")
  //  B) Client ID + Client Secret di un'app della Dev Dashboard: l'app conia da
  //     sé un token Admin col "client credentials grant" (valido ~24h) e lo
  //     rinnova alla scadenza. `token`/`tokenScadeIl` qui fanno da cache del
  //     token coniato; per il caso A `tokenScadeIl` resta null (non scade).
  token     String          @default("") // token Admin in uso (statico o coniato)
  clientId     String? // Dev Dashboard app: Client ID
  clientSecret String? // Dev Dashboard app: Client Secret
  tokenScadeIl DateTime? // scadenza del token coniato (null = token statico)
  attivo    Boolean         @default(true)
  ultimaSync DateTime?
  ordini    OrdineShopify[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// Ordine Shopify scaricato, con lo stato di riconciliazione con l'incasso.
// categoriaPagamento: bonifico | carta | contrassegno | altro — decide il flusso:
//  - bonifico  -> match 1:1 con un movimento bancario (TransazioneBancaria)
//  - carta     -> incassato via gateway (payout aggregato, riconciliato a blocco)
//  - contrassegno/altro -> incasso differito, da spuntare a mano
model OrdineShopify {
  id                 String         @id @default(cuid())
  negozioId          String
  negozio            NegozioShopify @relation(fields: [negozioId], references: [id], onDelete: Cascade)
  brand              String
  orderId            String // gid Shopify (globale, univoco per negozio)
  nome               String // es. #1234
  data               DateTime
  totale             Float
  valuta             String         @default("EUR")
  financialStatus    String? // PAID | PENDING | PARTIALLY_PAID | REFUNDED...
  gateway            String? // nomi gateway concatenati
  categoriaPagamento String         @default("altro") // bonifico | carta | contrassegno | altro
  clienteNome        String?
  clienteEmail       String?
  note               String?
  // COME si incassa questo ordine — cosa diversa dallo STATO qui sotto:
  //  - riconciliazione   -> si abbina a un movimento bancario (default)
  //  - partner           -> ordine di un partner: rientra nel suo conto mensile
  //                         (servizi/saldi), in banca non c'è niente da cercare.
  //                         È il default degli ordini deluxy.it
  //  - pagamento_esterno -> richiesta di pagamento mandata fuori da Shopify: il
  //                         denaro arriva davvero in banca e va abbinato
  // Lo decide l'operatore da `/ordini`; la sync non lo sovrascrive mai.
  gestione           String         @default("riconciliazione")
  // riconciliazione (INCASSO — soldi in entrata dal cliente)
  statoRicon         String         @default("da_riconciliare") // da_riconciliare | riconciliato | incassato_gateway | ignorato
  transazioneId      String? // movimento bancario abbinato (se bonifico)
  riconciliatoIl     DateTime?
  // COSTO FORNITORE — quanto Deluxy ha PAGATO al fioraio/fornitore per l'ordine
  // (uscita), abbinato a un movimento bancario in uscita (Qonto/file). Il fioraio
  // non è nell'ordine (sta nell'app fornitori) → abbinamento manuale.
  pagatoFornitore    Float? // importo pagato al fornitore per questo ordine
  fornitoreNome      String? // a chi è stato pagato (facoltativo)
  transazionePagamentoId String? // movimento bancario in uscita abbinato
  pagatoIl           DateTime?
  richieste          RichiestaPagamentoOrdine[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([negozioId, orderId])
  @@index([statoRicon, data])
  @@index([categoriaPagamento])
}

// Registro centrale dei pagamenti riconciliati: ogni incasso/pagamento
// riconosciuto (ordine Shopify, fattura pagata, pagamento diretto, bonifico
// partner) ottiene un RIFERIMENTO univoco e stabile (PAY-<anno>-<progressivo>),
// così le altre app possono citarlo. Idempotente per (origineTipo, origineId):
// lo stesso record d'origine non genera due riferimenti.
model Pagamento {
  id          String   @id @default(cuid())
  riferimento String   @unique // es. PAY-2026-000123
  numero      Int // progressivo nell'anno
  anno        Int
  tipo        String // ordine_shopify | fattura_servizi | pagamento_diretto | bonifico_partner | incasso_partner
  direzione   String // in (incasso) | out (pagamento in uscita)
  importo     Float
  divisa      String   @default("EUR")
  data        DateTime // data del pagamento/incasso
  controparte String? // partner/cliente/fornitore
  partnerId   String?
  descrizione String?
  origineTipo String // tipo del record che ha generato il pagamento
  origineId   String // id del record d'origine
  createdAt   DateTime @default(now())

  @@unique([origineTipo, origineId])
  @@unique([anno, numero])
  @@index([tipo, data])
  @@index([partnerId])
}

// Attività finance da portare a termine: cose da fare legate all'amministrazione
// (sollecitare un pagamento, emettere una fattura, verificare un incasso…).
// Collegabile opzionalmente a un partner o a un riferimento (fattura/PAY-…).
model TaskFinance {
  id           String    @id @default(cuid())
  titolo       String
  note         String?
  stato        String    @default("aperto") // aperto | in_corso | fatto
  priorita     String    @default("P1") // P0 (urgente) | P1 (media) | P2 (bassa)
  assegnatario String? // a chi è attribuita l'attività (nome o email)
  scadenza     DateTime?
  partnerId    String?
  partnerNome  String? // snapshot per l'elenco senza join
  riferimento  String? // riferimento libero: n° fattura, PAY-…, pro-forma…
  // condivisione con le altre app: chi ha creato il task e con quale id interno,
  // così un'app che crea/aggiorna lo stesso task non genera doppioni.
  origineApp   String? // app che ha aperto il task via API (es. deluxy-mail)
  idEsterno    String? // id del task nell'app d'origine
  // Copia nel registro centralizzato **deluxy-tasks**: là l'attività si vede
  // insieme a quelle di tutte le altre app. Qui si tiene l'id nativo per poterla
  // ritrovare e archiviare, e l'ora dell'ultimo allineamento riuscito.
  tasksId      String? // id della task dentro deluxy-tasks
  tasksIl      DateTime?
  completatoIl DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([origineApp, idEsterno])
  @@index([stato, scadenza])
}

// Impostazioni dell'app (chiave/valore): dati ordinante SEPA, preferenze
model Impostazione {
  chiave String @id
  valore String
}

// Storico delle fee di un partner: "dal mese/anno la fee diventa X%".
// Una vendita per un dato mese prende la fee valida in quel mese (la tariffa più
// recente con decorrenza <= mese), così lo storico resta invariato e i mesi
// successivi si aggiornano da soli. Fallback: partner.feePercent.
model TariffaPartner {
  id         String   @id @default(cuid())
  partnerId  String
  dalAnno    Int
  dalMese    Int // 1-12: la fee è valida DA questo mese in poi
  feePercent Float
  createdAt  DateTime @default(now())

  @@unique([partnerId, dalAnno, dalMese])
  @@index([partnerId])
}

// Regola di associazione: quando l'operatore assegna a mano un partner a un
// movimento non riconosciuto, la controparte viene memorizzata qui così i
// movimenti futuri dello stesso soggetto si riconoscono da soli.
model AssociazioneControparte {
  id          String   @id @default(cuid())
  chiave      String   @unique // controparte normalizzata
  partnerId   String
  partnerNome String
  esempio     String? // testo originale che ha generato la regola
  usi         Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Storico delle richieste di verifica arrivate via API da altri progetti.
model RichiestaVerifica {
  id              String   @id @default(cuid())
  origine         String? // app chiamante (header X-App o parametro)
  queryPartner    String // cosa è stato cercato
  partnerId       String?
  partnerNome     String?
  esito           String // trovato | non_trovato | non_autorizzato
  rispostaSintesi String? // riassunto testuale della situazione tornata
  ip              String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Piano commerciale: actual 2025 / actual 2026 / forecast 2026
// (foglio "Piano commerciale e Forecast")
model Forecast {
  id          String  @id @default(cuid())
  partnerNome String
  servizio    String
  anno        Int // anno di riferimento del forecast (2026)
  mese        Int
  valPrecedente Float? // consuntivo anno precedente (2025)
  actual      Float?
  forecast    Float?

  @@unique([partnerNome, servizio, anno, mese])
}
