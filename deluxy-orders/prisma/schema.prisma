// Deluxy Orders — schema dati
// Registro centralizzato degli ordini Shopify di tutti i brand Deluxy.
// È la fonte di verità degli ordini: li scarica da Shopify (NegozioShopify →
// Ordine), permette di riclassificarli a piacimento (stato/pipeline, etichette
// libere, categorie, assegnazione/instradamento) e li espone alle altre app via
// API a chiave di sola lettura. Gemello, per gli ordini, di Deluxy Anagrafiche.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) in produzione
  directUrl = env("DIRECT_URL") // connessione diretta per migrazioni/db push
}

// Negozio Shopify collegato. Autenticazione, in alternativa:
//  A) token statico shpat_... (custom app "vecchio stile")
//  B) Client ID + Secret di un'app della Dev Dashboard: l'app conia da sé un
//     token Admin col "client credentials grant" (valido ~24h) e lo rinnova.
// Stesso modello usato da deluxy-partner, così i negozi si configurano uguali.
model NegozioShopify {
  id           String    @id @default(cuid())
  brand        String    @unique // es. deluxyflowers.com
  dominio      String // es. fb72b1-2.myshopify.com
  token        String    @default("") // token Admin in uso (statico o coniato)
  clientId     String? // Dev Dashboard app: Client ID
  clientSecret String? // Dev Dashboard app: Client Secret
  tokenScadeIl DateTime? // scadenza del token coniato (null = token statico)
  // Colore del brand: distingue a colpo d'occhio gli ordini dei vari negozi
  // (pallino nell'elenco, bordo delle schede, testata della colonna per brand).
  colore       String    @default("#b8963e")
  // Come questo negozio si chiama nell'app Ricerca fornitori (search-deluxy):
  // lì i brand sono "deluxy.it", "deluxyflowers.com", "cakedesign.me". Se il
  // nome qui è diverso (es. "Flowers"), si indica la corrispondenza; se è
  // vuoto si usa il nome del brand così com'è.
  brandRicerca String?
  // Che cosa vende soprattutto questo negozio: «fiori», «torte»…
  // Serve quando un prodotto non si riconosce dal titolo (i best seller si
  // chiamano «Botticelli» o «Favolosa», e nel nome non c'è la categoria): su un
  // negozio che vende una cosa sola, quella cosa è la risposta giusta. Vuoto =
  // nessuna deduzione, il prodotto resta «non classificato».
  categoriaPredefinita String?
  attivo       Boolean   @default(true)
  ultimaSync   DateTime?
  ordini       Ordine[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Traccia dei clienti salvati nella rubrica Google. I clienti non sono una
// tabella (si ricavano dagli ordini), quindi si tiene qui il legame fra la
// chiave del cliente e il contatto creato: serve a non ricreare doppioni e a
// sapere cosa è già stato salvato senza reinterrogare Google.
model ContattoRubrica {
  id           String   @id @default(cuid())
  chiave       String   @unique // stessa chiave dei clienti: email → telefono → nome
  resourceName String   @default("") // id del contatto su Google (people/c123…)
  nome         String   @default("") // nome come scritto in rubrica ("FL Mario Rossi #1042")
  esito        String   @default("ok") // ok | errore | saltato
  messaggio    String? // motivo, se non è andata
  salvatoIl    DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([esito])
}

// Tipologia di un cliente decisa DA UN OPERATORE (privato, azienda, hotel,
// eventi, rivenditore). I clienti non sono una tabella — si ricavano dagli
// ordini — quindi il tag si aggancia alla stessa `chiave` (email → telefono →
// nome). L'app propone una tipologia dedotta dal nome dell'acquirente: quando
// qui c'è un record, vince questo. La mano batte sempre la deduzione, come per
// `categoriaPagamentoManuale` sugli ordini.
model TagCliente {
  id           String   @id @default(cuid())
  chiave       String   @unique
  tipo         String // privato | azienda | horeca | eventi | rivenditore
  note         String? // perché: "cliente B2B, fattura a fine mese"
  autore       String? // chi l'ha deciso
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([tipo])
}

// Le impostazioni di PRIVACY di un cliente decise qui dentro: valgono più di
// quelle importate da Shopify, perché sono l'ultima volontà che conosciamo
// (una telefonata, un'email di disiscrizione, una richiesta a voce).
//
// Tre valori possibili per canale: `si` (si può contattare), `no` (non si può),
// `null`/assente (non lo sappiamo → si applica quello di Shopify, e se manca
// anche quello **non si contatta**: nel dubbio non si scrive a nessuno).
//
// `bloccato` è l'interruttore generale: nessuna automazione lo scavalca, per
// nessun canale. Serve a chi chiede di essere lasciato in pace.
model PrivacyCliente {
  id           String   @id @default(cuid())
  chiave       String   @unique // stessa chiave dei clienti: email → telefono → nome
  email        String? // si | no
  sms          String? // si | no  (vale anche per WhatsApp)
  telefono     String? // si | no  (chiamate)
  bloccato     Boolean  @default(false)
  note         String? // perché: "ha chiesto di non essere più contattato, 12/07"
  autore       String?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([bloccato])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTOMAZIONI — messaggi ai clienti di una lista, scritti da uno script.
//
// Un'automazione NON invia da sola nel mondo: prepara i messaggi, uno per
// cliente, già compilati e già passati al setaccio dei consensi. L'invio vero
// resta un gesto con un responsabile davanti (oggi si esporta o si manda a mano
// dal Customer Service). È voluto: un errore in una lista da 2.000 persone non
// si corregge dopo.
// Uno SCRIPT è un testo da mandare ai clienti, scritto una volta e riusato: il
// messaggio di riordino, l'invito per una ricorrenza, il ringraziamento dopo il
// primo acquisto. Vive per conto suo perché lo si scrive una volta e lo si usa
// in più automazioni — e perché un testo che parla ai clienti si rilegge, si
// corregge e si fa correggere da qualcun altro.
//
// LE VARIABILI. Nel testo si scrivono fra doppie graffe: `{{nome}}`.
// Ce ne sono di due specie, e la differenza conta:
//  - **automatiche**: le riempie l'app coi dati di quel cliente ({{nome}},
//    {{ultimo_ordine}}, {{giorni}}, …). Sono sempre disponibili, non si
//    dichiarano;
//  - **dichiarate qui** (`variabili`): quelle che decide chi scrive — uno
//    sconto, una data, il nome di una collezione. Ogni automazione che usa lo
//    script sceglie il proprio valore, così lo stesso testo serve a gennaio e a
//    febbraio senza riscriverlo.
// Una variabile dichiarata **obbligatoria** e lasciata vuota BLOCCA la
// preparazione dei messaggi: meglio un'automazione ferma che cinquecento
// messaggi con scritto «{{sconto}}».
model Script {
  id          String  @id @default(cuid())
  nome        String
  descrizione String  @default("")
  canale      String  @default("whatsapp") // per quale canale è pensato
  oggetto     String  @default("") // solo per l'email
  testo       String  @default("") @db.Text
  // [{ chiave, etichetta, valore, obbligatoria }] — vedi VariabileScript
  variabili   Json?
  attivo      Boolean @default(true)

  automazioni  Automazione[]
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([attivo])
}

model Automazione {
  id          String @id @default(cuid())
  nome        String
  descrizione String @default("")
  // Chi riceve: la chiave di una lista del catalogo (src/lib/segmenti.ts).
  lista       String
  // Come si scrive: `canale` decide quale consenso serve.
  canale      String @default("whatsapp") // whatsapp | email | telefono
  // Cosa si scrive: normalmente uno SCRIPT riusabile (`scriptId`). `script` è
  // il testo scritto direttamente qui, che resta valido quando non si vuole
  // creare uno script apposta — e che tiene in piedi le automazioni nate prima
  // che gli script esistessero.
  scriptId    String?
  scriptUsato Script? @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  // I valori scelti da QUESTA automazione per le variabili dichiarate dallo
  // script: { "sconto": "10%", "collezione": "San Valentino" }. Vuoto = si usa
  // il valore predefinito della variabile.
  valori      Json?
  script      String @default("") @db.Text
  oggetto     String @default("") // solo per l'email

  // Guardrail, tutti con un motivo:
  //  - `giorniSilenzio`: non riscrivere alla stessa persona prima di N giorni;
  //  - `limiteGiro`: quanti messaggi al massimo prepara un giro (una lista da
  //    3.000 persone non si manda tutta in una notte);
  //  - `soloConsenso`: se true (predefinito) esclude chi non ha dato il
  //    consenso per quel canale. Si può togliere solo per i messaggi di
  //    servizio, non per il marketing.
  giorniSilenzio Int     @default(30)
  limiteGiro     Int     @default(50)
  soloConsenso   Boolean @default(true)

  attiva    Boolean               @default(false)
  ultimoGiro DateTime?
  messaggi  MessaggioAutomazione[]
  creatoIl  DateTime              @default(now())
  aggiornatoIl DateTime           @updatedAt

  @@index([attiva])
}

// Un messaggio preparato per un cliente. Resta qui anche dopo l'invio: è la
// memoria che impedisce di riscrivere alla stessa persona ogni settimana.
model MessaggioAutomazione {
  id            String      @id @default(cuid())
  automazioneId String
  automazione   Automazione @relation(fields: [automazioneId], references: [id], onDelete: Cascade)
  chiave        String // il cliente
  nome          String  @default("")
  destinatario  String  @default("") // email o telefono, secondo il canale
  testo         String  @default("") @db.Text
  oggetto       String  @default("")
  // pronto = preparato e mai inviato · inviato · saltato (con motivo) · annullato
  stato         String  @default("pronto")
  motivo        String? // perché è stato saltato: "nessun consenso email", "già scritto 12 giorni fa"
  preparatoIl   DateTime @default(now())
  inviatoIl     DateTime?

  @@index([automazioneId, stato])
  @@index([chiave, preparatoIl])
}

// EVENTI DEI CLIENTI — le occasioni per cui ordinano, ricavate dagli ordini.
//
// Un fioraio non vende fiori: vende ricorrenze. Quando lo stesso cliente manda
// qualcosa alla stessa persona più o meno nello stesso giorno di anni diversi,
// quello è un compleanno, un anniversario, una festa: l'informazione più utile
// che questo registro possieda, ed è sempre stata lì dentro senza che nessuno
// la leggesse.
//
// COME SI RICAVA, e cosa NON si deduce:
//  - si guardano solo la **data di consegna** (attributo strutturato, non il
//    testo delle note) e il **destinatario** della spedizione;
//  - stesso cliente + stesso destinatario + consegne entro 7 giorni l'una
//    dall'altra = una ricorrenza. Se cade in **anni diversi** è confermata dai
//    fatti (`ricorrenze` ≥ 2); se è capitata una volta sola resta un'ipotesi;
//  - **che cosa** si festeggi non si indovina: nessuno scrive «compleanno» in
//    un ordine. Il tipo resta «da precisare» finché una persona non lo scrive.
//    Chiamare «compleanno» un anniversario di matrimonio è il genere di errore
//    che si legge in un messaggio ai clienti.
//
// Gli ordini SENZA data di consegna (un terzo dell'archivio) non producono
// eventi: la data dell'ordine è quando si compra, non quando si festeggia.
model EventoCliente {
  id     String @id @default(cuid())
  chiave String // il cliente (email → telefono → nome), come nelle liste

  // Quando ricorre: giorno e mese, perché torna ogni anno.
  giorno Int
  mese   Int

  destinatario String @default("") // a chi va: è ciò che distingue due eventi
  citta        String @default("")
  titolo       String @default("") // come lo chiama l'operatore
  tipo         String @default("da-precisare") // compleanno | anniversario | ricorrenza | altro

  // Le prove: quante volte è successo, in quali anni, con quali ordini.
  ricorrenze Int      @default(1)
  primoAnno  Int
  ultimoAnno Int
  ordini     String   @default("") // numeri degli ordini, separati da spazio
  ultimaSpesa Float   @default(0) // quanto ha speso l'ultima volta

  // Da dove viene il TIPO (compleanno, anniversario, condoglianze…):
  //  · "" — nessuno l'ha detto, è ancora «da precisare»;
  //  · "ai" — l'ha letto ChatGPT nel biglietto o nella nota dell'ordine;
  //  · "manuale" — l'ha scritto una persona, e da lì l'AI non lo tocca più.
  tipoDa     String  @default("")
  motivoTipo String? // perché, come l'ha spiegato l'AI
  prova      String? // il pezzo di biglietto su cui si è basata: si legge in pagina

  origine String @default("dedotto") // dedotto | manuale
  // da-confermare = l'ha trovato l'app · confermato = l'ha guardato una persona
  // · ignorato = non è un evento (una consegna capitata lì per caso)
  stato   String @default("da-confermare")
  note    String?

  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  // Uno solo per cliente + destinatario + giorno: rilanciare il rilevamento
  // aggiorna, non duplica.
  @@unique([chiave, destinatario, mese, giorno])
  @@index([mese, giorno])
  @@index([chiave])
  @@index([stato])
}

// Stato del flusso di lavoro (pipeline) — completamente personalizzabile.
// È la classificazione principale su cui si muove la Bacheca. `chiave` è lo slug
// stabile citato dalle API; `nome` è l'etichetta mostrata.
model StatoOrdine {
  id          String   @id @default(cuid())
  chiave      String   @unique // slug stabile per le API, es. da_smistare
  nome        String
  colore      String   @default("#6e6e73") // hex, per dot/pillola
  ordine      Int      @default(0) // posizione nella pipeline
  predefinito Boolean  @default(false) // stato iniziale dei nuovi ordini
  terminale   Boolean  @default(false) // stato di chiusura (consegnato/annullato)
  ordini      Ordine[]
  createdAt   DateTime @default(now())

  @@index([ordine])
}

// Etichetta libera (tag) applicabile agli ordini per raggrupparli a piacimento.
model Etichetta {
  id        String   @id @default(cuid())
  nome      String   @unique
  colore    String   @default("#0071e3") // hex
  ordini    Ordine[] @relation("OrdineEtichette")
  createdAt DateTime @default(now())
}

// Ordine Shopify importato, con la classificazione Deluxy sovrapposta.
model Ordine {
  id        String         @id @default(cuid())
  negozioId String
  negozio   NegozioShopify @relation(fields: [negozioId], references: [id], onDelete: Cascade)
  brand     String
  orderId   String // gid Shopify (globale, univoco per negozio)
  numero    String // es. #1234
  data      DateTime // createdAt su Shopify
  totale    Float
  valuta    String         @default("EUR")

  // stato lato Shopify (informativo, non modificabile qui)
  financialStatus   String? // PAID | PENDING | PARTIALLY_PAID | REFUNDED | VOIDED...
  fulfillmentStatus String? // FULFILLED | UNFULFILLED | PARTIALLY_FULFILLED...
  // Annullamento: NON si deduce dal pagamento. Un ordine annullato può restare
  // "PAID" (rimborso non ancora emesso), quindi senza questi campi risulterebbe
  // identico a uno valido — caso reale: #2565, annullato ma PAID.
  annullatoIl        DateTime? // null = non annullato
  motivoAnnullamento String? // CUSTOMER | DECLINED | FRAUD | INVENTORY | STAFF | OTHER
  chiusoIl           DateTime? // archiviato su Shopify (lavorazione conclusa)

  // Analisi antifrode di Shopify. Si salvano il livello, la raccomandazione e
  // SOLO i motivi negativi: sono quelli che spiegano perché un ordine è
  // sospetto (IP lontano dalla consegna, paese di fatturazione diverso, proxy).
  // I motivi positivi e neutri sono decine per ordine e non servono a decidere.
  rischioLivello        String? // NONE | LOW | MEDIUM | HIGH
  rischioRaccomandazione String? // ACCEPT | INVESTIGATE | CANCEL | NONE
  rischioMotivi          String? // i motivi negativi, uno per riga
  gateway           String? // nomi gateway concatenati
  noteShopify       String?
  tagShopify        String? // tag Shopify (csv), informativi

  // ---- da dove è arrivato l'ordine (provenienza di marketing) ----
  // Shopify la sa e non la diceva a nessuno: `sorgente` è il canale tecnico
  // (web | shopify_draft_order | pos | id di un'app), `visitaSorgente` e gli
  // `utm*` vengono dalla PRIMA visita del percorso che ha portato a
  // quest'ordine (attribuzione al primo contatto, non all'ultimo).
  // `canaleMarketing` è la lettura in italiano di tutto questo (vedi
  // src/lib/marketing.ts): stringa vuota = non lo sappiamo, e allora non si
  // mostra nessun simbolo invece di inventarne uno.
  sorgente        String?
  visitaSorgente  String? // "Google", "direct", o l'indirizzo del sito che ci ha mandato la persona
  utmSource       String?
  utmMedium       String?
  utmCampaign     String? // il nome della campagna: "[Deluxy] Torte MILANO"
  canaleMarketing String  @default("")

  // cliente
  clienteNome     String?
  clienteEmail    String?
  clienteTelefono String?

  // Consensi di marketing come li conosce Shopify AL MOMENTO DELL'ORDINE.
  // Sono una fotografia, non la verità di oggi: il cliente può aver cambiato
  // idea dopo. Per sapere com'è adesso vale il consenso dell'ordine più
  // recente, e sopra tutto vale la scelta scritta a mano in PrivacyCliente.
  // Valori Shopify: SUBSCRIBED | NOT_SUBSCRIBED | PENDING | UNSUBSCRIBED | REDACTED.
  consensoEmail   String?
  consensoEmailIl DateTime? // quando il cliente ha espresso quel consenso
  consensoSms     String?
  consensoSmsIl   DateTime?

  // consegna richiesta dal cliente: su Shopify sono attributi dell'ordine
  // (Data_Consegna = data ISO, Fascia_Oraria_Consegna = fascia tipo "16-20").
  // Non tutti gli ordini li hanno: restano null.
  dataConsegna   DateTime? // giorno di consegna richiesto
  fasciaConsegna String? // fascia oraria, come scritta dal negozio

  // Testo del biglietto/dedica che accompagna il regalo. Per un fioraio è il
  // dato che non si può sbagliare: va scritto a mano sul cartoncino.
  biglietto String?
  // true = il testo non è un attributo strutturato ma la nota dell'ordine, che
  // *sembra* contenere una dedica. Va letto e verificato, non copiato alla
  // cieca: nelle note finiscono anche indirizzi e istruzioni per il corriere.
  bigliettoDaNota Boolean @default(false)

  // spedizione
  spedizioneNome String?
  indirizzo      String?
  citta          String?
  cap            String?
  provincia      String?
  paese          String?

  // La città RICAVATA quando l'indirizzo non ce l'ha: dai tag dell'ordine
  // («Roma») o dal nome del prodotto («Colazione Alassio»). Sta in un campo
  // SUO, separato da `citta`: un indirizzo di consegna è un impegno, una
  // deduzione è un'ipotesi, e confonderle vorrebbe dire mandare un fattorino a
  // un indirizzo che nessuno ha mai scritto. `cittaDedottaProva` conserva il
  // testo esatto in cui è stata trovata, così chi legge può darle torto.
  cittaDedotta      String?
  cittaDedottaDa    String? // tag | prodotto
  cittaDedottaProva String?

  // ---- chi manda (indirizzo di fatturazione su Shopify) ----
  // In un negozio di regali il mittente e il destinatario sono due persone e
  // due luoghi diversi: si spedisce da Kuwait a Gardone Riviera. Senza queste
  // colonne il registro sapeva solo dove arriva la merce, non da dove parte la
  // richiesta — che è metà del mestiere.
  mittenteNome      String?
  mittenteCitta     String?
  mittenteProvincia String?
  mittentePaese     String? // codice ISO2: IT, GB, US…

  // Quanto tempo c'è fra l'ordine e la consegna richiesta: urgenza, pensiero,
  // pianificato, evento, lontano — oppure "" se la data di consegna non c'è.
  // Si ricalcola da sé (src/lib/urgenza.ts): è una lettura di due date, non un
  // dato da tenere aggiornato a mano.
  urgenza String @default("")

  // Di che cosa è fatto l'ordine: le categorie dei suoi prodotti, separate da
  // spazio («fiori dolci»). Si ricava dai titoli delle righe (vedi
  // src/lib/categorie.ts) e si riscrive quando l'ordine cambia; l'archivio si
  // ricalcola in una query sola dal pulsante in Impostazioni.
  categorie String @default("")

  righe RigaOrdine[]

  // ---- classificazione Deluxy (riclassificabile a piacimento) ----
  statoId   String?
  stato     StatoOrdine? @relation(fields: [statoId], references: [id])
  etichette Etichetta[]  @relation("OrdineEtichette")

  // categorie (dedotte dalla sync, correggibili a mano)
  categoriaPagamento        String  @default("altro") // bonifico | carta | contrassegno | altro
  categoriaPagamentoManuale Boolean @default(false) // true = impostata a mano: la sync non la tocca
  tipoConsegna              String? // es. consegna | ritiro | spedizione
  tipoProdotto              String? // es. fiori | pasticceria | gift...
  canale                    String? // es. web | telefono | rivenditore

  // instradamento / assegnazione
  assegnatoApp String? // id app destinazione (search | partner | consegne...)
  fornitore    String? // fiorario/pasticceria assegnato
  responsabile String? // persona/email in carico

  // dimensioni libere chiave→valore (riclassificazione senza cambi di schema)
  classificazioni Json?

  // Ordine PROBLEMATICO: i soldi non tornano e serve un occhio umano. Oggi lo
  // fa scattare il RIMBORSO PARZIALE (financialStatus = PARTIALLY_REFUNDED):
  // l'ordine resta valido e in piedi, ma una parte del denaro è tornata al
  // cliente — e nel registro non c'è quanta. Non è un errore da nascondere: è
  // una coda di lavoro. Il motivo NON si salva (si ricava sempre dallo stato
  // Shopify, così non può invecchiare); qui si salva solo che qualcuno l'ha
  // guardato e cosa ha concluso.
  problemaGestito Boolean @default(false)
  problemaNota    String? // "rimborsata la spedizione, cliente d'accordo"

  // ---- CONTROLLO: i soldi di questo ordine (incasso e costo) ----------------
  // Le due metà del margine, tenute separate perché arrivano da due strade e non
  // valgono uguale: l'INCASSO è quello che il cliente ci ha davvero pagato, il
  // COSTO è quello che abbiamo pagato al fornitore. Nessuno dei due si deduce
  // dal totale dell'ordine: senza il dato si scrive che non c'è.
  //
  // COME si incassa: `riconciliazione` (si cerca il movimento in banca),
  // `partner` (l'ordine rientra nel conto mensile del partner, in banca non c'è
  // niente da cercare), `pagamento_esterno` (richiesta di pagamento fuori da
  // Shopify: il denaro arriva in banca e va abbinato).
  gestioneIncasso String @default("riconciliazione")
  // da_riconciliare | riconciliato | incassato_gateway | ignorato
  statoIncasso       String    @default("da_riconciliare")
  movimentoIncassoId String? // MovimentoBanca.id (specchio di Finance)
  incassatoIl        DateTime?

  // Quanto abbiamo PAGATO al fioraio/pasticceria per quest'ordine. Il fornitore
  // non sta nell'ordine Shopify: l'abbinamento è manuale o per numero d'ordine
  // in causale. `costoDa` dice CHI l'ha deciso, perché un costo scritto a mano e
  // uno agganciato da una regola non meritano la stessa fiducia.
  costoFornitore     Float?
  costoFornitoreNome String?
  costoMovimentoId   String? // MovimentoBanca.id dell'addebito
  costoIl            DateTime?
  costoDa            String? // manuale | causale | finance
  controlloNota      String?

  noteInterne      String?
  ultimaClassifica DateTime? // ultima modifica manuale della classificazione
  eventi           EventoOrdine[]
  feedback         FeedbackOrdine[] // reclami e voti dal Customer Service

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([negozioId, orderId])
  @@index([statoId])
  @@index([statoIncasso, data])
  @@index([costoFornitore])
  @@index([movimentoIncassoId])
  @@index([costoMovimentoId])
  @@index([brand, data])
  @@index([dataConsegna])
  @@index([annullatoIl])
  @@index([fulfillmentStatus])
  @@index([financialStatus])
  @@index([problemaGestito])
  @@index([rischioLivello])
  @@index([categoriaPagamento])
  @@index([canaleMarketing])
  @@index([urgenza])
  @@index([citta])
  @@index([paese])
  @@index([cittaDedotta])
  @@index([mittenteCitta])
  @@index([mittentePaese])
  @@index([assegnatoApp])
  @@index([data])
}

// Ciò che il CUSTOMER SERVICE sa di un ordine: reclami e voti importati da
// deluxy-messaging (porta 3140) via `/api/v1/feedback`. È una COPIA di sola
// lettura: la fonte resta il Customer Service, qui si mostra accanto all'ordine
// e al cliente. Nessuno modifica un reclamo da Orders — si aprono e si chiudono
// dove c'è la persona che ha parlato col cliente.
model FeedbackOrdine {
  id        String @id @default(cuid())
  // "reclamo:<id>" oppure "voto:<id>": l'identità nel Customer Service, così
  // reimportare è idempotente e un reclamo aggiornato non diventa un doppione.
  idEsterno String @unique
  tipo      String // reclamo | voto

  // Ordine a cui si riferisce. `ordineId` si valorizza SOLO quando il numero
  // identifica un ordine senza ambiguità: un reclamo attaccato all'ordine
  // sbagliato è peggio di un reclamo non attaccato. `collegamento` dice come è
  // andata (numero+brand | numero | ambiguo | non-trovato).
  ordineId     String?
  ordine       Ordine? @relation(fields: [ordineId], references: [id], onDelete: SetNull)
  ordineNumero String  @default("")
  negozio      String  @default("")
  collegamento String  @default("non-trovato")

  clienteNome     String @default("")
  clienteEmail    String @default("")
  clienteTelefono String @default("")

  // --- reclamo ---
  casistica   String  @default("")
  colpaTipo   String  @default("") // valet | partner | azienda | cliente | nessuno
  colpaNome   String  @default("")
  gravita     Int? // 1 lieve · 2 media · 3 grave
  stato       String  @default("") // aperto | in_lavorazione | risolto | chiuso
  descrizione String?
  azioni      String?
  esito       String?
  risoltoIl   DateTime?

  // --- voto (giudizio 1-5 su valet o partner, legato a un ordine) ---
  voto         Int?
  testo        String?
  origine      String? // telefono | whatsapp | email | reclamo | altro
  soggettoTipo String? // valet | partner
  soggettoNome String?

  creatoIl     DateTime // quando è nato nel Customer Service
  aggiornatoIl DateTime // ultima modifica là: è la base dell'import incrementale
  importatoIl  DateTime @default(now()) @updatedAt

  @@index([ordineId])
  @@index([tipo, stato])
  @@index([ordineNumero])
  @@index([aggiornatoIl])
}

// La categoria di un PRODOTTO, quando il suo nome non basta a capirla.
//
// I prodotti più venduti si chiamano «Botticelli - Nascita di Venere»,
// «Favolosa», «Alexander»: nel titolo non c'è nessuna parola che dica cosa
// sono. Qui si tiene la risposta, con scritto **da dove viene**:
//  · `manuale` — l'ha detto una persona, e vince su tutto;
//  · `ai` — l'ha proposta ChatGPT guardando nome, negozio e prezzo. È una
//    proposta: si vede, si corregge, e resta marcata come tale finché qualcuno
//    non la conferma.
// Le regole a parole (src/lib/categorie.ts) restano davanti alle proposte
// dell'AI: sono deterministiche e si leggono.
model CategoriaProdotto {
  id         String   @id @default(cuid())
  titolo     String   @unique // il titolo della riga d'ordine, così com'è
  categoria  String // una delle categorie vere, mai una inventata
  origine    String   @default("ai") // ai | manuale
  confermata Boolean  @default(false) // true = una persona l'ha guardata
  motivo     String? // perché, come l'ha spiegato l'AI
  righe      Int      @default(0) // quante righe d'ordine porta con sé
  creatoIl   DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([origine, confermata])
}

// Riga d'ordine (line item) importata da Shopify.
model RigaOrdine {
  id       String  @id @default(cuid())
  ordineId String
  ordine   Ordine  @relation(fields: [ordineId], references: [id], onDelete: Cascade)
  titolo   String
  variante String?
  sku      String?
  quantita Int     @default(1)
  prezzo   Float   @default(0) // prezzo unitario
  // Personalizzazioni scelte dal cliente sul prodotto ("Scritta sulla torta:
  // Sofia", "Colore della candelina: Rosso"): su Shopify sono le proprietà
  // della riga. Servono a chi prepara l'ordine, quindi si mostrano come lì.
  // Una per riga, nel formato "chiave: valore".
  proprieta String?
  immagine  String? // foto del prodotto (CDN Shopify), per riconoscerlo a colpo d'occhio

  @@index([ordineId])
}

// Storico delle classificazioni: ogni cambio (stato, etichetta, categoria,
// assegnazione, nota) e ogni import lasciano una traccia, così le altre app e
// gli operatori vedono chi ha fatto cosa e quando.
model EventoOrdine {
  id          String   @id @default(cuid())
  ordineId    String
  ordine      Ordine   @relation(fields: [ordineId], references: [id], onDelete: Cascade)
  tipo        String // stato | etichetta | categoria | assegnazione | nota | sync
  descrizione String
  autore      String? // "operatore" | "sync" | nome chiave API
  creatoIl    DateTime @default(now())

  @@index([ordineId, creatoIl])
}

// MOVIMENTO BANCARIO — specchio di SOLA LETTURA dell'estratto conto che vive in
// Finance (deluxy-partner, `GET /api/v1/movimenti`).
//
// Perché una copia e non una lettura al volo: il controllo degli ordini cerca,
// filtra e abbina su ~11.000 movimenti, e deve funzionare anche quando Finance è
// lento o giù. La copia è idempotente su `hash` (l'identità del movimento in
// Finance): reimportare non duplica niente.
//
// ⚠️ Qui NON si scrive mai niente che riguardi Finance: il denaro, la categoria
// di costo e lo stato contabile restano suoi. Di nostro c'è solo l'uso che ne fa
// il controllo degli ordini, e quello sta sull'ORDINE (movimentoIncassoId /
// costoMovimentoId), non qui: così una reimportazione non può cancellarlo.
model MovimentoBanca {
  id        String @id @default(cuid())
  idFinance String @unique // id del movimento in deluxy-partner
  hash      String @unique // identità stabile del movimento nell'estratto

  data        DateTime
  importo     Float // > 0 accredito (incasso), < 0 addebito (pagamento)
  divisa      String  @default("EUR")
  descrizione String  @db.Text
  controparte String?
  fonte       String? // nome del file/estratto da cui è arrivato
  // Come lo vede Finance: nuova | registrata | ignorata. Un movimento già
  // «registrata» là è stato usato per altro (una fattura, una spesa) e non va
  // offerto come incasso libero di un ordine.
  statoFinance String @default("nuova")

  importatoIl  DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([data])
  @@index([importo])
  @@index([statoFinance])
}

// Impostazione dell'app: chiave → valore, testuale. Serve alle poche scelte che
// non sono dati (la quota attesa del fornitore) e che devono valere anche in
// produzione senza un deploy.
model Impostazione {
  chiave       String   @id
  valore       String   @db.Text
  aggiornatoIl DateTime @updatedAt
}

// Chiave API di un'app client. Nel database c'è solo lo SHA-256 della chiave.
// Le chiavi si creano con `npm run chiave -- <nome-app> [--scrittura]`.
model ApiKey {
  id        String    @id @default(cuid())
  nome      String    @unique // app client: deluxy-search, deluxy-partner, ...
  hash      String    @unique // sha256 esadecimale della chiave
  scrittura Boolean   @default(false) // true = può riclassificare via PATCH
  attiva    Boolean   @default(true)
  creataIl  DateTime  @default(now())
  ultimoUso DateTime?
}

// Il RIEPILOGO di un cliente, scritto dall'AI leggendo i suoi ordini.
//
// Serve a chi apre una scheda e ha dieci secondi: chi è questa persona, cosa
// compra, per chi, e cosa le piace. Le stesse cose che un negoziante di
// quartiere sa a memoria dei suoi clienti abituali, e che qui erano sparse in
// venti righe d'ordine.
//
// SI AGGIORNA A OGNI ORDINE, non si riscrive: i punti già scritti restano e
// l'AI ne aggiunge uno per gli ordini nuovi. Così il riepilogo è una storia che
// cresce, e due letture a distanza di mesi non si contraddicono.
model RiepilogoCliente {
  id     String @id @default(cuid())
  chiave String @unique // la stessa dei clienti: email → telefono → nome

  testo String @default("") @db.Text // il riassunto in prosa, poche righe
  punti String @default("") @db.Text // un punto per riga: i fatti, in ordine
  // Preferenze e gusti: cosa compra e per chi. Sono la parte che serve a
  // vendere bene — «solo fiori, sempre rose rosse, sempre alla stessa persona».
  gusti String @default("") @db.Text

  // Fin dove è arrivato: se sono arrivati ordini dopo, il riepilogo è vecchio e
  // la scheda lo dice invece di far finta di niente.
  ordiniConsiderati Int       @default(0)
  ultimoOrdine      DateTime?
  modello           String    @default("")

  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt
}
