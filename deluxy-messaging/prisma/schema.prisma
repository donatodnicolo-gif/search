// Deluxy Messaggi — schema dati
//
// Un'inbox unificata: le conversazioni arrivano da canali diversi (WhatsApp,
// Messenger, Instagram via webhook Meta, più il widget di chat dei siti) ma
// vivono tutte nelle stesse due tabelle: Conversazione e Messaggio.
//
// I token Meta sono salvati in Impostazione SEMPRE cifrati (AES-256-GCM,
// src/lib/crypto.ts). Le password degli utenti sono hashate (scrypt), mai
// reversibili.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) in produzione
  directUrl = env("DIRECT_URL") // connessione diretta per prisma db push
}

// Chi accede all'app. Il primo utente si crea dalla pagina di login
// (bootstrap); gli altri li può creare un admin in seguito.
model Utente {
  id           String   @id @default(cuid())
  email        String   @unique
  nome         String
  passwordHash String // scrypt "salt.hash" — mai reversibile
  // ⚠️ `@default("admin")` è il default del PRIMO account (l'installazione
  // vergine). Le due creazioni che esistono passano sempre il ruolo esplicito
  // (`login/actions.ts` per il primo, `utenti/actions.ts` con ripiego su
  // «operatore» per gli altri): nessuna riga nasce amministratore per caso.
  ruolo        String   @default("admin") // admin | operatore
  /**
   * LA GENERAZIONE DELLE SUE SESSIONI.
   * ⚠️⚠️ Il cookie è `userId.generazione.HMAC(...)` e non contiene altro:
   * nessuna scadenza, nessun identificatore di sessione. Senza questo numero
   * **cambiare la password non buttava fuori nessuno** — che è la mossa
   * istintiva dopo un sospetto, e lasciava dentro esattamente chi si voleva
   * cacciare. L'unica leva era cambiare `APP_SECRET`, che però è anche la
   * chiave con cui sono cifrati tutti i segreti: usarla per chiudere una
   * sessione li rendeva illeggibili in blocco, webhook Meta e posta compresi.
   * Cambiando la password il numero sale, e ogni cookie firmato con il numero
   * di prima smette di valere al primo caricamento.
   */
  generazione  Int      @default(0)
  creatoIl     DateTime @default(now())
}

// Coppie chiave/valore di configurazione (token Meta cifrati, verify token,
// titolo del widget…). Vedi src/lib/impostazioni.ts per le chiavi usate.
model Impostazione {
  chiave String @id
  valore String @db.Text
}

// Uno store Shopify collegato. La holding ha più negozi: da ognuno scarichiamo
// gli ordini. Le credenziali (token statico o Client Secret) sono cifrate.
// Due modi di autenticarsi, come in src/lib/shopify.ts:
//  - token: Admin API access token statico (shpat_…) di un'app legacy
//  - clientId + clientSecret: app Dev Dashboard (client credentials grant)
model NegozioShopify {
  id               String   @id @default(cuid())
  nome             String // etichetta leggibile, es. "Deluxy Flowers"
  // Sigla usata davanti al nome in rubrica: DL (Deluxy), FL (Flowers), CK (Cake).
  // Vuota = dedotta dal nome/dominio (vedi prefissoDaNegozio in src/lib/negozi.ts).
  prefisso         String   @default("")
  // Il nome del brand come lo conosce l'app Ricerca fornitori (es. deluxyflowers.com):
  // serve al bottone "Fornitore" sotto ogni ordine. Vuoto = dedotto dal nome.
  brandRicerca     String   @default("")
  dominio          String   @unique // es. fb72b1-2.myshopify.com
  token            String   @default("") @db.Text // shpat_… cifrato (se app legacy)
  clientId         String   @default("")
  clientSecret     String   @default("") @db.Text // cifrato (se app Dev Dashboard)
  // Il numero WhatsApp Business di questo brand: `phone_number_id` di Meta
  // (app Meta → WhatsApp → Configurazione API). Serve a sapere a QUALE marchio
  // ha scritto un cliente, e quindi con che tono rispondergli — le istruzioni
  // di CS AI sono per brand. Vuoto = questo brand non ha un suo WhatsApp.
  waPhoneNumberId  String   @default("")
  /// Il numero di telefono di questo marchio, quello che squilla quando un
  /// cliente chiama. Solo cifre. Serve alle CHIAMATE: la notifica del
  /// centralino dice quale nostro numero e stato chiamato, e per uno
  /// sconosciuto — che non ha ordini da cui dedurre il marchio — e l unica
  /// cosa che lo colleghi a un brand. Vuoto = questo marchio non ha un suo
  /// numero, e le sue chiamate restano «senza marchio».
  telefonoChiamate String   @default("")
  attivo           Boolean  @default(true)
  creatoIl         DateTime @default(now())

  ordini         Ordine[]
  istruzioniAI   IstruzioneAI[]
  documentiAI    DocumentoAI[]
  numeriWhatsApp NumeroWhatsApp[]
  pagineMeta     PaginaMeta[]
  caselleEmail   CasellaEmail[]
  widgetSiti     WidgetSito[]
}

// Uno "script": una risposta pronta da dare ai clienti. Sono la memoria
// dell'assistenza — l'AI li legge per rispondere come rispondiamo noi, invece
// di inventare un tono e dei contenuti suoi.
model Script {
  id           String   @id @default(cuid())
  titolo       String
  categoria    String   @default("Generale")
  testo        String   @db.Text
  // Quando usarlo, a parole: serve all'AI per scegliere quello giusto.
  quando       String   @default("") @db.Text
  attivo       Boolean  @default(true)
  usi          Int      @default(0) // quante volte è stato usato: i migliori emergono
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([categoria])
}

// Una richiesta di pagamento: le coordinate su cui farsi pagare. L'IBAN e
// l'intestatario possono essere inseriti a mano o letti dall'AI da un
// messaggio o da un'immagine (schermata, foto di un bonifico).
model RichiestaPagamento {
  id                   String    @id @default(cuid())
  iban                 String
  bic                  String    @default("")
  intestatario         String
  importo              Float     @default(0)
  valuta               String    @default("EUR")
  causale              String    @default("")
  note                 String    @default("") @db.Text
  contatto             String    @default("") // come ricontattare chi ha chiesto il pagamento
  linkConversazione    String    @default("") // il thread da cui nasce la richiesta
  // Invio al canale di pagamento. `riferimento` è la chiave di idempotenza
  // concordata: rimandare la stessa richiesta non la duplica.
  riferimento          String    @unique @default(cuid())
  inviataIl            DateTime?
  partnerId            String    @default("")
  partnerStato         String    @default("") // in_attesa | approvata | rifiutata …
  // Da che canale è passata: `transactions` (il contratto: unica app da cui
  // esce denaro, richieste firmate) o `finance` (il ponte storico verso Deluxy
  // Partner, ripiego finché le variabili Transactions non sono impostate).
  // Vuoto = mai inviata. Serve a chiedere lo stato al canale giusto.
  canale               String    @default("")
  esitoInvio           String    @default("") @db.Text // errore dell'ultimo tentativo
  // Esito della verifica formale dell'IBAN (checksum mod-97): non ci si fida
  // di quello che estrae l'AI, si controlla.
  ibanValido           Boolean   @default(false)
  ibanPaese            String    @default("")
  // Da dove arriva: manuale | testo | immagine
  origine              String    @default("manuale")
  ordineNumero         String    @default("") // se legata a un ordine
  /**
   * ⚠️⚠️ L'IDENTITÀ dell'ordine, non il suo nome.
   * Il NUMERO non identifica: lo stesso «#2799» può esistere su due negozi, e
   * chi riconcilia il pagamento sceglieva `findFirst` — cioè uno a caso, e ci
   * scriveva sopra il fornitore e il costo, che finiscono nel margine e
   * viaggiano fino a Deluxy Orders.
   * L'operatore l'ordine lo SCEGLIE da un elenco (`ScegliOrdine`), quindi
   * l'identità c'era: si buttava via al salvataggio, tenendo solo il numero.
   * Qui si conserva. Vuoto = riga vecchia, o numero scritto a mano: in quel
   * caso si usa il numero, ma solo se porta a UN ordine solo.
   */
  ordineId             String    @default("")
  /**
   * COME lo paghiamo: `iban` · `link` · `paypal` · `carta` · `altro`.
   * ⚠️⚠️ Non tutti i fornitori si pagano con un bonifico. Chi manda un link di
   * pagamento, chi dà un indirizzo PayPal, chi si accorda a voce («mi paghi in
   * contanti alla consegna»). Finché l'unica forma prevista era l'IBAN, tutto
   * il resto **non si registrava affatto**: restava in una chat, e su
   * quell'ordine risultava che non avevamo pagato nessuno.
   * ⚠️ `iban` resta il caso di gran lunga più frequente, ed è l'unico che si
   * può verificare col codice di controllo: gli altri sono testo, e la verifica
   * non si finge (`ibanValido` resta falso, e non vuol dire «sbagliato»).
   */
  metodo               String    @default("iban")
  /**
   * Il riferimento quando NON è un IBAN: l'indirizzo del link, la mail PayPal,
   * dove e con quale carta (`carta`), la frase concordata. ⚠️ Testo libero di
   * proposito: la varietà è il punto.
   * ⚠️⚠️ Sta IN CHIARO (non è fra le `CHIAVI_CIFRATE`) in un Postgres condiviso
   * con altre app, e finisce dentro l'avviso su WhatsApp: per questo un numero
   * di carta per esteso viene rifiutato al salvataggio da
   * `numeroDiCartaNelTesto` (src/lib/metodo-pagamento.ts). Le ultime quattro
   * cifre sì: identificano la carta senza essere la carta.
   */
  riferimentoPagamento String    @default("") @db.Text

  // ── QUANDO È STATA PAGATA DAVVERO, e la prova ──
  //
  // ⚠️ Diverso da `inviataIl` (mandata a chi approva) e da `partnerStato`: qui
  // si annota che il denaro È USCITO. Finora l'app sapeva solo di aver chiesto
  // il pagamento, e «chiesto» e «pagato» non sono la stessa cosa — con un
  // fornitore che richiama per sapere se è stato pagato non c'era niente da
  // guardare.
  pagataIl     DateTime?
  pagataDaNome String    @default("")
  /**
   * COME è uscito il denaro: `banca` · `contanti` · `compensazione` ·
   * `app` (da Deluxy Transactions) · `altro`. Vuoto = **non indicato**.
   * ⚠️⚠️ Un bonifico NON parte per forza da un'app nostra. Quasi sempre esce dal
   * portale della banca, a mano; a volte si paga in contanti alla consegna, o si
   * scala da quello che quel fornitore ci deve. Dare per scontato che passi da
   * Deluxy Transactions vuol dire costruire un registro che descrive un mondo
   * che non esiste — e che quindi nessuno tiene aggiornato.
   * ⚠️ È lo stesso fatto che nel resto dell'ecosistema si chiama
   * `pagatoCon: "fuori_app"` (vedi la rotta di notifica di Partner): là serve a
   * ricordare che **la prova del pagamento non ce l'ha l'app**. Qui la prova
   * c'è — è la ricevuta — ma resta importante sapere da dove è uscito.
   * ⚠️ Vuoto NON si riempie da soli: «non indicato» è una risposta, indovinare
   * il canale di un'uscita di denaro no.
   */
  pagatoCon    String    @default("")
  /**
   * La ricevuta: immagine o PDF, tenuta come data URI.
   * ⚠️ Sta nel database e non in uno storage perché quest'app **non ha uno
   * storage**: gli allegati delle chat passano da Meta e non restano. Per
   * qualche centinaio di ricevute va bene; se diventano migliaia va spostata
   * altrove, ed è scritto qui perché chi lo farà sappia perché sta così.
   * ⚠️ Il tetto è ~1,5 MB: il corpo di una funzione serverless arriva a ~4,5 MB
   * e oltre non arriva nemmeno l'errore giusto.
   */
  ricevutaDati String    @default("") @db.Text
  ricevutaNome String    @default("")
  ricevutaTipo String    @default("")
  // ── L'AVVISO AL FORNITORE ──
  //
  // Parte da solo quando si segna «pagata». ⚠️ Ma **non sempre riesce**, e la
  // ragione più frequente non è un guasto: su WhatsApp si può scrivere a
  // qualcuno solo entro 24 ore da un suo messaggio (Meta, errore 131047). Un
  // fornitore che non ci scrive da ieri non è raggiungibile in testo libero.
  //
  // ⚠️⚠️ Per questo l'esito si SCRIVE e si mostra sulla riga. Un avviso
  // automatico di cui non si vede l'esito è la cosa peggiore delle due: si
  // crede che il fornitore sappia, e quello richiama fra tre giorni chiedendo
  // se è stato pagato — cioè si è persa anche la telefonata che si voleva
  // evitare.
  avvisoIl     DateTime?
  avvisoCanale String    @default("") // whatsapp | email
  avvisoEsito  String    @default("") @db.Text // vuoto = riuscito

  // ── COM'È ANDATA COL REGISTRO ANAGRAFICHE ──
  //
  // ⚠️⚠️ Prima non si salvava da nessuna parte: l'esito tornava al browser di
  // chi stava salvando e finiva lì. Misurato il 27/08/2026 su 26 fornitori
  // pagati: 24 erano in registro, 0 mancavano e **2 erano AMBIGUI** — il
  // registro risponde «somiglia a più anagrafiche» e noi giustamente non
  // scriviamo, perché creare a caso vuol dire fabbricare un doppione. Ma quei
  // due restavano fermi **senza che niente in questa app lo dicesse**: né una
  // riga, né un conteggio, né un posto dove andarli a cercare.
  //
  // ⚠️ Ora l'esito si scrive, e la Riconciliazione lo propone a una persona —
  // che è il posto dove in quest'app si sciolgono le ambiguità.
  //
  // `creato` · `aggiornato` · `ambiguo` · `errore` · `non-configurato` ·
  // `senza-nome`. Vuoto = non si è mai provato (le righe più vecchie).
  registroEsito     String    @default("")
  /**
   * La riga che spiega: «somiglia a più anagrafiche», il motivo dell'errore…
   */
  registroMessaggio String    @default("") @db.Text
  registroIl        DateTime?
  creatoIl          DateTime  @default(now())

  @@index([creatoIl])
  @@index([ordineNumero])
}

// Un numero WhatsApp Business collegato. Ce n'è più d'uno perché la holding ha
// più marchi (Deluxy Flowers, Cake Design, Deluxy Cake Delivery…) e ognuno ha
// il suo numero, spesso sotto un WhatsApp Business Account diverso.
//
// ⚠️ Prima la configurazione era SINGOLA (un token e un Phone Number ID nelle
// Impostazioni) e il legame col marchio stava su `NegozioShopify.waPhoneNumberId`.
// Con due marchi già non bastava: si rispondeva a tutti dal numero impostato,
// cioè per metà dei clienti dal marchio sbagliato — dal loro telefono è
// un'altra azienda che scrive di punto in bianco.
//
// Le Impostazioni restano come RIPIEGO per il token: chi ha un solo utente di
// sistema per tutti i numeri non deve ripeterlo qui.
model NumeroWhatsApp {
  id             String   @id @default(cuid())
  nome           String   @default("") // etichetta leggibile, es. "Deluxy Flowers"
  // `phone_number_id` di Meta: è la chiave con cui il webhook riconosce su
  // quale linea è arrivato un messaggio (Conversazione.numeroId).
  phoneNumberId  String   @unique
  numeroVisibile String   @default("") // +39 … , come lo vede il cliente
  // L'ID del WhatsApp Business Account che possiede il numero: serve alla
  // diagnosi per chiedere a Meta se la nostra app è iscritta a quell'account.
  wabaId         String   @default("")
  // Token dedicato a questo numero. Vuoto = si usa quello delle Impostazioni.
  // Cifrato come le password delle caselle: mai in chiaro in tabella.
  token          String   @default("") @db.Text
  // Il marchio a cui appartiene: decide il tono e la firma delle risposte
  // (le istruzioni di CS AI sono per brand).
  negozioId      String?
  attivo         Boolean  @default(true)
  creatoIl       DateTime @default(now())

  negozio NegozioShopify? @relation(fields: [negozioId], references: [id], onDelete: SetNull)

  @@index([negozioId])
}

// Una Pagina Facebook o un account Instagram professionale collegato.
//
// Stesso problema dei numeri WhatsApp, altro canale: la holding ha più pagine e
// più profili Instagram (Deluxy Flowers, Cake Design…). Senza sapere a QUALE
// account ha scritto il cliente si risponde col tono e la firma di un altro
// marchio — e, peggio, si risponde dal token di un'altra pagina, quindi il
// cliente vede arrivare un messaggio da un'azienda a cui non ha scritto.
model PaginaMeta {
  id               String    @id @default(cuid())
  canale           String // messenger | instagram
  // ── Scadenza del token ──
  //
  // ⚠️ Il token dell'«Instagram API con login di Instagram» NASCE CON LA
  // SCADENZA: un'ora quello breve, **60 giorni** quello lungo, e non si rinnova
  // da sé. Al sessantesimo giorno i direct smettono di arrivare senza che niente
  // lo dica — sembra un guasto e invece è il calendario.
  //
  // Qui si tiene quando scade e com'è andato l'ultimo rinnovo, e il cron
  // `/api/cron/token-meta` lo rinnova prima che sia tardi. Un token generato da
  // un UTENTE DI SISTEMA invece non scade: quando c'è quello, questi campi
  // restano vuoti ed è giusto così — è la strada migliore, non un ripiego.
  tokenScadeIl     DateTime?
  tokenRinnovatoIl DateTime?
  /**
   * Com'è andato l'ultimo tentativo di rinnovo: vuoto = mai provato.
   */
  tokenEsito       String    @default("") @db.Text
  // L'ID della Pagina (Messenger) o dell'account Instagram professionale.
  // È la chiave con cui il webhook riconosce il destinatario: sta in
  // `entry[].messaging[].recipient.id`, e finisce in Conversazione.numeroId.
  idPagina         String
  nome             String    @default("") // etichetta leggibile, es. "Deluxy Flowers"
  // Come lo vede il cliente: @nomeutente per Instagram, nome della pagina per
  // Facebook. Serve solo a farsi riconoscere in Inbox.
  riferimento      String    @default("")
  // Token di QUESTA pagina. Cifrato, mai in chiaro in tabella.
  // ⚠️ Qui il ripiego sul token generale è un ripiego vero, non un'equivalenza:
  // ogni Pagina Facebook ha il SUO Page Access Token, e usare quello di un'altra
  // pagina non manda il messaggio dalla pagina giusta — o fallisce, o parte dal
  // marchio sbagliato. Con più pagine, il token per pagina va messo.
  token            String    @default("") @db.Text
  negozioId        String?
  attivo           Boolean   @default(true)
  creatoIl         DateTime  @default(now())

  negozio NegozioShopify? @relation(fields: [negozioId], references: [id], onDelete: SetNull)

  // Lo stesso id non si ripete sullo stesso canale; fra canali diversi sì,
  // perché una Pagina e un account Instagram vivono in due spazi di id.
  @@unique([canale, idPagina])
  @@index([negozioId])
}

// Una casella di posta collegata (se ne possono collegare più d'una).
// Parametri ufficiali register.it: IMAP pop.securemail.pro:993 SSL,
// SMTP authsmtp.securemail.pro:465 SSL, utente = indirizzo completo.
model CasellaEmail {
  id            String   @id @default(cuid())
  nome          String   @default("") // etichetta, es. "Servizio clienti"
  indirizzo     String   @unique // es. cs@deluxy.it — è anche l'utente IMAP/SMTP
  nomeMittente  String   @default("Deluxy")
  // La FIRMA di questa casella, in coda a ogni mail che parte da qui.
  //
  // ⚠️ Una firma sola per tutte le caselle non va: le tre voci sono diverse — il
  // maggiordomo di deluxy.it, l'atelier dei fiori, il complice di Cakedesign — e
  // firmare una mail della pasticceria «Servizio Clienti Deluxy, consegna in
  // guanti bianchi» è dire al cliente una cosa che per quel brand non esiste.
  firma         String   @default("") @db.Text
  password      String   @default("") @db.Text // cifrata
  imapHost      String   @default("pop.securemail.pro")
  imapPort      Int      @default(993)
  smtpHost      String   @default("authsmtp.securemail.pro")
  smtpPort      Int      @default(465)
  // Alcuni provider usano STARTTLS su 587: allora la connessione parte in
  // chiaro e si cifra dopo (secure = false).
  smtpSicuro    Boolean  @default(true)
  // register.it presenta un certificato intestato a un altro dominio: la
  // connessione resta cifrata, si salta solo la verifica del NOME.
  ignoraCertTls Boolean  @default(true)
  attiva        Boolean  @default(true)
  /// A COSA SERVE questa casella:
  ///   `posta`    = posta normale, le mail entrano in inbox come conversazioni;
  ///   `chiamate` = notifiche del centralino, diventano righe in Chiamate.
  ///
  /// ⚠️⚠️ Serve un campo perché la differenza non si vede dall'indirizzo. Senza,
  /// le notifiche di `chiamate@deluxy.it` finirebbero in inbox: una
  /// conversazione per ogni telefonata, con un corpo che nessuno legge e un
  /// mittente che è il centralino, non il cliente. Il canale delle risposte si
  /// riempirebbe di roba a cui non si risponde.
  tipo          String   @default("posta")
  predefinita   Boolean  @default(false) // da quale casella parte una mail nuova
  // Il marchio della casella: è l'unico modo di sapere a chi ha scritto un
  // cliente via email. Una mail non porta con sé «il nostro numero» come fa
  // WhatsApp, quindi senza questo campo finisce «senza marchio» e nell'inbox a
  // colonne resta in un mucchio unico. Vuoto resta una risposta legittima: una
  // casella può servire tutti i marchi insieme.
  negozioId     String?
  creatoIl      DateTime @default(now())

  negozio NegozioShopify? @relation(fields: [negozioId], references: [id], onDelete: SetNull)

  @@index([negozioId])
}

// Ordini scaricati da Shopify. Ne teniamo una copia locale per mostrarli senza
// richiamare Shopify ogni volta e per ricordare se il contatto del cliente è
// già stato salvato su Google Contacts (contattoSalvato/contattoEsito).
model Ordine {
  id          String         @id @default(cuid())
  negozioId   String
  negozio     NegozioShopify @relation(fields: [negozioId], references: [id], onDelete: Cascade)
  negozioNome String         @default("") // denormalizzato per la lista
  shopifyId   String // gid Shopify dell'ordine (unico per negozio, non globale)
  /**
   * L'id che questo ordine ha in DELUXY ORDERS.
   * ⚠️⚠️ È il PONTE verso la piattaforma consegne: là la vendita porta
   * `externalOrderId = <id in Orders>`, non il numero e non il gid Shopify.
   * Senza questo campo, per sapere se un ordine è «in app» bisognerebbe
   * chiedere a Orders una volta per ordine — e chiedere col numero non
   * troverebbe niente, facendo sembrare che in app non ci sia mai nessuno.
   */
  ordersId    String         @default("")

  // ── DUE ORDINI CHE SONO UNA VENDITA SOLA ──
  //
  // ⚠️⚠️ IL CASO VERO (26/08/2026, segnalato dall'utente): «ada hunca» ha pagato
  // la stessa torta con DUE ordini — #1777 da 200 € e #1798 da 170 € — e il
  // fornitore è stato registrato su uno solo, con il costo INTERO: 253 €. Su
  // quell'ordine, da solo, il margine risulta **−43,44 €**; sui due insieme
  // (370 € contro 253) è positivo. Senza unirli, il lavoro si conta due volte,
  // il margine di uno è falso in negativo — e nelle KPI quel falso finisce
  // addosso a un operatore.
  //
  // `unitoA` = il NUMERO dell'ordine principale ('' = ordine a sé). Il numero e
  // non l'id perché è quello che si legge, si cerca e si scrive nelle causali —
  // e perché un ordine unito resta leggibile anche se l'altro sparisse.
  //
  // ⚠️ Un solo livello: unendo B ad A, e poi C a B, C finisce su A. Una catena
  // di ordini uniti non la ricostruisce nessuno.
  //
  // ⚠️⚠️ E RESTA UNA COSA NOSTRA: in Deluxy Orders quei due ordini restano due,
  // ognuno col suo margine. Qui si dice «sono un lavoro solo», non si riscrive
  // l'economia di un'altra app.
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * L'ultimo link di pagamento per una RICONSEGNA di quest'ordine.
   * ⚠️⚠️ Si tiene, e non è un vezzo: senza, chiudendo il pop-up il link
   * spariva e per riaverlo bisognava premere di nuovo «Crea il link» — cioè
   * creare una SECONDA bozza su Shopify per la stessa riconsegna. Due bozze
   * aperte sullo stesso cliente, e chi paga la sbagliata paga comunque.
   * Chiesto dall'utente il 26/08/2026: «segna comunque un link all'apertura del
   * pop-up».
   */
  riconsegnaLink   String    @default("")
  riconsegnaNumero String    @default("")
  riconsegnaIl     DateTime?

  unitoA         String    @default("")
  unitoIl        DateTime?
  unitoDaNome    String    @default("")
  numero         String    @default("") // es. #1042
  data           DateTime  @default(now())
  totale         Float     @default(0)
  valuta         String    @default("EUR")
  statoPagamento String    @default("")
  // GOVERNO del giro: "manuale" = questo ordine ce lo teniamo noi e lo
  // smistamento automatico della piattaforma lo salta; "" = può andare in
  // automatico. La verità sta su Orders (il registro che la piattaforma
  // legge): qui è il riflesso per la scheda, riscritto dalla sync.
  smistamento    String    @default("")
  // ⚠️ ANNULLATO SU SHOPIFY. Orders esclude gli annullati dai suoi elenchi:
  // senza questo campo l'annullamento era INVISIBILE da qui — l'ordine copiato
  // restava «valido» per sempre, smistabile e pagabile. Lo valorizza la sync
  // leggendo `GET /api/v1/ordini?annullatiDa=` (audit 24/08/2026). Un ordine
  // con annullatoIl non si lavora: né fornitore, né pagamento.
  annullatoIl    DateTime?
  clienteNome    String    @default("")
  telefono       String    @default("")
  email          String    @default("")
  indirizzo      String    @default("") @db.Text
  citta          String    @default("") // mostrata sulle card della vista a colonne
  // Paese di spedizione (ISO 2 lettere, da Orders): decide in che LINGUA si
  // scrive al cliente (src/lib/lingua.ts). Vuoto = non si sa, e allora si
  // guarda il prefisso del telefono.
  paese          String    @default("")
  // Consegna richiesta dal cliente e stato nella pipeline Deluxy: arrivano da
  // Orders e reggono il Calendario ordini.
  dataConsegna   DateTime?
  fasciaConsegna String    @default("")

  // ── Consegna spostata da noi ──
  //
  // Quando il cliente chiede un altro giorno, la consegna si sposta DA QUI: il
  // giro da fare prima era Shopify → aspettare il reimport → sperare. Il valore
  // nuovo si scrive dentro `dataConsegna`/`fasciaConsegna` — cioè i campi che
  // leggono già urgenza, calendario, ordinamenti e messaggio al fornitore —
  // e questo interruttore dice al sync di NON ripassarci sopra.
  //
  // ⚠️ Finché è acceso, la nostra data e quella di Shopify possono divergere:
  // l'originale resta in `dataConsegnaOriginale` e a schermo si dice. Quando
  // Orders porta la stessa data (perché qualcuno l'ha sistemata alla fonte),
  // l'interruttore si spegne da solo: la deroga dura solo finché serve.
  consegnaSpostata        Boolean   @default(false)
  dataConsegnaOriginale   DateTime?
  fasciaConsegnaOriginale String    @default("")
  consegnaSpostataDa      String    @default("")
  consegnaSpostataIl      DateTime?
  statoChiave             String    @default("")
  statoNome               String    @default("")
  statoColore             String    @default("")
  note                    String    @default("") @db.Text
  // DA CHE TIPO DI CLIENTE ARRIVA L'ORDINE, letto da Deluxy Orders:
  // privato | azienda | horeca | eventi | rivenditore. Vuoto = Orders non sa
  // dirlo (ordine senza email, telefono né nome).
  //
  // È una COPIA di comodo, non una fonte: la tipologia si decide in Orders (a
  // mano con `TagCliente`, altrimenti dedotta dal nome dell'acquirente) e qui si
  // riscrive a ogni sync. Non modificarla da questa app: cambierebbe solo qui e
  // le due schermate si contraddirebbero.
  clienteTipo             String    @default("")
  // "manuale" (deciso da un operatore in Orders) oppure "dedotta" (dal nome).
  // Serve a sapere quanto fidarsi: una deduzione si può smentire.
  clienteTipoDa           String    @default("")
  // Quante volte quel cliente aveva già comprato PRIMA di questo ordine, e che
  // numero ha questo ordine per lui (1 = è il suo primo).
  //
  // ⚠️ Il conto lo fa ORDERS sulla storia completa, e va preso da lì: la copia
  // locale copre solo gli ultimi due mesi (927 ordini su ~14.000), quindi
  // contando qui un cliente che compra ogni Natale risulterebbe nuovo ogni
  // volta. `null` = Orders non l'ha calcolato o non riconosce il cliente —
  // che è diverso da «è la prima volta», e non va mostrato come tale.
  clienteOrdiniPrima      Int?
  clienteNumeroOrdine     Int?
  // C'è una nota del cliente su questo ordine (dentro c'è il biglietto)?
  //
  // ⚠️ Si tiene solo il SÌ/NO, non il testo. Il testo lo mostra il dettaglio
  // chiedendolo a Orders, come il destinatario e l'indirizzo: è pieno di dati
  // personali (indirizzi, telefoni) e duplicarli qui vorrebbe dire tenerne due
  // copie che possono divergere. Qui serve solo per accendere il simbolo in
  // lista senza interrogare Orders per ogni riga.
  haBiglietto             Boolean   @default(false)
  contattoSalvato         Boolean   @default(false) // salvato su Google Contacts
  contattoEsito           String    @default("") // esito/errore dell'ultimo salvataggio
  // Come stiamo lavorando l'ordine QUI (nostro, distinto dallo stato della
  // pipeline di Orders in statoChiave): da_gestire | in_pagamento |
  // comunicazione | gestito. Lo scarico da Orders non lo tocca mai.
  gestione                String    @default("da_gestire")
  gestioneIl              DateTime?
  // CHI ha cambiato lo stato l ultima volta. Il nome e denormalizzato apposta:
  // la lista lo mostra su ogni riga e un join per ottenere un nome sarebbe
  // sproporzionato; e se un giorno quell utente viene cancellato, resta scritto
  // chi aveva spuntato l ordine invece di un id orfano.
  //
  // Vuoto sui 950 ordini gia in tabella: parte da ora. Non si indovina a
  // posteriori - meglio non saperlo che attribuirlo alla persona sbagliata.
  gestioneDaId            String    @default("")
  gestioneDaNome          String    @default("")

  // ── A CHI ABBIAMO DATO L'ORDINE DA PREPARARE ──
  //
  // ⚠️⚠️ Non esisteva da nessuna parte. L'app sapeva **chi si poteva chiamare**
  // (i fornitori in provincia, chiesti ad Anagrafiche) e sapeva **che è stato
  // pagato qualcuno** (`RichiestaPagamento.intestatario`, un nome su un IBAN),
  // ma non «questo ordine l'ha fatto Tizio». Quel fatto viveva nella testa di
  // chi aveva telefonato: il giorno dopo, davanti a un reclamo, non c'era modo
  // di sapere a chi chiedere — e alla domanda «quanto lavoro diamo a quel
  // fornitore?» non si poteva rispondere affatto.
  //
  // ⚠️ Sta QUI, sull'ordine, e non su una tabella a parte: è un fatto singolo
  // per ordine, si legge in ogni elenco, e una tabella in più vorrebbe dire un
  // join su ogni riga della bacheca.
  //
  // ⚠️ Lo scarico da Orders NON tocca questi campi (l'upsert scrive solo
  // `comuni`, vedi `src/lib/sincronizza.ts`): sono nostri, come
  // `gestione` e `contattoSalvato`.
  fornitoreNome     String    @default("")
  /**
   * L'id nel registro Anagrafiche, quando il fornitore viene da lì.
   * ⚠️ Vuoto NON vuol dire «non censito», vuol dire «trovato fuori dal
   * registro» (Google, passaparola): capita spesso, e impedirlo avrebbe
   * significato non registrare metà degli ordini — cioè non registrarne
   * nessuno, perché un archivio con dei buchi non lo guarda più nessuno.
   */
  fornitoreId       String    @default("")
  fornitoreCitta    String    @default("")
  fornitoreTelefono String    @default("")
  fornitoreEmail    String    @default("")
  /**
   * Quanto gli diamo DAVVERO, concordato al telefono.
   * ⚠️ Diverso dalla «quota fornitore» indicativa (il 60% del venduto), che
   * vive in Deluxy Orders e resta una stima: qui va la cifra pattuita. `null` =
   * non ancora concordata, che è diverso da zero.
   */
  fornitoreCosto    Float?
  fornitoreNota     String    @default("") @db.Text
  /**
   * Chi l'ha registrato e quando: la prima domanda quando qualcosa va storto.
   */
  fornitoreDaId     String    @default("")
  fornitoreDaNome   String    @default("")
  fornitoreIl       DateTime?

  // ── QUELLO CHE DICE LA PIATTAFORMA CONSEGNE (copia, non verità) ──
  //
  // ⚠️⚠️ Questi campi sono una COPIA a breve scadenza di uno stato che vive
  // nella piattaforma consegne (Standard §7: «cache TTL breve sì, tabelle-copia
  // no»). La verità sta là e si rilegge; qui serve a far vedere in elenco che di
  // quell'ordine si sta occupando l'app, senza chiedere a lei una volta per
  // riga. Se qui e là divergono, ha ragione lei.
  //
  // ⚠️ `appStato` sono i suoi stati, scritti come li scrive lei:
  // da_gestire · proposta · accettata · non_accettata · annullata.
  appVenditaId      String    @default("")
  appStato          String    @default("")
  appPartner        String    @default("")
  appCostoPartner   Float?
  appAggiornatoIl   DateTime?
  /**
   * Dov'era la lavorazione PRIMA che l'ordine passasse in app.
   * ⚠️ Serve a tornare indietro senza perdere niente: interrompendo la gestione
   * dall'app, o quando la proposta non viene accettata, l'ordine deve ritrovare
   * il punto in cui l'avevamo lasciato — non ripartire da «Da iniziare» come se
   * nessuno ci avesse mai lavorato.
   */
  appGestionePrima  String    @default("")
  /**
   * Quando una persona ha detto «questo lo facciamo noi».
   * ⚠️⚠️ Vale come un NO alla sincronizzazione: senza, il giro successivo
   * rimetterebbe l'ordine «In App» e la decisione della persona durerebbe dieci
   * minuti. Si toglie riportandolo in automatico.
   */
  appInterrottoIl   DateTime?
  /// La consegna nata di la quando l ordine e stato mandato IN APP da qui:
  /// numero che si legge a schermo e id interno.
  ///
  /// ⚠️ Si tiene per due motivi: dire a schermo QUALE consegna e nata (senza,
  /// «mandato in app» e una parola che nessuno puo verificare), e non
  /// rimandarlo due volte.
  appConsegnaId     String    @default("")
  appConsegnaNumero String    @default("")
  appMandataIl      DateTime?
  appMandataDaNome  String    @default("")

  // ── Chi se ne sta occupando ──
  //
  // Distinto da `gestioneDaId`, che dice chi ha toccato lo STATO per ultimo:
  // quello è un fatto passato, questo è un impegno che vale adesso. Stessi campi
  // e stesse regole della presa in carico delle conversazioni (nome COPIATO e
  // non collegato: se l'utente viene tolto resta scritto di chi era l'ordine
  // invece di un id orfano).
  //
  // ⚠️ Segnala, non blocca: chi ha preso l'ordine può andare a pranzo, e un
  // lucchetto vero lascerebbe il cliente senza risposta.
  // ── Pagamento e rischio frode, come li vede Shopify ──
  //
  // Arrivano da Orders (`shopify.financialStatus` e `shopify.rischio`), che li
  // legge da Shopify: qui si copiano soltanto. Servono a una cosa sola ma
  // importante — **fermare la mano prima di far partire un ordine che non è
  // stato pagato o che Shopify considera sospetto**.
  //
  // ⚠️ `rischioLivello` è la valutazione PIÙ SEVERA fra quelle che Shopify
  // conosce (NONE | LOW | MEDIUM | HIGH); `rischioRaccomandazione` è cosa dice
  // di fare (ACCEPT | INVESTIGATE | CANCEL). Vuoti = non lo sappiamo, che non
  // vuol dire «nessun rischio».
  rischioLivello         String @default("")
  rischioRaccomandazione String @default("")

  presaDaId   String    @default("")
  presaDaNome String    @default("")
  presaIl     DateTime?
  creatoIl    DateTime  @default(now())

  @@unique([negozioId, shopifyId]) // dedup per-negozio: il gid è unico solo lì
  @@index([ordersId])
  @@index([unitoA])
  @@index([data])
  // «Quanti ordini abbiamo dato a questo fornitore, e quanto gli abbiamo dato?»
  // è la domanda per cui il campo esiste: senza indice, con 1.300 ordini si
  // scansiona la tabella intera ogni volta.
  @@index([fornitoreNome])
}

// Una conversazione con una persona su un canale. idEsterno identifica la
// persona sul canale: numero WhatsApp, PSID Messenger, IGSID Instagram o il
// token segreto della sessione del widget.
model Conversazione {
  id                String    @id @default(cuid())
  canale            String // whatsapp | messenger | instagram | widget | email
  idEsterno         String
  // Solo email: la casella che ha ricevuto (da lì partono le risposte).
  casellaId         String    @default("")
  // ⚠️ SU QUALE NOSTRO NUMERO È ARRIVATO il messaggio (WhatsApp): il
  // `phone_number_id` di Meta, più il numero leggibile per mostrarlo.
  //
  // Serve perché la holding ha PIÙ WhatsApp Business (Deluxy Flowers, Cake
  // Design, Deluxy Cake Delivery…) e senza questo campo:
  //  - non si sa a quale marchio ha scritto il cliente, e la risposta parte col
  //    tono e la firma di un altro brand (le regole di CS AI sono per brand);
  //  - lo stesso cliente che scrive a due numeri finisce in UNA conversazione
  //    sola, con due discorsi diversi mescolati, perché la chiave era
  //    `[canale, idEsterno]`;
  //  - la risposta esce dal numero impostato nelle Impostazioni, che per metà
  //    dei messaggi è il numero sbagliato.
  // Vuoto = arrivato prima di questa modifica, o canale che non ha un numero
  // nostro (widget, Messenger, Instagram).
  numeroId          String    @default("")
  numeroNostro      String    @default("")
  // ── Smistamento per sito, quando lo sappiamo con certezza ──
  //
  // Il marchio di una conversazione arriva di norma dall'account che ha ricevuto
  // (numero WhatsApp, pagina Meta, casella email). Ma le notifiche d'ordine
  // arrivano TUTTE sulla stessa casella: `[cakedesign] Ordine #1742…` finiva
  // nella colonna della casella, non in quella del sito che ha venduto.
  //
  // Se nell'oggetto c'è un numero d'ordine e quel numero esiste nella nostra
  // tabella ordini, il marchio è quello dell'ordine: è una RICERCA, non una
  // deduzione dal testo. `negozioId` vince su tutto il resto.
  // Misurato il 30/07/2026: 981 ordini, **zero numeri ripetuti** fra i tre siti.
  negozioId         String?
  /**
   * Il numero dell'ordine di cui parla la conversazione, se lo sappiamo.
   */
  ordineNumero      String    @default("")
  nome              String    @default("")
  // Il nome come sta nella NOSTRA rubrica Google (deluxy.delivery@gmail.com).
  // Tenuto separato da `nome`, che è quello scelto dal cliente sul suo profilo
  // WhatsApp: sono due cose diverse e nessuna delle due va sovrascritta.
  // «FL Mario Rossi #1042» dice chi è e con che ordine; «Nicolo» no.
  nomeRubrica       String    @default("")
  // Quando abbiamo guardato in rubrica. Serve a NON richiedere ogni ora i
  // numeri che non ci sono: la People API si paga in tempo, e un numero che
  // manca oggi manca anche fra un'ora.
  rubricaCercataIl  DateTime?
  // ── Da dove arriva chi scrive dal widget del sito ──
  //
  // Chi apre la chat dopo aver cliccato un annuncio non è chi arriva dal
  // passaparola: cambia l'urgenza, cambia il tono e cambia cosa vale la pena
  // proporgli. Finora in Inbox erano tutti uguali.
  //
  // `origine`: google-ads | google | meta-ads | social | referral | diretto.
  // `origineDettaglio`: la campagna (utm_campaign) o il sito che ha mandato.
  // `paginaIngresso`: la pagina da cui ha aperto la chat, senza query — «stava
  // guardando /collections/torte-oggi» dice più di mille indovinelli.
  //
  // ⚠️ Si legge SOLO quello che c'è nel momento in cui la chat si apre: niente
  // cookie, niente storia salvata sul sito ospite. Chi clicca l'annuncio oggi e
  // scrive fra due giorni risulta «diretto», ed è giusto dirlo così invece di
  // costruirci sopra un tracciamento.
  origine           String    @default("")
  origineDettaglio  String    @default("")
  paginaIngresso    String    @default("")
  // Il riassunto della conversazione fatto dall'AI, con quello che il cliente ha
  // detto su data, ora, luogo e prodotto. Si salva per non rifarlo a ogni
  // apertura; si aggiorna a richiesta.
  riassunto         String    @default("") @db.Text
  riassuntoIl       DateTime?
  ultimoTesto       String    @default("") @db.Text
  ultimoMessaggioIl DateTime  @default(now())
  nonLetti          Int       @default(0) // messaggi in arrivo non ancora letti dall'operatore
  /**
   * «L'ho letta, ma ci devo tornare»: il gesto della posta, segnare di nuovo
   * come da leggere.
   * ⚠️⚠️ È un campo A PARTE e non un `nonLetti = 1` finto, per due motivi che
   * si sarebbero visti solo dopo:
   * · `nonLetti` è un CONTATORE che alzano i webhook. Rimetterlo a mano
   * direbbe «è arrivato un messaggio nuovo» quando non è arrivato niente, e
   * il numero sulla riga sarebbe una bugia;
   * · `src/lib/avvisi.ts` fa suonare l'app quando `nonLetti` CRESCE. Segnare
   * da leggere avrebbe fatto squillare un avviso a chi l'ha appena segnata.
   * ⚠️ Lo spegne il clic che riapre la conversazione, non la rotta dei
   * messaggi: quella la richiama il polling ogni 4 secondi, e il segno sarebbe
   * durato meno di un battito di ciglia.
   */
  daRileggere       Boolean   @default(false)
  // ── CHI SE NE STA OCCUPANDO ──
  //
  // Gli operatori sono tre e l'inbox è una sola: finora chi ha fatto cosa
  // *restava scritto* (`Messaggio.utenteNome`), ma nessuno *prendeva in carico*
  // — due persone potevano rispondere allo stesso cliente nello stesso momento,
  // e il cliente riceveva due risposte diverse dalla stessa azienda.
  //
  // ⚠️ NON È UN LUCCHETTO, ed è una scelta. Prendere in carico **non impedisce**
  // a nessun altro di rispondere: segnala. Un blocco vero, in un servizio
  // clienti, si ritorce contro il cliente — chi ha preso la conversazione va a
  // pranzo, il cliente aspetta, e chi potrebbe rispondere trova la porta
  // chiusa. Chi apre una conversazione presa da un altro vede l'avviso sopra il
  // riquadro di risposta e decide da persona.
  //
  // ⚠️ Il nome è **copiato, non collegato** (stessa scelta di
  // `Ordine.gestioneDaNome` e `Messaggio.utenteNome`): se l'account viene
  // tolto resta scritto chi se ne stava occupando, invece di un id orfano.
  // Vuoto = nessuno l'ha presa, che è diverso da «presa da qualcuno che non
  // c'è più».
  presaDaId         String    @default("")
  presaDaNome       String    @default("")
  presaIl           DateTime?
  archiviata        Boolean   @default(false)
  // CESTINO: quando è stata buttata. `null` = non è nel cestino.
  //
  // ⚠️ Eliminare non cancella più subito. Una conversazione buttata per errore
  // portava con sé tutti i suoi messaggi — il testo delle mail, gli allegati,
  // chi aveva risposto — e non c'era modo di riaverla. Ora finisce nel cestino e
  // ci resta **30 giorni**: dopo, il cron `/api/cron/cestino` la cancella
  // davvero. Trenta giorni sono la finestra in cui un cliente riscrive «ma la
  // mia mail?», che è il momento in cui serve.
  eliminataIl       DateTime?
  creatoIl          DateTime  @default(now())

  messaggi Messaggio[]

  // La chiave comprende il NOSTRO numero: due discorsi con lo stesso cliente su
  // due linee diverse sono due conversazioni, non una.
  @@unique([canale, idEsterno, numeroId])
  @@index([ultimoMessaggioIl])
  @@index([numeroId])
}

model Messaggio {
  id              String        @id @default(cuid())
  conversazioneId String
  conversazione   Conversazione @relation(fields: [conversazioneId], references: [id], onDelete: Cascade)
  direzione       String // in (dal cliente) | out (dall'operatore)
  oggetto         String        @default("") // solo email: l'oggetto del messaggio
  testo           String        @db.Text
  tipo            String        @default("testo") // testo | media | nota
  idEsterno       String        @default("") // id Meta del messaggio: dedup webhook e aggiornamenti di stato
  stato           String        @default("") // inviato | consegnato | letto | errore ("" per i messaggi in arrivo)
  errore          String        @default("") // motivo se stato = errore
  // CHI ha scritto, solo per i messaggi in USCITA. Il nome è copiato e non
  // collegato: le bolle della chat lo mostrano una per una, e un join per un
  // nome sarebbe sproporzionato — inoltre se quell'utente viene tolto resta
  // scritto chi aveva risposto al cliente invece di un id orfano.
  // Vuoto sui messaggi in arrivo (li scrive il cliente) e su quelli già in
  // archivio: parte da adesso, a posteriori non si indovina.
  utenteId        String        @default("")
  utenteNome      String        @default("")
  // ── Allegati (WhatsApp) ──
  // Il file NON si copia da nessuna parte: Meta lo tiene e ce lo dà a richiesta
  // con questo id. Salvarne una copia vorrebbe dire uno storage nostro, con le
  // foto dei clienti dentro, per mostrare una miniatura. `/api/media/[id]` fa
  // da ponte: chiede a Meta l'indirizzo e passa i byte, col token giusto.
  // ⚠️ In arrivo l'id resta valido finché Meta tiene il file (circa 30 giorni);
  // in uscita è quello che abbiamo caricato noi.
  mediaId         String        @default("")
  // ── Allegati (Instagram e Messenger) ──
  //
  // ⚠️ QUI META NON DÀ UN ID, DÀ UN INDIRIZZO. Su WhatsApp arriva `image.id` e
  // il file si richiede col token; su Instagram e Messenger arriva solo
  // `attachments[].payload.url`, un indirizzo già firmato. Sono due mondi
  // diversi e per questo servono due campi: chiedere a Meta l'id di un
  // messaggio Instagram non porta a niente.
  //
  // ⚠️⚠️ **QUESTO INDIRIZZO SCADE.** È firmato a tempo: passata la finestra, la
  // foto non si recupera più da nessuna parte, perché una copia nostra non
  // esiste. Il difetto che questo campo chiude era peggio (l'indirizzo veniva
  // buttato via subito e nella chat restava la scritta «[image]»: il 17/08/2026
  // una cliente ha mandato la foto della torta che voleva e l'operatore ha
  // dovuto chiedergliela di nuovo), ma la durata resta un limite dichiarato:
  // per tenerle davvero servirebbe uno storage nostro, e il download NON può
  // stare dentro il webhook — un webhook lento fa perdere messaggi.
  mediaUrl        String        @default("") @db.Text
  mimeType        String        @default("")
  nomeFile        String        @default("") // solo documenti: come si chiamava
  // ── Lingua e traduzione ──
  // `lingua` è il nome esteso ("inglese", "francese"…), riconosciuto IN CODICE
  // contando le parole comuni: nessuna chiamata, nessun costo, nessuna attesa.
  // Vuoto = testo troppo corto per decidere, e allora non si forza niente.
  lingua          String        @default("")
  /**
   * L'emoji con cui il cliente ha reagito a QUESTO messaggio («❤️», «👍»).
   * ⚠️ Sta sul messaggio a cui la reazione si riferisce, non su una riga sua:
   * su WhatsApp una reazione non è un messaggio, è un francobollo attaccato a
   * uno che c'è già. Tenerla come riga a parte dava «[reaction]» in mezzo al
   * filo — che non dice né quale emoji né a che cosa.
   * ⚠️ Togliere la reazione arriva come un evento con l'emoji VUOTA: allora
   * questo campo torna vuoto. Non è un caso da ignorare, è l'annullamento.
   */
  reazione        String        @default("")
  // La traduzione in italiano di un messaggio ARRIVATO in una lingua che non
  // leggiamo. Si salva perché è costata una chiamata: riaprire la
  // conversazione non deve ricomprarla.
  traduzione      String        @default("") @db.Text
  creatoIl        DateTime      @default(now())

  @@index([conversazioneId, creatoIl])
  @@index([idEsterno])
}

// L'aspetto e i testi del widget di chat, UN SITO PER VOLTA.
//
// ⚠️ Prima la configurazione era una sola per tutti: un tema, un titolo, un
// saluto nelle Impostazioni. Ma i tre siti non si somigliano — deluxy.it è nero
// e oro e dà del Lei, cakedesign.me è friendly e usa le emoji, deluxyflowers.com
// è un atelier — e un widget solo li faceva sembrare la stessa azienda, che è
// esattamente il contrario di quello che vendono.
//
// `slug` è la chiave che il sito ospite scrive nello snippet (`data-sito`):
// serve al widget per chiedere il SUO titolo e il SUO saluto, e finisce in
// `Conversazione.numeroId`, così in Inbox si vede da quale sito è arrivato il
// messaggio e la conversazione va nella colonna del marchio giusto.
model WidgetSito {
  id            String   @id @default(cuid())
  slug          String   @unique // deluxy | flowers | cake | …
  // IL CODICE DEL LINK PUBBLICO: /chat/<codice>.
  //
  // La stessa chat del widget, ma come pagina a sé — da mettere nella bio di
  // Instagram, in firma alle mail, dietro un QR sul biglietto che va col
  // mazzo. Non è lo `slug`: quello è pubblico per costruzione (sta nello
  // snippet di ogni sito) e con `/chat/cake` chiunque potrebbe indovinare gli
  // altri e aprire una conversazione a nome di un marchio. Il codice invece è
  // casuale e lungo, come fanno i servizi di chat pubblica.
  //
  // Opzionale perché i siti creati prima non ce l'hanno: si riempie al primo
  // salvataggio o dallo script di allineamento. In Postgres più NULL non
  // rompono l'unicità, più stringhe vuote sì.
  codice        String?  @unique
  nome          String   @default("") // come lo chiamiamo noi
  dominio       String   @default("") // deluxy.it, cakedesign.me…
  negozioId     String?
  // Aspetto: gli stessi valori che lo snippet mette negli attributi data-*.
  tema          String   @default("chiaro")
  accento       String   @default("") // #rrggbb, vuoto = quello del tema
  posizione     String   @default("destra")
  etichetta     String   @default("") // il testo accanto al bottone
  // Il selettore CSS di un elemento CHE C'E' GIA' sul sito (la voce «Live Chat»
  // del menu): cliccandolo si apre la nostra chat, senza toccare il tema.
  selettoreApri String   @default("")
  // Il bottone flottante si puo' togliere: se la chat si apre dal menu, due
  // punti d'ingresso sono uno di troppo.
  mostraBottone Boolean  @default(true)
  // ── Il link /chat/<codice> porta SUL SITO, con la chat già aperta ──
  //
  // Senza questo, il link è una chat a pagina intera su sfondo vuoto e la ×
  // porta via: chi arriva dalla bio di Instagram o da un QR non vede il
  // negozio, e chiudendo la chat non gli resta niente. Acceso, il link rimanda
  // al sito con `#chat` e il widget si apre da solo: la × torna a fare quello
  // che fa sui siti — **nasconde** la chat e lascia il bottone per riaprirla,
  // col negozio sotto.
  //
  // ⚠️⚠️ DEFAULT SPENTO, ED È IL PUNTO. Funziona solo se su quel dominio
  // `widget.js` c'è davvero: se non c'è, il cliente atterra sul sito senza
  // nessuna chat e il link diventa un vicolo cieco — peggio di adesso.
  // Verificato il 17/08/2026: **deluxyflowers.com sì, cakedesign.me sì,
  // deluxy.it NO**. Chi accende la spunta deve averlo controllato, e per questo
  // è una spunta e non una deduzione dal fatto che il dominio sia compilato.
  apreSulSito   Boolean  @default(false)
  // I LINK RAPIDI sotto il saluto: «Regali per oggi», «Torte nuziali»…
  //
  // Sono la risposta alla domanda del saluto («Come ti aiutiamo?»): il
  // visitatore sceglie e va dritto alla collezione giusta, senza scrivere e
  // senza aspettare che qualcuno risponda. La maggior parte di chi apre una chat
  // vuole una cosa che il sito ha gia': mandarcelo subito vale piu' di una
  // risposta scritta bene dieci minuti dopo.
  //
  // JSON: [{ "testo": "Regali per oggi", "url": "/collections/oggi" }]
  linkRapidi    String   @default("") @db.Text
  // Testi della chat: se vuoti valgono quelli generali delle Impostazioni.
  titolo        String   @default("")
  saluto        String   @default("") @db.Text
  attivo        Boolean  @default(true)
  creatoIl      DateTime @default(now())
  aggiornatoIl  DateTime @updatedAt

  negozio NegozioShopify? @relation(fields: [negozioId], references: [id], onDelete: SetNull)

  @@index([negozioId])
}

// Un promemoria dell'operatore: «richiamare il cliente domani», «sollecitare il
// fiorista sull'ordine 2529».
//
// ⚠️ Non è il registro attività dell'ecosistema. Quello è **Deluxy Tasks**
// (porta 3090), che tiene le attività di una PERSONA su tutte le app. Qui
// vivono i promemoria attaccati al lavoro di questa schermata — un ordine, una
// conversazione — che senza un posto dove stare finiscono su un foglietto.
// Quando ci sarà la chiave di Deluxy Tasks queste vanno anche spinte là: è
// scritto nell'handoff, non va dimenticato o diventano due registri.
model Attivita {
  id              String    @id @default(cuid())
  testo           String    @db.Text
  fatta           Boolean   @default(false)
  scadenza        DateTime?
  // A cosa si riferisce: si tiene l'id **e l'etichetta**, così il promemoria si
  // legge («ordine #2529») anche se quell'ordine non c'è più in tabella.
  ordineId        String    @default("")
  conversazioneId String    @default("")
  riferimento     String    @default("")
  // Chi l'ha scritta: con più operatori, «di chi è questo promemoria» è la prima
  // domanda. Copiato e non collegato, come su Messaggio.
  utenteId        String    @default("")
  utenteNome      String    @default("")
  fattaIl         DateTime?
  creatoIl        DateTime  @default(now())

  @@index([fatta, scadenza])
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER SERVICE — RECLAMI
//
// Da ogni ordine si può aprire un reclamo. Ogni reclamo ha una CASISTICA (il
// tipo di problema, con le azioni consigliate) ed è imputato a una COLPA: un
// valet (chi fa le consegne, registro locale qui sotto) o un partner (dal
// registro Anagrafiche, senza copia locale). Aggregando i reclami per colpa si
// danno i GIUDIZI a valet e partner.
// ─────────────────────────────────────────────────────────────────────────────

// Un valet: chi fa materialmente le consegne. Serve a imputare la colpa di un
// reclamo a una persona precisa e a darle un giudizio.
//
// ⚠️ DEVIAZIONE CONSAPEVOLE dalla regola "non duplicare i registri altrui".
// Il registro VERO dei valet è in deluxy-platform-next (`model Valet`, con
// IBAN, codice fiscale, veicolo, regole di stipendio: dati che qui non
// servono e non vogliamo). Non lo leggiamo perché **non esiste una API a
// chiave** per i valet: `GET /api/v1/valets` è protetta da JWT utente + ruolo
// (api/src/valets/valets.controller.ts), e l'unica alternativa oggi sarebbe
// conservare la password di un utente di servizio — peggio della copia.
// Perciò qui teniamo solo il minimo per attribuire una colpa: nome e recapito.
// DA FARE quando si potrà: aggiungere in platform-next una lettura a
// `x-api-key` sul modello di deluxy-orders (src/lib/api-auth.ts) e sostituire
// questa tabella con un `src/lib/valet.ts` che rilegge il registro, come già
// facciamo per i partner in src/lib/anagrafiche.ts.
model Valet {
  id       String   @id @default(cuid())
  nome     String
  telefono String   @default("")
  email    String   @default("")
  zona     String   @default("") // zona/quartiere di consegna, se utile
  note     String   @default("") @db.Text
  attivo   Boolean  @default(true)
  creatoIl DateTime @default(now())
}

// Una casistica di reclamo: il "tipo" di problema, con le azioni consigliate da
// eseguire e la colpa tipica. È il catalogo che l'operatore configura una volta
// e riusa aprendo i reclami.
model CasistaReclamo {
  id           String   @id @default(cuid())
  nome         String // es. "Consegna in ritardo"
  descrizione  String   @default("") @db.Text
  // A chi è di solito imputabile: valet | partner | azienda | cliente | nessuno.
  // È solo un default: sul singolo reclamo la colpa si può cambiare.
  colpaTipica  String   @default("")
  // Peso della casistica: 1 lieve, 2 media, 3 grave. Regge i giudizi.
  gravita      Int      @default(2)
  // Azioni consigliate da eseguire, una per riga.
  azioni       String   @default("") @db.Text
  attiva       Boolean  @default(true)
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt
}

// Un reclamo aperto su un ordine.
model Reclamo {
  id           String @id @default(cuid())
  // Ordine di riferimento: denormalizzato perché l'ordine può stare qui in
  // locale (ordineId valorizzato) oppure solo nell'archivio Orders.
  ordineId     String @default("")
  ordineNumero String @default("")
  negozioNome  String @default("")
  clienteNome  String @default("")
  telefono     String @default("")
  email        String @default("")

  // Casistica: il tipo di problema. `casistica` è il nome denormalizzato.
  casisticaId String @default("")
  casistica   String @default("")

  // Di chi è la colpa: valet | partner | azienda | cliente | nessuno.
  // colpaId è l'id del valet (registro locale) o del partner (Anagrafiche);
  // colpaNome è denormalizzato perché il nome del partner vive nel registro.
  colpaTipo String @default("nessuno")
  colpaId   String @default("")
  colpaNome String @default("")

  gravita     Int    @default(2) // 1 lieve, 2 media, 3 grave
  descrizione String @default("") @db.Text
  // Azioni da eseguire per questo reclamo (partono dalla casistica, poi si
  // adattano). Una per riga.
  azioni      String @default("") @db.Text
  stato       String @default("aperto") // aperto | in_lavorazione | risolto | chiuso
  esito       String @default("") @db.Text // com'è andata a finire

  risoltoIl    DateTime?
  creatoIl     DateTime  @default(now())
  aggiornatoIl DateTime  @updatedAt

  @@index([stato])
  @@index([colpaTipo, colpaId])
  @@index([creatoIl])
}

// Un giudizio dato a un valet o a un partner. Il giudizio automatico si calcola
// dai reclami (in src/lib/reclami.ts); questo è il giudizio MANUALE che
// l'operatore registra, e che completa/corregge quello automatico. Uno per
// soggetto (upsert su [soggettoTipo, soggettoId]).
model Giudizio {
  id           String   @id @default(cuid())
  soggettoTipo String // valet | partner
  soggettoId   String
  soggettoNome String   @default("")
  voto         Int      @default(3) // 1 pessimo … 5 ottimo
  nota         String   @default("") @db.Text
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@unique([soggettoTipo, soggettoId])
}

// Una RICHIESTA DI RIMBORSO su un ordine: il cliente riavrebbe indietro dei
// soldi, in tutto o in parte.
//
// ⚠️ QUESTA TABELLA NON RIMBORSA NIENTE. Registra che qualcuno lo ha chiesto e
// che qualcun altro lo ha approvato o rifiutato; il denaro lo muove una persona,
// da Shopify o dalla banca, e lo si segna qui con "eseguito". È la stessa regola
// che vale per i pagamenti in tutto il repo (vedi deluxy-transactions): nessuna
// app Deluxy paga per conto proprio. Chi in futuro volesse automatizzare l'uscita
// deve passare da lì — non aggiungere qui una chiamata che sposta soldi.
//
// Nasce quasi sempre da un reclamo (`reclamoId`), ma può stare in piedi da sola:
// un cliente può chiedere il rimborso senza aver aperto una contestazione.
model Rimborso {
  id           String @id @default(cuid())
  // L'ordine: denormalizzato come per i reclami, perché l'ordine può vivere qui
  // in locale oppure solo nell'archivio di Deluxy Orders.
  ordineId     String @default("")
  ordineNumero String @default("")
  negozioNome  String @default("")
  clienteNome  String @default("")
  telefono     String @default("")
  email        String @default("")

  // Quanto valeva l'ordine quando è stata fatta la richiesta: si congela qui
  // perché è il tetto su cui è stato deciso. Se domani l'ordine cambiasse, la
  // decisione presa resterebbe leggibile con i numeri di allora.
  importoOrdine Float  @default(0)
  importo       Float  @default(0) // quanto si chiede di rendere
  valuta        String @default("EUR")
  // totale | parziale — si ricava dagli importi, ma tenerlo scritto rende
  // leggibile l'elenco senza rifare il confronto a ogni riga.
  tipo          String @default("parziale")

  // Perché. `motivo` è il testo libero; `reclamoId` lega la richiesta alla
  // contestazione da cui nasce, se c'è.
  motivo    String @default("") @db.Text
  reclamoId String @default("")

  // richiesto | approvato | rifiutato | eseguito | annullato
  stato       String    @default("richiesto")
  richiestoDa String    @default("") // chi l'ha chiesto (nome dell'operatore)
  decisoDa    String    @default("") // chi ha approvato o rifiutato
  decisoIl    DateTime?
  // Come è finita davvero: "rimborsato su Shopify il 3/8", "bonifico del 5/8".
  esito       String    @default("") @db.Text
  eseguitoIl  DateTime?
  note        String    @default("") @db.Text

  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([stato])
  @@index([ordineId])
  @@index([creatoIl])
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER SERVICE — PUNTEGGI (pagella di valet e partner)
//
// Il punteggio NON è una formula fissa nel codice: è una somma pesata di VOCI
// che l'operatore configura (`VocePunteggio`). Ogni voce dice da dove prende il
// dato (`fonte`) e quanto pesa (`peso`). Così si possono aggiungere variabili
// nuove senza toccare il codice: i partner vivono su feedback e reclami, i valet
// su puntualità e feedback, ma nulla vieta di aggiungere "qualità dei fiori" o
// "cura del confezionamento" come voci manuali.
//
// Regola che tiene onesto il calcolo: una voce SENZA DATI per quel soggetto
// viene ESCLUSA dalla media pesata, non contata come zero. Altrimenti un partner
// di cui non misuriamo la puntualità risulterebbe scarso per un dato che non
// abbiamo mai raccolto. Vedi src/lib/punteggi.ts.
// ─────────────────────────────────────────────────────────────────────────────

// Una voce della pagella: cosa si misura, per chi, da dove e quanto pesa.
model VocePunteggio {
  id           String   @id @default(cuid())
  nome         String // es. "Feedback dei clienti", "Puntualità"
  descrizione  String   @default("") @db.Text
  // A chi si applica: valet | partner | tutti
  soggetto     String   @default("tutti")
  // Da dove arriva il dato:
  //   reclami    → dai reclami imputati al soggetto (meno reclami = più punti)
  //   feedback   → dalla media dei voti in `Feedback`
  //   puntualita → dalla quota di consegne in orario in `Puntualita`
  //   manuale    → da un valore 0-100 messo a mano in `MetricaManuale`
  fonte        String   @default("manuale")
  // Quanto pesa nella media (numero puro: contano i rapporti fra i pesi).
  peso         Int      @default(1)
  // Significato DIVERSO per fonte (documentato in src/lib/punteggi.ts):
  //   reclami    → il punteggio-reclami che azzera la voce (es. 10)
  //   puntualita → i minuti di tolleranza entro cui si è "in orario" (es. 15)
  //   feedback   → non usata
  //   manuale    → non usata
  soglia       Float    @default(10)
  attiva       Boolean  @default(true)
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([soggetto])
}

// Un feedback ricevuto su un valet o su un partner: il voto di una persona.
// Può nascere da un reclamo, da una telefonata o da un giro di chiamate.
model Feedback {
  id           String   @id @default(cuid())
  soggettoTipo String // valet | partner
  soggettoId   String
  soggettoNome String   @default("")
  voto         Int      @default(3) // 1 pessimo … 5 ottimo
  testo        String   @default("") @db.Text
  // Da chi arriva e su quale ordine, se si sa.
  clienteNome  String   @default("")
  ordineNumero String   @default("")
  // Come l'abbiamo raccolto: telefono | whatsapp | email | reclamo | altro
  origine      String   @default("altro")
  creatoIl     DateTime @default(now())

  @@index([soggettoTipo, soggettoId])
  @@index([creatoIl])
}

// Una consegna misurata sugli ORARI: quanto ha sforato rispetto a quando era
// attesa. È la base del punteggio di puntualità dei valet.
//
// `minutiRitardo` è il ritardo in minuti: 0 = puntuale, negativo = in anticipo.
// Si tiene il NUMERO, non un "in orario sì/no", perché la tolleranza è
// configurabile sulla voce di punteggio (`soglia`): cambiandola, gli stessi dati
// raccontano una storia diversa senza dover riscrivere nulla.
model Puntualita {
  id            String    @id @default(cuid())
  valetId       String
  valetNome     String    @default("")
  ordineNumero  String    @default("")
  // Quando era attesa e quando è arrivata davvero.
  attesaIl      DateTime?
  consegnataIl  DateTime?
  minutiRitardo Int       @default(0)
  note          String    @default("") @db.Text
  creatoIl      DateTime  @default(now())

  @@index([valetId])
  @@index([creatoIl])
}

// Il valore di una voce MANUALE per un soggetto: la "variabile impostabile".
// 0-100, dove 100 è il massimo. Uno per (voce, soggetto).
model MetricaManuale {
  id           String   @id @default(cuid())
  voceId       String
  soggettoTipo String // valet | partner
  soggettoId   String
  valore       Float    @default(0) // 0-100
  nota         String   @default("") @db.Text
  aggiornatoIl DateTime @updatedAt

  @@unique([voceId, soggettoTipo, soggettoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHIAVI API — lettura del Customer Service dalle altre app Deluxy
//
// Stesso schema di deluxy-orders e deluxy-anagrafiche (standard Deluxy §4.3):
// nel database c'è solo lo SHA-256 della chiave, mai il valore in chiaro.
// Si creano con `npm run chiave -- <nome-app>`.
model ApiKey {
  id        String    @id @default(cuid())
  nome      String    @unique // app client: deluxy-orders, ...
  hash      String    @unique // sha256 esadecimale della chiave
  // false = sola lettura (reclami e voti). true = può anche CREARE ordini
  // via /api/v1/nuovo-ordine (bozze Shopify con link di pagamento): si dà
  // solo alle app che mettono un operatore davanti al cliente (es. il CRM).
  scrittura Boolean   @default(false)
  attiva    Boolean   @default(true)
  creataIl  DateTime  @default(now())
  ultimoUso DateTime?
}

// ─────────────────────────────────────────────────────────────────────────────
// CS AI — le istruzioni con cui l'AI parla ai clienti
//
// Qui si scrive COME si risponde: il tono, la firma, cosa non promettere mai,
// le regole diverse fra chat e mail. Sono istruzioni, non testi da mandare —
// i testi pronti sono gli `Script`, e le due cose non vanno confuse: uno Script
// si invia, un'istruzione dice all'AI come comportarsi mentre lo adatta.
//
// ⚠️ NON tutte le regole stanno qui. I paletti di sicurezza (non inventare dati,
// non promettere rimborsi, usare solo gli script forniti) restano scritti nel
// codice in `src/lib/cs-ai.ts` e non si possono cancellare da questa pagina:
// sono ciò che impedisce all'AI di promettere a un cliente cose che l'azienda
// non ha deciso. Quello che si scrive qui si AGGIUNGE a quelli.
// ─────────────────────────────────────────────────────────────────────────────
model IstruzioneAI {
  id            String   @id @default(cuid())
  titolo        String
  categoria     String   @default("Generale") // Tono di voce, Firma, Reclami…
  testo         String   @db.Text
  // Dove vale: tutti | chat | email. Alla chat e alla mail si scrive in modo
  // diverso — una chat è breve e immediata, una mail ha oggetto e firma.
  ambito        String   @default("tutti")
  // Il BRAND per cui vale. Vuoto = tutti i brand. La holding ha più negozi
  // (Flowers, Cake Design, Gifts) e non parlano allo stesso modo: la firma dei
  // fiori non deve finire in una mail della pasticceria.
  negozioId     String?
  // Da quale documento caricato è stata ricavata. Vuoto = scritta a mano. Serve
  // a risalire: una regola di cui non si sa da dove viene non si può né
  // difendere davanti a un cliente né correggere quando la fonte cambia.
  documentoId   String?
  // Quale regola GENERALE questa regola di brand manda in pensione.
  //
  // ⚠️ Serve perché due regole che si contraddicono non si risolvono da sole nel
  // prompt. Misurato: con «firma Servizio Clienti Deluxy» (generale) e «firma Il
  // team di Cake Design» (brand) nello stesso prompt — anche scrivendo a chiare
  // lettere che vince quella del brand — il modello sceglieva la generale 4-6
  // volte su 6. L'unico modo affidabile è non mandargliele tutte e due: chi
  // scrive la regola di brand dice quale sostituisce, e quella non parte.
  sostituisceId String?
  // In che ordine finiscono nel prompt: le più importanti per prime.
  ordine        Int      @default(0)
  attiva        Boolean  @default(true)
  creatoIl      DateTime @default(now())
  aggiornatoIl  DateTime @updatedAt

  negozio   NegozioShopify? @relation(fields: [negozioId], references: [id], onDelete: SetNull)
  documento DocumentoAI?    @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  @@index([ambito])
  @@index([negozioId])
  @@index([documentoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// I DOCUMENTI da cui l'AI ricava le istruzioni: il manuale del servizio clienti,
// la brand voice, le regole di consegna. Si caricano PDF, Word o testo.
//
// ⚠️ Si salva il TESTO ESTRATTO, non il file originale, e il documento NON
// finisce nel prompt così com'è: da trenta pagine si ricavano poche regole, che
// una persona approva prima che diventino istruzioni. Allegare il manuale intero
// a ogni risposta costerebbe a ogni messaggio, annegherebbe le regole che
// contano in mezzo agli indici e ai frontespizi, e renderebbe impossibile capire
// perché l'AI ha scritto una certa frase.
// ─────────────────────────────────────────────────────────────────────────────
model DocumentoAI {
  id         String   @id @default(cuid())
  nome       String // nome del file caricato
  tipo       String   @default("") // mime dichiarato dal browser
  dimensione Int      @default(0) // byte dell'originale
  testo      String   @db.Text // il testo estratto: è questo che legge l'AI
  pagine     Int      @default(0) // solo per i PDF
  // Il brand a cui si riferisce. Vuoto = vale per tutti.
  negozioId  String?
  nota       String   @default("") @db.Text
  creatoIl   DateTime @default(now())

  negozio    NegozioShopify? @relation(fields: [negozioId], references: [id], onDelete: SetNull)
  istruzioni IstruzioneAI[]

  @@index([negozioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENTI UNITI A MANO.
//
// I clienti non sono una tabella: si ricavano dagli ordini raggruppando per
// telefono (ultime 9 cifre) e, in mancanza, per email. Funziona finché la stessa
// persona usa sempre gli stessi contatti — e spesso non è così: due numeri, la
// mail di lavoro e quella di casa, e la stessa persona diventa due righe con
// metà storia ciascuna.
//
// ⚠️ Queste unioni si fanno A MANO e non si indovinano. «Nicolò Donato» esiste
// due volte con due numeri e due email diverse: nessun dato le collega, solo il
// nome — e il nome non è una chiave, gli omonimi esistono. Unire da soli per
// nome vorrebbe dire mostrare a un cliente gli ordini di un altro.
//
// Si salva la riga ASSORBITA (`chiave`) e quella che resta (`principale`), così
// l'unione si può sempre disfare: nessun ordine viene toccato.
// ─────────────────────────────────────────────────────────────────────────────
model ClienteUnito {
  id         String   @id @default(cuid())
  // La riga assorbita: "tel:<ultime 9 cifre>" oppure "mail:<indirizzo>".
  chiave     String   @unique
  // La riga che resta, nella stessa forma.
  principale String
  // Chi ha unito: un'unione sbagliata va potuta chiedere a qualcuno.
  unitoDa    String   @default("")
  creatoIl   DateTime @default(now())

  @@index([principale])
}

// Le contestazioni di pagamento (chargeback) aperte dalle banche dei clienti.
//
// ⚠️ PERCHÉ ESISTE QUESTA TABELLA: sono soldi con una SCADENZA. Una
// contestazione «needs_response» che nessuno guarda si perde per silenzio —
// misurato il 19/08/2026: 10 perse per 2.087,66 €, e tre aperte per 373,28 €
// con le prove da mandare entro il 5 settembre. Finché il dato viveva solo
// dentro Shopify, nessuno lo apriva.
//
// ⚠️ È una COPIA di lavoro, non la verità: la verità sta in Shopify, e il
// nostro giro la riscrive ogni ora. Qui si tiene per poterle mostrare in
// bacheca, contarle e legarle agli ordini — non per deciderne lo stato.
model Chargeback {
  id              String    @id // l'id di Shopify, che è già unico
  negozioId       String    @default("")
  negozioNome     String    @default("")
  // L'ordine contestato: l'id numerico di Shopify e, quando lo troviamo fra i
  // nostri, il numero leggibile («#1741»).
  ordineIdShopify String    @default("")
  ordineNumero    String    @default("")
  tipo            String    @default("") // chargeback | inquiry
  importo         Float     @default(0)
  valuta          String    @default("EUR")
  motivo          String    @default("") // fraudulent, product_not_received…
  codiceRete      String    @default("")
  // needs_response | under_review | charge_refunded | accepted | won | lost
  stato           String    @default("")
  scadenzaProve   DateTime?
  proveInviateIl  DateTime?
  finalizzatoIl   DateTime?
  iniziatoIl      DateTime?
  // La bozza di risposta scritta da noi, prima di mandarla a Shopify: si scrive
  // in più momenti e la si rilegge, come si fa con una mail importante.
  bozzaRisposta   String    @default("") @db.Text
  aggiornatoIl    DateTime  @updatedAt
  creatoIl        DateTime  @default(now())

  @@index([stato])
  @@index([scadenzaProve])
}

// Il DIARIO di lavoro: le righe che il servizio clienti si scrive per ricordare
// cosa c'è da fare su un ordine.
//
// ⚠️ NASCE DA UN QUADERNO VERO: prima queste righe stavano in una chat interna,
// una sotto l'altra — «12562 da fare 16 luglio», «2506 pagamento su cs, per
// oggi, concordato cambio fiori con mittente». Funzionava per chi le scriveva e
// per nessun altro: chi apriva l'ordine #12562 non sapeva che esistessero.
//
// ⚠️ Il legame con l'ordine è il NUMERO, non l'id: è quello che si scrive a
// mano e quello che sopravvive quando l'ordine esce dai 60 giorni che teniamo in
// casa. Una nota può anche non averlo — «chiamare il fornitore di Bolzano» è
// lavoro lo stesso.
model NotaDiario {
  id               String    @id @default(cuid())
  /**
   * «#12562» o vuoto: la riga vale anche senza ordine.
   */
  ordineNumero     String    @default("")
  /**
   * La conversazione da cui la nota è stata scritta, se è stata scritta da lì.
   * ⚠️ Una nota presa mentre si parla col cliente — «richiamare domani», «vuole
   * il biglietto scritto a mano» — nasce SEMPRE in una chat, e spesso quella
   * chat non ha ancora un ordine. Legandola solo al numero d'ordine, quelle
   * note finivano in un elenco in cui non si capiva più di chi parlassero.
   */
  conversazioneId  String    @default("")
  /**
   * ⚠️ Il nome o il numero di chi scriveva, COPIATO qui. Il diario si legge da
   * una pagina sua, che non carica le conversazioni: senza questa copia una
   * riga direbbe soltanto «da una chat». E se la conversazione finisce nel
   * cestino, la nota deve continuare a dire di chi parlava.
   */
  conversazioneChi String    @default("")
  testo            String    @db.Text
  /**
   * Fatta o no: il diario è una lista di cose da fare, non un archivio.
   */
  fatta            Boolean   @default(false)
  fattaIl          DateTime?
  /**
   * Chi l'ha scritta e chi l'ha chiusa: con tre operatori è la prima domanda.
   */
  autoreId         String    @default("")
  autoreNome       String    @default("")
  fattaDaNome      String    @default("")
  /**
   * IL SEGUITO DI UN'ALTRA NOTA: l'id di quella che questa riga cita.
   * '' = riga a sé.
   * ⚠️⚠️ Un seguito è una NOTA, non un commento: si segna fatta, porta un
   * ordine, ha un autore. Il caso vero è «richiamare il cliente domani» →
   * «richiamato, vuole il biglietto riscritto» → «riscritto». Tre righe che
   * parlano della stessa cosa: separate diventano tre cose da fare, e chi
   * legge il diario non sa che le ultime due chiudono la prima.
   * ⚠️ Un solo livello: un seguito di un seguito si aggancia alla capofila.
   * Un albero profondo in una lista di cose da fare non si legge più.
   */
  rispostaA        String    @default("")
  creatoIl         DateTime  @default(now())
  aggiornatoIl     DateTime  @updatedAt

  @@index([ordineNumero])
  @@index([conversazioneId])
  @@index([fatta, creatoIl])
  @@index([rispostaA])
}

// Gli ordini creati DA QUI, al telefono col cliente (`/nuovo-ordine`).
//
// ⚠️⚠️ Esiste per una domanda sola, ed è quella della pagina «Operatori»:
// **quanti link di pagamento manda ciascuno**. Shopify sa che la bozza c'è, ma
// non sa chi di noi l'ha fatta: il nome dell'operatore vive solo nella nostra
// sessione, e se non lo scriviamo qui nell'istante in cui l'ordine nasce è
// perso per sempre — non c'è nessun archivio da cui ripescarlo dopo.
//
// ⚠️ NON è un secondo registro degli ordini: quello resta Deluxy Orders (vedi
// `src/lib/negozi.ts`). Qui si tiene solo la **riga di lavoro** — chi, quando,
// con che metodo, per quanto — e il numero con cui ritrovare l'ordine di là.
// Nessuna schermata legge di qui lo stato di un ordine.
//
// ⚠️ La scrittura di questa riga non deve MAI far fallire la creazione
// dell'ordine: quando ci arriviamo la bozza su Shopify esiste già, e un errore
// mostrato all'operatore lo farebbe ricominciare — col cliente che si ritrova
// due ordini. Vedi il try/catch in `src/lib/nuovo-ordine.ts`.
model OrdineCreato {
  id                  String    @id @default(cuid())
  /**
   * Chi l'ha fatto: è il motivo per cui questa tabella esiste.
   */
  utenteId            String    @default("")
  utenteNome          String    @default("")
  negozioId           String    @default("")
  negozioNome         String    @default("")
  /**
   * `link` (paga il cliente da Shopify) | `pagato` (i soldi c'erano già).
   */
  pagamento           String    @default("link")
  /**
   * Con che mezzo, quando è `pagato`: bonifico, contanti, POS.
   */
  mezzoPagamento      String    @default("")
  /**
   * gid della bozza Shopify e il suo nome (#D123).
   */
  bozzaId             String    @default("")
  bozzaNome           String    @default("")
  /**
   * Il numero dell'ordine vero, quando la bozza è stata chiusa subito.
   */
  ordineNumero        String    @default("")
  /**
   * Il totale che Shopify ha calcolato sulla bozza: quello vero, non il nostro.
   */
  importo             Float     @default(0)
  valuta              String    @default("EUR")
  clienteNome         String    @default("")
  clienteEmail        String    @default("")
  /**
   * Shopify ha spedito da solo la mail con l'invito (serve un indirizzo).
   */
  invitoInviato       Boolean   @default(false)
  /// Quando la bozza e stata ANNULLATA perche scaduta (cancellata su Shopify),
  /// e chi l ha fatto (di norma «automatico»).
  ///
  /// ⚠️⚠️ Una bozza annullata NON sparisce dalla tabella: sparisce dagli
  /// ELENCHI di lavoro. Cancellare la riga vorrebbe dire perdere chi aveva
  /// mandato quel link, a chi e per quanto — cioe la sola traccia che quel
  /// preventivo sia mai esistito.
  ///
  /// ⚠️ Si scrive SOLO dopo che Shopify ha confermato la cancellazione (o ha
  /// detto che la bozza non c e piu). Segnarla annullata senza averla
  /// cancellata lascerebbe in giro un link pagabile che qui risulta chiuso.
  annullataIl         DateTime?
  /**
   * CHI ha dichiarato che questa bozza è stata pagata, e quando.
   * ⚠️ Diverso da chi l'ha creata (`utenteNome`): il link lo manda una
   * persona, i soldi li vede arrivare un'altra, e magari giorni dopo. Davanti
   * a un ordine contestato «lo ha chiuso l'app» non è una risposta.
   * ⚠️ Vuoto = la bozza l'ha pagata il CLIENTE col link, e la chiusura l'ha
   * fatta Shopify per conto suo: sono due fatti diversi e non vanno confusi.
   */
  segnataPagataDaNome String    @default("")
  segnataPagataIl     DateTime?
  annullataDaNome     String    @default("")
  annullataMotivo     String    @default("")
  creatoIl            DateTime  @default(now())

  @@index([creatoIl])
  @@index([utenteId, creatoIl])
}

// I TURNI degli operatori: chi lavora, quando.
//
// Due tabelle e non una, perché sono due domande diverse: la settimana che si
// ripete («Federica il lunedì dalle 9 alle 13») e le volte in cui quella
// settimana non vale («il 25 agosto Federica è in ferie»). Tenerle insieme
// avrebbe voluto dire riscrivere la settimana ogni volta che qualcuno prende un
// giorno libero — e perdere qual era la regola.
//
// ⚠️⚠️ ORE E GIORNI SONO TESTO, NON DATE. `"09:00"` e `"2026-08-25"` sono un
// orario da parete e un giorno di calendario, non istanti: un turno comincia
// alle nove **in Italia**, non «alle 07:00 UTC». Salvarli come `DateTime`
// vorrebbe dire che a ottobre, finita l'ora legale, tutti i turni si spostano
// di un'ora da soli. Vedi la stessa scelta nei periodi della pagina Operatori.
model TurnoSettimanale {
  id         String   @id @default(cuid())
  utenteId   String
  /**
   * Copiato qui per leggere la griglia senza join; il nome buono resta quello di `Utente`.
   */
  utenteNome String   @default("")
  /**
   * 1 = lunedì … 7 = domenica (come le settimane ISO, e come le legge la gente).
   */
  giorno     Int
  /**
   * «09:00». Da «00:00» a «23:59»: il campo orario del browser non conosce le 24:00.
   */
  dalle      String
  alle       String
  creatoIl   DateTime @default(now())

  // ⚠️ Una persona può avere due fasce nello stesso giorno (mattina e
  // pomeriggio): l'unicità è sulla fascia, non sul giorno. Impedisce solo di
  // scrivere due volte lo stesso identico turno.
  @@unique([utenteId, giorno, dalle, alle])
  @@index([giorno])
}

// Il giorno in cui la settimana non vale: un riposo, delle ferie, o un orario
// diverso dal solito.
//
// ⚠️ `giorno` è una stringa «AAAA-MM-GG»: è un giorno di calendario. Con un
// `DateTime` il 25 agosto salvato a mezzanotte italiana torna indietro come
// «24 agosto 22:00 UTC», e la riga comparirebbe sul giorno sbagliato.
model EccezioneTurno {
  id           String   @id @default(cuid())
  utenteId     String
  utenteNome   String   @default("")
  /**
   * «2026-08-25».
   */
  giorno       String
  /**
   * `riposo` (quel giorno non lavora) | `orario` (lavora, ma in un'altra fascia).
   */
  tipo         String   @default("riposo")
  dalle        String   @default("")
  alle         String   @default("")
  /**
   * «ferie», «visita medica»: si legge nella griglia, ed è quasi sempre la domanda dopo.
   */
  motivo       String   @default("")
  creatoDaNome String   @default("")
  creatoIl     DateTime @default(now())

  @@unique([utenteId, giorno, dalle, alle])
  @@index([giorno])
}

// IL GLOSSARIO: quello che si sa e che oggi sta nella testa di chi c'era.
//
// ⚠️⚠️ NON è un doppione delle altre tre cose che l'app già tiene, e la
// distinzione va difesa o in sei mesi ci sono quattro posti dove cercare:
//   · `Script`       = un TESTO che si manda al cliente (il *cosa si dice*);
//   · `IstruzioneAI` = come l'AI si comporta mentre lo adatta (il *come*);
//   · `DocumentoAI`  = un file caricato, da cui l'AI impara;
//   · **`VoceGlossario` = un FATTO**, vero oggi, che serve a chi risponde —
//     «a Milano si consegna anche la domenica», «il codice sul cartoncino di
//     Cake è il numero d'ordine». Non è un testo da mandare: è quello che devi
//     sapere per scrivere il testo giusto.
//
// ⚠️ Quello che l'app SA GIÀ non si scrive qui: domini, numeri WhatsApp,
// caselle, siti e quota fornitore si leggono dalla configurazione ogni volta
// che si apre la pagina. Copiarli in una voce vorrebbe dire che il giorno che
// cambiano il glossario mente — ed è il modo più veloce per far smettere la
// gente di fidarsene.
model VoceGlossario {
  id              String   @id @default(cuid())
  /**
   * «Consegna in giornata», «Cartoncino Cake»: come lo cercherebbe una persona.
   */
  termine         String
  definizione     String   @db.Text
  /**
   * `cliente` = si può dire a un cliente · `tecnico` = come funziona di dentro.
   * ⚠️ Serve a non leggere a un cliente una nota interna: sono due pubblici.
   */
  categoria       String   @default("cliente")
  /**
   * ⚠️⚠️ SUPERATA da `negoziIds`. Non si legge e non si scrive più: resta come
   * fotografia di com'era prima del passaggio ai marchi multipli (24/08/2026),
   * finché il nuovo campo non è stato guardato in produzione per qualche
   * giorno. **Poi va tolta**, perché una colonna che ha ancora dei valori e che
   * nessuno aggiorna è una bugia che aspetta il primo che la legge.
   */
  negozioId       String   @default("")
  /**
   * I marchi a cui la voce vale. **Lista vuota = vale per tutti.**
   * ⚠️⚠️ Prima era UNO solo, e non bastava: una regola può valere per Cake e
   * FLowers ma non per Deluxy, e con un campo singolo l'unico modo era
   * scriverla due volte. Due copie della stessa frase divergono al primo che ne
   * corregge una — e nessuno si accorge che l'altra è rimasta indietro.
   * ⚠️ Il vincolo di unicità su (termine, negozioId) è caduto con questo
   * passaggio: due voci con lo stesso termine e marchi DIVERSI sono legittime.
   * Il doppione si impedisce nel codice, controllando la SOVRAPPOSIZIONE dei
   * marchi — che è più preciso di quel vincolo, e sa dire perché.
   */
  negoziIds       String[] @default([])
  /**
   * `persona` (scritta a mano) | `ai` (nata da una proposta accettata).
   */
  fonte           String   @default("persona")
  /**
   * La conversazione da cui è uscita, quando viene da una proposta.
   */
  conversazioneId String   @default("")
  autoreNome      String   @default("")
  creatoIl        DateTime @default(now())
  aggiornatoIl    DateTime @updatedAt

  @@index([categoria])
  @@index([termine])
}

// Quello che l'AI PROPONE dopo aver letto le chat del giorno.
//
// ⚠️⚠️ **Proposte, non modifiche.** Il glossario è quello su cui un operatore si
// basa per parlare a un cliente: un'AI che ci scrive dentro da sola metterebbe
// in bocca alle persone un fatto che nessuno ha verificato, e lo scoprirebbe il
// cliente. Qui vale la regola di tutta l'app: l'AI propone, decide una persona.
//
// ⚠️ Ogni proposta porta la **conversazione da cui nasce**: senza la prova non
// è una proposta, è un'opinione — e non si può controllare in dieci secondi.
model PropostaGlossario {
  id                   String    @id @default(cuid())
  /**
   * `aggiunta` (manca) · `correzione` (c'è ma è sbagliata) · `avviso` (da sapere).
   */
  tipo                 String    @default("aggiunta")
  /**
   * La voce da correggere, per le correzioni.
   */
  voceId               String    @default("")
  termine              String
  definizione          String    @db.Text
  categoria            String    @default("cliente")
  /**
   * Vuota = vale per tutti i marchi (come in `VoceGlossario`).
   */
  negozioId            String    @default("")
  /**
   * Che cosa ha visto: è la prova, e si legge prima di accettare.
   */
  perche               String    @default("") @db.Text
  conversazioneId      String    @default("")
  /**
   * La domanda all'amministratore da cui nasce, quando viene da lì.
   * ⚠️ Una proposta deve avere UNA delle due prove — una conversazione o una
   * domanda — o non è una proposta, è un'opinione. Le domande che si ripetono
   * sono esattamente le voci che al glossario mancano.
   */
  domandaId            String    @default("")
  /**
   * `aperta` | `accettata` | `scartata`.
   */
  stato                String    @default("aperta")
  decisaDaNome         String    @default("")
  decisaIl             DateTime?
  /**
   * ⚠️⚠️ ACCETTATA DOPO AVERLA CORRETTA A MANO.
   * Serve a una domanda sola, ma è la domanda importante: **quanto spesso l'AI
   * ci prende?** Senza questo campo l'archivio direbbe «proposta dall'AI e
   * accettata» anche quando il testo è stato riscritto da capo — cioè
   * racconterebbe un'AI più precisa di quella che è, e nessuno saprebbe che il
   * prompt va cambiato.
   * ⚠️ `termine` e `definizione` restano **la proposta originale**: quello che
   * si è deciso di scrivere davvero sta qui accanto. Sovrascriverli avrebbe
   * cancellato la prova di che cosa aveva detto l'AI.
   */
  corretta             Boolean   @default(false)
  termineAccettato     String    @default("")
  definizioneAccettata String    @default("") @db.Text
  /**
   * I marchi decisi accettando, quando diversi da quello proposto.
   * ⚠️⚠️ Serve perché il brand cambia il SENSO della voce, non la sua forma:
   * «la consegna è gratuita» è vera per un negozio e falsa per un altro, e
   * accettarla per tutti quando vale per uno solo mette in bocca agli operatori
   * una promessa sbagliata. Se chi accetta la restringe a un marchio, quel
   * cambiamento è importante quanto una riscrittura del testo — quindi si
   * archivia come gli altri due, invece di sovrascrivere in silenzio quello che
   * aveva proposto l'AI.
   * ⚠️ Vuota ha DUE significati e vanno distinti guardando `corretta`: se
   * `corretta` è falso non è stato cambiato niente; se è vero, vuota vuol dire
   * «l'ho reso valido per tutti i marchi».
   */
  negoziAccettati      String[]  @default([])
  creatoIl             DateTime  @default(now())

  @@index([stato, creatoIl])
}

// UNA DOMANDA ALL'AMMINISTRATORE, fatta dal punto in cui ci si è bloccati.
//
// ⚠️⚠️ **Il contesto è metà della domanda.** «Che faccio?» non si può rispondere;
// «che faccio con l'ordine #2783» sì. Per questo la pagina da cui è partita e il
// numero d'ordine si registrano **da soli**: chiederli a chi scrive vuol dire
// che una domanda su tre arriva senza, e chi risponde deve rincorrere.
//
// ⚠️ Restano scritte anche dopo la risposta, ed è il motivo per cui la tabella
// esiste: rilette tutte insieme dicono **che cosa non è chiaro** — cioè cosa
// manca nel glossario, negli script o nelle istruzioni dell'AI. Una domanda
// risposta e buttata è una lezione persa.
model DomandaAiuto {
  id    String @id @default(cuid())
  testo String @db.Text

  /**
   * Dove si trovava chi ha chiesto: `/ordini`, `/inbox`… Registrata da sola.
   */
  pagina          String  @default("")
  /**
   * L'ordine di cui si parla, se ce n'è uno. Preso dall'indirizzo quando c'è.
   */
  ordineNumero    String  @default("")
  /**
   * La conversazione da cui è partita, quando parte dall'inbox.
   */
  conversazioneId String  @default("")
  /**
   * QUESTA DOMANDA NASCE PER UN CLIENTE CHE ASPETTA.
   * ⚠️⚠️ Vera solo quando la apre l'AI fuori turno: quello che l'amministratore
   * risponde su WhatsApp viene GIRATO AL CLIENTE. Se un operatore chiede aiuto
   * per conto suo la risposta resta interna, e mandarla a un cliente sarebbe
   * spedire una nota di lavoro a chi ha comprato dei fiori.
   * ⚠️ È un campo suo e non si deduce da `utenteNome === "AI fuori turno"`:
   * un'etichetta da mostrare a schermo non è un permesso, e il giorno che
   * qualcuno la cambia per farla più bella l'automatismo cambierebbe
   * comportamento senza che nessuno colleghi le due cose.
   */
  perIlCliente    Boolean @default(false)

  utenteId   String @default("")
  utenteNome String @default("")

  /**
   * `aperta` | `risposta`.
   */
  stato          String    @default("aperta")
  risposta       String    @default("") @db.Text
  rispostaDaNome String    @default("")
  rispostaIl     DateTime?
  /**
   * L'avviso mandato su WhatsApp all'amministratore.
   * ⚠️⚠️ `avvisoEsito` va MOSTRATO a chi ha chiesto. Se la notifica non parte
   * — e fuori dalla finestra di 24h di WhatsApp non parte — chi ha scritto
   * crederebbe di aver avvisato qualcuno che invece non sa niente: e' peggio
   * che non avere la notifica del tutto.
   */
  avvisoWaId     String    @default("")
  avvisoEsito    String    @default("") @db.Text
  /**
   * Il codice corto («A7K2C») che va nell'avviso.
   * ⚠️ Serve a rispondere da WhatsApp senza dover citare il messaggio: chi
   * risponde dal telefono, in piedi, non usa «rispondi a questo messaggio».
   */
  codice         String    @default("")
  /**
   * Quando chi ha chiesto ha LETTO la risposta.
   * ⚠️ Serve al pallino sulla linguetta: senza, una risposta arrivata mentre
   * l'operatore era su un'altra pagina non lo raggiunge mai — e lui continua a
   * essere bloccato mentre l'amministratore lo dà per risolto.
   */
  lettaIl        DateTime?

  creatoIl DateTime @default(now())

  messaggi MessaggioAiuto[]

  @@index([stato, creatoIl])
  @@index([utenteId, creatoIl])
}

// I messaggi di una richiesta d'aiuto: è uno scambio, non una domanda sola.
//
// ⚠️⚠️ La prima versione era **una domanda e una risposta**, e si è rotta al
// primo uso vero: l'amministratore ha risposto «cosa hai bisogno?» e chi aveva
// chiesto non poteva continuare. Una richiesta d'aiuto **è una conversazione**:
// quasi mai la prima risposta è quella definitiva.
//
// ⚠️ `viaWhatsApp` dice da dove è entrato il messaggio. Chi legge ha diritto di
// sapere che una riga è stata scritta dal telefono, in piedi, e non guardando
// la schermata: cambia quanto ci si può appoggiare sopra.
model MessaggioAiuto {
  id        String       @id @default(cuid())
  domandaId String
  domanda   DomandaAiuto @relation(fields: [domandaId], references: [id], onDelete: Cascade)

  /**
   * `operatore` (chi ha chiesto o un collega) | `admin`.
   */
  autore      String  @default("operatore")
  autoreNome  String  @default("")
  testo       String  @db.Text
  viaWhatsApp Boolean @default(false)

  /**
   * L'avviso mandato su WhatsApp per QUESTO messaggio, e com'è andata.
   */
  avvisoWaId  String @default("")
  avvisoEsito String @default("") @db.Text

  creatoIl DateTime @default(now())

  @@index([domandaId, creatoIl])
}

/// A CHI ABBIAMO CHIESTO SE PUÒ FARE QUEST'ORDINE.
///
/// ⚠️⚠️ Non esisteva, e si vedeva: il bottone WhatsApp apriva la chat col
/// messaggio già scritto e poi **non restava traccia di niente**. Da cui, ogni
/// volta: non si sapeva a chi si era già chiesto, un collega richiedeva allo
/// stesso fornitore, e quando uno rispondeva sì bisognava andare a registrarlo
/// a mano in un'altra parte della scheda. Su un ordine urgente, con tre persone
/// che lo guardano, è il modo in cui si telefona due volte allo stesso fioraio e
/// a nessun altro.
///
/// ⚠️ Una riga qui vuol dire «gliel'ho CHIESTO», non «lo prepara lui»: chi lo
/// prepara sta sull'ordine (`Ordine.fornitoreNome`) e ci arriva solo quando
/// qualcuno risponde sì. Confondere le due cose vorrebbe dire dare per fatto un
/// ordine che nessuno ha ancora accettato.
model RichiestaFornitore {
  id            String    @id @default(cuid())
  /// Il nostro ordine (`Ordine.id`).
  ordineId      String
  ordineNumero  String    @default("")
  fornitoreNome String
  /// L'id nel registro Anagrafiche, quando il fornitore viene da lì.
  fornitoreId   String    @default("")
  telefono      String    @default("")
  email         String    @default("")
  /// whatsapp · email · telefono (chiamato a voce).
  canale        String    @default("whatsapp")
  /// Il testo com'era quando è partito.
  ///
  /// ⚠️ Si archivia INTERO e non si ricalcola: la data di consegna o
  /// l'indirizzo possono cambiare dopo, e allora «cosa gli abbiamo chiesto»
  /// diventerebbe una domanda senza risposta — proprio quando serve, cioè
  /// davanti a un fornitore che dice «a me avevate detto un'altra cosa».
  testo         String    @default("") @db.Text
  chiestoIl     DateTime  @default(now())
  chiestoDaId   String    @default("")
  chiestoDaNome String    @default("")
  /// in_attesa · si · no
  esito         String    @default("in_attesa")
  rispostaIl    DateTime?
  nota          String    @default("") @db.Text

  @@index([ordineId, chiestoIl])
  @@index([fornitoreNome])
}

/// IL FILO DI DOMANDE E RISPOSTE DI UN RECLAMO.
///
/// ⚠️⚠️ Un reclamo non si risolve con un campo «descrizione» e uno «esito»: in
/// mezzo c'è una conversazione — «il valet dice che ha citofonato, il cliente
/// dice di no», «chiedo al fioraio se ha la prova di consegna», «risposto: ce
/// l'ha, foto allegata». Finora quella conversazione stava nelle chat fra
/// colleghi o in testa a chi ci aveva lavorato: chi riapriva il reclamo tre
/// giorni dopo ricominciava da zero, e chi decideva un rimborso lo decideva
/// senza sapere cosa era già stato chiesto.
///
/// ⚠️ Le DOMANDE si segnano come tali (`domanda`), e una domanda senza risposta
/// resta visibile come tale: è la parte che aspetta qualcuno. Un filo di note
/// tutte uguali nasconderebbe proprio quella.
model MessaggioReclamo {
  id         String   @id @default(cuid())
  reclamoId  String
  /// Chi ha scritto. ⚠️ Il NOME si copia qui: il filo si legge senza caricare
  /// gli utenti, e chi scrive oggi può non essere più in squadra fra sei mesi —
  /// la riga deve continuare a dire di chi era.
  autoreId   String   @default("")
  autoreNome String   @default("")
  testo      String   @db.Text
  /// true = è una domanda, e resta aperta finché non arriva una risposta.
  domanda    Boolean  @default(false)
  /// L'id della domanda a cui questo messaggio risponde ('' = non risponde a
  /// niente, è una riga del filo).
  rispostaA  String   @default("")
  creatoIl   DateTime @default(now())

  @@index([reclamoId, creatoIl])
  @@index([rispostaA])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHIAMATE
//
// Il centralino manda una notifica a `chiamate@deluxy.it` per ogni telefonata
// ricevuta. Prima quelle mail non le leggeva nessuno: chi chiamava e non
// trovava risposta spariva, e il giorno dopo nessuno sapeva che avesse provato.
//
// ⚠️⚠️ UNA CHIAMATA NON È UNA CONVERSAZIONE. Non c'è un testo da leggere né una
// risposta da scrivere: c'è una persona che voleva parlare e non ha parlato.
// Perciò non entra in inbox (dove finirebbe in mezzo alle mail vere, con un
// corpo che nessuno legge) ma in una sezione sua, dove l'unica domanda è
// **richiamato o no**.
//
// ⚠️ Il TESTO della notifica si conserva per intero. Il riconoscimento del
// numero è un'interpretazione — e quando sbaglia, l'unica difesa di chi guarda
// è poter leggere quello che è arrivato davvero.
// ─────────────────────────────────────────────────────────────────────────────
model Chiamata {
  id        String   @id @default(cuid())
  /// Il Message-ID della mail di notifica: due giri dello scarico non devono
  /// creare due chiamate. Vuoto = notifica senza id (allora vale l'ora).
  idEsterno String   @default("")
  casellaId String   @default("")
  /// Quando è arrivata la chiamata = la data della notifica. ⚠️ Non `creatoIl`:
  /// una notifica scaricata stasera per una chiamata di stamattina deve
  /// risultare di stamattina, o l'elenco racconta l'ora sbagliata.
  quando    DateTime

  /// Il numero di chi ha chiamato, come sta scritto nella notifica.
  numero         String @default("")
  /// Le ultime 9 cifre: è la chiave con cui si riconosce una persona in tutta
  /// l'app (vedi `cifreTelefono` in scheda-cliente.ts). Un numero salvato con o
  /// senza prefisso è lo stesso numero.
  cifre          String @default("")
  /// Il NOSTRO numero che ha squillato, se la notifica lo dice: è l'unico modo
  /// di attribuire a un marchio la chiamata di uno sconosciuto.
  numeroChiamato String @default("")
  chiamante      String @default("")
  oggetto        String @default("")
  testo          String @default("") @db.Text

  /// Il marchio. Da un ordine riconosciuto, oppure dal numero chiamato
  /// (`NegozioShopify.telefonoChiamate`). ⚠️ `null` resta una risposta
  /// legittima: scrivere un marchio a caso su una chiamata è peggio che
  /// lasciarla «senza marchio», perché poi qualcuno la conta.
  negozioId String?

  /// Che cosa abbiamo capito di chi ha chiamato:
  ///   `ordine`      = c'è un ordine suo, ed è quello che sta qui sotto;
  ///   `cliente`     = lo conosciamo (ha comprato in passato), ma nessun ordine
  ///                   recente a cui attaccare la chiamata;
  ///   `sconosciuto` = non risulta nostro cliente: va richiamato lo stesso, ma
  ///                   chi lo fa deve saperlo prima di rispondere «buongiorno,
  ///                   per il suo ordine».
  esito        String @default("sconosciuto")
  ordineId     String @default("")
  ordineNumero String @default("")
  clienteNome  String @default("")
  email        String @default("")

  /// Il promemoria aperto per richiamare (`Attivita`). Si tiene l'id per poter
  /// spuntare l'uno quando si chiude l'altra: due liste che dicono cose diverse
  /// sulla stessa telefonata sono peggio di una lista sola.
  attivitaId String @default("")

  richiamataIl     DateTime?
  richiamataDaNome String    @default("")
  esitoRichiamata  String    @default("") @db.Text

  creatoIl DateTime @default(now())

  @@index([quando])
  @@index([cifre])
  @@index([ordineId])
  @@index([richiamataIl])
  @@index([negozioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PREVENTIVI
//
// Un preventivo è una richiesta di prezzo che NON è ancora un ordine: «quanto
// costa un bouquet di 100 rose consegnato a Como sabato?». Finché non c'è un
// posto dove scriverla, quella domanda vive in una conversazione — e una
// conversazione si archivia. Chi ha chiesto un prezzo e non ha avuto risposta
// non lascia traccia da nessuna parte: non è un ordine perso, è un ordine che
// non è mai stato contato.
//
// ⚠️⚠️ NON È UN REGISTRO ORDINI. L'ordine, quando nasce, nasce su Shopify e vive
// in Deluxy Orders (regola in testa a `src/lib/negozi.ts`). Qui c'è la
// RICHIESTA e la nostra risposta: quanto abbiamo detto, con che link, ed è
// finita sì o no. Quando il cliente paga, l'ordine arriva dal giro normale e
// questo preventivo si chiude — non diventa lui l'ordine.
//
// ⚠️ Il preventivo MANDATO è una bozza Shopify col link di pagamento: la stessa
// strada del «Nuovo ordine» (`nuovo-ordine.ts`, `pagamento: 'link'`), perché una
// bozza non è un incasso finché non la pagano. Qui si tiene il nome della bozza
// e il link, che è quello che si rimanda al cliente se lo perde.
//
// ⚠️ Da non confondere con le «richieste di preventivo dei PARTNER» della
// piattaforma consegne (`QuoteRequest` in deluxy-platform-next): quelle sono
// aziende che chiedono un prezzo a noi dal loro accesso. Queste sono i clienti.
// ─────────────────────────────────────────────────────────────────────────────
model Preventivo {
  id String @id @default(cuid())

  /// Il marchio: è la colonna in cui il preventivo si legge, come in bacheca.
  /// ⚠️ `null` = non si sa ancora — e resta una risposta legittima: chi scrive
  /// «quanto costa una torta per 30 persone» a una casella che serve tutti i
  /// marchi non ha ancora detto a quale brand sta parlando.
  negozioId String?

  clienteNome String @default("")
  email       String @default("")
  telefono    String @default("")
  /// Le ultime 9 cifre del telefono: la stessa chiave con cui si riconosce una
  /// persona in tutta l'app (chiamate, rubrica, scheda cliente).
  cifre       String @default("")

  /// Che cosa ha chiesto, **con parole sue**. ⚠️ Non un riassunto: chi prepara
  /// il prezzo tre ore dopo deve poter leggere la domanda vera, non la sua
  /// interpretazione di chi l'ha raccolta.
  richiesta      String    @db.Text
  occasione      String    @default("")
  citta          String    @default("")
  dataConsegna   DateTime?
  fasciaConsegna String    @default("")

  /// Da dove è arrivata la richiesta, e — quando si sa — la riga da cui nasce:
  /// email | whatsapp | telefono | sito | manuale.
  /// ⚠️ Il legame si tiene perché la prima domanda di chi riprende in mano un
  /// preventivo è «cosa ci siamo detti»: senza, si ricomincia da capo col
  /// cliente che ha già spiegato tutto.
  origine         String @default("manuale")
  conversazioneId String @default("")
  chiamataId      String @default("")

  /// `da_fare` (chiesto, nessuno ha ancora risposto) → `inviato` (prezzo dato)
  /// → `accettato` | `rifiutato` | `scaduto`.
  /// ⚠️ «scaduto» è uno stato e non un silenzio: un preventivo che nessuno
  /// chiude resta aperto per sempre e sporca il conto di quanti ne stiamo
  /// aspettando davvero.
  stato String @default("da_fare")

  /// Quanto abbiamo detto. 0 = non ancora quotato.
  importo Float  @default(0)
  valuta  String @default("EUR")

  /// La bozza su Shopify e il suo link di pagamento: è il preventivo mandato.
  bozzaNome     String @default("")
  linkPagamento String @default("") @db.Text
  /// Il numero dell'ordine vero, se il cliente ha pagato.
  ordineNumero  String @default("")

  /// Fino a quando vale il prezzo. ⚠️ Un prezzo senza scadenza si trasforma in
  /// un impegno eterno: il cliente ripesca il link di marzo a novembre.
  validoFinoAl DateTime?

  seguitoDaId   String @default("")
  seguitoDaNome String @default("")
  note          String @default("") @db.Text

  creatoIl     DateTime  @default(now())
  inviatoIl    DateTime?
  chiusoIl     DateTime?
  chiusoDaNome String    @default("")

  @@index([stato, creatoIl])
  @@index([negozioId, stato])
  @@index([cifre])
  @@index([conversazioneId])
}

// ─────────────────────────────────────────────────────────────────────────────
// RICHIESTA DI FATTURA su un ordine
//
// Il caso vero: il cliente chiede la fattura — al telefono, in chat, dopo aver
// comprato. Finora quella richiesta viveva in una conversazione e i dati
// fiscali si copiavano in un messaggio: chi emette la fattura doveva andarseli
// a cercare, e metà delle volte mancava il codice destinatario.
//
// ⚠️⚠️ QUI NON SI EMETTE NIENTE. La fattura elettronica esce da FINANCE /
// Fatture in Cloud, prende un numero nella numerazione dell'anno e parte verso
// lo SDI: non si annulla con un clic, si annulla con una nota di credito.
// Questa tabella tiene la RICHIESTA e i DATI FISCALI del cliente — che oggi non
// stanno da nessuna parte — e lo stato: chiesta, emessa, o non dovuta.
//
// ⚠️ I dati fiscali NON si deducono dall'ordine: l'indirizzo di spedizione è
// del destinatario (è un regalo), e la ragione sociale non è il nome di chi
// compra. Si chiedono, e finché non ci sono la riga resta incompleta e lo dice.
// ─────────────────────────────────────────────────────────────────────────────
model RichiestaFattura {
  id           String @id @default(cuid())
  /// L'ordine di cui si chiede la fattura. Uno solo: due fatture per lo stesso
  /// ordine sono un problema fiscale, non una comodità.
  ordineId     String @unique
  ordineNumero String @default("")
  negozioId    String @default("")

  /// `privato` (serve il codice fiscale) | `azienda` (serve P.IVA + SDI o PEC).
  /// ⚠️ Non è un dettaglio anagrafico: cambia quali campi sono obbligatori
  /// perché lo SDI scarta una fattura elettronica senza il recapito giusto.
  tipo String @default("privato")

  /// Intestazione: ragione sociale per l'azienda, nome e cognome per il privato.
  intestazione  String @default("")
  partitaIva    String @default("")
  codiceFiscale String @default("")
  /// Il codice destinatario a 7 caratteri, oppure la PEC: ne basta uno, ma uno
  /// dei due deve esserci per un'azienda.
  codiceSdi     String @default("")
  pec           String @default("")
  email         String @default("")

  /// L'indirizzo DI FATTURAZIONE. ⚠️ Non quello di consegna: la fattura va a chi
  /// paga, la consegna a chi riceve, e da noi sono quasi sempre due persone.
  indirizzo String @default("")
  cap       String @default("")
  citta     String @default("")
  provincia String @default("")
  paese     String @default("IT")

  note String @default("") @db.Text

  /// `chiesta` → `emessa` | `non_dovuta`.
  /// ⚠️ «non dovuta» è uno stato e non una cancellazione: se il cliente cambia
  /// idea o la fattura c'era già, la richiesta resta scritta — altrimenti fra un
  /// mese nessuno sa perché quell'ordine non ne ha una.
  stato String @default("chiesta")

  numeroFattura String    @default("")
  emessaIl      DateTime?
  emessaDaNome  String    @default("")

  /// Quando la richiesta e stata MANDATA ad amministrazione, a chi, e com e
  /// andata.
  ///
  /// ⚠️⚠️ Si scrive l ESITO dell invio, non solo la data: una mail che non e
  /// partita e una richiesta che nessuno ha ricevuto, e senza questa riga
  /// sembrerebbe mandata. La mail parte solo quando i dati sono COMPLETI —
  /// mandarne una a meta obbligherebbe amministrazione a rincorrere il codice
  /// destinatario, che e esattamente il lavoro che questa cosa toglie.
  inviataIl     DateTime?
  inviataA      String    @default("")
  inviataEsito  String    @default("")
  chiestaDaNome String    @default("")
  creatoIl      DateTime  @default(now())
  aggiornatoIl  DateTime  @updatedAt

  @@index([stato, creatoIl])
  @@index([negozioId, stato])
}
