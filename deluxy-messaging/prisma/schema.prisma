// Deluxy Messaggi — schema dati
//
// Un'inbox unificata: le conversazioni arrivano da canali diversi (WhatsApp,
// Messenger, Instagram via webhook Meta, più il widget di chat dei siti) ma
// vivono tutte nelle stesse due tabelle: Conversazione e Messaggio.
//
// I token Meta sono salvati in Impostazione SEMPRE cifrati (AES-256-GCM,
// src/lib/crypto.ts). Le password degli utenti sono hashate (scrypt), mai
// reversibili.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) in produzione
  directUrl = env("DIRECT_URL") // connessione diretta per prisma db push
}

// Chi accede all'app. Il primo utente si crea dalla pagina di login
// (bootstrap); gli altri li può creare un admin in seguito.
model Utente {
  id           String   @id @default(cuid())
  email        String   @unique
  nome         String
  passwordHash String // scrypt "salt.hash" — mai reversibile
  ruolo        String   @default("admin") // admin | operatore
  creatoIl     DateTime @default(now())
}

// Coppie chiave/valore di configurazione (token Meta cifrati, verify token,
// titolo del widget…). Vedi src/lib/impostazioni.ts per le chiavi usate.
model Impostazione {
  chiave String @id
  valore String @db.Text
}

// Uno store Shopify collegato. La holding ha più negozi: da ognuno scarichiamo
// gli ordini. Le credenziali (token statico o Client Secret) sono cifrate.
// Due modi di autenticarsi, come in src/lib/shopify.ts:
//  - token: Admin API access token statico (shpat_…) di un'app legacy
//  - clientId + clientSecret: app Dev Dashboard (client credentials grant)
model NegozioShopify {
  id           String   @id @default(cuid())
  nome         String // etichetta leggibile, es. "Deluxy Flowers"
  // Sigla usata davanti al nome in rubrica: DL (Deluxy), FL (Flowers), CK (Cake).
  // Vuota = dedotta dal nome/dominio (vedi prefissoDaNegozio in src/lib/negozi.ts).
  prefisso     String   @default("")
  // Il nome del brand come lo conosce l'app Ricerca fornitori (es. deluxyflowers.com):
  // serve al bottone "Fornitore" sotto ogni ordine. Vuoto = dedotto dal nome.
  brandRicerca String   @default("")
  dominio      String   @unique // es. fb72b1-2.myshopify.com
  token        String   @default("") @db.Text // shpat_… cifrato (se app legacy)
  clientId     String   @default("")
  clientSecret String   @default("") @db.Text // cifrato (se app Dev Dashboard)
  attivo       Boolean  @default(true)
  creatoIl     DateTime @default(now())

  ordini Ordine[]
}

// Ordini scaricati da Shopify. Ne teniamo una copia locale per mostrarli senza
// richiamare Shopify ogni volta e per ricordare se il contatto del cliente è
// già stato salvato su Google Contacts (contattoSalvato/contattoEsito).
model Ordine {
  id             String   @id @default(cuid())
  negozioId      String
  negozio        NegozioShopify @relation(fields: [negozioId], references: [id], onDelete: Cascade)
  negozioNome    String   @default("") // denormalizzato per la lista
  shopifyId      String // gid Shopify dell'ordine (unico per negozio, non globale)
  numero         String   @default("") // es. #1042
  data           DateTime @default(now())
  totale         Float    @default(0)
  valuta         String   @default("EUR")
  statoPagamento String   @default("")
  clienteNome    String   @default("")
  telefono       String   @default("")
  email          String   @default("")
  indirizzo      String   @default("") @db.Text
  citta          String   @default("") // mostrata sulle card della vista a colonne
  note           String   @default("") @db.Text
  contattoSalvato Boolean @default(false) // salvato su Google Contacts
  contattoEsito  String   @default("") // esito/errore dell'ultimo salvataggio
  creatoIl       DateTime @default(now())

  @@unique([negozioId, shopifyId]) // dedup per-negozio: il gid è unico solo lì
  @@index([data])
}

// Una conversazione con una persona su un canale. idEsterno identifica la
// persona sul canale: numero WhatsApp, PSID Messenger, IGSID Instagram o il
// token segreto della sessione del widget.
model Conversazione {
  id                String   @id @default(cuid())
  canale            String // whatsapp | messenger | instagram | widget
  idEsterno         String
  nome              String   @default("")
  ultimoTesto       String   @default("") @db.Text
  ultimoMessaggioIl DateTime @default(now())
  nonLetti          Int      @default(0) // messaggi in arrivo non ancora letti dall'operatore
  archiviata        Boolean  @default(false)
  creatoIl          DateTime @default(now())

  messaggi Messaggio[]

  @@unique([canale, idEsterno])
  @@index([ultimoMessaggioIl])
}

model Messaggio {
  id              String   @id @default(cuid())
  conversazioneId String
  conversazione   Conversazione @relation(fields: [conversazioneId], references: [id], onDelete: Cascade)
  direzione       String // in (dal cliente) | out (dall'operatore)
  oggetto         String   @default("") // solo email: l'oggetto del messaggio
  testo           String   @db.Text
  tipo            String   @default("testo") // testo | media | nota
  idEsterno       String   @default("") // id Meta del messaggio: dedup webhook e aggiornamenti di stato
  stato           String   @default("") // inviato | consegnato | letto | errore ("" per i messaggi in arrivo)
  errore          String   @default("") // motivo se stato = errore
  creatoIl        DateTime @default(now())

  @@index([conversazioneId, creatoIl])
  @@index([idEsterno])
}
