// Deluxy Messaggi — schema dati
//
// Un'inbox unificata: le conversazioni arrivano da canali diversi (WhatsApp,
// Messenger, Instagram via webhook Meta, più il widget di chat dei siti) ma
// vivono tutte nelle stesse due tabelle: Conversazione e Messaggio.
//
// I token Meta sono salvati in Impostazione SEMPRE cifrati (AES-256-GCM,
// src/lib/crypto.ts). Le password degli utenti sono hashate (scrypt), mai
// reversibili.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) in produzione
  directUrl = env("DIRECT_URL") // connessione diretta per prisma db push
}

// Chi accede all'app. Il primo utente si crea dalla pagina di login
// (bootstrap); gli altri li può creare un admin in seguito.
model Utente {
  id           String   @id @default(cuid())
  email        String   @unique
  nome         String
  passwordHash String // scrypt "salt.hash" — mai reversibile
  ruolo        String   @default("admin") // admin | operatore
  creatoIl     DateTime @default(now())
}

// Coppie chiave/valore di configurazione (token Meta cifrati, verify token,
// titolo del widget…). Vedi src/lib/impostazioni.ts per le chiavi usate.
model Impostazione {
  chiave String @id
  valore String @db.Text
}

// Uno store Shopify collegato. La holding ha più negozi: da ognuno scarichiamo
// gli ordini. Le credenziali (token statico o Client Secret) sono cifrate.
// Due modi di autenticarsi, come in src/lib/shopify.ts:
//  - token: Admin API access token statico (shpat_…) di un'app legacy
//  - clientId + clientSecret: app Dev Dashboard (client credentials grant)
model NegozioShopify {
  id           String   @id @default(cuid())
  nome         String // etichetta leggibile, es. "Deluxy Flowers"
  // Sigla usata davanti al nome in rubrica: DL (Deluxy), FL (Flowers), CK (Cake).
  // Vuota = dedotta dal nome/dominio (vedi prefissoDaNegozio in src/lib/negozi.ts).
  prefisso     String   @default("")
  // Il nome del brand come lo conosce l'app Ricerca fornitori (es. deluxyflowers.com):
  // serve al bottone "Fornitore" sotto ogni ordine. Vuoto = dedotto dal nome.
  brandRicerca String   @default("")
  dominio      String   @unique // es. fb72b1-2.myshopify.com
  token        String   @default("") @db.Text // shpat_… cifrato (se app legacy)
  clientId     String   @default("")
  clientSecret String   @default("") @db.Text // cifrato (se app Dev Dashboard)
  attivo       Boolean  @default(true)
  creatoIl     DateTime @default(now())

  ordini       Ordine[]
  istruzioniAI IstruzioneAI[]
  documentiAI  DocumentoAI[]
}

// Uno "script": una risposta pronta da dare ai clienti. Sono la memoria
// dell'assistenza — l'AI li legge per rispondere come rispondiamo noi, invece
// di inventare un tono e dei contenuti suoi.
model Script {
  id        String   @id @default(cuid())
  titolo    String
  categoria String   @default("Generale")
  testo     String   @db.Text
  // Quando usarlo, a parole: serve all'AI per scegliere quello giusto.
  quando    String   @default("") @db.Text
  attivo    Boolean  @default(true)
  usi       Int      @default(0) // quante volte è stato usato: i migliori emergono
  creatoIl  DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([categoria])
}

// Una richiesta di pagamento: le coordinate su cui farsi pagare. L'IBAN e
// l'intestatario possono essere inseriti a mano o letti dall'AI da un
// messaggio o da un'immagine (schermata, foto di un bonifico).
model RichiestaPagamento {
  id           String   @id @default(cuid())
  iban         String
  bic          String   @default("")
  intestatario String
  importo      Float    @default(0)
  valuta       String   @default("EUR")
  causale      String   @default("")
  note         String   @default("") @db.Text
  contatto     String   @default("") // come ricontattare chi ha chiesto il pagamento
  linkConversazione String @default("") // il thread da cui nasce la richiesta
  // Invio a Deluxy Partner, che approva e paga. `riferimento` è la chiave di
  // idempotenza concordata: rimandare la stessa richiesta non la duplica.
  riferimento  String   @unique @default(cuid())
  inviataIl    DateTime?
  partnerId    String   @default("")
  partnerStato String   @default("") // in_attesa | approvata | rifiutata …
  esitoInvio   String   @default("") @db.Text // errore dell'ultimo tentativo
  // Esito della verifica formale dell'IBAN (checksum mod-97): non ci si fida
  // di quello che estrae l'AI, si controlla.
  ibanValido   Boolean  @default(false)
  ibanPaese    String   @default("")
  // Da dove arriva: manuale | testo | immagine
  origine      String   @default("manuale")
  ordineNumero String   @default("") // se legata a un ordine
  creatoIl     DateTime @default(now())

  @@index([creatoIl])
}

// Una casella di posta collegata (se ne possono collegare più d'una).
// Parametri ufficiali register.it: IMAP pop.securemail.pro:993 SSL,
// SMTP authsmtp.securemail.pro:465 SSL, utente = indirizzo completo.
model CasellaEmail {
  id           String   @id @default(cuid())
  nome         String   @default("") // etichetta, es. "Servizio clienti"
  indirizzo    String   @unique // es. cs@deluxy.it — è anche l'utente IMAP/SMTP
  nomeMittente String   @default("Deluxy")
  password     String   @default("") @db.Text // cifrata
  imapHost     String   @default("pop.securemail.pro")
  imapPort     Int      @default(993)
  smtpHost     String   @default("authsmtp.securemail.pro")
  smtpPort     Int      @default(465)
  // Alcuni provider usano STARTTLS su 587: allora la connessione parte in
  // chiaro e si cifra dopo (secure = false).
  smtpSicuro   Boolean  @default(true)
  // register.it presenta un certificato intestato a un altro dominio: la
  // connessione resta cifrata, si salta solo la verifica del NOME.
  ignoraCertTls Boolean @default(true)
  attiva       Boolean  @default(true)
  predefinita  Boolean  @default(false) // da quale casella parte una mail nuova
  creatoIl     DateTime @default(now())
}

// Ordini scaricati da Shopify. Ne teniamo una copia locale per mostrarli senza
// richiamare Shopify ogni volta e per ricordare se il contatto del cliente è
// già stato salvato su Google Contacts (contattoSalvato/contattoEsito).
model Ordine {
  id             String   @id @default(cuid())
  negozioId      String
  negozio        NegozioShopify @relation(fields: [negozioId], references: [id], onDelete: Cascade)
  negozioNome    String   @default("") // denormalizzato per la lista
  shopifyId      String // gid Shopify dell'ordine (unico per negozio, non globale)
  numero         String   @default("") // es. #1042
  data           DateTime @default(now())
  totale         Float    @default(0)
  valuta         String   @default("EUR")
  statoPagamento String   @default("")
  clienteNome    String   @default("")
  telefono       String   @default("")
  email          String   @default("")
  indirizzo      String   @default("") @db.Text
  citta          String   @default("") // mostrata sulle card della vista a colonne
  // Paese di spedizione (ISO 2 lettere, da Orders): decide in che LINGUA si
  // scrive al cliente (src/lib/lingua.ts). Vuoto = non si sa, e allora si
  // guarda il prefisso del telefono.
  paese          String   @default("")
  // Consegna richiesta dal cliente e stato nella pipeline Deluxy: arrivano da
  // Orders e reggono il Calendario ordini.
  dataConsegna   DateTime?
  fasciaConsegna String   @default("")
  statoChiave    String   @default("")
  statoNome      String   @default("")
  statoColore    String   @default("")
  note           String   @default("") @db.Text
  // DA CHE TIPO DI CLIENTE ARRIVA L'ORDINE, letto da Deluxy Orders:
  // privato | azienda | horeca | eventi | rivenditore. Vuoto = Orders non sa
  // dirlo (ordine senza email, telefono né nome).
  //
  // È una COPIA di comodo, non una fonte: la tipologia si decide in Orders (a
  // mano con `TagCliente`, altrimenti dedotta dal nome dell'acquirente) e qui si
  // riscrive a ogni sync. Non modificarla da questa app: cambierebbe solo qui e
  // le due schermate si contraddirebbero.
  clienteTipo    String   @default("")
  // "manuale" (deciso da un operatore in Orders) oppure "dedotta" (dal nome).
  // Serve a sapere quanto fidarsi: una deduzione si può smentire.
  clienteTipoDa  String   @default("")
  // Quante volte quel cliente aveva già comprato PRIMA di questo ordine, e che
  // numero ha questo ordine per lui (1 = è il suo primo).
  //
  // ⚠️ Il conto lo fa ORDERS sulla storia completa, e va preso da lì: la copia
  // locale copre solo gli ultimi due mesi (927 ordini su ~14.000), quindi
  // contando qui un cliente che compra ogni Natale risulterebbe nuovo ogni
  // volta. `null` = Orders non l'ha calcolato o non riconosce il cliente —
  // che è diverso da «è la prima volta», e non va mostrato come tale.
  clienteOrdiniPrima Int?
  clienteNumeroOrdine Int?
  contattoSalvato Boolean @default(false) // salvato su Google Contacts
  contattoEsito  String   @default("") // esito/errore dell'ultimo salvataggio
  // Come stiamo lavorando l'ordine QUI (nostro, distinto dallo stato della
  // pipeline di Orders in statoChiave): da_gestire | in_pagamento |
  // comunicazione | gestito. Lo scarico da Orders non lo tocca mai.
  gestione       String   @default("da_gestire")
  gestioneIl     DateTime?
  creatoIl       DateTime @default(now())

  @@unique([negozioId, shopifyId]) // dedup per-negozio: il gid è unico solo lì
  @@index([data])
}

// Una conversazione con una persona su un canale. idEsterno identifica la
// persona sul canale: numero WhatsApp, PSID Messenger, IGSID Instagram o il
// token segreto della sessione del widget.
model Conversazione {
  id                String   @id @default(cuid())
  canale            String // whatsapp | messenger | instagram | widget | email
  idEsterno         String
  // Solo email: la casella che ha ricevuto (da lì partono le risposte).
  casellaId         String   @default("")
  nome              String   @default("")
  ultimoTesto       String   @default("") @db.Text
  ultimoMessaggioIl DateTime @default(now())
  nonLetti          Int      @default(0) // messaggi in arrivo non ancora letti dall'operatore
  archiviata        Boolean  @default(false)
  creatoIl          DateTime @default(now())

  messaggi Messaggio[]

  @@unique([canale, idEsterno])
  @@index([ultimoMessaggioIl])
}

model Messaggio {
  id              String   @id @default(cuid())
  conversazioneId String
  conversazione   Conversazione @relation(fields: [conversazioneId], references: [id], onDelete: Cascade)
  direzione       String // in (dal cliente) | out (dall'operatore)
  oggetto         String   @default("") // solo email: l'oggetto del messaggio
  testo           String   @db.Text
  tipo            String   @default("testo") // testo | media | nota
  idEsterno       String   @default("") // id Meta del messaggio: dedup webhook e aggiornamenti di stato
  stato           String   @default("") // inviato | consegnato | letto | errore ("" per i messaggi in arrivo)
  errore          String   @default("") // motivo se stato = errore
  creatoIl        DateTime @default(now())

  @@index([conversazioneId, creatoIl])
  @@index([idEsterno])
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER SERVICE — RECLAMI
//
// Da ogni ordine si può aprire un reclamo. Ogni reclamo ha una CASISTICA (il
// tipo di problema, con le azioni consigliate) ed è imputato a una COLPA: un
// valet (chi fa le consegne, registro locale qui sotto) o un partner (dal
// registro Anagrafiche, senza copia locale). Aggregando i reclami per colpa si
// danno i GIUDIZI a valet e partner.
// ─────────────────────────────────────────────────────────────────────────────

// Un valet: chi fa materialmente le consegne. Serve a imputare la colpa di un
// reclamo a una persona precisa e a darle un giudizio.
//
// ⚠️ DEVIAZIONE CONSAPEVOLE dalla regola "non duplicare i registri altrui".
// Il registro VERO dei valet è in deluxy-platform-next (`model Valet`, con
// IBAN, codice fiscale, veicolo, regole di stipendio: dati che qui non
// servono e non vogliamo). Non lo leggiamo perché **non esiste una API a
// chiave** per i valet: `GET /api/v1/valets` è protetta da JWT utente + ruolo
// (api/src/valets/valets.controller.ts), e l'unica alternativa oggi sarebbe
// conservare la password di un utente di servizio — peggio della copia.
// Perciò qui teniamo solo il minimo per attribuire una colpa: nome e recapito.
// DA FARE quando si potrà: aggiungere in platform-next una lettura a
// `x-api-key` sul modello di deluxy-orders (src/lib/api-auth.ts) e sostituire
// questa tabella con un `src/lib/valet.ts` che rilegge il registro, come già
// facciamo per i partner in src/lib/anagrafiche.ts.
model Valet {
  id       String   @id @default(cuid())
  nome     String
  telefono String   @default("")
  email    String   @default("")
  zona     String   @default("") // zona/quartiere di consegna, se utile
  note     String   @default("") @db.Text
  attivo   Boolean  @default(true)
  creatoIl DateTime @default(now())
}

// Una casistica di reclamo: il "tipo" di problema, con le azioni consigliate da
// eseguire e la colpa tipica. È il catalogo che l'operatore configura una volta
// e riusa aprendo i reclami.
model CasistaReclamo {
  id          String   @id @default(cuid())
  nome        String // es. "Consegna in ritardo"
  descrizione String   @default("") @db.Text
  // A chi è di solito imputabile: valet | partner | azienda | cliente | nessuno.
  // È solo un default: sul singolo reclamo la colpa si può cambiare.
  colpaTipica String   @default("")
  // Peso della casistica: 1 lieve, 2 media, 3 grave. Regge i giudizi.
  gravita     Int      @default(2)
  // Azioni consigliate da eseguire, una per riga.
  azioni      String   @default("") @db.Text
  attiva      Boolean  @default(true)
  creatoIl    DateTime @default(now())
  aggiornatoIl DateTime @updatedAt
}

// Un reclamo aperto su un ordine.
model Reclamo {
  id           String   @id @default(cuid())
  // Ordine di riferimento: denormalizzato perché l'ordine può stare qui in
  // locale (ordineId valorizzato) oppure solo nell'archivio Orders.
  ordineId     String   @default("")
  ordineNumero String   @default("")
  negozioNome  String   @default("")
  clienteNome  String   @default("")
  telefono     String   @default("")
  email        String   @default("")

  // Casistica: il tipo di problema. `casistica` è il nome denormalizzato.
  casisticaId  String   @default("")
  casistica    String   @default("")

  // Di chi è la colpa: valet | partner | azienda | cliente | nessuno.
  // colpaId è l'id del valet (registro locale) o del partner (Anagrafiche);
  // colpaNome è denormalizzato perché il nome del partner vive nel registro.
  colpaTipo    String   @default("nessuno")
  colpaId      String   @default("")
  colpaNome    String   @default("")

  gravita      Int      @default(2) // 1 lieve, 2 media, 3 grave
  descrizione  String   @default("") @db.Text
  // Azioni da eseguire per questo reclamo (partono dalla casistica, poi si
  // adattano). Una per riga.
  azioni       String   @default("") @db.Text
  stato        String   @default("aperto") // aperto | in_lavorazione | risolto | chiuso
  esito        String   @default("") @db.Text // com'è andata a finire

  risoltoIl    DateTime?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([stato])
  @@index([colpaTipo, colpaId])
  @@index([creatoIl])
}

// Un giudizio dato a un valet o a un partner. Il giudizio automatico si calcola
// dai reclami (in src/lib/reclami.ts); questo è il giudizio MANUALE che
// l'operatore registra, e che completa/corregge quello automatico. Uno per
// soggetto (upsert su [soggettoTipo, soggettoId]).
model Giudizio {
  id           String   @id @default(cuid())
  soggettoTipo String // valet | partner
  soggettoId   String
  soggettoNome String   @default("")
  voto         Int      @default(3) // 1 pessimo … 5 ottimo
  nota         String   @default("") @db.Text
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@unique([soggettoTipo, soggettoId])
}

// Una RICHIESTA DI RIMBORSO su un ordine: il cliente riavrebbe indietro dei
// soldi, in tutto o in parte.
//
// ⚠️ QUESTA TABELLA NON RIMBORSA NIENTE. Registra che qualcuno lo ha chiesto e
// che qualcun altro lo ha approvato o rifiutato; il denaro lo muove una persona,
// da Shopify o dalla banca, e lo si segna qui con "eseguito". È la stessa regola
// che vale per i pagamenti in tutto il repo (vedi deluxy-transactions): nessuna
// app Deluxy paga per conto proprio. Chi in futuro volesse automatizzare l'uscita
// deve passare da lì — non aggiungere qui una chiamata che sposta soldi.
//
// Nasce quasi sempre da un reclamo (`reclamoId`), ma può stare in piedi da sola:
// un cliente può chiedere il rimborso senza aver aperto una contestazione.
model Rimborso {
  id           String   @id @default(cuid())
  // L'ordine: denormalizzato come per i reclami, perché l'ordine può vivere qui
  // in locale oppure solo nell'archivio di Deluxy Orders.
  ordineId     String   @default("")
  ordineNumero String   @default("")
  negozioNome  String   @default("")
  clienteNome  String   @default("")
  telefono     String   @default("")
  email        String   @default("")

  // Quanto valeva l'ordine quando è stata fatta la richiesta: si congela qui
  // perché è il tetto su cui è stato deciso. Se domani l'ordine cambiasse, la
  // decisione presa resterebbe leggibile con i numeri di allora.
  importoOrdine Float   @default(0)
  importo      Float    @default(0) // quanto si chiede di rendere
  valuta       String   @default("EUR")
  // totale | parziale — si ricava dagli importi, ma tenerlo scritto rende
  // leggibile l'elenco senza rifare il confronto a ogni riga.
  tipo         String   @default("parziale")

  // Perché. `motivo` è il testo libero; `reclamoId` lega la richiesta alla
  // contestazione da cui nasce, se c'è.
  motivo       String   @default("") @db.Text
  reclamoId    String   @default("")

  // richiesto | approvato | rifiutato | eseguito | annullato
  stato        String   @default("richiesto")
  richiestoDa  String   @default("") // chi l'ha chiesto (nome dell'operatore)
  decisoDa     String   @default("") // chi ha approvato o rifiutato
  decisoIl     DateTime?
  // Come è finita davvero: "rimborsato su Shopify il 3/8", "bonifico del 5/8".
  esito        String   @default("") @db.Text
  eseguitoIl   DateTime?
  note         String   @default("") @db.Text

  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([stato])
  @@index([ordineId])
  @@index([creatoIl])
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER SERVICE — PUNTEGGI (pagella di valet e partner)
//
// Il punteggio NON è una formula fissa nel codice: è una somma pesata di VOCI
// che l'operatore configura (`VocePunteggio`). Ogni voce dice da dove prende il
// dato (`fonte`) e quanto pesa (`peso`). Così si possono aggiungere variabili
// nuove senza toccare il codice: i partner vivono su feedback e reclami, i valet
// su puntualità e feedback, ma nulla vieta di aggiungere "qualità dei fiori" o
// "cura del confezionamento" come voci manuali.
//
// Regola che tiene onesto il calcolo: una voce SENZA DATI per quel soggetto
// viene ESCLUSA dalla media pesata, non contata come zero. Altrimenti un partner
// di cui non misuriamo la puntualità risulterebbe scarso per un dato che non
// abbiamo mai raccolto. Vedi src/lib/punteggi.ts.
// ─────────────────────────────────────────────────────────────────────────────

// Una voce della pagella: cosa si misura, per chi, da dove e quanto pesa.
model VocePunteggio {
  id          String   @id @default(cuid())
  nome        String // es. "Feedback dei clienti", "Puntualità"
  descrizione String   @default("") @db.Text
  // A chi si applica: valet | partner | tutti
  soggetto    String   @default("tutti")
  // Da dove arriva il dato:
  //   reclami    → dai reclami imputati al soggetto (meno reclami = più punti)
  //   feedback   → dalla media dei voti in `Feedback`
  //   puntualita → dalla quota di consegne in orario in `Puntualita`
  //   manuale    → da un valore 0-100 messo a mano in `MetricaManuale`
  fonte       String   @default("manuale")
  // Quanto pesa nella media (numero puro: contano i rapporti fra i pesi).
  peso        Int      @default(1)
  // Significato DIVERSO per fonte (documentato in src/lib/punteggi.ts):
  //   reclami    → il punteggio-reclami che azzera la voce (es. 10)
  //   puntualita → i minuti di tolleranza entro cui si è "in orario" (es. 15)
  //   feedback   → non usata
  //   manuale    → non usata
  soglia      Float    @default(10)
  attiva      Boolean  @default(true)
  creatoIl    DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([soggetto])
}

// Un feedback ricevuto su un valet o su un partner: il voto di una persona.
// Può nascere da un reclamo, da una telefonata o da un giro di chiamate.
model Feedback {
  id           String   @id @default(cuid())
  soggettoTipo String // valet | partner
  soggettoId   String
  soggettoNome String   @default("")
  voto         Int      @default(3) // 1 pessimo … 5 ottimo
  testo        String   @default("") @db.Text
  // Da chi arriva e su quale ordine, se si sa.
  clienteNome  String   @default("")
  ordineNumero String   @default("")
  // Come l'abbiamo raccolto: telefono | whatsapp | email | reclamo | altro
  origine      String   @default("altro")
  creatoIl     DateTime @default(now())

  @@index([soggettoTipo, soggettoId])
  @@index([creatoIl])
}

// Una consegna misurata sugli ORARI: quanto ha sforato rispetto a quando era
// attesa. È la base del punteggio di puntualità dei valet.
//
// `minutiRitardo` è il ritardo in minuti: 0 = puntuale, negativo = in anticipo.
// Si tiene il NUMERO, non un "in orario sì/no", perché la tolleranza è
// configurabile sulla voce di punteggio (`soglia`): cambiandola, gli stessi dati
// raccontano una storia diversa senza dover riscrivere nulla.
model Puntualita {
  id           String   @id @default(cuid())
  valetId      String
  valetNome    String   @default("")
  ordineNumero String   @default("")
  // Quando era attesa e quando è arrivata davvero.
  attesaIl     DateTime?
  consegnataIl DateTime?
  minutiRitardo Int     @default(0)
  note         String   @default("") @db.Text
  creatoIl     DateTime @default(now())

  @@index([valetId])
  @@index([creatoIl])
}

// Il valore di una voce MANUALE per un soggetto: la "variabile impostabile".
// 0-100, dove 100 è il massimo. Uno per (voce, soggetto).
model MetricaManuale {
  id           String   @id @default(cuid())
  voceId       String
  soggettoTipo String // valet | partner
  soggettoId   String
  valore       Float    @default(0) // 0-100
  nota         String   @default("") @db.Text
  aggiornatoIl DateTime @updatedAt

  @@unique([voceId, soggettoTipo, soggettoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHIAVI API — lettura del Customer Service dalle altre app Deluxy
//
// Stesso schema di deluxy-orders e deluxy-anagrafiche (standard Deluxy §4.3):
// nel database c'è solo lo SHA-256 della chiave, mai il valore in chiaro.
// Si creano con `npm run chiave -- <nome-app>`.
model ApiKey {
  id        String    @id @default(cuid())
  nome      String    @unique // app client: deluxy-orders, ...
  hash      String    @unique // sha256 esadecimale della chiave
  attiva    Boolean   @default(true)
  creataIl  DateTime  @default(now())
  ultimoUso DateTime?
}

// ─────────────────────────────────────────────────────────────────────────────
// CS AI — le istruzioni con cui l'AI parla ai clienti
//
// Qui si scrive COME si risponde: il tono, la firma, cosa non promettere mai,
// le regole diverse fra chat e mail. Sono istruzioni, non testi da mandare —
// i testi pronti sono gli `Script`, e le due cose non vanno confuse: uno Script
// si invia, un'istruzione dice all'AI come comportarsi mentre lo adatta.
//
// ⚠️ NON tutte le regole stanno qui. I paletti di sicurezza (non inventare dati,
// non promettere rimborsi, usare solo gli script forniti) restano scritti nel
// codice in `src/lib/cs-ai.ts` e non si possono cancellare da questa pagina:
// sono ciò che impedisce all'AI di promettere a un cliente cose che l'azienda
// non ha deciso. Quello che si scrive qui si AGGIUNGE a quelli.
// ─────────────────────────────────────────────────────────────────────────────
model IstruzioneAI {
  id        String   @id @default(cuid())
  titolo    String
  categoria String   @default("Generale") // Tono di voce, Firma, Reclami…
  testo     String   @db.Text
  // Dove vale: tutti | chat | email. Alla chat e alla mail si scrive in modo
  // diverso — una chat è breve e immediata, una mail ha oggetto e firma.
  ambito    String   @default("tutti")
  // Il BRAND per cui vale. Vuoto = tutti i brand. La holding ha più negozi
  // (Flowers, Cake Design, Gifts) e non parlano allo stesso modo: la firma dei
  // fiori non deve finire in una mail della pasticceria.
  negozioId String?
  // Da quale documento caricato è stata ricavata. Vuoto = scritta a mano. Serve
  // a risalire: una regola di cui non si sa da dove viene non si può né
  // difendere davanti a un cliente né correggere quando la fonte cambia.
  documentoId String?
  // Quale regola GENERALE questa regola di brand manda in pensione.
  //
  // ⚠️ Serve perché due regole che si contraddicono non si risolvono da sole nel
  // prompt. Misurato: con «firma Servizio Clienti Deluxy» (generale) e «firma Il
  // team di Cake Design» (brand) nello stesso prompt — anche scrivendo a chiare
  // lettere che vince quella del brand — il modello sceglieva la generale 4-6
  // volte su 6. L'unico modo affidabile è non mandargliele tutte e due: chi
  // scrive la regola di brand dice quale sostituisce, e quella non parte.
  sostituisceId String?
  // In che ordine finiscono nel prompt: le più importanti per prime.
  ordine    Int      @default(0)
  attiva    Boolean  @default(true)
  creatoIl  DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  negozio   NegozioShopify? @relation(fields: [negozioId], references: [id], onDelete: SetNull)
  documento DocumentoAI?    @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  @@index([ambito])
  @@index([negozioId])
  @@index([documentoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// I DOCUMENTI da cui l'AI ricava le istruzioni: il manuale del servizio clienti,
// la brand voice, le regole di consegna. Si caricano PDF, Word o testo.
//
// ⚠️ Si salva il TESTO ESTRATTO, non il file originale, e il documento NON
// finisce nel prompt così com'è: da trenta pagine si ricavano poche regole, che
// una persona approva prima che diventino istruzioni. Allegare il manuale intero
// a ogni risposta costerebbe a ogni messaggio, annegherebbe le regole che
// contano in mezzo agli indici e ai frontespizi, e renderebbe impossibile capire
// perché l'AI ha scritto una certa frase.
// ─────────────────────────────────────────────────────────────────────────────
model DocumentoAI {
  id         String   @id @default(cuid())
  nome       String // nome del file caricato
  tipo       String   @default("") // mime dichiarato dal browser
  dimensione Int      @default(0) // byte dell'originale
  testo      String   @db.Text // il testo estratto: è questo che legge l'AI
  pagine     Int      @default(0) // solo per i PDF
  // Il brand a cui si riferisce. Vuoto = vale per tutti.
  negozioId  String?
  nota       String   @default("") @db.Text
  creatoIl   DateTime @default(now())

  negozio    NegozioShopify? @relation(fields: [negozioId], references: [id], onDelete: SetNull)
  istruzioni IstruzioneAI[]

  @@index([negozioId])
}
