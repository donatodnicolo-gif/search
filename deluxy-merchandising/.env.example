# Deluxy Merchandising — variabili d'ambiente (copiare in .env; MAI committare .env)

# --- Database ---
# Postgres condiviso Deluxy (Supabase), schema dedicato "merchandising". Le due
# stringhe si scrivono da sole con:
#   node scripts/configura-db-condiviso.mjs ../deluxy-partner/.env
DATABASE_URL=""
DIRECT_URL=""

# --- Protezione UI (obbligatoria in produzione) ---
# Qui ci sono costi e margini di prodotto: senza questa password l'app NON va
# pubblicata. In sviluppo locale si può lasciare vuota (UI aperta).
MERCHANDISING_APP_PASSWORD=""

# --- Vendite: registro ordini Deluxy Orders (a monte del trend) ---
# Da qui arriva il venduto reale che alimenta "Vendite & trend" e le ipotesi di
# ordinativo. La chiave si crea in deluxy-orders con:
#   npm run chiave -- deluxy-merchandising
# Senza chiave l'app resta leggibile ma non importa nulla (in locale si possono
# caricare vendite dimostrative con: npm run vendite:demo).
ORDERS_URL="https://deluxy-orders.vercel.app"
ORDERS_API_KEY=""

# --- Lettura AI del trend ---
# Senza chiave la pagina "Trend con AI" mostra comunque i numeri pronti, ma non
# la lettura. Il modello interpreta: non calcola e non esegue niente.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Cifratura dei token salvati dall'app ---
# I token Shopify inseriti in Impostazioni si salvano cifrati con questa chiave
# (AES-256-GCM). Una frase lunga a caso va benissimo. Senza, l'app si rifiuta di
# salvarli invece di metterli in chiaro nel database.
# ATTENZIONE: cambiandola, i token già salvati non si decifrano più e vanno reinseriti.
APP_SECRET=""

# --- Shopify (pubblicazione prodotti a valle) ---
# Necessarie SOLO per pubblicare davvero i prodotti sul negozio.
# Finché mancano, l'app prepara il payload e traccia lo stato ma non scrive su Shopify.
# SHOPIFY_STORE_DOMAIN="deluxyflowers.myshopify.com"
# SHOPIFY_ADMIN_TOKEN=""
