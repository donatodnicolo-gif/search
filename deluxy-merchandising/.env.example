# Deluxy Merchandising — variabili d'ambiente (copiare in .env; MAI committare .env)

# --- Database ---
# Postgres condiviso Deluxy (Supabase), schema dedicato "merchandising". Le due
# stringhe si scrivono da sole con:
#   node scripts/configura-db-condiviso.mjs ../deluxy-partner/.env
DATABASE_URL=""
DIRECT_URL=""

# --- Protezione UI (obbligatoria in produzione) ---
# Qui ci sono costi e margini di prodotto: senza questa password l'app NON va
# pubblicata. In sviluppo locale si può lasciare vuota (UI aperta).
MERCHANDISING_APP_PASSWORD=""

# --- Shopify (pubblicazione prodotti a valle) ---
# Necessarie SOLO per pubblicare davvero i prodotti sul negozio.
# Finché mancano, l'app prepara il payload e traccia lo stato ma non scrive su Shopify.
# SHOPIFY_STORE_DOMAIN="deluxyflowers.myshopify.com"
# SHOPIFY_ADMIN_TOKEN=""
