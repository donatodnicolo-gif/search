// Deluxy Merchandising — schema dati
// Gestione del prodotto a 360° come una maison di moda: collezioni e stagioni,
// sviluppo prodotto (PLM), costi e margini, visual merchandising e pubblicazione
// su Shopify (l'app è la fonte di verità a monte; Shopify resta il canale vendita).
//
// Database: Postgres condiviso Deluxy (Supabase), schema dedicato "merchandising".
// Si configura con: node scripts/configura-db-condiviso.mjs ../deluxy-partner/.env
// Eredità del periodo SQLite (lasciata apposta): niente enum né array scalari,
// gli stati sono stringhe normalizzate con cataloghi in src/lib/dominio.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) in produzione
  directUrl = env("DIRECT_URL") // connessione diretta per migrazioni/db push
}

// Una collezione stagionale: l'unità con cui una maison organizza il prodotto.
model Collezione {
  id          String     @id @default(cuid())
  nome        String // es. "Fioritura Notturna"
  stagione    String // catalogo in dominio.ts: SS26, FW26, CRUISE26, HOLIDAY26, ...
  anno        Int
  tema        String? // concept creativo / mood della collezione
  descrizione String?
  // in_sviluppo | in_vendita | archiviata
  stato       String     @default("in_sviluppo")
  // Target di marginalità della collezione (%). Alimenta gli allarmi in Costi.
  margineTarget Float?
  dataLancio  DateTime?
  copertina   String? // URL immagine di copertina (mood/lookbook)
  note        String?
  prodotti    Prodotto[]
  creataIl    DateTime   @default(now())
  aggiornataIl DateTime  @updatedAt

  @@index([stato])
  @@index([stagione])
}

// Il prodotto, gestito lungo tutto il suo ciclo di vita.
model Prodotto {
  id           String   @id @default(cuid())
  codice       String   @unique // SKU / codice interno (es. FN-26-001)
  nome         String
  collezioneId String?
  collezione   Collezione? @relation(fields: [collezioneId], references: [id], onDelete: SetNull)
  // Chiave della categoria: il catalogo vive in `CategoriaProdotto` (modificabile
  // dall'app) e `dominio.ts` tiene solo le etichette di riserva per le chiavi
  // storiche. Resta una stringa e non una relazione obbligatoria perché un
  // prodotto non deve sparire dalle liste se qualcuno rinomina una categoria.
  categoria    String   @default("BOUQUET")
  // La linea del prodotto (come nell'app reale: "Linea"), decisa qui.
  lineaId      String?
  linea        LineaProdotto? @relation(fields: [lineaId], references: [id], onDelete: SetNull)
  // Fuori dalle analisi: righe di servizio dei negozi (supplementi di prezzo,
  // spese), prove, prodotti che non sono prodotti. Restano in anagrafica — non
  // si cancella niente — ma spariscono da classifiche, trend, assortimento e
  // ipotesi di ordinativo, dove falserebbero i conti.
  esclusoDaAnalisi Boolean @default(false)
  motivoEsclusione String?
  // **Riconciliazione**: due schede che sono lo stesso prodotto (lo stesso
  // bouquet importato da due negozi con titoli diversi). Si sceglie quale
  // tenere; l'altra resta qui — non si cancella niente — ma punta alla buona con
  // `unitoAId`, e le sue vendite/varianti/collezioni vengono spostate su quella.
  // Così le classifiche smettono di contare due volte lo stesso prodotto senza
  // che nessun dato sparisca.
  unitoAId     String?
  unitoA       Prodotto?  @relation("Riconciliazione", fields: [unitoAId], references: [id], onDelete: SetNull)
  assorbiti    Prodotto[] @relation("Riconciliazione")
  unitoIl      DateTime?
  // Fase del ciclo di vita (PLM): concept | prototipo | approvato | in_vendita | archiviato
  fase         String   @default("concept")
  descrizione  String?
  // — Scheda creativa / PLM —
  brief        String? // brief creativo iniziale
  materiali    String? // materiali / fiori / componenti principali (testo)
  palette      String? // gamma cromatica
  noteSviluppo String?
  fornitoreId  String?
  fornitore    Fornitore? @relation(fields: [fornitoreId], references: [id], onDelete: SetNull)
  // — Costi & margini (in euro; la variante può aggiungere delta) —
  costoProduzione Float @default(0) // costo pieno di produzione/approvvigionamento
  prezzoVendita   Float @default(0) // prezzo di listino consigliato
  // — Visual merchandising —
  immagine     String? // URL immagine still-life di prodotto
  priorita     Int      @default(0) // priorità di esposizione (più alto = più in vista)
  // — Quello che dice Shopify del prodotto (letto, non dedotto) —
  // `tipoShopify` è il "product type" del negozio: è la categoria vera, scritta
  // da chi cura il sito. Vale più di qualsiasi tentativo di indovinarla dal
  // titolo, e infatti la categoria interna resta separata: una si legge, l'altra
  // si decide.
  tipoShopify    String?
  // La **categoria della tassonomia Shopify**: non è il tipo scritto a mano, è
  // una voce di un albero standard ("Home & Garden > Decor > Flowers"). Vale
  // come il tipo — è letta, non dedotta — ma è normalizzata, quindi si presta a
  // fare da ponte verso le nostre categorie.
  categoriaShopifyId   String?
  categoriaShopifyNome String? // nome completo, col percorso
  vendorShopify  String?
  // **Dove si consegna**, dal metafield `custom.nations_availability` di Shopify:
  // le province, come "ITALY-MILAN(MI), ITALY-MONZA AND BRIANZA(MB)". E' il posto
  // dove la disponibilita' per citta' vive davvero — i tag sono testo libero e
  // mescolano citta', fornitori e occasioni.
  zoneConsegna String?
  // Il metafield `custom.citta`: la citta' dichiarata del prodotto.
  cittaShopify String?
  // **Quando il negozio l'ha pubblicato e quando l'ha creato.** `creatoIl` qui
  // sopra e' la data della **nostra** scheda — cioe' quando l'import l'ha vista
  // per la prima volta — e non dice niente sulla novita': fra i 1.024 prodotti
  // attivi c'erano tre sole date, le tornate di import. La novita' vera e' la
  // **pubblicazione**: e' il momento in cui il cliente ha potuto vederlo.
  pubblicatoIlShopify DateTime?
  creatoIlShopify     DateTime?
  // **Dove e' nato il prodotto.** `merchandising` = disegnato qui (il caso
  // normale); `platform` = caricato da un partner nella piattaforma consegne,
  // dove il partner ha il suo account. Non e' un dettaglio di provenienza: un
  // prodotto nato altrove non deve entrare nelle classifiche di assortimento
  // come se l'avessimo scelto noi.
  origine    String  @default("merchandising")
  // Il suo id nell'app dov'e' nato, per ritrovarlo senza indovinare.
  idEsterno  String?
  // **Che ne fa la piattaforma consegne di questo prodotto**: `attivo` oppure
  // `archiviato`. NON e' la nostra `fase`, ed e' apposta che siano due campi:
  // la fase e' la decisione del PLM (dove sta nel suo ciclo di vita), questo e'
  // il fatto che la piattaforma lo tenga ancora a catalogo. Un prodotto puo'
  // essere «in vendita» per noi e archiviato la' perche' non lo consegna
  // nessuno da due anni: sono due verita', e schiacciarle in un campo solo ne
  // farebbe sparire una.
  statoPiattaforma   String?
  statoPiattaformaIl DateTime?
  // **L'anagrafica vera del prodotto**, dai metafield `custom.*` di Shopify.
  // Sono liste scelte da un elenco chiuso — non testo libero come i tag — quindi
  // una condizione costruita qui sopra non sbaglia per una maiuscola o un
  // sinonimo. Si salvano separate da virgola, come i tag.
  occasioniShopify      String?  // custom.occasioni      — Sorprese Romantiche, Ringraziamenti…
  tipologiaShopify      String?  // custom.tipologia      — Raccomandato…
  classificazioneShopify String? // custom.classificazione — Pret-a-Porter…
  dataShopify           String?  // custom.data           — Domani…
  orarioShopify         String?  // custom.orario_consegna — In Mattinata…
  bestSellerShopify     Boolean? // custom.best_seller
  // `custom.minimo_orario` (= 7 sul prodotto di prova). **Importato ma non ancora
  // usato come condizione**: non e' chiaro se sia l'ora limite dell'ordine o le
  // ore di preavviso, e una condizione costruita sul significato sbagliato
  // sceglierebbe i prodotti sbagliati in silenzio.
  minimoOrario          Int?
  // **Gli altri metafield che il negozio riempie davvero** (censiti sul negozio
  // il 17/08/2026 leggendo i prodotti attivi, non presi da una lista teorica).
  // Sono l'anagrafica merceologica che finora l'app non vedeva: com'è fatto il
  // prodotto, di che materia, chi lo produce.
  //
  // ⚠️ `custom.modello` e `custom.modelli` **sono due chiavi diverse per la
  // stessa cosa** — singolare sui fiori, plurale sui dolci — e finiscono nello
  // stesso campo: sono un errore di battitura diventato struttura, e tenerli
  // separati vorrebbe dire due lenti mezze vuote per lo stesso concetto.
  modelloShopify        String?  // custom.modello / custom.modelli — Bouquet, Pianta, Crostata
  fioriShopify          String?  // custom.fiori         — Ortensie, Rose, Dalie
  coloreFioriShopify    String?  // custom.colore_fiori  — Pink, White, Mix
  gustiShopify          String?  // custom.gusti         — Frutta, Crema
  dolciShopify          String?  // custom.dolci         — Macarons
  daChiFattoShopify     String?  // custom.da_chi_fatto  — «Creato dall'Artista: », «Selezionato per te da »
  claimShopify          String?  // custom.descrizione_cattura_vendite — «No Tempura No Party!»
  pezzoUnicoShopify     Boolean? // custom.is_unique
  nonFisicoShopify      Boolean? // custom.not_physical  — niente spedizione né giacenza
  // **Chi lo produce, secondo il negozio.** È il partner della piattaforma
  // consegne (`custom.partner_id`) col suo indirizzo. Vale doppio qui: l'app ha
  // un buco storico di prodotti senza fornitore, e questo è il dato vero scritto
  // sul negozio invece che dedotto. Resta **separato da `fornitoreId`**: quello
  // è il fornitore deciso qui dentro, questo è quello che dice Shopify — e
  // finché nessuno li ha confrontati, sovrapporli sarebbe una deduzione.
  partnerIdShopify      String?  // custom.partner_id
  partnerIndirizzoShopify String? // custom.partner_address
  tagShopify     String? // separati da virgola, come li dà Shopify
  handleShopify  String?
  // Giorni minimi per evadere il prodotto: il metafield Shopify `prodotto.consegna`
  // (mostrato come "gg_disp_min"). Da qui si ricava la **tipologia di risposta al
  // bisogno** (0 = urgenze, 1 = da domani, 2-3 = pianificato, 4-10 = su misura),
  // in src/lib/risposta-bisogno.ts. Null = non dichiarato: non si deduce.
  ggDispMin      Int?
  // — SEO del prodotto —
  // Come per le collezioni: col suffisso `Shopify` c'è quello che il negozio
  // dice oggi (riletto e sovrascritto a ogni import), senza suffisso **il
  // nostro**, da correggere e migliorare, che nessun import tocca.
  seoTitoloShopify      String?
  seoDescrizioneShopify String?
  seoTitolo             String?
  seoDescrizione        String?
  // Quando il **nostro** SEO è stato cambiato e quando è stato mandato al
  // negozio: se il primo è più recente del secondo, c'è da sincronizzare.
  // Stessa convenzione di ordineModificatoIl / ordineSpintoIl.
  seoModificatoIl DateTime?
  seoSpintoIl     DateTime?
  // Lo **stato del prodotto sul negozio**: ACTIVE | DRAFT | ARCHIVED, letto a
  // ogni import. Sta qui e non nella `fase` perché la fase è la leva **umana**
  // (è così che si archiviano a mano le righe di servizio) e un import non deve
  // sovrascriverla. È questo campo a dire chi va in vetrina: un prodotto
  // archiviato sul negozio il cliente non lo vede, per quanto qui sia «in vendita».
  statoShopify   String?
  // — Sincronizzazione Shopify (canale di vendita a valle) —
  shopifyStato   String  @default("non_pubblicato") // non_pubblicato | bozza | pubblicato
  shopifyId      String? // id prodotto su Shopify una volta pubblicato
  shopifySyncIl  DateTime?
  // **Prodotto composto**: un prodotto originale fatto di altri prodotti del
  // catalogo (il cesto, la composizione, il kit). `componenti` sono i pezzi che
  // lo formano; `usatoIn` dice in quali composti entra questo prodotto.
  componenti   ComponenteProdotto[] @relation("Composizione")
  usatoIn      ComponenteProdotto[] @relation("UsatoIn")
  varianti     Variante[]
  tappe        TappaSviluppo[]
  vetrine      VetrinaProdotto[]
  vendite      Vendita[]
  righeRiordino RigaRiordino[]
  collezioniShopify ProdottoInCollezioneShopify[]
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([collezioneId])
  @@index([categoria])
  @@index([fase])
  @@index([shopifyStato])
  @@index([unitoAId])
}

// Varianti di un prodotto (formato/misura/colore), come una maison declina un capo.
model Variante {
  id         String   @id @default(cuid())
  prodottoId String
  prodotto   Prodotto @relation(fields: [prodottoId], references: [id], onDelete: Cascade)
  nome       String // es. "Medium", "Deluxe", "Rosa cipria"
  sku        String?  @unique
  // Delta rispetto al prodotto base (possono essere negativi).
  deltaCosto   Float @default(0)
  deltaPrezzo  Float @default(0)
  giacenza     Int   @default(0) // stock disponibile
  creataIl   DateTime @default(now())
  vendite    Vendita[]
  righeRiordino RigaRiordino[]

  @@index([prodottoId])
}

// Storico delle fasi del ciclo di vita del prodotto (pipeline di sviluppo).
model TappaSviluppo {
  id         String   @id @default(cuid())
  prodottoId String
  prodotto   Prodotto @relation(fields: [prodottoId], references: [id], onDelete: Cascade)
  da         String
  a          String
  nota       String?
  origine    String   @default("ui")
  creataIl   DateTime @default(now())

  @@index([prodottoId, creataIl])
}

// Fornitori / atelier che producono o approvvigionano il prodotto.
// ⚠️ L'IDENTITÀ DI UN FORNITORE VIVE IN DELUXY ANAGRAFICHE, non qui (audit
// 24/08/2026): nome, città, referenti e recapiti non si compilano a mano in
// questa tabella — si aggancia il record del registro con `anagraficaId` e i
// campi qui sotto restano al più una cache di visualizzazione. Stato reale al
// 24/08/2026: dentro ci sono SOLO i 3 fornitori del seed dimostrativo (con 5
// prodotti collegati) e l'unico uso nel codice è il dizionario delle città in
// criteri-tipologia — il fornitore operativo del PLM è `vendorShopify` sul
// prodotto. Modello candidato alla rimozione; non si aggiunge altro qui.
model Fornitore {
  id           String     @id @default(cuid())
  // Id del partner in deluxy-anagrafiche: è QUESTO il collegamento giusto.
  anagraficaId String?    @unique
  nome         String
  tipo         String? // atelier, vivaio, importatore, packaging, ...
  citta        String?
  referente    String?
  email        String?
  telefono     String?
  note         String?
  prodotti     Prodotto[]
  creatoIl     DateTime   @default(now())
}

// Visual merchandising: un allestimento (vetrina / lookbook / capsula) in cui i
// prodotti sono disposti in un ordine curato.
model Vetrina {
  id          String   @id @default(cuid())
  nome        String
  stagione    String?
  tipo        String   @default("vetrina") // vetrina | lookbook | homepage | capsule
  descrizione String?
  prodotti    VetrinaProdotto[]
  creataIl    DateTime @default(now())
  aggiornataIl DateTime @updatedAt
}

model VetrinaProdotto {
  id         String   @id @default(cuid())
  vetrinaId  String
  vetrina    Vetrina  @relation(fields: [vetrinaId], references: [id], onDelete: Cascade)
  prodottoId String
  prodotto   Prodotto @relation(fields: [prodottoId], references: [id], onDelete: Cascade)
  posizione  Int      @default(0) // ordine di esposizione nell'allestimento

  @@unique([vetrinaId, prodottoId])
  @@index([vetrinaId, posizione])
}

// Un negozio Shopify che Merchandising può interrogare: dominio + token Admin.
//
// I token si impostano dalla pagina Impostazioni e nel database stanno
// **cifrati** (AES-256-GCM con APP_SECRET, vedi src/lib/crypto.ts): l'app li
// decifra solo nell'istante della chiamata e non li rimostra mai in pagina —
// una volta salvato, un token si sostituisce, non si rilegge.
//
// Ogni negozio ha il suo token perché su Shopify il token è legato al singolo
// negozio: non esiste una chiave che li apra tutti.
model NegozioShopify {
  id          String    @id @default(cuid())
  nome        String    @unique // come si chiama qui: "Flowers", "deluxy.it"…
  dominio     String // es. fb72b1-2.myshopify.com
  // Due modi di autenticarsi, entrambi cifrati:
  //
  // 1. **Client ID + Secret** (app della Dev Dashboard, il modo di oggi): l'app
  //    si conia da sola un token con il "client credentials grant", valido ~24h,
  //    e lo rinnova quando scade. Nessun token da custodire per sempre.
  // 2. **Token statico** `shpat_…` (app personalizzata del negozio, ancora
  //    valido): si incolla una volta e resta.
  //
  // Se ci sono le credenziali si usano quelle: il token qui sotto diventa solo
  // la copia di lavoro dell'ultimo token coniato.
  // Come si chiama questo negozio **nel venduto**, cioè il `canale` che arriva
  // da Deluxy Orders (es. "cakedesign.me" per il negozio qui chiamato "Cake").
  // Senza, incrociare vendite e collezioni dà zero senza dire perché.
  canaleVendite       String?
  // **Come si scrive il SEO di questo brand**, dettato da chi lo cura: tono,
  // parole da usare o evitare, cosa promettere e cosa no. Lo legge la scrittura
  // AI e ha la precedenza sulle regole generiche — stessa idea del prompt di
  // categoria per le descrizioni: chi conosce il brand scrive una volta, l'AI
  // parte già nella lingua giusta.
  lineeGuidaSeo       String?
  clientIdCifrato     String?
  clientSecretCifrato String?
  tokenCifrato  String?
  tokenScadeIl  DateTime? // null = token statico, non scade
  // Impronta corta del token: serve solo a riconoscere "quale" token è
  // impostato senza mostrarlo (le ultime cifre cambiano se lo sostituisci).
  tokenImpronta String   @default("")
  attivo      Boolean   @default(true)
  // Esito dell'ultima verifica: permessi che il token dichiara e cosa risponde
  // davvero il negozio. Senza, l'unico modo di scoprire che manca un permesso è
  // un import che fallisce a metà.
  verificatoIl DateTime?
  permessi     String? // scope separati da virgola, come li dichiara Shopify
  esitoVerifica String? // ok | errore
  messaggio    String?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([attivo])
}

// Il prompt AI di una categoria, come nel form Categorie di app.deluxy.it: chi
// conosce il prodotto scrive una volta come si racconta quella famiglia (le
// torte non si descrivono come i bouquet) e l'AI lo riusa a ogni descrizione.
model PromptCategoria {
  categoria    String   @id // chiave del catalogo in dominio.ts
  prompt       String
  aggiornatoIl DateTime @updatedAt
}

// Impostazioni riservate salvate dall'app (oggi: la chiave OpenAI), cifrate
// come i token Shopify. Stanno qui e non solo nell'ambiente perché chi usa
// l'app possa cambiarle senza un deploy.
model Impostazione {
  chiave        String   @id
  valoreCifrato String
  impronta      String   @default("")
  aggiornataIl  DateTime @updatedAt
}

// Il catalogo delle **categorie di prodotto**, deciso qui dentro.
//
// Ogni categoria ha una **descrizione**: non è decorazione, è il testo con cui
// l'AI capisce che cosa ci va dentro quando deve riconciliare i prodotti
// importati dai negozi (dove la stessa cosa si chiama «Fiori», «Rose»,
// «Bouquet»…). Più è precisa la descrizione, meno l'AI tira a indovinare.
model CategoriaProdotto {
  chiave      String   @id // es. BOUQUET — è quella scritta su Prodotto.categoria
  nome        String
  descrizione String? // che cosa ci va dentro e cosa no: guida umana e guida AI
  colore      String? // token del design system, es. "var(--green)"
  ordine      Int      @default(0)
  attiva      Boolean  @default(true)
  creataIl    DateTime @default(now())
  aggiornataIl DateTime @updatedAt

  @@index([attiva, ordine])
}

// Un pezzo di un **prodotto composto**: quale prodotto ci entra e quanti.
//
// Il costo e il prezzo del composto non si scrivono a mano: si leggono dai
// componenti, uno per uno. Per questo qui c'è solo il legame e la quantità —
// se il costo di una rosa cambia, cambia da solo il costo di tutti i cesti che
// la contengono.
model ComponenteProdotto {
  id           String   @id @default(cuid())
  compostoId   String
  composto     Prodotto @relation("Composizione", fields: [compostoId], references: [id], onDelete: Cascade)
  componenteId String
  componente   Prodotto @relation("UsatoIn", fields: [componenteId], references: [id], onDelete: Cascade)
  quantita     Int      @default(1)
  note         String?
  creatoIl     DateTime @default(now())

  @@unique([compostoId, componenteId])
  @@index([componenteId])
}

// Le **fasce di prezzo**: gli scalini in cui si legge il catalogo ("fino a
// 50 €", "100–200 €"). Non si assegnano a mano prodotto per prodotto — la fascia
// di un prodotto è quella in cui **cade il suo prezzo**, e se il prezzo cambia
// la fascia lo segue da sola. Qui si decidono solo i confini, che sono la vera
// scelta commerciale.
//
// `da` è compreso, `a` è **escluso**: così un prodotto da 49,90 € non finisce
// nel buco fra due fasce. `a = null` vuol dire «da qui in su».
model FasciaPrezzo {
  id          String   @id @default(cuid())
  nome        String   @unique
  da          Float    @default(0)
  a           Float?
  descrizione String? // a chi parla questa fascia: guida umana e guida AI
  colore      String?
  ordine      Int      @default(0)
  attiva      Boolean  @default(true)
  creataIl    DateTime @default(now())
  aggiornataIl DateTime @updatedAt

  @@index([attiva, ordine])
}

// Le **linee** di prodotto: la famiglia commerciale trasversale alle stagioni
// ("Ora Blu", "Gifting", "B2B"). Anche qui la descrizione serve all'AI.
model LineaProdotto {
  id          String     @id @default(cuid())
  nome        String     @unique
  descrizione String?
  ordine      Int        @default(0)
  attiva      Boolean    @default(true)
  prodotti    Prodotto[]
  creataIl    DateTime   @default(now())
  aggiornataIl DateTime  @updatedAt

  @@index([attiva, ordine])
}

// Una collezione **vera** di Shopify, importata dal negozio.
//
// Non si mescola con `Collezione` (le collezioni stagionali della maison, che
// nascono qui): sono due cose diverse. «Fioritura Notturna» è una scelta
// creativa, «Bouquet sotto i 50 €» è un raggruppamento del sito. Tenerle nella
// stessa lista confonderebbe il merchandising con la vetrina.
//
// Su Shopify un prodotto sta in **molte** collezioni: per questo la relazione
// passa da una tabella di legame e non dal campo `collezioneId` del prodotto,
// che di collezioni ne tiene una sola.
model CollezioneShopify {
  id           String   @id @default(cuid())
  negozio      String // nome del negozio collegato: "Flowers", "Cake"…
  shopifyId    String // gid://shopify/Collection/...
  handle       String
  titolo       String
  descrizione  String?
  immagine     String?
  // Quanti prodotti dice Shopify che contiene: confrontato con quelli abbinati
  // qui dice quanta parte di quella collezione l'app conosce.
  prodottiShopify Int   @default(0)
  // — Quello che dice Shopify della collezione (letto, non deciso qui) —
  tipo            String  @default("manuale") // manuale | automatica (smart collection)
  ordinamento     String? // sortOrder: BEST_SELLING, MANUAL, PRICE_ASC…
  regole          String? // le condizioni di una collezione automatica, in chiaro
  // — SEO —
  // **Due coppie, e servono tutte e due.** Quelle col suffisso `Shopify` sono
  // ciò che il negozio dice oggi: si rileggono a ogni import e si sovrascrivono.
  // Quelle senza suffisso sono **le nostre**, da correggere e migliorare: un
  // import non le tocca mai, altrimenti il primo giro cancellerebbe il lavoro.
  // È la stessa convenzione di `tipoShopify` (letto) accanto a `categoria`
  // (decisa da noi).
  seoTitoloShopify      String?
  seoDescrizioneShopify String?
  seoTitolo       String?
  seoDescrizione  String?
  // Quando il **nostro** SEO è stato cambiato e quando è stato mandato al
  // negozio: se il primo è più recente del secondo, c'è da sincronizzare.
  // Stessa convenzione di ordineModificatoIl / ordineSpintoIl.
  seoModificatoIl DateTime?
  seoSpintoIl     DateTime?
  modelloTema     String? // templateSuffix: quale layout usa il tema
  // È pubblicata sul negozio online, cioè la vedono i clienti? Letto da Shopify
  // (publishedOnPublication sull'Online Store). Visual mostra solo queste: una
  // collezione non pubblicata non è "in scena".
  pubblicataShopify Boolean @default(false)
  aggiornataShopifyIl DateTime?
  // — Quello che decidiamo qui (Shopify non lo sa) —
  // La regola con cui l'app propone l'ordine dei prodotti in vetrina (best
  // seller, novità, margine, prezzo…), da src/lib/ordinamento-vetrina.ts. È
  // solo il punto di partenza: dopo si ritocca a mano. "manuale" = nessuna regola.
  regolaOrdinamento String?
  // La **regola d'ordine salvata** scelta per questa collezione. Quando c'è,
  // vince su `regolaOrdinamento`: quella resta per le regole rapide scelte al
  // volo, questa è la regola scritta una volta e riusata.
  regolaOrdineId String?
  regolaOrdine   RegolaOrdine? @relation(fields: [regolaOrdineId], references: [id], onDelete: SetNull)
  // **Quanti prodotti per riga** mostrare sulla pagina della collezione.
  // Su Shopify non esiste un campo per questo: la disposizione la decide il
  // tema. Si scrive quindi come **metafield** `custom.prodotti_per_riga`, che è
  // l'unico posto per-collezione dove può stare — e vale solo se il tema lo
  // legge. Qui si sceglie, con `prodottiPerRigaSpintoIl` a dire se il negozio
  // ha già il valore o è rimasto indietro.
  prodottiPerRiga         Int?
  prodottiPerRigaSpintoIl DateTime?
  // I **temi** a cui è stata assegnata: raggruppamenti liberi decisi da una
  // persona (Natale, San Valentino…). Più di uno: una collezione può stare in
  // più temi insieme.
  temi         TemaCollezioni[]
  // La **tipologia** editoriale a cui appartiene la collezione (Bouquet, Torte,
  // Occasioni…), decisa da noi. Se la tipologia ha una regola, quella è
  // "standing": si riapplica da sola a ogni import, così i prodotti nuovi si
  // sistemano invece di restare in fondo. La assegna una persona.
  tipologiaId  String?
  tipologia    TipologiaCollezione? @relation(fields: [tipologiaId], references: [id], onDelete: SetNull)
  // La **rotazione periodica** a cui è iscritta questa collezione: ogni quanto
  // l'ordine si rifà da solo, perché una vetrina ferma smette di essere vista.
  // **La regola porta dentro i prodotti, non solo li ordina.** Con questo acceso,
  // ogni volta che la regola si applica i prodotti che le condizioni prendono e
  // che qui non ci sono ancora **entrano nella collezione**, su Shopify e qui.
  // Spento di default: far entrare prodotti in una vetrina e' una decisione, non
  // un effetto collaterale dell'ordinamento.
  aggiuntaAutomatica Boolean @default(false)
  // **Quanti prodotti al massimo può avere questa vetrina.** `null` = nessun
  // tetto (com'era prima). Si conta su chi il cliente vede davvero — i prodotti
  // in scena, `FILTRO_IN_SCENA` — e non su tutta l'appartenenza: due prodotti su
  // tre del catalogo sono archiviati su Shopify e in vetrina non compaiono, un
  // tetto che li contasse direbbe «piena» una vetrina mezza vuota.
  //
  // Vive sulla **singola collezione** e non sulla regola: la stessa priorità
  // serve una vetrina di punta da venti pezzi e una categoria da duecento.
  //
  // Il tetto **ferma le aggiunte automatiche** da solo; togliere quelli di
  // troppo è invece un gesto esplicito con conferma (`potaCollezione`), mai una
  // conseguenza del cron: un automatismo che toglie prodotti dal sito vero di
  // notte è esattamente la cosa che qui non si fa.
  massimoProdotti Int?
  // **La stellina**: le collezioni su cui si sta lavorando. Vive solo qui —
  // e' una scorciatoia personale, non una proprieta' del negozio.
  preferita Boolean @default(false)
  rotazioneId  String?
  rotazione    RegolaRotazione? @relation(fields: [rotazioneId], references: [id], onDelete: SetNull)
  // Quando l'ordine curato qui è stato cambiato l'ultima volta e quando è stato
  // spinto su Shopify: se il primo è più recente del secondo, c'è da sincronizzare.
  ordineModificatoIl DateTime?
  ordineSpintoIl     DateTime?
  // Dove si usa questa collezione: vetrina, home, menu, campagne… Più valori,
  // separati da virgola, dal catalogo in src/lib/collezioni.ts.
  posizioni       String?
  // Si può usare nelle campagne pubblicitarie? È una decisione di marketing,
  // non una proprietà del negozio: sta qui e non su Shopify.
  inCampagne      Boolean @default(false)
  stato           String  @default("attiva") // attiva | sospesa
  note            String?
  aggiornataIl DateTime @updatedAt
  creataIl     DateTime @default(now())
  prodotti     ProdottoInCollezioneShopify[]

  @@unique([negozio, shopifyId])
  @@index([negozio])
  @@index([tipologiaId])
  @@index([rotazioneId])
}

// Una **regola di rotazione**: ogni quanto l'ordine delle collezioni iscritte si
// rifà da solo. Una vetrina che resta identica per settimane smette di essere
// guardata; qui si decide il ritmo una volta e vale per tutte le collezioni che
// le assegni.
//
// Chi la esegue: il cron giornaliero (`/api/cron/rotazioni`, vedi vercel.json).
// Gira una volta al giorno e fa scattare **solo le regole scadute**: così
// giornaliera, settimanale e mensile convivono con un solo cron.
model RegolaRotazione {
  id        String @id @default(cuid())
  nome      String @unique
  // **Ogni quante unità**, con l'unità qui sotto: 2 + settimanale = ogni due
  // settimane. Con le sole tre frequenze fisse non si poteva dire «ogni dieci
  // giorni», e il ritmo di una vetrina non è sempre uno dei tre.
  ogniQuanti Int @default(1)
  // giornaliera | settimanale | mensile
  frequenza String @default("settimanale")
  // Che cosa fa quando scatta:
  // - "rinfresca": riapplica le regole d'ordine, così l'ordine segue i dati
  //   aggiornati (chi vende di più oggi sale oggi);
  // - "ruota": i primi passano in fondo, così a turno tutti i prodotti hanno il
  //   loro momento in cima. Serve quando i primi sono sempre gli stessi.
  modo      String @default("rinfresca")
  // Quanti prodotti passano in fondo a ogni giro, per il modo "ruota".
  passo     Int    @default(1)
  attiva    Boolean @default(true)
  // Se mandare l'ordine **anche a Shopify** a ogni giro. Di default NO: un
  // automatismo che scrive da solo sul negozio vero è una decisione da prendere
  // apposta, non un effetto collaterale. Senza, l'ordine si rifà qui e la
  // collezione resta segnata «da sincronizzare».
  spingiSuShopify Boolean @default(false)
  ultimaEsecuzioneIl DateTime?
  ultimoEsito        String?
  collezioni  CollezioneShopify[]
  creataIl     DateTime @default(now())
  aggiornataIl DateTime @updatedAt
}

// Un **tema**: un raggruppamento libero di collezioni, deciso da una persona.
//
// «Natale», «San Valentino», «Matrimoni»: un nome a cui si assegnano le
// collezioni che si vogliono, anche di negozi diversi. **Nessun criterio
// automatico** — a differenza delle tipologie, che si definiscono per criteri
// sui prodotti, qui la scelta è tutta umana: serve a ritrovare le collezioni
// che vanno insieme e a lavorarci sopra in blocco.
//
// Una collezione può stare in **più temi** (Natale *e* Regali per lei), quindi
// la relazione è molti-a-molti: è la differenza con la tipologia, che è una sola.
model TemaCollezioni {
  id           String   @id @default(cuid())
  nome         String   @unique
  descrizione  String?
  collezioni   CollezioneShopify[]
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt
}

// Una **regola d'ordine salvata**: si scrive una volta, ha un nome e si riusa.
//
// Prima l'ordine si poteva esprimere solo con le sei metriche fisse
// (best_seller, ricavo, novita, margine, prezzo_*), da riscegliere ogni volta
// collezione per collezione. Qui una regola è una **sequenza di passi in
// priorità**: il primo decide, i successivi spezzano i pareggi. Un passo può
// essere una metrica oppure un **attributo del prodotto** (categoria, tipo del
// negozio, fornitore, linea, tag, risposta al bisogno, prezzo), e in quel caso
// **porta in cima chi corrisponde** senza togliere nessuno dalla fila.
// I passi stanno in JSON, vedi src/lib/regole-ordine.ts.
model RegolaOrdine {
  id           String   @id @default(cuid())
  nome         String   @unique
  descrizione  String?
  // **Ogni quanti giorni la fila si rimescola dentro i gruppi della regola.**
  // Le condizioni restano le stesse — cambia **chi di quel gruppo sta davanti**,
  // perche' una vetrina in cui i primi sono sempre gli stessi smette di essere
  // guardata. null/0 = ferma.
  rotazioneGiorni Int?
  passi           String   @default("[]")
  collezioni   CollezioneShopify[]
  tipologie    TipologiaCollezione[]
  creataIl     DateTime @default(now())
  aggiornataIl DateTime @updatedAt
}

// Una **tipologia di collezione**: un'etichetta editoriale nostra (Bouquet,
// Torte, Occasioni…) che raggruppa collezioni di negozi diversi e porta una
// **regola d'ordine standing**. Si imposta la regola una volta sola sulla
// tipologia e vale per tutte le collezioni che le assegni; si riapplica da sola
// a ogni import (i prodotti nuovi si sistemano da soli). È la "regola per
// tipologia estesa a più collezioni".
model TipologiaCollezione {
  id           String   @id @default(cuid())
  nome         String   @unique
  descrizione  String?
  // **I criteri che dicono quali prodotti sono di questa tipologia**: «Lusso» =
  // fasce alte, «Linea rose» = quella linea, «Originale» = quel tipo di prodotto.
  // JSON (vedi src/lib/criteri-tipologia.ts): dentro un criterio i valori valgono
  // in alternativa (una qualsiasi), fra criteri diversi valgono tutti insieme.
  // Vuoto = nessun criterio, la tipologia non seleziona niente da sola.
  criteri      String?
  // La regola d'ordine standing, dalle chiavi di src/lib/ordinamento-vetrina.ts
  // (best_seller, ricavo, novita, margine, prezzo_*, manuale). null/"manuale" =
  // nessuna regola automatica, l'ordine si cura a mano collezione per collezione.
  regolaOrdinamento String?
  // La regola salvata, se la tipologia ne usa una: vince su `regolaOrdinamento`.
  regolaOrdineId String?
  regolaOrdine   RegolaOrdine? @relation(fields: [regolaOrdineId], references: [id], onDelete: SetNull)
  collezioni   CollezioneShopify[]
  creataIl     DateTime @default(now())
  aggiornataIl DateTime @updatedAt
}

model ProdottoInCollezioneShopify {
  id           String            @id @default(cuid())
  collezioneId String
  collezione   CollezioneShopify @relation(fields: [collezioneId], references: [id], onDelete: Cascade)
  prodottoId   String
  prodotto     Prodotto          @relation(fields: [prodottoId], references: [id], onDelete: Cascade)
  // L'ordine curato del prodotto dentro questa collezione: è quello che si
  // spinge su Shopify (collectionReorderProducts). 0 finché non lo si ordina.
  // Chi ha messo qui questo prodotto: "regola" se ce l'ha portato l'aggiunta
  // automatica, "manuale" per tutti gli altri — quelli arrivati dall'import di
  // Shopify e quelli aggiunti a mano da una persona. Serve a **distinguere a
  // vista** cosa e' una scelta di qualcuno da cosa e' conseguenza della regola:
  // senza, riapplicando la regola non si sa piu' cosa si sta per sovrascrivere.
  origine   String @default("manuale")
  posizione Int               @default(0)
  // Il GID Shopify del prodotto su questo negozio (gid://shopify/Product/…):
  // serve per riordinare su Shopify, che ragiona per id suoi. Salvato all'import.
  prodottoShopifyId String?

  @@unique([collezioneId, prodottoId])
  @@index([collezioneId, posizione])
  @@index([prodottoId])
}

// Il registro delle **categorie viste sui negozi**: la tassonomia standard di
// Shopify e i «tipi prodotto» scritti a mano da chi cura il sito.
//
// Sta separato dalle nostre `CategoriaProdotto` per la stessa ragione per cui
// le collezioni Shopify stanno separate dalle collezioni di maison: una si
// legge dal negozio, l'altra la decidiamo noi. Questo elenco è la materia
// prima con cui — a mano o con l'AI — si costruisce la corrispondenza.
model CategoriaShopify {
  id           String   @id @default(cuid())
  // "tassonomia" = categoria standard Shopify; "tipo" = productType libero.
  origine      String   @default("tassonomia")
  chiave       String // gid della tassonomia, oppure il testo del tipo
  nome         String // nome corto
  nomeCompleto String? // il percorso completo nell'albero, se c'è
  prodotti     Int      @default(0) // quanti prodotti nostri ce l'hanno
  negozi       String? // su quali negozi è stata vista, separati da virgola
  // A quale categoria nostra corrisponde, quando qualcuno lo decide.
  categoriaDeluxy String?
  vistaIl      DateTime @updatedAt

  @@unique([origine, chiave])
  @@index([origine])
}

// Chiave API con cui le altre app Deluxy leggono da qui.
//
// Nel database resta solo lo SHA-256: la chiave si vede una volta sola, quando
// si crea. Stesso schema di deluxy-orders e deluxy-anagrafiche, così chi
// integra trova sempre lo stesso meccanismo.
model ApiKey {
  id        String    @id @default(cuid())
  nome      String    @unique // a chi è stata data: "deluxy-marketing"…
  hash      String    @unique
  attiva    Boolean   @default(true)
  ultimoUso DateTime?
  creataIl  DateTime  @default(now())
}

// Storico degli import delle collezioni da Shopify.
model ImportCollezioni {
  id            String   @id @default(cuid())
  iniziatoIl    DateTime @default(now())
  negozio       String
  collezioniLette Int    @default(0)
  prodottiLetti Int      @default(0)
  abbinamenti   Int      @default(0)
  // Schede nate da questo import: prodotti che il negozio ha e qui non c'erano.
  prodottiCreati Int     @default(0)
  prodottiIgnoti Int     @default(0)
  esito         String   @default("ok")
  messaggio     String?

  @@index([iniziatoIl])
}

// Una riga venduta, al giorno in cui è stata venduta. È il fatto elementare su
// cui poggiano trend e ipotesi di ordinativo.
//
// La fonte è il registro centralizzato Deluxy Orders (che a sua volta legge
// Shopify): qui NON si vende nulla, si legge il venduto. Le righe che non si
// riescono ad abbinare a un prodotto di questa app restano comunque salvate con
// `prodottoId` nullo — spariscono dai trend per prodotto ma non dai totali, e la
// pagina Vendite le elenca perché qualcuno le mappi. Inventare un abbinamento
// sarebbe peggio: un riordino calcolato sul prodotto sbagliato è un ordine
// sbagliato al fornitore.
model Vendita {
  id         String    @id @default(cuid())
  data       DateTime // giorno della vendita (mezzanotte)
  prodottoId String?
  prodotto   Prodotto? @relation(fields: [prodottoId], references: [id], onDelete: SetNull)
  varianteId String?
  variante   Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  // Da quale scheda veniva questa riga prima di una **riconciliazione**. Serve a
  // una cosa sola: poter separare due prodotti uniti per sbaglio rimettendo
  // esattamente le righe che erano state spostate. Senza questo campo l'unione
  // sarebbe irreversibile, e un'operazione irreversibile su dati veri non si fa
  // con un bottone.
  prodottoOriginaleId String?
  titolo     String // titolo della riga così come arriva dal canale
  // Nome della variante scelta dal cliente ("40 rose", "Medium"): è la parola
  // del negozio, l'unica leggibile quando lo SKU è un codice cieco tipo ICQLBN-2.
  varianteNome String?
  sku        String?
  canale     String    @default("shopify") // brand/negozio di origine
  // Stato dell'ordine da cui viene la riga, come lo dà Shopify tramite Orders.
  // Serve a distinguere una vendita andata a buon fine da una rimborsata o mai
  // pagata: senza questi due campi le classifiche premierebbero prodotti che
  // hanno solo generato resi.
  statoPagamento String? // PAID | PENDING | PARTIALLY_PAID | REFUNDED | PARTIALLY_REFUNDED | VOIDED
  statoEvasione  String? // FULFILLED | UNFULFILLED | PARTIALLY_FULFILLED | RESTOCKED
  quantita   Int       @default(1)
  ricavo     Float     @default(0) // prezzo unitario x quantità
  origine    String    @default("orders") // orders | demo | manuale
  // **Dove è andata a finire**: la provincia e il paese di *spedizione*
  // dell'ordine, letti da Orders (`spedizione.provincia`, `spedizione.paese`).
  //
  // Tre scelte, tutte deliberate:
  // 1. si prende la **provincia**, non la città: le città sono migliaia e ogni
  //    riga farebbe gruppo a sé, mentre la provincia dà un centinaio di gruppi
  //    su cui un confronto fra periodi ha senso statistico;
  // 2. si legge `spedizione.*` e **mai `cittaDedotta`**, che in Orders è
  //    dichiaratamente ricavata dal testo — un'area sbagliata sposterebbe
  //    fatturato da un pezzo d'Italia a un altro senza che nessuno se ne accorga;
  // 3. si tiene solo il livello **provincia/paese** e non l'indirizzo: qui serve
  //    a raggruppare del venduto, e un dato personale che non serve non si copia.
  provinciaSpedizione String?
  paeseSpedizione     String?
  // Chiave di deduplica dell'import: "<idOrdine>#<indiceRiga>". Le righe di
  // Orders non hanno un id proprio, quindi la posizione fa da identità.
  riferimento String?  @unique
  creataIl   DateTime  @default(now())

  @@index([data])
  @@index([prodottoOriginaleId])
  @@index([prodottoId, data])
  @@index([varianteId, data])
  @@index([origine])
  // Il **brand** è il canale della vendita: ci passa ogni filtro d'ambito
  // (`filtroVendite`) e l'elenco dei brand disponibili (distinct su canale).
  // Senza indice erano scansioni piene su tutto il venduto, a ogni pagina.
  @@index([canale])
  @@index([canale, data])
  // `FILTRO_BUON_FINE` (statoPagamento in PAID/PARTIALLY_PAID) sta in quasi ogni
  // conto di vendita: classifiche, trend, riordino, assortimento.
  @@index([statoPagamento, data])
  // La scomposizione «da cosa viene la differenza» raggruppa per area su due
  // periodi affiancati: senza indice è una scansione piena del venduto.
  @@index([provinciaSpedizione])
}

// Storico delle importazioni dal registro ordini: quando, quanto, com'è andata.
model ImportVendite {
  id            String   @id @default(cuid())
  iniziatoIl    DateTime @default(now())
  dal           DateTime
  al            DateTime
  ordiniLetti   Int      @default(0)
  righeLette    Int      @default(0)
  righeNuove    Int      @default(0)
  righeAbbinate Int      @default(0)
  // Righe **già in archivio** a cui è cambiato lo stato dell'ordine: importate
  // ieri come non pagate e incassate oggi, o rimborsate dopo. Contate a parte da
  // `righeNuove` perché non sono venduto nuovo, è venduto che ha cambiato
  // verdetto — e senza questo passaggio resterebbero per sempre com'erano al
  // primo import, cioè `FILTRO_BUON_FINE` deciderebbe su stati fossili.
  righeAggiornate Int    @default(0)
  // Chi ha lanciato l'import: `false` = qualcuno ha premuto il bottone,
  // `true` = il giro notturno. Serve a dire in pagina se il venduto si aggiorna
  // da solo o soltanto quando qualcuno se ne ricorda.
  automatico    Boolean  @default(false)
  esito         String   @default("ok") // ok | errore
  messaggio     String?

  @@index([iniziatoIl])
}

// Un'ipotesi di ordinativo congelata: i parametri con cui è stata calcolata
// restano dentro il piano, altrimenti a distanza di giorni non si capisce più
// perché proponeva quelle quantità.
model PianoRiordino {
  id                 String         @id @default(cuid())
  nome               String
  stato              String         @default("bozza") // bozza | confermato | archiviato
  // Ambito con cui è stata calcolata: null = tutti i brand. Congelarlo serve
  // quanto congelare i parametri: un'ipotesi fatta sul solo Flowers non si
  // rilegge come se valesse per tutti i negozi.
  canale             String?
  giorniStorico      Int            @default(56) // finestra di vendite osservata
  leadTimeGiorni     Int            @default(7) // quanto ci mette il fornitore
  coperturaGiorni    Int            @default(21) // quanti giorni deve coprire l'ordine
  scortaSicurezzaPct Int            @default(20)
  note               String?
  righe              RigaRiordino[]
  creatoIl           DateTime       @default(now())
  aggiornatoIl       DateTime       @updatedAt

  @@index([stato])
}

model RigaRiordino {
  id                String        @id @default(cuid())
  pianoId           String
  piano             PianoRiordino @relation(fields: [pianoId], references: [id], onDelete: Cascade)
  prodottoId        String?
  prodotto          Prodotto?     @relation(fields: [prodottoId], references: [id], onDelete: SetNull)
  varianteId        String?
  variante          Variante?     @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  descrizione       String // nome congelato: "Bouquet Ora Blu · Deluxe"
  venditeGiorno     Float         @default(0) // ritmo di vendita usato nel calcolo
  giacenza          Int           @default(0)
  coperturaGiorni   Float         @default(0) // giorni coperti dalla giacenza attuale
  quantitaSuggerita Int           @default(0)
  quantitaScelta    Int           @default(0) // quella decisa dall'operatore
  costoUnitario     Float         @default(0)
  prezzoUnitario    Float         @default(0)
  confidenza        String        @default("media") // alta | media | bassa
  motivo            String? // la frase che spiega la quantità

  @@index([pianoId])
}

// Lettura AI del trend, storicizzata: si conserva anche il pacchetto di numeri
// dato al modello, così la lettura resta verificabile a mesi di distanza.
model LetturaTrend {
  id        String   @id @default(cuid())
  creataIl  DateTime @default(now())
  dal       DateTime
  al        DateTime
  modello   String
  sintesi   String
  contenuto String // JSON: osservazioni, azioni, domande aperte
  dati      String // JSON: i numeri passati al modello

  @@index([creataIl])
}
