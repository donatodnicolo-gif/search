// Deluxy Marketing — schema dati
// La memoria operativa dell'advertising Deluxy: qui si depositano le analisi
// e gli audit prodotti dalle sessioni Claude (custode e progetti brand), le
// azioni che ne derivano — con storia completa e feedback — e le campagne con
// le loro metriche. La FONTE DI VERITÀ documentale resta la cartella Google
// Drive "ADV DELUXY SRL": l'app la indicizza (DocumentoDrive) e non la scrive.
//
// Postgres condiviso delle app Deluxy (stesso cluster di hub/anagrafiche),
// schema "marketing". In locale si può restare su SQLite cambiando provider
// e url: lo schema è compatibile con entrambi (niente enum né array, gli
// stati sono stringhe normalizzate con cataloghi in src/lib/dominio.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) in produzione
  directUrl = env("DIRECT_URL") // connessione diretta per migrazioni e db push
}

// Un'analisi depositata: audit Google/Meta, analisi performance, revisione
// creativi o landing, report settimanale… La sintesi è testo/markdown; il
// documento completo vive su Drive (fileDrive = percorso relativo).
model Analisi {
  id           String   @id @default(cuid())
  // catalogo TIPI_ANALISI in dominio.ts: audit_google | audit_meta | analisi_performance |
  // revisione_creativi | revisione_landing | report_settimanale | analisi_pubblici | analisi | altro
  tipo         String   @default("analisi")
  titolo       String
  // catalogo BRANDS: flowers | cake | gifts | cross
  brand        String   @default("cross")
  // catalogo CANALI: google_ads | meta_ads | email | sito | seo | crm | social | altro
  canale       String?
  // Sintesi operativa (markdown semplice): cosa è emerso, in breve.
  sintesi      String
  // ok | attenzione | critico — il "semaforo" dell'analisi
  esito        String?
  // Percorso del documento completo dentro "ADV DELUXY SRL" (relativo alla cartella)
  fileDrive    String?
  dataAnalisi  DateTime @default(now())
  // chi ha depositato: claude_code | custode | manuale | demo
  origine      String   @default("claude_code")
  note         String?
  azioni       Azione[]
  creataIl     DateTime @default(now())
  aggiornataIl DateTime @updatedAt

  @@index([brand])
  @@index([tipo])
  @@index([dataAnalisi])
}

// Un'azione operativa (task): nasce da un'analisi, da un piano su Drive o a
// mano. Gli stati ricalcano i gemelli dei piani: todo | in_corso | fatta |
// superata | bloccata. La storia completa vive in EventoAzione.
model Azione {
  id            String         @id @default(cuid())
  titolo        String
  descrizione   String?
  brand         String         @default("cross")
  canale        String?
  stato         String         @default("todo")
  // alta | media | bassa
  priorita      String         @default("media")
  // chi deve eseguirla: ai | utente
  owner         String         @default("ai")
  scadenza      DateTime?
  // Com'è andata a finire (compilato alla chiusura)
  esito         String?
  // Change control (doc 11): L0 osservazione · L1 leggera · L2 significativa · L3 strutturale
  livello       String?
  // Piano di rollback obbligatorio per L2/L3 su campagne traino
  rollbackPiano String?
  // Chiusura a doppio stato (00.3): FATTO con paper-trail, poi VERIFICATA o RIAPERTA
  prima         String?
  dopo          String?
  fattoIl       DateTime?
  verificataIl  DateTime?
  esitoVerifica String?
  riaperture    Int            @default(0)
  // Riferimento al gemello/piano su Drive da cui proviene, se c'è
  fileDrive     String?
  analisiId     String?
  analisi       Analisi?       @relation(fields: [analisiId], references: [id], onDelete: SetNull)
  campagnaId    String?
  campagna      Campagna?      @relation(fields: [campagnaId], references: [id], onDelete: SetNull)
  eventi        EventoAzione[]
  creataIl      DateTime       @default(now())
  aggiornataIl  DateTime       @updatedAt

  @@index([stato])
  @@index([brand])
  @@index([scadenza])
}

// La storia di un'azione: creazione, cambi di stato, feedback e note.
// È il registro che rende l'app la memoria delle decisioni prese.
model EventoAzione {
  id       String   @id @default(cuid())
  azioneId String
  azione   Azione   @relation(fields: [azioneId], references: [id], onDelete: Cascade)
  // creazione | stato | feedback | nota
  tipo     String
  // per tipo "stato": da → a
  da       String?
  a        String?
  testo    String?
  // chi scrive: utente | claude_code | custode | sistema
  autore   String   @default("utente")
  creatoIl DateTime @default(now())

  @@index([azioneId])
}

// Una campagna pubblicitaria (Google, Meta, email…): il registro vivo con
// stato, budget e obiettivo. Le metriche giornaliere stanno in MetricaCampagna.
model Campagna {
  id                String                 @id @default(cuid())
  nome              String
  // Il nome che le diamo NOI, per leggerla. "[Deluxy] - Fiori Milano ENG" è
  // la chiave con cui l'import la ritrova e non si tocca mai: qui ci si può
  // scrivere "Fiori Milano — inglese". Se c'è comanda a schermo, e il nome di
  // Google resta accanto, perché è quello che si cerca in interfaccia.
  // Gemello di `Gruppo.nomeVisibile`, stessa idea di `stato` contro
  // `statoPiattaforma`: la nostra parola e il fatto non si sovrascrivono.
  nomeVisibile      String?
  brand             String                 @default("flowers")
  // ⚠️ Il brand deciso A MANO non si tocca più, come `origine: "manuale"` sul
  // legame Shopify. Senza questo, una sync mirata su un account rimetteva il
  // brand dell'account e la correzione durava fino al giro dopo.
  brandManuale      Boolean                @default(false)
  // L'account pubblicitario su cui la campagna gira DAVVERO (248-656-1148,
  // 1040175814157216…), scritto dall'import che l'ha vista.
  //
  // ⚠️ Senza, «di chi è questa campagna» era una DEDUZIONE — dal nome o dal
  // brand dell'ultima sync che l'aveva toccata — e quando sbagliava non c'era
  // modo di accorgersene. Caso reale (09/08/2026): `[Palloncini] - AWARENESS`
  // risultava di Cake con 1.137,67 € di spesa attribuiti, e sul conto Meta di
  // Cake quella campagna non esiste. L'account è un fatto, il brand è la sua
  // conseguenza: tenere solo la conseguenza rende l'errore invisibile.
  account           String?
  canale            String                 @default("google_ads")
  // bozza | in_apprendimento | attiva | in_pausa | conclusa | in_lancio | defunta
  // ⚠️ È il GIUDIZIO nostro. L'import lo aggiorna solo quando NON è uno degli
  // stati nostri (vedi STATI_CAMPAGNA_NOSTRI): «defunta» decisa a mano non
  // deve tornare «in_pausa» al giro dopo.
  stato             String                 @default("attiva")
  // Cosa dice Google, sempre e comunque: ENABLED | PAUSED | REMOVED.
  // Gemello di `Gruppo.statoPiattaforma`. Serve a non perdere il fatto quando
  // il giudizio nostro lo copre — una campagna può essere «defunta» per noi e
  // ancora accesa su Google, ed è esattamente il caso da vedere.
  statoPiattaforma  String?
  // classe di protezione (doc 11): traino | standard | sperimentale
  classe            String                 @default("standard")
  obiettivo         String?
  budgetGiornaliero Float?
  // CPA target per pacing e regole se/allora (doc 10 §7)
  cpaTarget         Float?
  // Strategia di offerta letta dalla piattaforma: serve al CHECK OBBLIGATORIO
  // VALORE vs NUMERO delle ISTRUZIONI (dal 16/7/2026). Es. TARGET_ROAS,
  // MAXIMIZE_CONVERSION_VALUE (valore) · TARGET_CPA, MAXIMIZE_CONVERSIONS (numero)
  strategiaOfferta  String?
  // vendite | lead — le campagne B2B/corporate ottimizzano LEAD con valore
  // simbolico (doc 4): giudicarle col ROAS e un errore di lettura. Dedotto
  // dal valore medio per conversione, correggibile a mano.
  tipoConversione   String?
  // Annunci in revisione da oltre 24h: alimenta l alert A4 (doc 11 §4)
  annunciInReview   Int?
  annunciTotali     Int?
  // id della campagna sulla piattaforma esterna (Google/Meta)
  idEsterno         String?
  inizio            DateTime?
  fine              DateTime?
  note              String?
  // landing principale a cui la campagna manda il traffico
  landingId         String?
  landing           LandingPage?           @relation(fields: [landingId], references: [id], onDelete: SetNull)
  metriche          MetricaCampagna[]
  gruppi            Gruppo[]
  localita          LocalitaCampagna[]
  termini           TermineRicerca[]
  segmenti          SegmentoCampagna[]
  azioni            Azione[]
  alert             Alert[]
  modifiche         Modifica[]
  incidenti         Incidente[]
  legameShopify     LegameCampagnaShopify?
  proposteAi        PropostaAi[]
  creataIl          DateTime               @default(now())
  aggiornataIl      DateTime               @updatedAt

  @@index([brand])
  @@index([stato])
}

// Il gruppo di annunci: il livello dove si decide davvero. Due gruppi della
// stessa campagna possono avere rese opposte e la media di campagna li nasconde
// entrambi. Ha le sue metriche giornaliere, esattamente come una campagna.
// Per le Performance Max, che gruppi di annunci non ne hanno, qui stanno i
// gruppi di ASSET: stesso livello, stessa lettura (tipo = asset_group_pmax).
model Gruppo {
  id               String          @id @default(cuid())
  // Il nome che il gruppo ha SU GOOGLE. Non si tocca: è anche la chiave con
  // cui l'import lo ritrova quando manca l'id di piattaforma
  // (ingest-gruppi.ts, findFirst per campagna+nome). Cambiarlo qui vorrebbe
  // dire che al giro dopo Google ne crea un altro.
  nome             String
  // Il nome che gli diamo NOI, per leggerlo. "Fiori a Domicilio + località
  // d'interesse" dice tutto e non si legge; qui ci si può scrivere "Fiori
  // Milano - generiche". Se c'è, comanda in ogni elenco; il nome di Google
  // resta visibile sotto, perché è quello che si cerca in interfaccia.
  // Stessa idea di `stato` contro `statoPiattaforma`: la nostra parola e il
  // fatto della piattaforma non sono la stessa cosa e non si sovrascrivono.
  nomeVisibile     String?
  campagnaId       String
  campagna         Campagna        @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  canale           String          @default("google_ads")
  // Copiato dalla campagna: serve a filtrare e a leggere il ROAS col
  // break-even giusto senza risalire ogni volta alla campagna.
  brand            String          @default("cross")
  // ⚠️ La lingua VERA di quello che si compra: ita | eng | fra.
  //
  // Sta qui e non sulla campagna perché è qui che è una cosa sola. Una campagna
  // può servire due pubblici insieme — «Gifts Milano» con un gruppo «Regali in
  // Italiano» e uno «Regali Inglese» — e la sua dichiarazione di lingua è al
  // plurale apposta. Il gruppo invece parla una lingua e basta: è il livello a
  // cui gli annunci sono scritti, e quindi quello a cui la domanda ha una
  // risposta secca.
  //
  // Vuoto = si deduce dal nome del gruppo, e se il nome non lo dice, dalla
  // campagna. Scritto = l'ha deciso una persona e nessuna deduzione lo tocca.
  lingua           String?
  // Id sulla piattaforma, con dentro l'account perché tre account possono
  // avere gli stessi numeri: "825-518-1560:12345" (gruppo di annunci) oppure
  // "825-518-1560:ag:678" (gruppo di asset di una PMax).
  idEsterno        String?
  // search_standard | search_dynamic_ads | asset_group_pmax | …
  tipo             String?
  // Stato deciso QUI dall'utente: attivo | vincente | da_valutare | in_pausa | escluso.
  // Non viene mai sovrascritto dall'import, come per le keyword.
  stato            String          @default("attivo")
  // Stato reale sulla piattaforma: ENABLED | PAUSED
  statoPiattaforma String?
  note             String?
  metriche         MetricaGruppo[]
  operazioni       OperazioneAdv[]
  creatoIl         DateTime        @default(now())
  aggiornatoIl     DateTime        @updatedAt

  @@unique([canale, idEsterno])
  @@index([campagnaId])
  @@index([brand])
  bozzaAnnuncio    BozzaAnnuncio?
}

// Snapshot giornaliero di un gruppo. Gemello di MetricaCampagna: stessa forma,
// stesso upsert per (gruppo, giorno), così le due letture si sommano e si
// confrontano senza conversioni.
model MetricaGruppo {
  id          String   @id @default(cuid())
  gruppoId    String
  gruppo      Gruppo   @relation(fields: [gruppoId], references: [id], onDelete: Cascade)
  data        DateTime
  spesa       Float?
  impression  Int?
  click       Int?
  conversioni Float?
  ricavi      Float?
  creataIl    DateTime @default(now())

  @@unique([gruppoId, data])
  @@index([data])
}

// Snapshot giornaliero dei KPI di una campagna: alimenta le dashboard.
// Upsert per (campagna, giorno): rimandare gli stessi dati non duplica.
model MetricaCampagna {
  id               String   @id @default(cuid())
  campagnaId       String
  campagna         Campagna @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  data             DateTime
  spesa            Float?
  impression       Int?
  click            Int?
  conversioni      Float?
  ricavi           Float?
  // Quota impressioni (0-1): la domanda "quanto altro ci sarebbe da prendere".
  // persaBudget e persaRank dicono PERCHÉ non la si prende: soldi finiti o
  // posizione insufficiente. Sono due strade opposte, confonderle costa.
  quotaImpressioni Float?
  persaBudget      Float?
  persaRank        Float?
  creataIl         DateTime @default(now())

  @@unique([campagnaId, data])
  @@index([data])
}

// Indice (sola lettura) della cartella Drive "ADV DELUXY SRL" sincronizzata
// in locale con Google Drive per Desktop. L'app NON scrive mai su Drive:
// legge e indicizza per rendere i documenti cercabili e collegabili.
model DocumentoDrive {
  id              String   @id @default(cuid())
  // percorso relativo alla radice della cartella ufficiale, con "/"
  percorso        String   @unique
  nome            String
  cartella        String
  estensione      String
  // flowers | cake | gifts | cross | pubblici | performance | altro
  brand           String   @default("altro")
  // definitivi | analisi | piani | audit | archivio | pubblici | creativita | seo | altro
  categoria       String   @default("altro")
  dimensione      Int      @default(0)
  modificatoIl    DateTime
  sincronizzatoIl DateTime @default(now())

  @@index([brand])
  @@index([categoria])
  @@index([modificatoIl])
}

// Chiavi API per le sessioni Claude (custode, progetti brand) e le altre app.
// Nel database c'è solo lo SHA-256; si creano con `npm run chiave -- <nome>`.
model ApiKey {
  id        String    @id @default(cuid())
  nome      String
  hash      String    @unique
  scrittura Boolean   @default(true)
  attiva    Boolean   @default(true)
  creataIl  DateTime  @default(now())
  ultimoUso DateTime?
}

// ============ Monitoraggio (import da "Monitoraggio 2026.xlsx") ============

// Vendite e budget ADV mensili per sito (foglio "SALES GLOBAL 26 - REVISED").
model VenditaMensile {
  id        String   @id @default(cuid())
  anno      Int
  mese      Int // 1-12
  // gifts (deluxy.it) | cake (cakedesign.me) | flowers (deluxyflowers.com)
  sito      String
  vendite   Float?
  b2b       Float?
  eventi    Float?
  totale    Float?
  budgetAdv Float?
  quotaAnno Float?
  creataIl  DateTime @default(now())

  @@unique([anno, mese, sito])
}

// Budget ADV mensile con ripartizione per canale/campagna (foglio "Budget adv").
model BudgetMensile {
  id              String   @id @default(cuid())
  anno            Int
  mese            Int
  sito            String
  venditaPrevista Float?
  ros             Float?
  budgetMese      Float?
  budgetGiorno    Float?
  // JSON { voce: { quota, giorno } } — es. "Fiori Milano ita": { quota: 0.3, giorno: 16.4 }
  ripartizione    String?
  creataIl        DateTime @default(now())

  @@unique([anno, mese, sito])
}

// Settimana di marketing (fogli 2026/2025 e Deluxy/Flowers/CakeDM):
// il cuore del confronto anno su anno.
model SettimanaMkt {
  id           String   @id @default(cuid())
  anno         Int
  inizio       DateTime // primo giorno della settimana
  // totale | gifts | flowers | cake
  scope        String
  google       Float?
  meta         Float?
  totaleMkt    Float?
  vendite      Float?
  margine      Float?
  risultato    Float?
  ordini       Int?
  mediaOrdine  Float?
  costoConv    Float?
  nuoviClienti Int?
  // riga AZIONI del foglio: cosa è successo quella settimana
  note         String?
  creataIl     DateTime @default(now())

  @@unique([anno, inizio, scope])
  @@index([scope])
}

// ============ Copy & annunci ============

// Un asset di copy: titolo/descrizione RSA, primary text Meta, keyword…
model CopyAnnuncio {
  id               String    @id @default(cuid())
  brand            String
  canale           String    @default("google_ads")
  campagna         String
  gruppo           String?
  lingua           String? // it | en | fr | es
  // titolo | descrizione | primary_text | headline_meta | keyword | sitelink | nota | altro
  tipo             String
  posizione        Int?
  testo            String
  caratteri        Int?
  finalUrl         String?
  // Copy: attivo | bozza | in_pausa | da_riscrivere | archiviato
  // Keyword: attiva | da_valutare | in_pausa | negativa | esclusa | vincente
  stato            String    @default("attivo")
  // Nota di lavoro sulla keyword (perché è stata messa in pausa, ecc.)
  notaStato        String?
  // Resa e spesa: dal Monitoraggio o, se collegato, da Google Ads
  incasso          Float?
  spesa            Float?
  // Metriche vive da Google Ads (script giornaliero)
  clic             Int?
  impressioni      Int?
  conversioni      Float?
  punteggioQualita Int?
  // Etichetta di rendimento degli asset RSA: BEST | GOOD | LOW | LEARNING
  rendimento       String?
  // Stato sulla piattaforma (ENABLED/PAUSED): distinto dallo stato deciso qui,
  // che resta una scelta dell'utente e non va mai sovrascritta dall'import.
  statoPiattaforma String?
  // Id del criterio/asset su Google: riconosce la stessa riga nel tempo
  idEsterno        String?
  metricheAl       DateTime?
  // Su QUANTI GIORNI sono calcolati i numeri qui sopra.
  //
  // ⚠️ Senza, l'app non poteva dire su che finestra stava guardando: il
  // riquadro delle keyword aveva «30 giorni» scritto a mano nel codice, e
  // sarebbe diventato una bugia al primo giro con un `GIORNI_COPY` diverso —
  // cioè esattamente quello che fa un caricamento storico. `metricheAl` dice
  // QUANDO sono stati scritti, questo dice A COSA si riferiscono: due domande
  // diverse. (`TermineRicerca` aveva già `dal`/`al`; qui mancava.)
  metricheGiorni   Int?
  fonte            String?
  // Livello a cui l'asset è agganciato: account | campagna | gruppo
  livello          String?
  // Per le immagini: URL dell'anteprima
  anteprima        String?
  // Gli ID degli ANNUNCI che usano questo testo, separati da virgola.
  // ⚠️ Serve a rimettere insieme gli annunci uno per uno: l'app riceve i testi
  // ACCORPATI (lo stesso titolo sta in più annunci, e tenerne una riga per
  // annuncio moltiplicherebbe le righe e i numeri), quindi senza questo elenco
  // non c'è modo di sapere quali 15 titoli stavano insieme nello stesso
  // annuncio. Si riempie dal giro `copy` dello script aggiornato al
  // 07/08/2026: sulle righe più vecchie resta vuoto.
  annunci          String?
  note             String?
  creataIl         DateTime  @default(now())
  aggiornataIl     DateTime  @updatedAt

  @@index([brand, campagna])
}

// ============ Test Meta (backlog pianificabile in anticipo) ============

model TestMeta {
  id                String    @id @default(cuid())
  titolo            String
  brand             String    @default("cross") // flowers | cake | gifts | cross
  // A | I | D | X | retention | trasversale (fase AIDA)
  fase              String?
  ipotesi           String
  variabile         String? // hook, seed pubblico, struttura ad set, finestra, formato…
  pubblico          String?
  formato           String?
  metricaSuccesso   String? // costo LPV, costo ATC, ROAS vs break-even…
  guardrail         String?
  budgetGiornaliero Float?
  dataInizio        DateTime?
  dataVerifica      DateTime?
  // idea | pianificato | in_corso | concluso | promosso | respinto
  stato             String    @default("idea")
  esito             String?
  lezione           String?
  fonte             String? // documento di provenienza (es. 8.3)
  note              String?
  creataIl          DateTime  @default(now())
  aggiornataIl      DateTime  @updatedAt

  @@index([stato])
  @@index([brand])
}

// ============ Landing page ============

// Registro delle landing: configurazione (la 00.4 del Drive resta il canonico;
// qui lo schema navigabile con campagne associate e performance).
model LandingPage {
  id           String             @id @default(cuid())
  url          String             @unique // path completo, es. deluxyflowers.com/pages/…
  nome         String?
  brand        String             @default("cross")
  lingua       String? // it | en | fr | es
  // dedicata | collection | pdp | home | lead
  tipo         String?
  scopo        String?
  gemellaUrl   String? // versione IT<->EN
  // attiva | mismatch | da_verificare | dismessa
  stato        String             @default("attiva")
  verificataIl DateTime?
  scorecard    Int? // voto /100 (guida 9.2)
  note         String?
  campagne     Campagna[]
  metriche     MetricaLanding[]
  scorecards   LandingScorecard[]
  creataIl     DateTime           @default(now())
  aggiornataIl DateTime           @updatedAt

  @@index([brand])
}

// Performance di una landing in un periodo (es. "2026-07" o "2026-W29").
model MetricaLanding {
  id               String      @id @default(cuid())
  landingId        String
  landing          LandingPage @relation(fields: [landingId], references: [id], onDelete: Cascade)
  periodo          String
  canale           String? // google_ads | meta_ads | organico | totale
  clic             Int?
  costo            Float?
  sessioni         Int?
  conversioni      Float?
  ricavi           Float?
  tassoConversione Float?
  note             String?
  creataIl         DateTime    @default(now())

  @@unique([landingId, periodo, canale])
}

// ============ Storico (registro globale delle modifiche) ============

// Ogni scrittura nell'app lascia una voce qui: il gemello digitale
// dello "00.2 Registro Modifiche" del Drive.
model RegistroEvento {
  id        String   @id @default(cuid())
  creatoIl  DateTime @default(now())
  autore    String   @default("utente") // utente | chiave API | sistema | import
  // creazione | modifica | stato | feedback | import | sync
  tipo      String
  // analisi | azione | campagna | metrica | landing | copy | test_meta | drive | vendite | budget | settimana
  entita    String
  entitaId  String?
  titolo    String
  dettaglio String?

  @@index([creatoIl])
  @@index([entita])
}

// ============ Pubblici (CRM & audience) ============

// Un pubblico, una lista o un segmento su una piattaforma pubblicitaria o CRM.
// Il canonico resta la "00.4 Mappa Pubblici e Segmenti" del sistema CRM su
// Drive: qui vive lo specchio navigabile, con la storia delle dimensioni.
model Pubblico {
  id           String           @id @default(cuid())
  nome         String
  // meta | google | tiktok | klaviyo | shopify | altro
  piattaforma  String           @default("meta")
  brand        String           @default("cross")
  // cliente | lookalike | retargeting | interessi | esclusione | segmento | altro
  tipo         String           @default("cliente")
  // ultima dimensione nota (utenti/contatti)
  dimensione   Int?
  // attivo | da_creare | da_verificare | obsoleto | in_aggiornamento
  stato        String           @default("da_verificare")
  verificatoIl DateTime?
  fonte        String? // documento di provenienza su Drive
  note         String?
  misure       MisuraPubblico[]
  creatoIl     DateTime         @default(now())
  aggiornatoIl DateTime         @updatedAt

  @@unique([nome, piattaforma])
  @@index([brand])
  @@index([piattaforma])
}

// Storico della dimensione di un pubblico: i pool si consumano, va visto nel tempo.
model MisuraPubblico {
  id         String   @id @default(cuid())
  pubblicoId String
  pubblico   Pubblico @relation(fields: [pubblicoId], references: [id], onDelete: Cascade)
  data       DateTime
  dimensione Int
  note       String?

  @@unique([pubblicoId, data])
}

// ============ Impostazioni ============

// Impostazioni dell'app in coppie chiave/valore (una riga per voce), così
// una modifica non richiede una migrazione. Es. "drive.cartella".
model Impostazione {
  id           String   @id @default(cuid())
  chiave       String   @unique
  valore       String
  aggiornataIl DateTime @updatedAt
}

// Un account pubblicitario collegato (Google Ads, Meta, TikTok…): serve a
// sapere su quale account agisce ogni campagna e a passarlo alle sessioni
// Claude che eseguono le modifiche.
model AccountAdv {
  id           String   @id @default(cuid())
  nome         String
  // google_ads | meta_ads | tiktok | ga4 | shopify | klaviyo | altro
  piattaforma  String   @default("google_ads")
  // identificativo sulla piattaforma (es. 825-518-1560, act_1040175814157216)
  idEsterno    String
  brand        String   @default("cross")
  attivo       Boolean  @default(true)
  note         String?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@unique([piattaforma, idEsterno])
  @@index([brand])
}

// ============ Ordini (da Shopify) ============

// Un ordine scaricato da uno dei negozi Shopify. Serve a mettere le vendite
// accanto alla spesa pubblicitaria: quanto rende davvero ogni offerta.
model Ordine {
  id          String       @id @default(cuid())
  // negozio di provenienza (handle myshopify o dominio)
  negozio     String
  brand       String       @default("gifts")
  // numero visibile dell'ordine (es. #12581)
  numero      String
  idEsterno   String // id Shopify
  data        DateTime
  totale      Float?
  // valore netto merce (esclusi spedizione e tasse) se disponibile
  netto       Float?
  spedizione  Float?
  sconto      Float?
  valuta      String       @default("EUR")
  // pagato | rimborsato | parzialmente_rimborsato | annullato
  stato       String       @default("pagato")
  cliente     String?
  email       String?
  citta       String?
  // Come si sa la citta: "tag" o "prodotto" se arriva dalla classificazione
  // di Orders, vuoto se e quella scritta dal cliente al checkout.
  cittaFonte  String?
  // Sigla della provincia di consegna (MI, RM, FI): arriva da Orders gia
  // normalizzata, ed e l unico raggruppamento geografico di cui fidarsi —
  // la citta la scrive il cliente e diventa "Roma"/"Rome"/"ROMA".
  provincia   String?
  paese       String?
  // canale di provenienza dichiarato da Shopify/UTM, quando c'è
  origine     String?
  utmSource   String?
  utmCampagna String?
  righe       RigaOrdine[]
  creatoIl    DateTime     @default(now())

  @@unique([negozio, idEsterno])
  @@index([data])
  @@index([brand])
}

// Una riga d'ordine: è il livello a cui si valuta la singola offerta.
model RigaOrdine {
  id        String  @id @default(cuid())
  ordineId  String
  ordine    Ordine  @relation(fields: [ordineId], references: [id], onDelete: Cascade)
  titolo    String
  sku       String?
  vendor    String?
  // tipo prodotto dichiarato su Shopify (Fiori d'Arte, Originali Deluxy, …)
  tipo      String?
  quantita  Int     @default(1)
  prezzo    Float? // prezzo unitario
  totale    Float? // prezzo * quantità al netto degli sconti di riga
  // categoria normalizzata dall'app (fiori, torte, colazioni…)
  categoria String?

  @@index([ordineId])
  @@index([titolo])
  @@index([categoria])
}

// ============ Guardrail e governance (Definitivi 00.3/00.5/10/11) ============

// Alert automatici sulle campagne (doc 11 §4): A1 acquisto muto, A2 erogazione,
// A3 redditività, A5 segnali deboli. Valutati sulle metriche giornaliere.
model Alert {
  id         String   @id @default(cuid())
  campagnaId String
  campagna   Campagna @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  tipo       String // A1 | A2 | A3 | A5
  livello    String // rosso | arancio | giallo
  messaggio  String
  // giorno di riferimento: evita duplicati per lo stesso giorno
  giorno     DateTime
  stato      String   @default("aperto") // aperto | annotato | risolto
  creatoIl   DateTime @default(now())

  @@unique([campagnaId, tipo, giorno])
  @@index([stato])
}

// Storico errori ERR-* (00.5): registro append-only degli incidenti.
// Una voce APERTA mette in freeze gli oggetti che riguarda.
model Incidente {
  id             String    @id @default(cuid())
  codice         String    @unique // ERR-2026-001, mai riusato
  titolo         String
  stato          String    @default("aperto") // aperto | chiuso
  verdetto       String?
  contesto       String?
  timeline       String?
  impatto        String?
  cause          String?
  erroriProcesso String?
  rimedi         String?
  // oggetti coinvolti in testo libero (nomi campagne, liste, documenti)
  oggetti        String?
  campagnaId     String?
  campagna       Campagna? @relation(fields: [campagnaId], references: [id], onDelete: SetNull)
  apertoIl       DateTime  @default(now())
  chiusoIl       DateTime?

  @@index([stato])
}

// Modifiche alle campagne con change control (doc 11 §2-3): livello L0-L3,
// PRIMA/DOPO, rollback. Da qui si calcolano blackout 72h e giudicabilità.
model Modifica {
  id             String   @id @default(cuid())
  campagnaId     String
  campagna       Campagna @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  livello        String   @default("L1") // L0 | L1 | L2 | L3
  descrizione    String
  prima          String?
  dopo           String?
  deltaBudgetPct Float?
  rollbackPiano  String?
  autore         String   @default("utente")
  eseguitaIl     DateTime @default(now())

  @@index([campagnaId])
}

// Memoria condivisa (00.3): lezioni apprese append-only. Le voci non si
// modificano mai: una voce nuova può "superare" una vecchia citandola.
model MemoriaVoce {
  id       String   @id @default(cuid())
  data     DateTime @default(now())
  autore   String   @default("utente")
  // metodo | decisioni | trappole
  sezione  String   @default("metodo")
  brand    String?
  testo    String
  stato    String   @default("attiva") // attiva | storico | consolidata
  superaId String?
  creataIl DateTime @default(now())

  @@index([stato])
}

// Incongruenze documenti ↔ realtà (MODELLO Incongruenze.md), con verdetto.
model Incongruenza {
  id                String    @id @default(cuid())
  progetto          String    @default("app")
  documento         String
  dice              String
  risulta           String
  evidenza          String?
  azioneConsigliata String?
  priorita          String    @default("P1") // P0 | P1 | P2
  stato             String    @default("aperta") // aperta | vera | parziale | respinta | integrata
  creataIl          DateTime  @default(now())
  verdettoIl        DateTime?
}

// Cadenze ricorrenti (doc 5 §8.1, doc 10 §7, ISTRUZIONI PROGETTO):
// checkpoint del lunedì, manutenzione mensile, re-upload liste…
model Cadenza {
  id         String              @id @default(cuid())
  nome       String              @unique
  // settimanale | bisettimanale | mensile | trimestrale | annuale
  frequenza  String
  checklist  String?
  fonte      String?
  attiva     Boolean             @default(true)
  occorrenze CadenzaOccorrenza[]
}

model CadenzaOccorrenza {
  id         String    @id @default(cuid())
  cadenzaId  String
  cadenza    Cadenza   @relation(fields: [cadenzaId], references: [id], onDelete: Cascade)
  prevista   DateTime
  eseguitaIl DateTime?
  esito      String?

  @@unique([cadenzaId, prevista])
}

// Occasioni del gifting (doc 8.2 §3.1, doc 4 §2.2): picchi con finestre calde
// da accorciare a T-21/T-14 e ripristinare a T+7; niente tCPA nei picchi.
model Occasione {
  id       String   @id @default(cuid())
  nome     String
  data     DateTime
  brand    String   @default("cross")
  note     String?
  creataIl DateTime @default(now())

  @@unique([nome, data])
}

// Creativi Meta per la rotazione (doc 8.3): età, fase, stato.
// "I vincenti non si toccano."
model Creativo {
  id         String    @id @default(cuid())
  nome       String
  brand      String    @default("cross")
  // A | ID | X
  fase       String    @default("A")
  // in_coda | attivo | vincente | sostituito | bocciato
  stato      String    @default("in_coda")
  lanciatoIl DateTime?
  note       String?
  creatoIl   DateTime  @default(now())

  @@index([stato])
}

// Scorecard landing 13 criteri /100 (doc 9.2 §10) con pre-check tecnico.
model LandingScorecard {
  id        String      @id @default(cuid())
  landingId String
  landing   LandingPage @relation(fields: [landingId], references: [id], onDelete: Cascade)
  data      DateTime    @default(now())
  // JSON: { criterio: punteggio 0-5 } per i 13 criteri
  criteri   String
  voto      Int
  fascia    String // critica | da_migliorare | buona | eccellente
  note      String?
}

// Copy Score /100 (doc 7 §6.6): 5 criteri pesati + penalità parole tossiche.
model CopyScore {
  id         String   @id @default(cuid())
  brand      String
  testoCopy  String
  // JSON: { attention, interest, desire, action, igiene } 0-5
  criteri    String
  penalita   Int      @default(0)
  score      Int
  giudizio   String // eccellente | buono | sufficiente | da_rifare
  faseDebole String?
  creataIl   DateTime @default(now())
}

// ============ Scrittura verso le piattaforme (coda approvata) ============

// L'app NON scrive mai in diretta su Google Ads. Ogni modifica diventa una
// riga qui, che nasce "in_attesa": va approvata a mano prima che lo script
// la possa prendere. È la traduzione tecnica della regola dei Definitivi
// ("ESEGUE SOLO le azioni esplicitamente approvate", AGENDA PIANI) e del
// change control del doc 11: il guardrail valida PRIMA di creare la riga.
model OperazioneAdv {
  id          String    @id @default(cuid())
  // pausa_campagna | attiva_campagna | budget | pausa_keyword | attiva_keyword |
  // negativa | nuova_keyword | nuova_campagna | pausa_gruppo | attiva_gruppo
  tipo        String
  canale      String    @default("google_ads")
  account     String?
  // Oggetto su cui agire, con l'id di piattaforma quando c'è
  bersaglio   String
  idEsterno   String?
  // Parametri specifici (JSON): es. { "budget": 18.5 } o { "testo": "gratis" }
  parametri   String?
  motivo      String?
  // Cosa ha detto il guardrail quando l'operazione è entrata in coda: una
  // riga per avviso, separate da " · ". Dal 04/08/2026 il change control non
  // BLOCCA più (decisione dell'utente): avvisa, e l'avviso deve arrivare fin
  // qui — è al momento dell'approvazione che serve, non in un messaggio che
  // sparisce col redirect.
  avvisi      String?
  // in_attesa | approvata | eseguita | fallita | annullata
  stato       String    @default("in_attesa")
  livello     String    @default("L1")
  // Stato prima dell'esecuzione: serve al rollback e al paper-trail
  prima       String?
  esito       String?
  richiestaDa String    @default("utente")
  approvataDa String?
  approvataIl DateTime?
  // Da quando può partire. `null` = appena approvata, come è sempre stato.
  //
  // ⚠️ È una data DI PARTENZA, non un orario di esecuzione: l'operazione
  // parte al primo giro utile DOPO quel giorno. Prometterlo al minuto
  // vorrebbe dire promettere qualcosa che dipende dallo scheduler di Google
  // (o da chi preme, su Meta).
  //
  // ⚠️ La rispetta CHI ESEGUE, non solo la schermata: l'endpoint che serve
  // le operazioni allo script e l'esecutore Meta filtrano su questo campo.
  // Una data che vive solo nell'interfaccia è una promessa che il primo giro
  // notturno smentisce.
  daEseguireDal DateTime?
  eseguitaIl  DateTime?
  // «Lo so, è voluto»: quando qualcuno dichiara che la differenza fra ciò che
  // l'app crede e ciò che Google riporta è una SUA decisione, non un guasto.
  //
  // ⚠️ Serve perché la conferma per operazione (17/08/2026) mostra ogni
  // divergenza — ed è il suo mestiere — ma senza un modo di chiuderla una
  // divergenza voluta resta a segnalare per sempre. Un avviso che non si può
  // chiudere si smette di leggere, e allora smette di funzionare anche per
  // quelli veri. Non cancella niente: dice chi ha deciso, quando e perché.
  divergenzaAccettataIl DateTime?
  divergenzaAccettataDa String?
  divergenzaMotivo      String?
  campagnaId  String?
  gruppoId    String?
  gruppo      Gruppo?   @relation(fields: [gruppoId], references: [id], onDelete: SetNull)
  azioneId    String?
  creataIl    DateTime  @default(now())

  @@index([stato])
  @@index([canale])
}

// Ogni consegna di dati verso l'app: chi l'ha mandata (chiave API + account
// della piattaforma), che tipo di dati, quante righe e che periodo coprono.
// Serve a rispondere a "cosa sto ricevendo, da chi, e da quando".
model RicezioneDati {
  id         String    @id @default(cuid())
  fonte      String    @default("google_ads")
  account    String?
  // metriche | copy | asset | approvazioni | operazioni | ordini | altro
  tipo       String
  // Nome del client della chiave API che ha consegnato
  chiave     String?
  righe      Int       @default(0)
  nuove      Int       @default(0)
  aggiornate Int       @default(0)
  scartate   Int       @default(0)
  // Periodo coperto dai dati consegnati
  dal        DateTime?
  al         DateTime?
  campagne   Int       @default(0)
  esito      String    @default("ok")
  ricevutoIl DateTime  @default(now())

  @@index([ricevutoIl])
  @@index([fonte, tipo])
}

// Quello che le persone hanno digitato per davvero, non quello che abbiamo
// comprato: è qui che si vede dove scivolano i soldi (doc 4). Lo stato è una
// scelta dell'utente e l'import non lo sovrascrive mai.
model TermineRicerca {
  id             String    @id @default(cuid())
  campagnaId     String
  campagna       Campagna  @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  gruppo         String?
  testo          String
  // La keyword che l'ha intercettato, con la sua corrispondenza. Se sono state
  // più d'una, qui c'è quella che ci ha speso di più e `keywordDiverse` dice
  // quante erano: i numeri della riga sono la SOMMA di tutte.
  keyword        String?
  corrispondenza String?
  keywordDiverse Int?
  spesa          Float?
  clic           Int?
  impressioni    Int?
  conversioni    Float?
  ricavi         Float?
  // nuovo | pertinente | da_escludere | escluso
  stato          String    @default("nuovo")
  notaStato      String?
  dal            DateTime?
  al             DateTime?
  creatoIl       DateTime  @default(now())
  aggiornatoIl   DateTime  @updatedAt

  @@unique([campagnaId, testo])
  @@index([campagnaId])
}

// Come si spartisce la spesa dentro una campagna: dispositivo, giorno della
// settimana, rete. Una tabella sola per tutti i tagli, così aggiungerne uno
// non richiede una tabella nuova.
model SegmentoCampagna {
  id           String    @id @default(cuid())
  campagnaId   String
  campagna     Campagna  @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  // dispositivo | giorno | rete
  tipo         String
  // MOBILE | DESKTOP | TABLET · MONDAY… · SEARCH | SEARCH_PARTNERS | CONTENT
  valore       String
  spesa        Float?
  clic         Int?
  impressioni  Int?
  conversioni  Float?
  ricavi       Float?
  dal          DateTime?
  al           DateTime?
  aggiornatoIl DateTime  @updatedAt

  @@unique([campagnaId, tipo, valore])
  @@index([campagnaId])
}

// "Aggiorna adesso" premuto nell'app. Gli Script di Google Ads girano DENTRO
// Google e non si possono lanciare da fuori: nessuna API li avvia. Quindi la
// richiesta si mette in coda qui e il primo script che parte — qualunque sia il
// suo lavoro — la vede, la esegue col periodo chiesto e riferisce.
// Per Meta non serve: lì è l'app che va a prendere i dati, subito.
model RichiestaAggiornamento {
  id          String    @id @default(cuid())
  canale      String    @default("google_ads")
  account     String?
  // metriche | copy | gruppi | asset | diagnosi | approvazioni | tutto
  lavoro      String    @default("metriche")
  giorni      Int       @default(7)
  // in_attesa | presa | fatta | scaduta
  stato       String    @default("in_attesa")
  richiestaDa String    @default("utente")
  motivo      String?
  esito       String?
  creataIl    DateTime  @default(now())
  presaIl     DateTime?
  fattaIl     DateTime?

  @@index([stato])
  @@index([canale, account])
}

// Le vendite che ci si aspetta da ogni canale, brand per brand e mese per mese.
// Il Monitoraggio arriva fino al brand ("Gifts venderà 65.000 € a luglio"), ma
// la domanda operativa è un'altra: quanto deve portare Google, quanto Meta,
// quanto arriva da solo. Senza questa riga non si può dire se un canale sta
// mancando l'obiettivo o se è il mercato che va piano.
//
// Si compila a mano nella sezione Budget: è una DECISIONE, non un dato
// importato, e nessun import la sovrascrive.
model VenditaAttesa {
  id           String   @id @default(cuid())
  anno         Int
  mese         Int
  // gifts | flowers | cake
  brand        String
  // google_ads | meta_ads | tiktok | organico | diretto | email | altro
  canale       String
  // Vendite attese dal canale in quel mese
  vendite      Float?
  // Spesa prevista per ottenerle (facoltativa: se c'è, l'app calcola il ROS atteso)
  spesa        Float?
  note         String?
  aggiornatoIl DateTime @updatedAt
  creataIl     DateTime @default(now())

  @@unique([anno, mese, brand, canale])
  @@index([anno, mese])
}

// ============ Legame campagna ↔ vendite Shopify ============

// A quale pezzo del negozio guarda una campagna. Serve a mettere accanto alla
// spesa il venduto DI CONTESTO — non l'attribuzione.
//
// ⚠️ Distinzione che non va persa: l'attribuzione vera è una sola, l'UTM
// scritto sull'ordine (`Ordine.utmCampagna`). Questa tabella è l'altra cosa:
// il prodotto e la lingua DEDOTTI DAL NOME della campagna ("[Deluxy] Torte
// ROMA" → torte, italiano). Dice "mentre questa campagna spendeva, le torte
// hanno venduto tanto così": è contesto utile, ma NON vuol dire che quelle
// vendite arrivino da lì. Le pagine che la usano devono scriverlo.
//
// `origine = manuale` è la correzione fatta a mano dalla scheda campagna: da
// quel momento la deduzione non la tocca più.
model LegameCampagnaShopify {
  id           String   @id @default(cuid())
  campagnaId   String   @unique
  campagna     Campagna @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  // categoria di RigaOrdine: fiori | torte | colazioni | dolci | palloncini | vini | altro
  // null = la campagna non parla di un prodotto solo (brand protection, generiche)
  categoria    String?
  // ita | eng | fra | altro — null se il nome non lo dice
  lingua       String?
  // negozio di Ordine: deluxygifts | deluxyflowers | cakedesignme
  negozio      String?
  // Citta di consegna, dedotta dal nome della campagna ("Torte ROMA" → Roma).
  // Si confronta con la citta DEDOTTA da Orders, non con quella scritta al
  // checkout: "Rome" e "Roma" sono la stessa consegna e come testo no.
  citta        String?
  // dedotto | manuale — manuale vince e non viene mai sovrascritto
  origine      String   @default("dedotto")
  // Perché la deduzione ha scelto così: si mostra in pagina, così si vede
  // subito quando è stata la parola sbagliata del nome a decidere.
  motivo       String?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt

  @@index([categoria])
}

// ============ Proposte dell'AI su keyword e parole cercate ============

// Cosa farebbe l'AI di ogni keyword e di ogni parola cercata, e perché.
//
// ⚠️ È una PROPOSTA, non una decisione: resta qui finché una persona non la
// accetta, e accettarla mette in coda un'operazione da approvare come tutte le
// altre. L'AI non tocca Google — non lo tocca nemmeno l'app.
//
// I numeri su cui la proposta è stata fatta si congelano in `numeri`: una
// proposta riletta fra un mese deve poter dire su cosa era stata fatta,
// altrimenti sembra un giudizio sui numeri di oggi.
model PropostaAi {
  id         String    @id @default(cuid())
  // keyword | termine
  tipo       String
  campagnaId String
  campagna   Campagna  @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  testo      String
  // ideal | specific — vedi CLASSI_PAROLA in lib/proposte-ai.ts
  classe     String?
  // tieni | osserva | alza | abbassa | pausa | escludi | aggiungi
  azione     String
  motivo     String
  // alta | media | bassa: quanta fiducia dichiara l'AI. Con "bassa" la
  // proposta si mostra ma non si offre il bottone per eseguirla.
  fiducia    String    @default("media")
  // I numeri del momento, congelati (JSON breve)
  numeri     String?
  // proposta | accettata | scartata
  stato      String    @default("proposta")
  creataIl   DateTime  @default(now())
  decisaIl   DateTime?

  @@unique([campagnaId, tipo, testo])
  @@index([campagnaId, tipo])
  @@index([classe])
}

// ============ Viste salvate ============

// Un modo di guardare una pagina (filtri + ordinamento + periodo) messo da
// parte con un nome. CONDIVISE: non sono per utente, sono dell'azienda — se
// una vista è quella giusta per guardare le campagne, lo è per tutti.
// `parametri` è la query string così com'è ("brand=gifts&ordina=spesa").
model VistaSalvata {
  id           String   @id @default(cuid())
  // campagne | termini | keywords | brand
  pagina       String
  nome         String
  parametri    String
  // Al massimo una per pagina: aprendo la pagina senza filtri si va lì.
  predefinita  Boolean  @default(false)
  creataIl     DateTime @default(now())
  aggiornataIl DateTime @updatedAt

  @@unique([pagina, nome])
  @@index([pagina])
}

// ============ Stato della sincronizzazione Drive ============

// La sync del Drive attraversa centinaia di file: su Vercel una funzione ha
// pochi secondi e il 28/07/2026 si è fermata a 179 documenti su 669 senza
// lasciare traccia nel registro. Questa riga è la traccia: si scrive PRIMA di
// cominciare e si aggiorna alla fine, così una sync morta a metà resta scritta
// come "interrotta" e la successiva riparte da dove serve.
model SyncDrive {
  id           String    @id @default(cuid())
  // in_corso | completata | interrotta | errore
  stato        String    @default("in_corso")
  radice       String
  // Cartella (percorso relativo) da cui ripartire: null = dall'inizio.
  ripartiDa    String?
  trovati      Int       @default(0)
  nuovi        Int       @default(0)
  aggiornati   Int       @default(0)
  rimossi      Int       @default(0)
  // Analisi importate dai documenti (vedi lib/analisi-drive.ts)
  analisi      Int       @default(0)
  // Momento dell'ultima sync ARRIVATA IN FONDO: la successiva può guardare
  // solo i file modificati dopo, invece di ripassare tutto.
  completataIl DateTime?
  messaggio    String?
  iniziataIl   DateTime  @default(now())

  @@index([iniziataIl])
}

// Dove una campagna eroga davvero: le località su cui è mirata, e quelle che
// esclude.
//
// ⚠️ Fino al 09/08/2026 il targeting geografico NON veniva importato affatto:
// nello script non c'era nessuna query, e nell'app nessuna tabella. Una
// campagna che si chiama «Fiori Milano» poteva essere mirata su tutta Italia
// e nessuno poteva accorgersene guardando l'app — si vedeva solo la spesa, e
// la spesa non dice dove è andata.
//
// ⚠️ `esclusa` fa parte della CHIAVE: la stessa località può comparire una
// volta come mirata (la regione) e una come esclusa (una città dentro), ed è
// una configurazione normale, non un doppione.
// La STORIA giorno per giorno delle keyword: una riga per criterio per
// giorno con impressioni, dal lavoro `keyword-giorni` dello script (10/08).
// È quella che permette alla tabella delle keyword di SEGUIRE il periodo
// scelto, invece della fotografia a finestra fissa di CopyAnnuncio.
// L'aggancio a CopyAnnuncio è per `idEsterno` (account:gruppo:criterio),
// non una FK: le righe copy possono rinascere, la storia resta.
// La storia giorno per giorno di ogni ANNUNCIO: gemella di MetricaKeyword,
// dal lavoro keyword-giorni dello script (15/08/2026). Serve a mostrare le
// prestazioni di un annuncio per finestra invece della sola fotografia a 30
// giorni del giro copy.
model MetricaAnnuncio {
  id           String   @id @default(cuid())
  idEsterno    String
  campagna     String
  gruppo       String?
  data         DateTime
  spesa        Float?
  impressioni  Int?
  clic         Int?
  conversioni  Float?
  ricavi       Float?
  creataIl     DateTime @default(now())
  aggiornataIl DateTime @updatedAt

  @@unique([idEsterno, data])
  @@index([campagna, data])
}

model MetricaKeyword {
  id             String   @id @default(cuid())
  idEsterno      String
  campagna       String
  gruppo         String?
  testo          String
  corrispondenza String?
  data           DateTime
  spesa          Float?
  impressioni    Int?
  clic           Int?
  conversioni    Float?
  ricavi         Float?
  creataIl       DateTime @default(now())
  aggiornataIl   DateTime @updatedAt

  @@unique([idEsterno, data])
  @@index([campagna, data])
}

model LocalitaCampagna {
  id           String   @id @default(cuid())
  campagnaId   String
  campagna     Campagna @relation(fields: [campagnaId], references: [id], onDelete: Cascade)
  // L'id del "geo target constant" di Google: 1008736, 2380…
  // È la chiave vera: i nomi cambiano lingua a seconda di chi legge.
  idEsterno    String
  nome         String
  // City | Region | Country | Postal Code | Airport | Neighborhood…
  // Lo dice Google: è il livello a cui la località è mirata.
  tipo         String?
  // true = località ESCLUSA, non mirata.
  esclusa      Boolean  @default(false)
  // Il moltiplicatore di offerta, quando c'è: +20% su Milano è una decisione,
  // e senza vederla si legge male la spesa per città.
  modificatore Float?
  creataIl     DateTime @default(now())
  aggiornataIl DateTime @updatedAt

  @@unique([campagnaId, idEsterno, esclusa])
  @@index([campagnaId])
}

// La bozza di un annuncio in scrittura, salvata mentre si scrive.
//
// ⚠️ Sul DATABASE e non nel browser, di proposito: un annuncio si scrive in più
// momenti — «lo finisco domani» — e una bozza chiusa dentro localStorage vive
// su quel computer e su quel browser soltanto. Qui vale la stessa scelta delle
// viste salvate: condivisa, non per utente. Chi riapre il gruppo ritrova quello
// che c'era, anche da un'altra postazione.
//
// Una sola bozza per gruppo: è la stessa casella su cui si stava scrivendo, non
// una collezione di tentativi. Quando l'annuncio va in coda, la bozza si
// cancella — tenerla farebbe ricomparire un lavoro già consegnato.
model BozzaAnnuncio {
  id           String   @id @default(cuid())
  gruppoId     String   @unique
  gruppo       Gruppo   @relation(fields: [gruppoId], references: [id], onDelete: Cascade)
  // Un titolo per riga, una descrizione per riga: la stessa forma della casella
  // in cui si scrive, così non c'è niente da tradurre nei due sensi.
  titoli       String?
  descrizioni  String?
  finalUrl     String?
  // Cosa era stato chiesto all'AI: senza, riaprendo si riscrive a memoria.
  indicazione  String?
  creataIl     DateTime @default(now())
  aggiornataIl DateTime @updatedAt
}

// ── LISTE DI PAROLE ESCLUSE, condivise fra campagne ─────────────────────────
//
// Una lista è un gruppo di parole per cui non vogliamo comparire, con un nome:
// «brand concorrenti», «lavoro e carriera», «gratis e fai da te». Si scrive una
// volta e si applica a più campagne — che è il modo in cui questo lavoro si fa
// davvero, perché le stesse esclusioni valgono per quasi tutte le campagne di
// un brand.
//
// ⚠️ SU GOOGLE ESISTONO DAVVERO, e sono la cosa giusta da usare: gli Script
// hanno `newNegativeKeywordListBuilder()`, `list.addNegativeKeywords()` e
// `campagna.addNegativeKeywordList()`. Non si simula copiando N negative su
// ogni campagna: quella strada le renderebbe indipendenti, e correggerne una
// vorrebbe dire ripassare campagna per campagna.
//
// ⚠️ MA VIVONO DENTRO UN ACCOUNT. Una lista di Flowers non esiste per Cake:
// applicarla a un altro brand vuol dire crearne una COPIA in quell'account, e
// da quel momento sono due liste che vanno tenute allineate. L'app lo dichiara
// invece di far finta che sia una sola.
model ListaNegative {
  id           String              @id @default(cuid())
  // Il nome è quello che comparirà in Google Ads: si sceglie una volta e non
  // si cambia a cuor leggero, perché è la chiave con cui lo script la ritrova.
  nome         String              @unique
  descrizione  String?
  parole       ParolaListaNegative[]
  creataIl     DateTime            @default(now())
  aggiornataIl DateTime            @updatedAt
}

model ParolaListaNegative {
  id             String        @id @default(cuid())
  listaId        String
  lista          ListaNegative @relation(fields: [listaId], references: [id], onDelete: Cascade)
  testo          String
  // exact | phrase | broad — la stessa scala delle negative singole.
  corrispondenza String        @default("exact")
  creataIl       DateTime      @default(now())

  @@unique([listaId, testo, corrispondenza])
  @@index([listaId])
}
