{
  "name": "deluxy-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Deluxy CRM — il libro dei clienti top: schede a 360 gradi dagli ordini, ricorrenze, eventi con inviti e mail personalizzate",
  "scripts": {
    "dev": "next dev -p 3190",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3190",
    "db:push": "prisma db push",
    "db:condiviso": "node scripts/configura-db-condiviso.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.5.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
