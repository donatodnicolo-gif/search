// Deluxy CRM — schema `crm` sul Postgres condiviso.
// I clienti e i loro ordini NON vivono qui: la fonte è Deluxy Orders
// (/api/v1/clienti, /api/v1/ordini). Qui vive solo il dominio della
// relazione: attività, eventi con inviti, template e registro mail.
// Il riferimento al cliente è `chiaveCliente` = la chiave base64url di Orders
// (email → telefono → nome), la stessa di TagCliente/PrivacyCliente in Orders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Diario della relazione: chiamate, incontri, note, messaggi.
model Attivita {
  id            String   @id @default(cuid())
  chiaveCliente String
  // fotografia del nome al momento della registrazione (il dato vivo è in Orders)
  nomeCliente   String   @default("")
  tipo          String // nota | chiamata | email | incontro | whatsapp | altro
  titolo        String
  dettaglio     String?  @db.Text
  autore        String   @default("")
  quando        DateTime @default(now())
  creatoIl      DateTime @default(now())
  aggiornatoIl  DateTime @updatedAt

  @@index([chiaveCliente, quando])
  @@index([quando])
  @@index([tipo])
}

// Evento o occasione speciale Deluxy (cena, presentazione, anteprima…).
model Evento {
  id           String    @id @default(cuid())
  titolo       String
  descrizione  String?   @db.Text
  luogo        String    @default("")
  dataInizio   DateTime
  dataFine     DateTime?
  dressCode    String    @default("")
  capienza     Int?
  stato        String    @default("bozza") // bozza | aperto | concluso | annullato
  note         String?   @db.Text
  inviti       Invito[]
  creatoIl     DateTime  @default(now())
  aggiornatoIl DateTime  @updatedAt

  @@index([dataInizio])
  @@index([stato])
}

// Invito di un cliente a un evento, col suo percorso.
model Invito {
  id            String    @id @default(cuid())
  eventoId      String
  evento        Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  chiaveCliente String
  // fotografia di cortesia al momento dell'invito (il dato vivo è in Orders)
  nomeCliente   String    @default("")
  emailCliente  String    @default("")
  stato         String    @default("da_invitare") // da_invitare | invitato | confermato | declinato | partecipato
  invitatoIl    DateTime?
  rispostaIl    DateTime?
  note          String?
  mailId        String?
  creatoIl      DateTime  @default(now())
  aggiornatoIl  DateTime  @updatedAt

  @@unique([eventoId, chiaveCliente])
  @@index([chiaveCliente])
  @@index([stato])
}

// Modello di mail personalizzata, con variabili {{nome}}, {{...}}.
model TemplateMail {
  id           String   @id @default(cuid())
  nome         String   @unique
  oggetto      String
  corpo        String   @db.Text
  archiviatoIl DateTime? // archiviato = non si propone più in Componi, ma resta
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt
}

// Registro delle mail uscite dal CRM (l'originale resta negli Inviati del mittente).
model MailInviata {
  id            String   @id @default(cuid())
  chiaveCliente String
  nomeCliente   String   @default("")
  destinatario  String
  oggetto       String
  corpo         String   @db.Text
  esito         String   @default("inviata") // inviata | errore
  errore        String?
  templateId    String?
  eventoId      String?
  listaId       String? // se è partita da un invio a lista
  autore        String   @default("")
  inviataIl     DateTime @default(now())

  @@index([chiaveCliente, inviataIl])
  @@index([inviataIl])
  @@index([eventoId])
  @@index([listaId])
}

// Una lista di clienti costruita dall'AI da un brief. La lista è una
// SELEZIONE (dominio del CRM): i clienti veri restano in Orders, qui ne resta
// la fotografia al momento della generazione, coi contatti per l'invio.
model ListaClienti {
  id           String        @id @default(cuid())
  nome         String
  brief        String        @db.Text // le parole dell'operatore
  criteri      Json // la ricetta dell'AI: rieseguirla aggiorna la lista
  spiegazione  String        @db.Text // come l'AI ha letto il brief
  note         String        @default("") // trasparenza: cap, esclusi, fonte
  modello      String        @default("")
  generataIl   DateTime      @default(now())
  membri       MembroLista[]
  creatoIl     DateTime      @default(now())
  aggiornatoIl DateTime      @updatedAt

  @@index([creatoIl])
}

model MembroLista {
  id            String       @id @default(cuid())
  listaId       String
  lista         ListaClienti @relation(fields: [listaId], references: [id], onDelete: Cascade)
  chiaveCliente String
  nome          String       @default("")
  email         String       @default("")
  telefono      String       @default("")
  citta         String       @default("")
  segmento      String       @default("")
  ordini        Int          @default(0)
  speso         Float        @default(0)
  ultimoOrdine  DateTime?

  @@unique([listaId, chiaveCliente])
  @@index([listaId])
}

// Modello di messaggio WhatsApp, con le stesse {{variabili}} delle mail.
// NB: sono i modelli NOSTRI (testo libero), non i template approvati da Meta.
model TemplateWhatsApp {
  id           String   @id @default(cuid())
  nome         String   @unique
  testo        String   @db.Text
  archiviatoIl DateTime?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @updatedAt
}

// Registro dei WhatsApp usciti (o preparati) dal CRM.
model MessaggioWhatsApp {
  id            String   @id @default(cuid())
  chiaveCliente String
  nomeCliente   String   @default("")
  telefono      String
  testo         String   @db.Text
  canale        String   @default("api") // api (via Customer Service) | wame (aperto sul WhatsApp dell'operatore)
  esito         String   @default("inviato") // inviato | errore | preparato
  errore        String?
  listaId       String?
  autore        String   @default("")
  inviatoIl     DateTime @default(now())

  @@index([chiaveCliente, inviatoIl])
  @@index([inviatoIl])
  @@index([listaId])
}

// La password di squadra, quando è stata cambiata dall'app. Riga unica
// (id "team"). Finché la riga non esiste vale la password di nascita in
// CRM_APP_PASSWORD; da quando esiste, vale SOLO questa (scrypt salt:hash).
// `versione` cresce a ogni cambio: le sessioni portano la versione con cui
// sono nate, e una versione diversa le chiude (revoca, Libro Sicurezza §1).
model PasswordTeam {
  id         String   @id @default("team")
  hash       String
  versione   Int      @default(1)
  cambiataDa String   @default("")
  cambiataIl DateTime @default(now())
}

// Link «password dimenticata»: a database c'è SOLO lo SHA-256 del token, mai
// il token. Monouso (usatoIl) e a tempo (scadeIl). ipHash serve a contare le
// richieste, non a identificare: è l'hash dell'IP col segreto dell'app.
model TokenResetPassword {
  id       String    @id @default(cuid())
  hash     String    @unique
  scadeIl  DateTime
  usatoIl  DateTime?
  ipHash   String    @default("")
  creatoIl DateTime  @default(now())

  @@index([creatoIl])
  @@index([ipHash, creatoIl])
}

// Il profilo di RELAZIONE di un cliente: quello che sappiamo di lui oltre agli
// ordini. Nome, email, telefono, città e ordini restano in Orders (standard
// §7: casa unica); qui vivono solo i dati che nascono dal rapporto —
// come lo chiamiamo, cosa fa nella vita, la sua foto, le note del client
// advisor. Una riga per cliente, agganciata alla chiaveCliente di Orders.
model ProfiloCliente {
  chiaveCliente String   @id
  nome          String   @default("") // come lo chiamiamo (vuoto = il nome degli ordini)
  professione   String   @default("")
  punteggio     Int? // il voto del client advisor (0-100): entra nei cluster (cluster.ts)
  foto          Bytes? // ridotta nel browser (≤ 512 px), tetto 600 KB
  fotoTipo      String   @default("")
  autore        String   @default("")
  creatoIl      DateTime @default(now())
  aggiornatoIl  DateTime @updatedAt
}

// Le impostazioni del CRM che cambiano dall'app (riga unica, id "crm"). Oggi:
// le soglie e i cluster dei clienti (src/lib/cluster.ts) — CHI conta come
// cliente da coltivare e in quale gruppo sta. Tutti i clienti restano
// visibili: le soglie evidenziano, non escludono (decisione dell'utente 10/09).
model ImpostazioniCrm {
  id           String   @id @default("crm")
  clienti      Json // { soglie: {...}, cluster: [...] } — vedi cluster.ts
  aggiornatoDa String   @default("")
  aggiornatoIl DateTime @updatedAt
}

// Due chiavi di Orders che sono la STESSA persona (l'email del lavoro e quella
// personale, il telefono senza email…): «Unisci» dalla scheda. Orders resta
// com'è (ogni chiave ha i suoi ordini); il CRM mostra la scheda del principale
// con dentro anche gli ordini, le ricorrenze e il diario degli alias, e
// rimanda là chi apre un alias. Si può sempre separare.
model UnioneClienti {
  chiaveAlias      String   @id
  chiavePrincipale String
  autore           String   @default("")
  creatoIl         DateTime @default(now())

  @@index([chiavePrincipale])
}

// Le NOTE di un cliente: quante se ne vogliono, ognuna con la sua data e il
// suo autore, ognuna modificabile. Diverse dalle attività del diario (che
// raccontano cosa è successo): queste sono ciò che vale la pena ricordare.
model NotaCliente {
  id            String   @id @default(cuid())
  chiaveCliente String
  testo         String   @db.Text
  autore        String   @default("")
  creatoIl      DateTime @default(now())
  aggiornatoIl  DateTime @updatedAt

  @@index([chiaveCliente, creatoIl])
}

// Una cosa da fare CON un cliente in un giorno preciso: chiamarlo, passare a
// trovarlo, mandare un pensiero. È la programmazione del client advisor, e
// finisce nel Calendario del CRM insieme a ricorrenze ed eventi.
model Programmazione {
  id            String    @id @default(cuid())
  chiaveCliente String
  nomeCliente   String    @default("")
  quando        DateTime // il giorno (e l'ora, se c'è)
  conOra        Boolean   @default(false)
  titolo        String
  dettaglio     String?   @db.Text
  stato         String    @default("da_fare") // da_fare | fatta | annullata
  fattaIl       DateTime?
  autore        String    @default("")
  creatoIl      DateTime  @default(now())
  aggiornatoIl  DateTime  @updatedAt

  @@index([quando])
  @@index([chiaveCliente, quando])
  @@index([stato, quando])
}
