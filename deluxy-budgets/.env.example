# --- Database ---
# Postgres condiviso Deluxy (Supabase), schema dedicato "budgets". Le due
# stringhe si scrivono da sole con:
#   node scripts/configura-db-condiviso.mjs ../deluxy-partner/.env
DATABASE_URL=""
DIRECT_URL=""

# --- Protezione UI (obbligatoria in produzione) ---
# Qui ci sono budget, premi e costi del personale: senza questa password l'app
# NON va pubblicata. In sviluppo locale si può lasciare vuota (UI aperta).
BUDGETS_APP_PASSWORD=""

# --- Chiavi dalla cassaforte del Hub ---
# Le chiavi (FINANCE_API_KEY, OPENAI_API_KEY, …) NON si tengono più qui: si
# chiedono al Hub (pagina /chiavi, progetto "deluxy-budgets"). L'unico segreto
# locale è il token di servizio, uguale a HUB_KEYS_TOKEN del Hub.
HUB_URL="https://deluxy-hub.vercel.app"
HUB_KEYS_TOKEN=""

# URL dei servizi (non segreti): opzionali, default alla produzione.
FINANCE_API_URL="https://deluxy-partner.vercel.app"
OPENAI_MODEL="gpt-4o-mini"
# Linee di vendita: Scout ne è il master (edge function Supabase). L'URL non è
# segreto; la chiave LINEE_API_KEY viene dal vault del Hub.
SCOUT_LINEE_URL="https://fdsziebgkljfsugqqbqd.supabase.co/functions/v1/linee"

# In sviluppo puoi ancora mettere una chiave qui per lavorare offline: se
# presente, l'env locale ha la precedenza sul Hub.
# FINANCE_API_KEY=""
# OPENAI_API_KEY=""
# LINEE_API_KEY=""

