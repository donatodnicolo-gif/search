# Deluxy Transactions — SOLO NOMI, mai valori (Standard Deluxy §5.1).
# Copiare in .env e riempire. Il file .env non si committa e non si carica su
# Vercel (vedi .vercelignore).

# --- Database (Postgres Supabase condiviso, schema dedicato) ---
# pooler, porta 6543
DATABASE_URL=
# connessione diretta, porta 5432 (serve a prisma db push)
DIRECT_URL=

# --- Segreti dell'app ---
# AES-256-GCM per i segreti a riposo (TOTP degli operatori, segreti HMAC delle
# chiavi API). 64 caratteri esadecimali. Generarlo con: npm run segreti
# ⚠️ Se cambia, i segreti già salvati non si decifrano più.
TRANSACTIONS_ENC_KEY=
# firma del cookie di sessione (>= 32 caratteri)
APP_SECRET=
# protegge /api/cron/manutenzione su Vercel
CRON_SECRET=

# --- Posta: il codice che sblocca i pagamenti ---
# Senza queste variabili il codice non parte e NESSUN pagamento può uscire
# (si fallisce chiusi: è voluto). Stanno qui e non sul database di proposito —
# vedi docs/SICUREZZA.md §0.
# Con una casella Register.it: host authmail.register.it, porta 587 (o 465 SSL),
# utente = indirizzo email completo.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cassaforte chiavi del Hub (Standard §4.2) ---
HUB_URL=
HUB_KEYS_TOKEN=

# --- Facoltativo: primo accesso ---
# Email dell'operatore amministratore creato da `npm run operatore`.
# Nessuna password di team: qui si entra con account nominali + TOTP.
