// Deluxy Transactions — schema del registro pagamenti.
//
// Principi (vedi docs/SICUREZZA.md):
//  1. Gli IMPORTI sono in CENTESIMI interi. Mai un Float su del denaro.
//  2. Nulla si cancella: gli stati finali sono stati, non delete. Il registro
//     eventi è una catena di hash e non ha update né delete.
//  3. I segreti (TOTP, HMAC delle chiavi API) sono cifrati AES-256-GCM.
//  4. Questa è l'UNICA app Deluxy da cui può uscire denaro, e l'uscita ha una
//     porta sola: lo sblocco del pagatore (codice via email + PIN). Nessun'altra
//     app, e nessuna chiave API, può far partire un pagamento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Operatori (persone che autorizzano)
// ---------------------------------------------------------------------------

// Niente password unica di team come nelle altre app: qui serve sapere CHI ha
// approvato, e serve il secondo fattore. Deviazione motivata dallo standard §4.
model Operatore {
  id             String    @id @default(cuid())
  email          String    @unique
  nome           String
  ruolo          String    @default("approvatore") // admin | approvatore | osservatore
  passwordHash   String // PBKDF2-SHA256, 210.000 giri
  passwordSalt   String
  totpSegreto    String? // cifrato AES-256-GCM
  totpAttivo     Boolean   @default(false)
  // PIN di pagamento: terzo fattore, richiesto SOLO al pagatore e SOLO per far
  // uscire il denaro. Non sostituisce la password né il TOTP, si aggiunge.
  // Stesso PBKDF2 della password: non è un numero in chiaro sul database.
  pinHash        String?
  pinSalt        String?
  pinAggiornatoIl DateTime?
  // Tetto personale in centesimi: sopra questa cifra l'operatore non può
  // approvare da solo. 0 = nessun tetto personale (vale solo quello globale).
  tettoApprovazione Int    @default(0)
  attivo         Boolean   @default(true)
  tentativiFalliti Int     @default(0)
  bloccatoFinoA  DateTime?
  ultimoAccesso  DateTime?
  creatoIl       DateTime  @default(now())

  approvazioni Approvazione[]
  sessioni     Sessione[]

  @@index([attivo])
}

// Le sessioni stanno sul database così una revoca ha effetto immediato: il
// cookie da solo non basta mai per entrare.
model Sessione {
  id          String    @id @default(cuid())
  operatoreId String
  operatore   Operatore @relation(fields: [operatoreId], references: [id], onDelete: Cascade)
  hash        String    @unique // SHA-256 del token nel cookie
  ip          String?
  userAgent   String?
  creataIl    DateTime  @default(now())
  // Ultima pagina aperta con questa sessione: da qui si contano i minuti di
  // inattività. `scadeIl` resta il tetto assoluto, questo è il tempo fermo.
  ultimoUso   DateTime  @default(now())
  scadeIl     DateTime
  revocataIl  DateTime?

  @@index([operatoreId])
  @@index([scadeIl])
}

// ---------------------------------------------------------------------------
// Chiavi API (le altre app Deluxy)
// ---------------------------------------------------------------------------

model ChiaveApi {
  id            String    @id @default(cuid())
  nome          String // "deluxy-messaging", "deluxy-acquisti", …
  hash          String    @unique // SHA-256 della chiave: il valore in chiaro non esiste qui
  prefisso      String // primi caratteri, per riconoscerla nell'elenco
  segretoHmac   String // cifrato AES-256-GCM: con questo l'app firma le richieste
  // Permessi minimi: un'app può CHIEDERE un pagamento e LEGGERE le proprie
  // richieste. Nessuna chiave può approvare: l'approvazione è solo umana.
  puoRichiedere Boolean   @default(true)
  puoLeggere    Boolean   @default(true)
  // Tetti per singola richiesta e per giornata, in centesimi. 0 = nessun tetto.
  tettoRichiesta Int      @default(0)
  tettoGiornaliero Int    @default(0)
  // Elenco di IP consentiti separati da virgola. Vuoto = nessun filtro.
  ipConsentiti  String    @default("")
  // Webhook di default dell'app: dove mandare gli esiti se la singola richiesta
  // non ne indica uno. L'override per-richiesta è ammesso solo sullo STESSO
  // host di questo indirizzo (difesa SSRF: il corpo di una POST non può
  // dirottare gli esiti verso un dominio qualsiasi).
  urlNotifica   String    @default("")
  attiva        Boolean   @default(true)
  scadeIl       DateTime?
  ultimoUso     DateTime?
  creataIl      DateTime  @default(now())
  revocataIl    DateTime?

  richieste Richiesta[]

  @@index([attiva])
}

// Anti-replay: ogni richiesta firmata porta un nonce usabile una volta sola.
model Nonce {
  valore   String   @id
  chiaveId String
  creatoIl DateTime @default(now())
  scadeIl  DateTime

  @@index([scadeIl])
}

// Idempotenza: la stessa X-Idempotency-Key restituisce la stessa risposta,
// così un retry di rete non genera due pagamenti.
model Idempotenza {
  id         String   @id @default(cuid())
  chiaveApiId String
  chiave     String
  impronta   String // SHA-256 del corpo: stessa chiave + corpo diverso = errore
  risposta   String // JSON della risposta originale
  creataIl   DateTime @default(now())

  @@unique([chiaveApiId, chiave])
  @@index([creataIl])
}

// Finestra scorrevole per il rate limit, una riga per (chiave, minuto).
model Contatore {
  id       String   @id // "<chiaveApiId>:<minuto epoch>"
  colpi    Int      @default(0)
  scadeIl  DateTime

  @@index([scadeIl])
}

// ---------------------------------------------------------------------------
// Beneficiari (rubrica IBAN)
// ---------------------------------------------------------------------------

// Serve a due cose: la lista bianca degli IBAN già verificati e il rilevamento
// del cambio IBAN, che è la frode più comune sui pagamenti B2B.
model Beneficiario {
  id           String   @id @default(cuid())
  nome         String
  nomeNorm     String // minuscolo, senza spazi/punteggiatura: per il confronto
  iban         String
  bic          String?
  paese        String
  verificato   Boolean  @default(false)
  verificatoDa String?
  verificatoIl DateTime?
  note         String?
  creatoIl     DateTime @default(now())

  @@unique([nomeNorm, iban])
  @@index([nomeNorm])
  @@index([iban])
}

// ---------------------------------------------------------------------------
// Richieste di pagamento
// ---------------------------------------------------------------------------

// Stati: in_attesa → approvata → in_lotto → pagata
//              ↘ rifiutata   ↘ annullata   ↘ sospesa (torna in_attesa)
model Richiesta {
  id            String   @id @default(cuid())
  riferimento   String   @unique // TRX-2026-000123, quello che si cita fuori
  // Provenienza
  chiaveApiId   String?
  chiaveApi     ChiaveApi? @relation(fields: [chiaveApiId], references: [id])
  origine       String // "deluxy-messaging", "manuale", …
  riferimentoEsterno String? // id dell'oggetto nell'app di origine

  // Denaro: SEMPRE centesimi interi.
  importoCent   Int
  valuta        String   @default("EUR")

  beneficiario  String
  beneficiarioNorm String
  // Come si vuole pagare. "iban" è l'unico metodo che le vie automatiche
  // (distinta SEPA, Qonto) sanno eseguire; gli altri (link, paypal, carta,
  // altro) si chiudono SOLO a mano con «pagata fuori dall'app».
  metodo        String   @default("iban") // iban | link | paypal | carta | altro
  // IBAN vuoto ("") quando il metodo non è "iban".
  iban          String
  bic           String?
  // Il «come si paga» quando non è un IBAN: il link, l'indirizzo PayPal, la
  // nota per la carta. In chiaro: l'operatore deve leggerlo per pagare. La sua
  // integrità la difende il sigillo (v2), come per l'IBAN.
  riferimentoPagamento String?
  causale       String
  note          String?
  // Imputazione di spesa dichiarata dal chiamante (vocabolario in docs/API.md:
  // "fornitore", "partner", "valet", o una categoria di Budgets). NON è il tipo
  // di app: quello è `origine`.
  categoria     String?
  scadenza      DateTime?

  stato         String   @default("in_attesa")
  // Valutazione del rischio calcolata alla creazione e ricalcolabile.
  rischio       Int      @default(0) // 0-100
  motiviRischio String   @default("") // elenco separato da "|"
  // true = servono due approvatori distinti (sopra soglia o rischio alto)
  doppiaFirma   Boolean  @default(false)

  // Sigillo: SHA-256 dei campi che contano (importo, iban, beneficiario,
  // causale). Se qualcuno tocca la riga nel database, non torna più.
  // v1 = formula storica; v2 aggiunge metodo + riferimentoPagamento (senza il
  // versionamento, cambiare la formula avrebbe invalidato tutte le righe in coda).
  sigillo       String
  sigilloV      Int      @default(1)

  lottoId       String?
  lotto         Lotto?   @relation(fields: [lottoId], references: [id])

  urlNotifica   String? // webhook firmato verso l'app di origine (override per-richiesta)
  creataIl      DateTime @default(now())
  // Ultimo cambiamento visibile da fuori: è la colonna del pull di recupero
  // (`GET /api/v1/richieste?aggiornateDa=`) — il webhook è un avviso, la fonte
  // espone i cambi che i lettori devono poter ritirare (Standard §7.3.5).
  aggiornataIl  DateTime @default(now()) @updatedAt
  decisaIl      DateTime?
  pagataIl      DateTime?

  // Come è uscito il denaro: "distinta" (file SEPA caricato a mano in banca)
  // oppure "qonto" (bonifico partito dall'API). Vuoto finché non è pagata.
  pagatoCon      String?
  qontoTransferId String? @unique // id del bonifico in Qonto: prova dell'uscita
  qontoStato      String?
  // Movimento bancario riconosciuto in riconciliazione.
  qontoMovimentoId String?

  approvazioni Approvazione[]
  eventi       Evento[]
  allegati     Allegato[]
  notifiche    NotificaInvio[]

  @@unique([origine, riferimentoEsterno])
  @@index([stato, creataIl])
  @@index([beneficiarioNorm])
  @@index([iban])
  @@index([lottoId])
  @@index([chiaveApiId, aggiornataIl])
}

// ---------------------------------------------------------------------------
// Allegati — documenti a corredo e prove di pagamento
// ---------------------------------------------------------------------------

// I metadati stanno qui; i byte in AllegatoDati, in una tabella a parte, così
// nessun elenco può tirarli giù per sbaglio. I byte vivono nel database come
// interim DICHIARATO (il cluster è condiviso: soglia scritta in docs/API.md —
// oltre 500 MB complessivi o 2.000 allegati si migra a object storage).
model Allegato {
  id          String    @id @default(cuid())
  richiestaId String
  richiesta   Richiesta @relation(fields: [richiestaId], references: [id])
  // "richiesta" = documento a corredo (fattura, screenshot della richiesta),
  //   caricabile anche dall'app chiamante via API.
  // "prova" = prova del pagamento eseguito: la scrive SOLO un operatore di
  //   quest'app (chi paga), mai l'app che ha chiesto il pagamento — altrimenti
  //   la prova la scriverebbe l'accusato.
  ruolo       String    @default("richiesta")
  nome        String
  tipo        String // MIME dalla whitelist, verificato sui magic bytes
  byte        Int
  sha256      String // impronta dei byte: verifica end-to-end e dedup
  caricatoDa  String // email operatore o nome dell'app
  creatoIl    DateTime  @default(now())

  dati AllegatoDati?

  @@unique([richiestaId, sha256])
  @@index([richiestaId])
}

// SOLO i byte (base64). Si legge esclusivamente al download, mai negli elenchi.
model AllegatoDati {
  allegatoId String   @id
  allegato   Allegato @relation(fields: [allegatoId], references: [id], onDelete: Cascade)
  dati       String   @db.Text // base64 senza prefisso
}

// ---------------------------------------------------------------------------
// Notifiche in uscita — outbox transazionale
// ---------------------------------------------------------------------------

// Ogni cambio di stato che l'app di origine deve sapere diventa una riga qui,
// scritta insieme al cambio. Il primo tentativo parte subito; i successivi li
// fa il cron (ogni tentativo si RIFIRMA con timestamp fresco, altrimenti
// morirebbe sulla finestra ±5 minuti del ricevente). Dopo 3 tentativi la riga
// resta «fallita» e si rilancia a mano dal dettaglio della richiesta; il
// paracadute vero è il pull `?aggiornateDa=` del chiamante.
model NotificaInvio {
  id            String    @id @default(cuid())
  richiestaId   String
  richiesta     Richiesta @relation(fields: [richiestaId], references: [id])
  evento        String    @default("richiesta.stato")
  // Il motivo (rifiuto/annullo/chiusura) viaggia col payload, che però si
  // costruisce al momento dell'invio leggendo lo stato corrente.
  motivo        String?
  stato         String    @default("da_inviare") // da_inviare | inviata | fallita
  tentativi     Int       @default(0)
  ultimoEsito   String? // "200", "timeout", "ECONNREFUSED"… mai il payload
  prossimoTentativo DateTime?
  creataIl      DateTime  @default(now())
  inviataIl     DateTime?

  @@index([stato, prossimoTentativo])
  @@index([richiestaId])
}

model Approvazione {
  id          String    @id @default(cuid())
  richiestaId String
  richiesta   Richiesta @relation(fields: [richiestaId], references: [id], onDelete: Cascade)
  operatoreId String
  operatore   Operatore @relation(fields: [operatoreId], references: [id])
  esito       String // approvata | rifiutata | sospesa
  motivo      String?
  ip          String?
  creataIl    DateTime  @default(now())

  // Un operatore vota una volta sola sulla stessa richiesta: è ciò che rende
  // vera la doppia firma (due persone diverse, non due clic della stessa).
  @@unique([richiestaId, operatoreId])
  @@index([richiestaId])
}

// ---------------------------------------------------------------------------
// Distinte SEPA
// ---------------------------------------------------------------------------

model Lotto {
  id          String   @id @default(cuid())
  riferimento String   @unique // LOTTO-2026-0007
  stato       String   @default("aperto") // aperto | esportato | pagato | annullato
  creatoDa    String
  creatoIl    DateTime @default(now())
  esportatoIl DateTime?
  pagatoIl    DateTime?
  // Impronta del file XML consegnato alla banca: prova di cosa è stato inviato.
  improntaXml String?

  // Sblocco del pagatore: finché queste tre colonne sono vuote o scadute, il
  // file SEPA non si genera e non si scarica. È la porta da cui esce il denaro.
  sbloccatoDa    String?
  sbloccatoIl    DateTime?
  sbloccoScadeIl DateTime?

  richieste Richiesta[]
  sblocchi  SbloccoPagamento[]

  @@index([stato])
}

// ---------------------------------------------------------------------------
// Sblocco del pagamento (codice via email + PIN)
// ---------------------------------------------------------------------------

// Un codice per volta, per distinta: si chiede, arriva per email al pagatore,
// vale pochi minuti e si consuma. Il codice in chiaro NON è qui: solo il suo
// SHA-256, come per le chiavi API. Le righe non si cancellano: usate o scadute
// restano, perché "chi ha chiesto di pagare e quando" è la domanda a cui questa
// tabella deve saper rispondere fra due anni.
model SbloccoPagamento {
  id          String    @id @default(cuid())
  lottoId     String
  lotto       Lotto     @relation(fields: [lottoId], references: [id], onDelete: Cascade)
  // Chi ha chiesto il codice e a chi è stato spedito (di norma la stessa
  // persona: il pagatore).
  chiestoDa   String
  inviatoA    String
  codiceHash  String // SHA-256 del codice: in chiaro esiste solo nell'email
  // Copia dell'importo al momento della richiesta: se la distinta cambia fra
  // l'invio del codice e lo sblocco, il codice non vale più.
  totaleCent  Int
  impronta    String // SHA-256 di (riferimento + totale + IBAN dei beneficiari)
  scadeIl     DateTime
  tentativi   Int       @default(0)
  usatoIl     DateTime?
  annullatoIl DateTime?
  ip          String?
  creatoIl    DateTime  @default(now())

  @@index([lottoId, creatoIl])
  @@index([scadeIl])
}

// ---------------------------------------------------------------------------
// Registro eventi — catena di hash, a sola aggiunta
// ---------------------------------------------------------------------------

// Ogni riga incatena l'hash della precedente: cambiare o togliere un evento
// spezza la catena e la pagina /registro lo dice. È il libro mastro.
model Evento {
  seq         Int      @id @default(autoincrement())
  tipo        String
  richiestaId String?
  richiesta   Richiesta? @relation(fields: [richiestaId], references: [id])
  attore      String // email dell'operatore, nome dell'app, "sistema"
  dettagli    String   @default("{}") // JSON
  ip          String?
  hashPrec    String
  hash        String
  creatoIl    DateTime @default(now())

  @@index([richiestaId])
  @@index([tipo, creatoIl])
}

// ---------------------------------------------------------------------------
// Impostazioni (soglie e regole)
// ---------------------------------------------------------------------------

model Impostazione {
  chiave      String   @id
  valore      String
  aggiornataIl DateTime @updatedAt
}
