// Deluxy Hub — schema dati
// Solo gli utenti stanno sul database. Il catalogo delle app e la mappa
// ruolo → app vivono nel codice (src/lib/apps.ts), perché sono configurazione
// di deploy (URL, icone) e non dati che l'utente modifica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres (Supabase). Il portale vive nello schema "hub" dello stesso database
  // di deluxy-partner: le sue tabelle restano isolate da quelle di Partner, che
  // stanno in "public". Lo schema si sceglie con ?schema=hub nelle URL, quindi
  // un "prisma db push" del Hub non può toccare i dati di Partner.
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler 6543 con ?pgbouncer=true&connection_limit=1&schema=hub
  directUrl = env("DIRECT_URL") // pooler 5432 con ?schema=hub — per migrazioni/db push
}

// Chiavi/segreti dei progetti (pagina /chiavi, solo admin). Il valore è cifrato
// con AES-256-GCM (src/lib/cifratura.ts) usando HUB_CHIAVI_SECRET: sul database
// non c'è mai nulla in chiaro. `suffisso` (ultimi 4 caratteri) serve solo a
// riconoscere la chiave in lista senza doverla decifrare.
model Chiave {
  id            String   @id @default(cuid())
  progetto      String // a quale app/progetto appartiene (es. "deluxy-mail")
  nome          String // nome della variabile (es. "OPENAI_API_KEY")
  valoreCifrato String // "iv:tag:dati" in esadecimale
  suffisso      String // ultimi 4 caratteri in chiaro, per riconoscerla in lista
  note          String   @default("")
  creatoIl      DateTime @default(now())
  aggiornatoIl  DateTime @updatedAt

  @@unique([progetto, nome])
  @@index([progetto])
}

// Token di servizio per l'API di lettura delle chiavi (GET /api/chiavi). Ogni
// app che deve leggere i propri segreti ne riceve uno. Sul database c'è solo lo
// SHA-256 del token (come le chiavi API di Anagrafiche): il valore in chiaro si
// vede una volta sola alla generazione. `progetti` limita cosa può leggere
// (vuoto = tutti i progetti).
model TokenApi {
  id        String    @id @default(cuid())
  nome      String // a chi appartiene, es. "deluxy-scout"
  hash      String    @unique // sha256 del token in chiaro
  progetti  String[]  @default([]) // progetti leggibili; vuoto = tutti
  attivo    Boolean   @default(true)
  creatoIl  DateTime  @default(now())
  ultimoUso DateTime?
}

// ---------- Cartellino (timbrature, presenze, assenze) ----------

// Una singola marcatura del cartellino: l'utente entra o esce. Una timbratura
// non si modifica e non si cancella: è il registro dei fatti, come il cartellino
// di carta. Le correzioni si aggiungono (origine "manuale"), così resta scritto
// che quella riga è stata messa a mano e non timbrata.
// `giorno` è la data in fuso Europe/Rome ("YYYY-MM-DD") già calcolata: il server
// gira in UTC e senza questo campo una timbratura delle 00:30 italiane finirebbe
// nel giorno prima. Si raggruppa e si indicizza su quello.
model Timbratura {
  id       String   @id @default(cuid())
  utente   Utente   @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  utenteId String
  verso    String // entrata | uscita
  istante  DateTime @default(now())
  giorno   String // "YYYY-MM-DD" in fuso Europe/Rome
  // web = timbrata col bottone; manuale = inserita a mano (dimenticanza, trasferta)
  origine  String   @default("web")
  note     String   @default("")

  @@index([utenteId, giorno])
  @@index([giorno])
}

// Un'assenza dichiarata dal membro. Ferie, permessi e trasferte sono RICHIESTE
// (le approva un admin); la malattia è un FATTO che si registra e basta — lì
// quello che conta è il certificato allegato, non il permesso di chi gestisce.
model Assenza {
  id            String    @id @default(cuid())
  utente        Utente    @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  utenteId      String
  tipo          String // ferie | permesso | malattia | trasferta
  dal           DateTime // mezzanotte del primo giorno (fuso Europe/Rome)
  al            DateTime // mezzanotte dell'ultimo giorno, incluso
  motivo        String    @default("")
  // in-attesa | approvata | respinta (ferie, permessi, trasferte)
  // registrata (malattia: non passa da approvazione)
  stato         String    @default("in-attesa")
  decisaDa      String? // id dell'admin che ha deciso
  decisaDaNome  String    @default("")
  decisaIl      DateTime?
  notaDecisione String    @default("")
  creataIl      DateTime  @default(now())

  certificati Certificato[]

  @@index([utenteId])
  @@index([stato])
}

// Il certificato di malattia (o il giustificativo di un permesso). Il file sta
// nel database e non su disco: le funzioni Vercel non hanno un disco persistente
// e qui parliamo di pochi file l'anno. Limite 5 MB, solo PDF/JPEG/PNG. Il campo
// `dati` non va MAI incluso in una query di elenco: si legge solo nella rotta di
// download, che controlla prima chi sta chiedendo.
model Certificato {
  id         String   @id @default(cuid())
  utente     Utente   @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  utenteId   String
  assenza    Assenza? @relation(fields: [assenzaId], references: [id], onDelete: Cascade)
  assenzaId  String?
  nomeFile   String
  tipoMime   String
  dimensione Int // byte
  dati       Bytes
  protocollo String   @default("") // numero di protocollo del certificato, se c'è
  caricatoIl DateTime @default(now())

  @@index([utenteId])
  @@index([assenzaId])
}

model Utente {
  id            String    @id @default(cuid())
  email         String    @unique
  nome          String
  // scrypt: "salt:hash" in esadecimale, vedi src/lib/password.ts
  passwordHash  String
  // admin | partner | commerciale — valori in src/lib/ruoli.ts.
  // Governa i privilegi (solo admin gestisce gli utenti), NON più quali app si
  // vedono: quelle sono la lista esplicita appAbilitate qui sotto.
  ruolo         String
  // ID delle app che questo utente può aprire (valori in src/lib/apps.ts).
  // Ignorato per gli admin, che vedono comunque tutto il catalogo.
  appAbilitate  String[]  @default([])
  attivo        Boolean   @default(true)
  creatoIl      DateTime  @default(now())
  ultimoAccesso DateTime?
  // Le sessioni (cookie firmati) emesse PRIMA di questo istante non valgono
  // più. `null` = nessuna revoca, tutti i cookie firmati e non scaduti valgono.
  // Si sposta avanti al cambio password e a un eventuale «esci da tutti i
  // dispositivi»: così un cookie rubato muore, cosa che cancellarlo dal client
  // (esci) non otteneva. Confrontato con l'`iat` del cookie in sessioneCorrente.
  sessioniValideDa DateTime?

  // Cartellino: cancellando l'utente sparisce anche il suo cartellino (cascade).
  timbrature  Timbratura[]
  assenze     Assenza[]
  certificati Certificato[]
  tokenReset  TokenReset[]

  @@index([ruolo])
}

// Recupero password: un token monouso mandato per email a chi dichiara di aver
// dimenticato la password. A database NON c'e mai il token in chiaro, solo il
// suo SHA-256: chi legge la tabella (o un backup) non puo' usarlo per entrare,
// esattamente come per i token di servizio della cassaforte.
model TokenReset {
  id       String   @id @default(cuid())
  utente   Utente   @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  utenteId String
  // SHA-256 esadecimale del token in chiaro. Unico: due richieste non possono
  // collidere, e la ricerca avviene per hash (mai per utente + confronto).
  hash     String   @unique
  scadeIl  DateTime
  // Valorizzato quando il token viene speso: da li' in poi non vale piu'
  // (monouso). Non si cancella la riga: serve a raccontare cosa e' successo.
  usatoIl  DateTime?
  creatoIl DateTime @default(now())
  // SHA-256 dell'indirizzo IP di chi ha chiesto il recupero, con il segreto
  // dell'app come sale: serve SOLO a frenare chi ne chiede troppi. L'IP in
  // chiaro e' un dato personale e non ha ragione di stare qui.
  ipHash   String   @default("")

  @@index([utenteId, creatoIl])
  @@index([ipHash, creatoIl])
}
