// ============================================================
// Deluxy Platform - Schema dati completo
// ------------------------------------------------------------
// PostgreSQL ovunque (dev e prod): DATABASE_URL="postgresql://..."
//   In locale si usa il Postgres di docker-compose; in cloud Supabase.
//   Gli "enum" restano modellati come String (eredita' della fase
//   SQLite, non ancora convertiti a enum nativi Postgres); i valori
//   ammessi sono definiti in api/src/common/enums.ts e validati nei DTO.
// ============================================================

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x serve al runtime serverless di Vercel: senza questo
  // target il query engine non viene incluso nel bundle della funzione.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Utenti e ruoli
// role: ADMIN | OPERATION | PARTNER | VALET | PROJECT_MANAGER
// isSupport: admin "support" -> vede Finanza / marginalita'
// ------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  email        String   @unique
  passwordHash String?  // null finché l'utente non accetta l'invito e sceglie la password
  firstName    String
  lastName     String
  role         String
  isSupport    Boolean  @default(false)
  /// Quando è entrato l'ultima volta: base della regola «valet fermo 90 giorni
  /// → inattivo». Null = mai registrato (il campo esiste dal 26/08/2026).
  lastLoginAt  DateTime?
  // Stato dell'ACCESSO (separato dall'operatività dell'anagrafica):
  //  invited   -> creato, non ha ancora scelto la password (non può entrare)
  //  active    -> può accedere
  //  suspended -> sospeso temporaneo (non può entrare, torna attivabile)
  //  archived  -> cessato (non può entrare; il record resta per lo storico)
  status       String   @default("invited")
  // Invito: token monouso a scadenza con cui la persona sceglie la password
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  activatedAt          DateTime?
  /// RESET PASSWORD (27/08/2026). Token monouso a scadenza breve.
  ///
  /// ⚠️ In colonna sta l'IMPRONTA sha256 del token, non il token: chi legge il
  /// database non deve poter entrare nell'account di nessuno. Il valore vero
  /// esiste solo dentro il link che arriva per mail.
  ///
  /// ⚠️ È un campo SEPARATO dall'invito, non lo stesso riusato: un invito e un
  /// reset hanno regole diverse (l'invito attiva l'account, il reset no) e
  /// riusare la stessa colonna vorrebbe dire che chiedere un reset annulla un
  /// invito in sospeso.
  resetTokenHash       String?   @unique
  resetTokenExpiresAt  DateTime?
  resetRequestedAt     DateTime?
  partnerId    String?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  valetId      String?  @unique
  valet        Valet?   @relation(fields: [valetId], references: [id])
  operationId  String?    @unique
  operation    Operation? @relation(fields: [operationId], references: [id])
  /// account di accesso di un cliente (ruolo CUSTOMER)
  customerId   String?    @unique
  customer     Customer?  @relation(fields: [customerId], references: [id])
  savedViews   SavedView[]
  events       UserEvent[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  deliveriesCreated      Delivery[] @relation("DeliveryCreataDa")
  deliveriesReadAsPartner Delivery[] @relation("DeliveryLettaDaPartner")
  deliveriesReadAsValet   Delivery[] @relation("DeliveryLettaDaValet")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// Notifiche (equivalente del modulo `web-push-notification`
// del backend legacy, contatore in header + storico).
// ============================================================

/// Una notifica destinata a un utente. Resta a storico anche dopo la lettura:
/// il contatore in header conta solo quelle con readAt = null.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Valori in NotificationType (api/src/common/enums.ts).
  type   String
  title  String
  body   String
  /// Entita' che ha generato la notifica, per portare l'utente al dettaglio
  /// al click (es. "delivery" + id della consegna).
  entityType String?
  entityId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Il contatore delle non lette e' la query piu' frequente dell'app.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Iscrizione Web Push di un browser (una per dispositivo/browser).
/// L'endpoint e' l'identificatore univoco assegnato dal push service.
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  /// Chiavi del client per cifrare il payload (standard Web Push).
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Registro delle azioni sugli utenti (audit): chi ha invitato/attivato/
// sospeso/archiviato chi, quando e con quale nota.
model UserEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // created | invited | activated | suspended | archived | reactivated | role_changed
  actorId    String?  // id dell'utente che ha compiuto l'azione (null = sistema)
  actorEmail String?
  note       String?
  createdAt  DateTime @default(now())
}

/**
 * Vista di visualizzazione rapida salvata dall'utente su una lista:
 * memorizza ricerca/ordinamento/paginazione/filtri per richiamarli con un clic.
 * Legata all'utente (segue l'account, non il browser).
 */
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sezione: deliveries | products | customers | partners | valets | categories | services | operators
  section   String
  name      String
  // JSON con lo stato della lista: { q, sort, dir, pageSize, ...filtri specifici }
  config    String
  // Vista condivisa con tutto il team (non solo con chi l'ha creata)
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, section])
}

// ------------------------------------------------------------
// Geografia: province e citta'
// ------------------------------------------------------------
model Province {
  id                String             @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  name              String
  code              String             @unique // es. "MI"
  cities            City[]
  partnerProvinces  PartnerProvince[]
  valetProvinces    ValetProvince[]
  categoryDiscounts CategoryDiscount[]
  sales             Sale[]
  deliveries        Delivery[]
  priorityLists     PriorityList[]
}

model City {
  id         String   @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  name       String
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])
}

/// La COMMISSIONE DI INCASSO per metodo di pagamento.
///
/// ⭐ 25/08/2026: prima la Finanza toglieva un 3% fisso a tutti. Ma il costo
/// di incassare dipende da COME ha pagato il cliente — Shopify Payments non
/// costa quanto PayPal, e un bonifico o un contrassegno non costano affatto
/// quello. Il metodo lo sa Deluxy Orders (`gateway` e `categoriaPagamento`).
///
/// ⚠️ `confermata` esiste perche' queste percentuali sono state CERCATE, non
/// lette da un contratto: le tariffe cambiano col piano e le fonti pubbliche
/// non concordano (per PayPal si trova 2,49%, 3,4% e 3,49% a seconda di dove
/// si guarda). Finche' resta `false` il numero e' una stima dichiarata, e la
/// pagina lo dice. Chi ha in mano la fattura del gestore la conferma.
///
/// ⚠️ La commissione ha DUE parti: una percentuale e una quota FISSA per
/// transazione. Sui piccoli importi la fissa pesa piu' della percentuale —
/// 0,25 € su un ordine da 8 € sono il 3,1% — e tenerla fuori dal conto
/// sottostima proprio gli ordini che gia' rendono poco.
model CommissioneIncasso {
  id          String    @id @default(cuid())
  /// Il gateway come lo scrive Shopify: `shopify_payments`, `paypal`, `manual`…
  gateway     String
  /// Il NEGOZIO a cui vale la tariffa; null = tutti.
  ///
  /// ⚠️ Serve perche' la commissione di Shopify Payments dipende dal PIANO, e
  /// il piano e' del negozio: Deluxy sta sul Basic dappertutto tranne che su
  /// «gifts» (`deluxygifts.myshopify.com`, brand `deluxy.it`), che sta sul
  /// piano subito sopra. Una tariffa sola per tutti sarebbe sbagliata proprio
  /// sul negozio piu' grande — 11.800 ordini su 14.406.
  brand       String?
  /// La categoria di Orders: carta | bonifico | contrassegno | altro.
  categoria   String?
  /// Quota percentuale sull'incassato.
  percentuale Float     @default(0)
  /// Quota fissa per transazione.
  fissa       Float     @default(0)
  /// Da quando vale (null = da sempre); le tariffe cambiano nel tempo, e
  /// questa tabella non deve ripetere l'errore del listino valet.
  validoDa    DateTime?
  validoA     DateTime?
  /// Dove l'abbiamo presa: serve a poterla rimettere in discussione.
  fonte       String?
  /// `false` = stima cercata, non confermata da un documento nostro.
  confermata  Boolean   @default(false)
  note        String?
  attiva      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([gateway, brand, validoDa])
  @@index([gateway, brand, validoDa])
}

// ------------------------------------------------------------
// Tipi di servizio
// pricingModel: PREZZO_FISSO | A_ORA | VENDITA | CORPORATE | MAGAZZINO
// MAGAZZINO: basePrice + perPiecePrice + transportPrice
// A_ORA: minimo 1 ora (minHours)
// Il matching automatico avviene per pricingModel:
//   servizio prezzo fisso del partner <-> salario prezzo fisso del valet
// ------------------------------------------------------------
model ServiceType {
  id              String           @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  name            String
  code            String           @unique
  pricingModel    String // VENDITA | PREZZO_FISSO | A_ORA | MAGAZZINO | CORPORATE
  scope           String           @default("partner") // partner | valet | both
  basePrice       Float? // magazzino: prezzo fisso
  perPiecePrice   Float? // magazzino: prezzo a pezzo
  transportPrice  Float? // magazzino: prezzo consegna
  deliveryPrice   Float? // magazzino: prezzo consegna (nuovo)
  minHours        Int?             @default(1)
  // Setup prenotazione (usato dalle regole di richiesta servizio)
  noticeDays      Int? // giorni di preavviso
  slotHours       Int? // fascia oraria: 1 | 2 | 4 (ore)
  maxOrderTime    String? // ora massima inserimento giornaliero "HH:MM" (fine generazione fasce consegna)
  minOrderTime    String? // ora minima inserimento giornaliero "HH:MM" (inizio generazione fasce consegna)
  allowFlexibleTime Boolean        @default(false) // consente la fascia di consegna flessibile (dalle–alle)
  notes           String?
  hideCustomerInfo Boolean         @default(false)
  active          Boolean          @default(true)
  partnerServices PartnerService[]
  valetServices   ValetService[]
  recurringServices RecurringService[]
  deliveries      Delivery[]
  deliveryRules   DeliveryRule[]
}

// ------------------------------------------------------------
// Partner (negozi)
// ------------------------------------------------------------
model Partner {
  id                  String            @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  insegna             String
  businessName        String? // ragione sociale
  email               String            @unique
  vatNumber           String? // P.IVA
  fiscalCode          String? // CF
  address             String?
  /// Citta' e coordinate dal database originario. La citta' NON e' sempre
  /// dentro l'indirizzo (32 partner e 78 valet ce l'hanno solo qui), e le
  /// coordinate servono a calcolare le distanze senza richiamare Maps.
  city                String?
  latitude            Float?
  longitude           Float?
  phone               String?
  contactName         String? // referente
  invoicingEnabled    Boolean           @default(false)
  invoiceEmail        String?
  smsTemplatesEnabled Boolean           @default(false)
  notificationsEnabled Boolean          @default(true)
  documentation       String?
  notes               String?
  woocommerceApiKey   String?           @unique
  // Stato pagamenti del partner (legacy): active | inactive | blocked
  paymentStatus       String            @default("active")
  // Metodo di pagamento (legacy): bankTransfer | creditCard | directDebitMandate
  paymentMethod       String?
  // Referente: nome (contactName) + cognome
  contactSurname      String?
  // Notifiche granulari (come nell'app reale)
  whatsappNotifications Boolean         @default(false)
  mailNotifications   Boolean           @default(false)
  // Pagamenti e contratto
  bankAccount         String? // IBAN
  bankAccountName     String? // intestatario conto
  sdiCode             String? // codice SDI fatturazione elettronica
  // --- dati amministrativi che arrivano dal registro Anagrafiche ---
  /// Referente amministrazione del registro (non il referente commerciale).
  adminName           String?
  adminEmail          String?
  adminPhone          String?
  /// Stato finanziario secondo il registro: da_verificare | regolare | in_ritardo | insoluto.
  /// ⚠️ Nel registro vale `da_verificare` su 1.034 anagrafiche su 1.057, cioe' e'
  /// il valore predefinito: solo 23 dicono davvero qualcosa.
  financialStatus     String?
  certifiedEmail      String? // PEC
  contractStart       DateTime?
  contractEnd         DateTime?
  /// Il vecchio sistema aveva gia' avvisato della scadenza del contratto.
  /// Si importa per non rimandare a quel partner un avviso che ha gia' avuto.
  contractExpiryNotified Boolean        @default(false)
  // Notifiche extra
  activityReminder    Boolean           @default(false) // promemoria attività
  // KM a livello partner (soglia inclusa entro il comune + extra fuori città)
  kmIncluded          Float?
  extraOutOfCityPrice Float?
  // Commissione del partner (Fee%): usata dalla Finanza per Fee value = Fee% x prezzo partner.
  commissionPercent   Float             @default(0)
  /// Il partner tiene merce da noi. Nel legacy e' `partner.partnerHasWarehouse`:
  /// se e' spento, i servizi di magazzino a listino NON si mostrano, anche quando
  /// la riga esiste (3 partner su 267 sono in questo stato, fra cui 142 RESTAURANT).
  hasWarehouse        Boolean           @default(false)
  // Tipo codice di consegna (quando deliveryCodeRequired): UNIQUE_PER_DELIVERY | UNIQUE_PER_CUSTOMER
  deliveryCodeCheckType String          @default("UNIQUE_PER_DELIVERY")
  // Indirizzo di ritiro multiplo (+ lista indirizzi come JSON per compat. SQLite)
  isMultiPickup       Boolean           @default(false)
  pickupAddresses     String? // JSON array di indirizzi di ritiro aggiuntivi
  // Campi di vendita
  storeUrl            String?
  imageUrl            String?
  // Sicurezza
  valetIdentityCheck  Boolean           @default(false)
  deliveryCodeRequired Boolean          @default(false)
  // Partner magazzino
  isWarehouse         Boolean           @default(false)
  active              Boolean           @default(true)
  provinces           PartnerProvince[]
  services            PartnerService[]
  categories          PartnerCategory[]
  openingHours        OpeningHour[]
  dayExceptions       PartnerDayException[]
  daySlots            PartnerDaySlot[]
  products            Product[]
  deliveries          Delivery[]
  recurringServices   RecurringService[]
  customers           Customer[]
  users               User[]
  smsTemplates        SmsTemplate[]
  sales               Sale[]
  deliveryRules       DeliveryRulePartner[]
  invoices            Invoice[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  priorityEntries     PriorityEntry[]
  quoteRequests       QuoteRequest[]
}

// ------------------------------------------------------------
// Richieste di PREVENTIVO dei partner, dal loro accesso (es. «torta come in
// foto per 30 persone, Cernobbio, 30 agosto»). La foto e' un data URL
// compresso dal client (niente storage esterno: su serverless il disco
// sparisce al redeploy — stessa ragione del problema noto delle ricevute).
// L'ufficio risponde qui (reply) e/o su WhatsApp (numero nelle impostazioni).
// stato: aperta | in_lavorazione | risposta
// ------------------------------------------------------------
model QuoteRequest {
  id           String    @id @default(cuid())
  partnerId    String
  partner      Partner   @relation(fields: [partnerId], references: [id])
  description  String
  people       Int?
  city         String?
  requestedFor DateTime? // data di consegna desiderata
  photo        String? // data URL (immagine compressa lato client)
  status       String    @default("aperta")
  reply        String? // risposta dell'ufficio, visibile al partner
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PartnerProvince {
  id         String   @id @default(cuid())
  partnerId  String
  provinceId String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  province   Province @relation(fields: [provinceId], references: [id])

  @@unique([partnerId, provinceId])
}

// Servizi abilitati per partner: prezzo, KM inclusi, extra fuori citta', extra KM
model PartnerService {
  id                  String      @id @default(cuid())
  partnerId           String
  serviceTypeId       String
  price               Float
  includedKm          Float       @default(0)
  extraKmPrice        Float       @default(0)
  extraOutOfCityPrice Float       @default(0)
  /// Prezzo a pezzo (servizi magazzino). Gemello di ValetService.salaryPerItem,
  /// che sul lato partner mancava: nel legacy 10 listini lo usano.
  pricePerItem        Float?
  partner             Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  serviceType         ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@unique([partnerId, serviceTypeId])
}

// Categorie di prodotto vendute dal partner, con priorita' di smistamento vendite
/// La LISTA PRIORITA' di una coppia (provincia, categoria).
///
/// E' il cuore dello smistamento dei prodotti NON UNICI: quando arriva un
/// ordine, si scorre questa lista nell'ordine deciso e si propone al primo
/// partner aperto. Nel database originario sono due tabelle senza nome
/// (`tabella-53` le liste, `tabella-54` i partner dentro): 29 liste e 49
/// partner ordinati.
///
/// ⚠️ Non e' la stessa cosa di `PartnerCategory`, che dice solo QUALI categorie
/// tratta un partner senza dire dove ne' in che ordine. Fino al 24/08/2026 lo
/// smistamento usava quella, e le sue 455 righe avevano tutte `priority = 0`:
/// ordinava per un campo uguale per tutti, cioe' non ordinava affatto.
model PriorityList {
  id         String   @id @default(cuid())
  /// id nel database originario MySQL
  legacyId   Int?     @unique
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  entries    PriorityEntry[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provinceId, categoryId])
}

/// Un partner dentro una lista priorita', con la sua posizione.
model PriorityEntry {
  id       String       @id @default(cuid())
  /// id nel database originario MySQL
  legacyId Int?         @unique
  listId   String
  list     PriorityList @relation(fields: [listId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// Posizione: 1 = primo a cui si propone.
  position  Int         @default(1)

  @@unique([listId, partnerId])
  @@index([listId, position])
}

model PartnerCategory {
  id         String   @id @default(cuid())
  partnerId  String
  categoryId String
  priority   Int      @default(0) // ordine nella lista priorita' smistamento vendite
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([partnerId, categoryId])
}

// Orari di apertura settimanali (dayOfWeek: 0=domenica ... 6=sabato)
model OpeningHour {
  id        String  @id @default(cuid())
  partnerId String
  dayOfWeek Int
  openTime  String? // "09:00"
  closeTime String? // "19:30"
  closed    Boolean @default(false)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, dayOfWeek])
}

// Eccezioni per DATA specifica (chiusura straordinaria o orario speciale):
// vincono sull'orario settimanale per quel giorno. Una riga per (partner, data).
/// Fascia oraria di apertura di un partner in un giorno preciso.
/// ⚠️ Esiste perche' `PartnerDayException` ne ammette UNA sola per data
/// (@@unique partnerId+date), mentre nel database originario un partner puo'
/// avere piu' finestre nello stesso giorno: misurato, 8.466 giorni hanno due o
/// piu' fasce diverse (es. 12:00-14:30 e 19:30-23:30). Comprimerle in una sola
/// perdeva silenziosamente le altre.
model PartnerDaySlot {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  date      DateTime
  timeFrom  String?
  timeTo    String?
  available Boolean  @default(true)

  @@index([partnerId, date])
}

model PartnerDayException {
  id        String   @id @default(cuid())
  partnerId String
  date      DateTime // giorno specifico (mezzanotte UTC)
  closed    Boolean  @default(false)
  openTime  String? // "09:00" (orario speciale, se non chiuso)
  closeTime String? // "13:00"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, date])
}

// ------------------------------------------------------------
// Valet (corrieri)
// ------------------------------------------------------------
// NB: nella piattaforma legacy il valet si chiama internamente "expert"
// (es. endpoint /api/experts/...). Qui usiamo "valet" come nel linguaggio
// di business.
model Valet {
  id                  String            @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  firstName           String
  lastName            String
  email               String            @unique
  phone               String?
  address             String?
  /// Citta' e coordinate dal database originario. La citta' NON e' sempre
  /// dentro l'indirizzo (32 partner e 78 valet ce l'hanno solo qui), e le
  /// coordinate servono a calcolare le distanze senza richiamare Maps.
  city                String?
  latitude            Float?
  longitude           Float?
  hasVat              Boolean           @default(false) // flag P.IVA
  vatNumber           String?
  fiscalCode          String?
  birthPlace          String?
  birthDate           DateTime?
  iban                String?
  /// ⭐ Non e' una persona: e' il segnaposto «Consegna Partner», usato quando
  /// la consegna se l'e' fatta il partner e non c'e' nessun valet da pagare.
  ///
  /// Serve una colonna perche' riconoscerlo dal NOME sarebbe pericoloso: c'e'
  /// un valet vero che si chiama «Consegna Amin» (una persona, 220 consegne da
  /// pagare) e una regola larga su «consegna» lo cancellerebbe dagli stipendi.
  placeholder         Boolean           @default(false)
  isTeamLeader        Boolean           @default(false)

  // Team leader: province dove può assegnare + partner associati + partner esclusi (JSON array di id, compat. SQLite)
  teamLeaderProvinces String?
  teamLeaderPartners  String?
  teamLeaderExcludedPartners String? // partner esclusi dallo scope del team leader
  vehicle             String? // mezzi (anche piu' d'uno, separati da virgola): Auto | Bicicletta | Furgone | Moto/Scooter
  /// Modello per ciascun mezzo scelto, JSON {"Auto":"Fiat Panda",...}
  vehicleModels       String?
  withholdingPercent  Float             @default(0) // % ritenuta rimborso
  // Stipendio
  salaryFrequency     String            @default("monthly") // monthly | weekly
  weeklyDepositLimit  Float?
  // KM a livello valet
  minimumKmIncluded   Float? // soglia KM inclusi entro il comune
  extraOutOfCityPrice Float? // rimborso extra fuori dal comune
  notes               String?
  notifyByEmail       Boolean           @default(true)
  notifyByWhatsapp    Boolean           @default(false)
  active              Boolean           @default(true)
  provinces           ValetProvince[]
  services            ValetService[]
  deliveries          Delivery[]
  recurringServices   RecurringService[]
  /// Eccezioni di giorno che assegnano QUESTO valet solo in certi giorni.
  varianteRicorrenti  RecurringServiceVariant[]
  activities          Activity[]
  availabilities      ValetAvailability[]
  openingHours        ValetOpeningHour[]
  salaries            Salary[]
  payments            Payment[]
  deliveryRules       ValetDeliveryRuleValet[]
  receipts            Receipt[]
  user                User?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model ValetProvince {
  id         String   @id @default(cuid())
  valetId    String
  provinceId String
  valet      Valet    @relation(fields: [valetId], references: [id], onDelete: Cascade)
  province   Province @relation(fields: [provinceId], references: [id])

  @@unique([valetId, provinceId])
}

// Servizi con salario per valet (matching per pricingModel con PartnerService)
/// Il listino del valet per un servizio, CON LA SUA STORIA.
///
/// ⭐ 25/08/2026: prima c'era una riga sola per coppia valet+servizio, cioe' la
/// tariffa di OGGI e basta. Verificare una paga del 2024 contro quella riga
/// significa confrontarla con un listino che allora non esisteva: SERGIO DE
/// ROSA ha oggi «Consegna Standard» a 8,00 €, ma nel 2024 l'importo ricorrente
/// e' 7,20 € (781 volte) e nel 2025 ancora (916), e diventa 8,00 solo nel 2026.
/// Il risultato erano 4.120 consegne «non spiegate», di cui **3.260 pagavano
/// semplicemente la tariffa di allora**.
///
/// Ora una coppia valet+servizio puo' avere piu' righe, ognuna col suo periodo.
/// `validFrom` nullo = «da sempre»; `validTo` nullo = «ancora in vigore».
///
/// ⚠️ Il vincolo unique comprende `validFrom` proprio per permettere la storia:
/// tenerlo su (valetId, serviceTypeId) e' una regola di business piu' stretta
/// della realta', e una regola cosi' non da' errore — cancella in silenzio.
/// E' la stessa lezione delle fasce dei valet, dove un unique troppo stretto
/// aveva fatto perdere 366 disponibilita' durante l'import.
model ValetService {
  id            String      @id @default(cuid())
  /// id nel database originario MySQL: serve a ricollegare expertServiceId delle consegne
  legacyId      Int?        @unique
  valetId       String
  serviceTypeId String
  salary        Float
  salaryPerItem Float? // per i servizi magazzino (salario a pezzo)
  extraKmPrice  Float? // Extra KM/€
  /// Da quando vale questa tariffa (null = da sempre).
  validFrom     DateTime?
  /// Fino a quando (null = ancora in vigore).
  validTo       DateTime?
  /// Da dove viene la riga: `listino` (tariffa corrente, inserita o importata)
  /// oppure `dedotta` (ricostruita dagli importi davvero pagati).
  ///
  /// ⚠️ Serve a non far passare una ricostruzione per un documento: una
  /// tariffa dedotta dai pagamenti spiega la storia, non la certifica.
  origine       String      @default("listino")
  valet         Valet       @relation(fields: [valetId], references: [id], onDelete: Cascade)
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@unique([valetId, serviceTypeId, validFrom])
  @@index([valetId, serviceTypeId, validFrom])
}

// Disponibilita' del valet per DATA specifica (impostata dal valet dal calendario):
// available=false -> non disponibile; timeFrom/timeTo -> disponibile solo in fascia.
/// Orario settimanale del valet: il gemello di OpeningHour lato partner.
///
/// Prima esisteva solo la disponibilita' giorno per giorno (ValetAvailability),
/// cioe' migliaia di righe per dire «il lunedi' lavoro dalle 9 alle 18». Il
/// modello e' quello di Google: una settimana tipo, piu' le date che fanno
/// eccezione.
model ValetOpeningHour {
  id        String  @id @default(cuid())
  valetId   String
  dayOfWeek Int
  openTime  String? // "09:00"
  closeTime String? // "18:00"
  closed    Boolean @default(false)
  valet     Valet   @relation(fields: [valetId], references: [id], onDelete: Cascade)

  @@unique([valetId, dayOfWeek])
}

model ValetAvailability {
  id        String   @id @default(cuid())
  valetId   String
  date      DateTime
  timeFrom  String? // "08:00"
  timeTo    String? // "20:00"
  available Boolean  @default(true)
  note      String?
  valet     Valet    @relation(fields: [valetId], references: [id], onDelete: Cascade)

  // ⚠️ La chiave comprende la FASCIA, non solo il giorno.
  //
  // Con `@@unique([valetId, date])` un valet poteva avere una disponibilita'
  // sola al giorno, e nel legacy ne ha fino a sei: 325 fasce distinte non sono
  // mai entrate — chi guardava vedeva «disponibile 16:00-18:00» dove in realta'
  // c'era anche «12:00-18:00». È lo stesso vincolo troppo stretto che aveva gia'
  // fatto perdere le finestre dei partner in `PartnerDayException`.
  @@unique([valetId, date, timeFrom, timeTo])
}

// ------------------------------------------------------------
// Prodotti e categorie
// type: UNICO | NON_UNICO | SUPERPRODOTTO
// - UNICO: appartiene a un partner
// - NON_UNICO: es. fiori, vendibile da piu' partner
// - SUPERPRODOTTO: combinazione di altri prodotti (ProductComponent)
// isAutoDiscounted + parentProductId: prodotti scontati generati
//   automaticamente dagli sconti % per categoria/provincia
// ------------------------------------------------------------
model Category {
  id               String             @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  name             String             @unique
  notes            String?
  aiPrompt         String? // prompt per generazione AI (es. torte)
  /// Fuori dal catalogo corrente, ma non cancellata.
  ///
  /// ⚠️ Archiviare una categoria NON tocca i prodotti che ce l'hanno: 16
  /// categorie su 65 non hanno più un prodotto in lista, ma i loro prodotti
  /// archiviati continuano a dire a quale categoria appartenevano — e senza
  /// quel nome una scheda del 2023 diventa illeggibile.
  ///
  /// Sparisce dalle tendine di scelta, resta ovunque sia già scritta.
  archived         Boolean            @default(false)
  archivedAt       DateTime?
  products         Product[]
  discounts        CategoryDiscount[] // sconto % per provincia
  fields           CategoryField[] // campi testuali extra per i prodotti della categoria
  partnerCategories PartnerCategory[]
  priorityLists    PriorityList[]
}

// Campo testuale extra definito a livello categoria.
// fieldType: optional | required | admin (solo admin)
model CategoryField {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  fieldType  String   @default("optional")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// Sconto % per categoria e provincia -> genera prodotti scontati automatici
model CategoryDiscount {
  id              String   @id @default(cuid())
  categoryId      String
  provinceId      String
  discountPercent Float
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  province        Province @relation(fields: [provinceId], references: [id])

  @@unique([categoryId, provinceId])
}

model Product {
  id                      String             @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  name                    String
  description             String?
  shortDesc               String? // "Plus del prodotto" (max 80 char)
  price                   Float
  publicPrice             Float? // prezzo pubblico
  sku                     String?
  prepDays                Int? // giorni di preparazione
  line                    String? // linea/brand
  imageUrl                String? // immagine principale
  images                  String? // JSON array di URL immagine (galleria/Shopify)
  platformDescriptions    String? // JSON { piattaforma: descrizione } per SELECT PLATFORMS
  /// JSON { piattaforma: idProdotto } sulle 6 piattaforme di vendita del legacy.
  platformProductIds      String?
  /// Storico prezzi del legacy (JSON).
  priceHistory            String?
  /// Campi extra della categoria, valorizzati sul prodotto (JSON).
  categoryMetaFields      String?
  /// Codice di riferimento interno del legacy.
  reference               String?
  /// Provincia dichiarata sul prodotto nel legacy.
  legacyProvince          String?
  /// Disponibilita' dichiarata nel legacy.
  availability            String?
  /// Origine della creazione (creationSource).
  createdFrom             String?
  approvalEmailSent       Boolean            @default(false)
  deletedAt               DateTime?
  approved                Boolean            @default(false)
  /// Chi lo vende: UNICO (di un partner solo) | NON_UNICO (lista priorità).
  ///
  /// ⚠️ SUPERPRODOTTO non è un tipo: nel legacy `uniqueProduct` e
  /// `isSuperProduct` sono DUE colonne indipendenti, e l'utente ha confermato
  /// il 24/08/2026 che restano separate. Sono due domande diverse — *chi lo
  /// vende* e *com'è fatto* — e un prodotto può essere unico E combinato.
  /// Averle fuse in un enum rendeva quella combinazione inesprimibile.
  type                    String // UNICO | NON_UNICO
  /// Com'è fatto: combinazione di più prodotti (i componenti stanno in
  /// ProductComponent). Indipendente da `type`.
  isSuperProduct          Boolean            @default(false)
  partnerId               String?
  partner                 Partner?           @relation(fields: [partnerId], references: [id])
  categoryId              String?
  category                Category?          @relation(fields: [categoryId], references: [id])
  visibleToOtherPartners  Boolean            @default(false)
  // Flag prodotto (come app reale)
  notEditable             Boolean            @default(false) // non modificabile
  controlStock            Boolean            @default(false) // controlla stock
  stock                   Int? // giacenza (se controlStock)
  notPhysical             Boolean            @default(false) // prodotto non fisico
  isSuperProvince         Boolean            @default(false) // super provincia
  useAlternateName        Boolean            @default(false)
  alternateName           String? // nome alternativo del prodotto
  // Piattaforme di vendita abilitate (JSON array: deluxy|cakes|flowers|business|experience|dotcom)
  platforms               String?
  // Varianti
  hasVariants             Boolean            @default(false)
  optionTitle             String? // titolo opzione varianti (es. "Dimensione")
  variants                ProductVariant[]
  // Partner aggiuntivi che vendono il prodotto (oltre al partner proprietario)
  partnerLinks            ProductPartnerLink[]
  isAutoDiscounted        Boolean            @default(false)
  parentProductId         String?
  parentProduct           Product?           @relation("DiscountedVariants", fields: [parentProductId], references: [id])
  discountedVariants      Product[]          @relation("DiscountedVariants")
  components              ProductComponent[] @relation("SuperProduct")
  usedInSuperProducts     ProductComponent[] @relation("ComponentProduct")
  fields                  ProductField[]
  deliveryProducts        DeliveryProduct[]
  sales                   Sale[]
  active                  Boolean            @default(true)
  // Archiviato: stato SEPARATO da `active`. Un prodotto disattivato resta
  // visibile nella lista principale; uno archiviato va nella sezione Archivio.
  archived                Boolean            @default(false)
  archivedAt              DateTime?
  /// Perche' e' finito in archivio: `partner-disattivato` quando ci e' andato
  /// da solo, `null` quando l'ha archiviato una persona.
  ///
  /// Serve a poter DISFARE la regola automatica: riattivando il partner si
  /// ripescano solo i prodotti che erano stati archiviati per causa sua, e non
  /// quelli che qualcuno aveva archiviato apposta.
  archivedReason          String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

// Variante di prodotto (es. taglia S/M/L), con proprio prezzo e SKU
model ProductVariant {
  /// id nel database originario MySQL
  legacyId     Int?    @unique
  id           String  @id @default(cuid())
  productId    String
  name         String // valore opzione (es. "Media")
  price        Float?
  publicPrice  Float? // prezzo pubblico variante
  sku          String? // SKU variante (auto: <SKU prodotto>-NN progressivo)
  imageUrl     String? // immagine della variante
  prepDays     Int? // giorni di preparazione variante
  controlStock Boolean @default(false) // controlla stock variante
  stock        Int? // giacenza variante
  active       Boolean @default(true)
  /// La stessa variante in Merchandising, che ne e' la casa.
  ///
  /// La variante dice COM'E' FATTO il prodotto (taglia, colore), e questo e'
  /// mestiere del PLM. Qui serve a due cose sole: riconoscere lo SKU di un
  /// ordine e prezzare una riga di consegna.
  ///
  /// ⚠️ 5.201 varianti esistono in tutte e due le app con lo stesso SKU. Il
  /// collegamento non le sposta: dichiara chi comanda, cosi' quando i due
  /// valori discordano si sa quale guardare invece di indovinare.
  merchandisingId String?
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  deliveryProducts DeliveryProduct[]
  sales        Sale[]
}

// Associazione prodotto <-> partner aggiuntivo (PRODUCTS PARTNER)
model ProductPartnerLink {
  id        String  @id @default(cuid())
  productId String
  partnerId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, partnerId])
}

// Componenti di un superprodotto
model ProductComponent {
  id                 String  @id @default(cuid())
  superProductId     String
  componentProductId String
  quantity           Int     @default(1)
  superProduct       Product @relation("SuperProduct", fields: [superProductId], references: [id], onDelete: Cascade)
  componentProduct   Product @relation("ComponentProduct", fields: [componentProductId], references: [id])

  @@unique([superProductId, componentProductId])
}

// Campi testuali del prodotto (obbligatori / opzionali / solo-admin)
model ProductField {
  id        String  @id @default(cuid())
  productId String
  name      String
  required  Boolean @default(false)
  adminOnly Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// Clienti
// ------------------------------------------------------------
model Customer {
  id         String     @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  firstName  String
  lastName   String
  email      String?
  phone      String?
  address    String?
  notes      String?
  partnerId  String?
  partner    Partner?   @relation(fields: [partnerId], references: [id])
  deliveries Delivery[]
  sales      Sale[]
  /// account di accesso del cliente (facoltativo)
  user       User?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ------------------------------------------------------------
// SERVIZI RICORRENTI (27/08): il presidio che si ripete — «ogni lunedi'
// 7-8 per Chanel», «sabato e domenica 13-14». Un cron genera le consegne
// del giorno; a ciascuna si applicano le regole carnet del partner.
// `giorni` e' una maschera lun..dom ("1000000" = solo lunedi').
// ------------------------------------------------------------
model RecurringService {
  id                 String       @id @default(cuid())
  nome               String
  partnerId          String
  partner            Partner      @relation(fields: [partnerId], references: [id])
  serviceTypeId      String
  serviceType        ServiceType  @relation(fields: [serviceTypeId], references: [id])
  valetId            String?
  valet              Valet?       @relation(fields: [valetId], references: [id])
  /// COME SI RIPETE (27/08/2026). Prima esisteva solo il giro settimanale, e
  /// «il 1° di ogni mese» o «ogni tre giorni» non si potevano dire.
  ///   SETTIMANALE  -> i giorni della settimana in `giorni`, ogni `ogni` settimane
  ///   GIORNALIERO  -> ogni `ogni` giorni, contati da `dataInizio`
  ///   MENSILE      -> i giorni del mese in `giorniMese`, ogni `ogni` mesi
  frequenza          String       @default("SETTIMANALE")
  /// Ogni quante settimane / giorni / mesi. 1 = tutte.
  ogni               Int          @default(1)
  /// Solo per MENSILE: i giorni del mese separati da virgola, es. "1,15".
  /// ⚠️ Un 31 nei mesi corti NON si arrotonda al 30: il giorno non esiste e
  /// la consegna non si genera. Inventarla sarebbe peggio che saltarla.
  giorniMese         String?
  giorni             String // maschera lun..dom, es. "1000000"
  timeFrom           String // "07:00"
  timeTo             String // "08:00"
  pickupAddress      String?
  recipientFirstName String?
  recipientLastName  String?
  recipientAddress   String
  price              Float? // prezzo al partner, se fisso
  valetSalary        Float? // paga del valet, se fissa (senza, vale il listino)
  hours              Float? // per i servizi a ora
  dataInizio         DateTime
  dataFine           DateTime?
  attivo             Boolean      @default(true)
  note               String?
  ultimaGenerazione  DateTime?
  deliveries         Delivery[]
  /// Le ECCEZIONI per certi giorni (vedi RecurringServiceVariant).
  varianti           RecurringServiceVariant[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

/// ECCEZIONI PER GIORNO di un servizio ricorrente (27/08/2026, chiesto
/// dall'utente): «da lunedi' a venerdi' 7-8, sabato e domenica 8-9».
///
/// La fascia del servizio (`RecurringService.timeFrom/timeTo`) resta quella
/// NORMALE; qui si dichiara solo che cosa cambia in certi giorni. Un giorno
/// senza eccezione usa la fascia normale — cosi' l'eccezione si legge per
/// differenza, e non si e' costretti a ripetere il caso comune sette volte.
///
/// ⚠️ Le maschere NON possono sovrapporsi: due eccezioni che rivendicano lo
/// stesso giorno si rifiutano al salvataggio. Scegliere «la prima» vorrebbe
/// dire far decidere all'ORDINAMENTO quale fascia vale, e l'ordinamento cambia
/// da solo aggiungendo una riga.
model RecurringServiceVariant {
  id                 String           @id @default(cuid())
  recurringServiceId String
  recurringService   RecurringService @relation(fields: [recurringServiceId], references: [id], onDelete: Cascade)
  /// Maschera lun..dom, es. "0000011" = sabato e domenica.
  giorni             String
  timeFrom           String // "08:00"
  timeTo             String // "09:00"
  /// Valet diverso in quei giorni (facoltativo). Vuoto = quello del servizio.
  valetId            String?
  valet              Valet?           @relation(fields: [valetId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([recurringServiceId])
}

// ------------------------------------------------------------
// Consegne
// status: created | assigned | in_preparation | accepted |
//         in_delivery | delivered | not_delivered | cancelled |
//         cancellation_requested | not_accepted |
//         delivered_time_approved | delivered_time_not_approved
// DDT: lo stesso ddtNumber su piu' ritiri (DeliveryPickup) = una consegna
// ------------------------------------------------------------
model Delivery {
  id                 String            @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  // Numero progressivo leggibile (assegnato dal service: max(code)+1;
  // autoincrement su campo non-id non e' supportato da SQLite)
  code               Int               @unique
  date               DateTime // giorno della consegna
  serviceTypeId      String
  serviceType        ServiceType       @relation(fields: [serviceTypeId], references: [id])
  partnerId          String
  partner            Partner           @relation(fields: [partnerId], references: [id])
  valetId            String?
  valet              Valet?            @relation(fields: [valetId], references: [id])
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id])
  status             String            @default("created")
  paymentStatus      String            @default("default") // default | paid | toBePaid
  // Token del link pubblico di monitoraggio (bottone MONITORARE).
  // Casuale e opaco: niente @unique per evitare il rebuild tabella in SQLite,
  // la ricerca usa findFirst.
  trackingToken      String?
  // Conferma di consegna (dal link pubblico "consegnata"): chi ha ritirato.
  receivedBy         String?
  // Fascia oraria consegna + ritiro (se non flessibile => fascia di 1 ora)
  deliveryTimeFrom   String? // "09:00"
  deliveryTimeTo     String? // "13:00"
  deliveryFlexible   Boolean           @default(false)
  pickupTimeFrom     String? // "10:00"
  pickupTimeTo       String? // "12:00"
  pickupFlexible     Boolean           @default(false)
  pickupAddress      String?
  // Destinatario
  recipientFirstName String
  recipientLastName  String
  recipientAddress   String
  // Coordinate geocodificate dell'indirizzo destinatario (per la mappa consegne).
  // Popolate una volta alla creazione/modifica; null se non geocodificabile.
  latitude           Float?
  longitude          Float?
  recipientIntercom  String? // citofono
  recipientPhone     String?
  recipientEmail     String?
  // Mittente
  senderFirstName    String?
  senderLastName     String?
  senderPhone        String?
  // Pagamento alla consegna (contanti detratti dallo stipendio del valet)
  paymentOnDelivery  Boolean           @default(false)
  paymentAmount      Float?
  tryAndReturn       Boolean           @default(false)
  deliveryCodeRequired Boolean         @default(false)
  // Note
  notes              String?
  internalNotes      String? // visibili solo ad admin/operation/valet
  /// Nata da un SERVIZIO RICORRENTE: quale (e la coppia servizio+data non si rigenera).
  /// Le richieste testuali da cui questa consegna e` nata.
  richieste  RichiestaConsegna[]
  recurringServiceId String?
  recurringService   RecurringService? @relation(fields: [recurringServiceId], references: [id], onDelete: SetNull)
  ddtNumber          String?
  /// Il BRAND a cui appartiene il numero DDT/riferimento della vendita:
  /// con piu' negozi lo stesso numero esiste su brand diversi (il DDT «3749»
  /// sta su 16 consegne di 8 partner), e il numero da solo non identifica.
  ddtBrand           String?
  ddtFile            String? // file/URL del DDT
  // Distanza e extra (calcolo automatico ritiro -> consegna)
  distanceKm         Float?
  extraKm            Float             @default(0)
  extraOutOfCity     Boolean           @default(false)
  // Vendita Deluxy + valet servizio
  deluxyDelivery     Boolean           @default(false) // "Vendita Deluxy"
  valetServiceId     String? // "Valet Servizio" (id ValetService/ServiceType)
  // Economia (LISTINO: da fatturare / da pagare)
  billable           Boolean           @default(true) // da fatturare
  payable            Boolean           @default(true) // da pagare
  price              Float? // prezzo per il partner
  additionalPrice    Float? // plus/minus prezzo partner
  deliveryPrice      Float? // "Consegna prezzo": tariffa consegna al cliente (Finanza)
  valetSalary        Float? // paga del valet
  valetAdditionalPrice Float? // plus/minus paga valet
  isFlexiblePrice    Boolean           @default(false)
  flexiblePrice      String? // prezzo flessibile (JSON/testo)
  hours              Float? // per servizi a ora
  personalizeSaleNotes String? // personalizzazione
  // SMS: numero telefonico + trigger
  smsPhoneNo         String?
  smsOnCreated       Boolean           @default(false)
  smsOnDeparted      Boolean           @default(false)
  smsOnArrived       Boolean           @default(false)
  // ==========================================================================
  // Campi recuperati dal database originario (23/08/2026).
  // Delle 114 colonne del `delivery` legacy, 54 avevano gia' una destinazione,
  // 4 erano sempre vuote e 56 no: queste sono quelle, meno cinque scartate
  // perche' ridondanti (`isPickUpTimePassed`/`isDeliveryTimePassed` sono
  // calcolate, `serviceName` e' denormalizzato, `updatedUser` vale 0 ovunque,
  // `createdWith` vale sempre "xl").
  // ==========================================================================

  /// Codice pubblico alfanumerico del legacy (es. "ZhonMV"). Diverso da `code`,
  /// che e' il progressivo interno.
  identifier         String?
  /// Origine della consegna: "SALEAUTOMATION", "chaneldeluxy"…
  createdFrom        String?
  /// Sito da cui e' arrivata (integrazioni WooCommerce/Shopify esterne).
  externalOrderSource String?
  createdByUserId    String?
  createdByUser      User?             @relation("DeliveryCreataDa", fields: [createdByUserId], references: [id])

  // --- ordine e vendita di provenienza --------------------------------------
  // ⚠️ Riferimenti alle tabelle di vendita del legacy, non ancora importate:
  // per ora sono numeri, non relazioni.
  legacyOrderId      Int?
  realOrderNumber    String?
  shop               String? // ShopifySale | CakeSales | FlowersSales | BusinessSales
  /// ⚠️ Contiene sia id interni sia id di ordini Shopify (fino a 12 cifre):
  /// non entra in un intero a 32 bit, quindi e' testo.
  legacySaleId       String?
  legacyPrimarySaleId Int?
  /// Come ha pagato il cliente, per sapere quanto costa incassare.
  ///
  /// ⚠️ Questo dato NON e' nostro: lo possiede Deluxy Orders, che tiene
  /// l'ordine Shopify. Qui e' una copia di comodo per il calcolo del margine,
  /// aggiornata dall'import — non una seconda fonte di verita'. Se i due
  /// divergono, ha ragione Orders.
  paymentGateway     String?
  /// La categoria del pagamento secondo Orders: carta | bonifico | contrassegno | altro.
  paymentCategory    String?
  /// Il negozio Shopify dell'ordine: decide il piano, e il piano la tariffa.
  paymentBrand       String?
  saleType           String? // unique | nonunique | shopifysale
  acceptSale         Boolean           @default(false)
  customSaleDelivery Boolean           @default(false)

  // --- presa visione ---------------------------------------------------------
  // ⚠️ Misurato: nel legacy questi NON sono partner/valet ma UTENTI (non
  // coincidono quasi mai con partnerId/expertId), quindi puntano a User.
  readDelivery       Boolean           @default(false)
  readAt             DateTime?
  readByPartnerUserId String?
  readByPartnerUser  User?             @relation("DeliveryLettaDaPartner", fields: [readByPartnerUserId], references: [id])
  readAtByPartner    DateTime?
  readByValetUserId  String?
  readByValetUser    User?             @relation("DeliveryLettaDaValet", fields: [readByValetUserId], references: [id])
  readAtByValet      DateTime?

  // --- tempi reali -----------------------------------------------------------
  startedAt          DateTime? // quando il valet e' partito
  deliveredAt        DateTime? // quando ha consegnato davvero
  serviceStartTime   String? // servizi a ora: inizio previsto "HH:mm"
  serviceEndTime     String? // servizi a ora: fine prevista
  valetStartTime     String? // orario dichiarato dal valet
  valetEndTime       String?
  approvedTimingStatus String? // stato approvazione delle ore: 0 | 1 | 3

  // --- svolgimento -----------------------------------------------------------
  requestExpert      Boolean           @default(false) // "richiedi valet"
  sendToExpert       Boolean           @default(false)
  pickupCompleted    Boolean           @default(false)
  receiverType       String? // recipient | concierge | other | null
  receiverSign       String? // firma del ricevente
  receipt            String? // foto/ricevuta della consegna
  notDeliveredActionTaken Boolean      @default(false)
  deliveryCode       String?
  deliveryCodeVerified Boolean         @default(false)
  valetIdentityCheck Boolean           @default(false)
  valetVerified      Boolean           @default(false)

  // --- economia --------------------------------------------------------------
  invoiced           Boolean           @default(false)
  invoicePaymentStatus String? // default | paid
  productValue       Float? // valore della merce
  paidViaCard        Boolean           @default(false)
  additionalValetPlusMinus Float?

  // --- magazzino -------------------------------------------------------------
  productManagement  String? // none | deluxyWareHouse | keptInCar | returnToBoutique
  stockConsumed      Boolean           @default(false)
  stockReturned      Boolean           @default(false)

  // --- regole carnet applicate -----------------------------------------------
  withDailyDeliveryRule Boolean        @default(false)
  withTotalDeliveryRule Boolean        @default(false)
  deliveryRuleId     String?
  deliveryRule       DeliveryRule?     @relation(fields: [deliveryRuleId], references: [id])
  valetDeliveryRuleId String?
  valetDeliveryRule  ValetDeliveryRule? @relation(fields: [valetDeliveryRuleId], references: [id])

  // --- altro -----------------------------------------------------------------
  provinceId         String?
  province           Province?         @relation(fields: [provinceId], references: [id])
  existingCustomer   Boolean           @default(false)
  /// Consegna corrispondente nel legacy (110 righe): riferimento non risolto.
  legacyCorrespondDeliveryId Int?
  /// Consegna padre nei multi-ritiro con DDT.
  parentDeliveryId   String?
  parentDelivery     Delivery?         @relation("DeliveryPadre", fields: [parentDeliveryId], references: [id])
  childDeliveries    Delivery[]        @relation("DeliveryPadre")

  /// Soft delete del legacy: **431 consegne** (contate in banca il 26/08/2026;
  /// qui c'era scritto 524, numero mai verificato). Sta in un campo suo per non
  /// sovrascrivere lo stato reale della consegna — e infatti sono tutte in
  /// stato `created`, che non e' uno stato chiuso: gli elenchi che si
  /// dimenticano di filtrarle se le ritrovano fra le cose «da fare».
  ///
  /// ⚠️ L'app nuova NON scrive piu' qui: `DeliveriesService.remove()` cancella
  /// davvero (`prisma.delivery.delete`). Quindi l'insieme e' congelato a 431 e
  /// non cresce. Resta pero' una contraddizione da decidere: un modello con il
  /// soft delete in schema e una `remove()` che fa hard delete.
  deletedAt          DateTime?

  products           DeliveryProduct[]
  pickups            DeliveryPickup[]
  activities         Activity[]
  logs               DeliveryLog[]
  /// Le righe di fattura che riguardano questa consegna: se ce n'è una, la
  /// consegna è già fatturata e non deve rientrare in una fattura nuova.
  invoiceLines       InvoiceLine[]
  /// Le righe di stipendio che riguardano questa consegna: se ce n'e' una, la
  /// consegna e' gia' stata pagata al valet.
  salaryLines        SalaryLine[]

  // ⚠️ Questa tabella non aveva NESSUN indice, e sono 61.405 righe. Il solo
  // conto per la paginazione costava 1,9 secondi a ogni apertura della pagina
  // Consegne, prima ancora di leggere una riga.
  //
  // `deletedAt, date` sta per primo perche' e' la lettura di sempre: le
  // consegne vive, dalla piu' recente. Gli altri servono ai filtri di ruolo
  // (il partner vede le sue, il valet le proprie) e alle query di
  // fatturazione e stipendi, che filtrano su stato e su «gia' fatturata».
  @@index([deletedAt, date])
  @@index([partnerId, date])
  @@index([valetId, date])
  @@index([status])
  @@index([invoiced])
  @@index([paymentStatus])
  @@index([realOrderNumber])

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model DeliveryProduct {
  id             String   @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  deliveryId     String
  /// ⚠️ La riga di consegna NON è un record agganciato al prodotto: è la
  /// STAMPA di uno stato di fatto, come tutto il resto della consegna
  /// (destinatario, indirizzo, prezzo). Il prodotto può essere cancellato dal
  /// catalogo senza che questa riga perda significato — resta scritto cosa è
  /// stato portato a quella persona, quel giorno.
  ///
  /// Per questo `productId` è opzionale e la cancellazione lo azzera
  /// (`SetNull`): il collegamento serve finché il prodotto esiste, il FATTO
  /// resta comunque.
  productId      String?
  /// La fotografia: com'era il prodotto quando è stato messo in questa consegna.
  /// Non si legge più dal catalogo, perché il catalogo intanto cambia — un
  /// prodotto rinominato riscriverebbe la storia di consegne già fatte.
  productName    String?
  productSku     String?
  variantName    String?
  quantity       Int      @default(1)
  /// Variante scelta in questa riga di consegna (nel legacy 985 varianti diverse).
  productVariantId String?
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  /// Riga esclusa dal calcolo commissioni.
  withoutCommission Boolean @default(false)
  /// Misure dichiarate nel legacy (valorizzate sul 6% delle righe, valori 0/1).
  length         Float?
  width          Float?
  height         Float?
  weight         Float?
  deletedAt      DateTime?
  price          Float? // prezzo del prodotto in questa consegna (override se flessibile)
  flexiblePrice  Boolean  @default(false) // consente la modifica del prezzo prodotto
  fieldValues    String? // JSON {nomeCampo: valore} per i ProductField
  delivery       Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// Ritiri multipli sotto lo stesso DDT
model DeliveryPickup {
  id         String   @id @default(cuid())
  deliveryId String
  address    String
  timeFrom   String?
  timeTo     String?
  ddtNumber  String?
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

// Log della consegna: inserita / partita / effettuata / cambi stato
model DeliveryLog {
  id         String   @id @default(cuid())
  deliveryId String
  type       String // created | departed | delivered | status_change | note
  message    String
  userId     String?
  createdAt  DateTime @default(now())
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// Attivita' (ogni consegna genera attivita' di ritiro + consegna)
// type: PICKUP | DELIVERY - ordinabili per orario ("reorder with time")
// Il team leader vede anche le attivita' degli altri valet delle sue province
// ------------------------------------------------------------
model Activity {
  id          String   @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  valetId     String?
  valet       Valet?   @relation(fields: [valetId], references: [id])
  type        String // PICKUP | DELIVERY
  status      String   @default("pending") // pending | done | skipped
  scheduledAt DateTime?
  timeFrom    String?
  timeTo      String?
  address     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------------
// Modelli SMS per brand
// brand: DELUXY | DELUXY_FLOWERS | CAKEDESIGN_ME | BUSINESS_DELUXY |
//        DELUXY_EXPERIENCE | DELUXY_DOT_COM
// trigger: CREATED | DEPARTED | ARRIVED
// partnerId valorizzato = modello personalizzato del partner (se abilitato)
// ------------------------------------------------------------
/// CACHE di quello che il CLIENTE ha pagato online, per ordine Shopify.
///
/// Il dato appartiene a Deluxy Orders (Standard §7): qui se ne tiene una copia
/// per riferimento — aggiornata dalla corsa notturna dei margini, che gli
/// ordini li scorre comunque — perché i MARGINI della Finanza devono contare
/// il prezzo pagato dal cliente (prodotti + consegna), mentre le consegne
/// mostrano solo il prezzo concordato col partner (deciso dall'utente 26/08).
model OrdineCliente {
  id           String   @id @default(cuid())
  /// Numero Shopify nudo (la coda del gid): lo stesso di Delivery.realOrderNumber.
  orderId      String   @unique
  /// L'id dell'ordine DENTRO Deluxy Orders: serve a linkare la sua pagina
  /// (che ha anche il bottone verso l'admin Shopify — il dominio lo sa lei).
  ordersId     String?
  /// Il brand dell'ordine ("deluxy.it", …): e' il filtro Brand della Finanza.
  brand        String?
  /// Il numero umano ("#12731"), per leggersi negli elenchi.
  numero       String?
  /// Somma delle righe pagate dal cliente (prezzo x quantita).
  prodotti     Float
  /// Consegna pagata dal cliente: totale - prodotti, mai sotto zero.
  consegna     Float
  totale       Float
  /// La COMMISSIONE D'INCASSO come la sa ORDERS (il proprietario, 26/08/2026):
  /// 'shopify' = fee reale dalle transazioni, 'tariffa' = suo listino. La
  /// Finanza la usa al posto della propria stima quando c'e' la firma.
  commissioneIncassi Float?
  commissioneDa      String  @default("")
  aggiornatoIl DateTime @updatedAt
}

model SmsTemplate {
  id        String   @id @default(cuid())
  /// id nel vecchio sistema: rende l'import ripetibile senza doppioni.
  legacyId  Int?     @unique
  brand     String
  trigger   String
  name      String
  text      String
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// Regole carnet consegne
// type: DAILY_COUNT (numero giornaliero) | TOTAL_COUNT (totale nel periodo)
// partnerBillingAdjustment / valetPayAdjustment: plus/minus applicati
// Estendibili a piu' partner tramite DeliveryRulePartner
// ------------------------------------------------------------
model DeliveryRule {
  id   String @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  name String

  // Sull'app reale "Daily Number Rule" e "Total Number Rule" sono due Si/No
  // indipendenti: una regola puo' garantire un numero giornaliero, un numero
  // totale nel periodo, o entrambi. Ogni toggle ha il suo conteggio.
  dailyRule  Boolean @default(false)
  dailyCount Int     @default(0)
  totalRule  Boolean @default(false)
  totalCount Int     @default(0)

  // Periodo di validita' e fascia oraria in cui la regola si applica.
  periodStart DateTime?
  periodEnd   DateTime?
  timeFrom    String? // "HH:mm"
  timeTo      String? // "HH:mm"

  // Distanza (KM) entro cui vale la regola; opzionale.
  kmDistance Float?

  /// Giorni della settimana in cui la regola vale: 7 flag "0"/"1".
  /// ⚠️ L'ordine e' quello ORIGINALE del legacy, conservato senza reinterpretarlo.
  /// Gli schemi osservati ("1000001" e il suo complemento "0111110") fanno pensare
  /// che l'indice 0 sia la DOMENICA, ma e' una deduzione: prima di usarlo per
  /// filtrare, confrontare una regola con l'app reale.
  days String?

  /// Modello di prezzo a cui la regola era legata nel legacy (`fixedprice`,
  /// `hourlyrate`). ⚠️ NON e' un servizio: li' era un modello, e di PREZZO_FISSO
  /// esistono 10 servizi. Sta qui, e non in `serviceTypeId`, per non inventare
  /// a quale servizio si riferisse.
  legacyPricingModel String?

  // Tipo di servizio a cui la regola e' legata (opzionale).
  serviceTypeId String?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])

  // Plus/Minus (anche negativi) su fatturazione partner e paga valet.
  partnerBillingAdjustment Float @default(0)
  valetPayAdjustment       Float @default(0)

  // Toggle "Da fatturare" / "Da pagare" della consegna generata dalla regola.
  toBill Boolean @default(true)
  toPay  Boolean @default(true)

  active    Boolean               @default(true)
  partners  DeliveryRulePartner[]
  deliveries Delivery[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

/// Regole carnet LATO VALET: scaglioni che aumentano la paga in base al numero
/// di ritiri. Nel legacy sono una tabella a parte (`expert-delivery-rules`),
/// non una variante di DeliveryRule: quelle dei partner limitano il numero di
/// consegne, queste modificano una paga. Tenerle separate evita di forzare due
/// cose diverse nello stesso modello.
model ValetDeliveryRule {
  id       String  @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId Int?    @unique
  name     String
  /// Scaglioni, come nel legacy: [{operator, pickUps, plusSalary}].
  /// `operator` vale `equal` o `moreThan`; `pickUps` e' il numero di ritiri e
  /// `plusSalary` il plus sulla paga.
  tiers    String
  active   Boolean @default(true)
  valets   ValetDeliveryRuleValet[]
  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ValetDeliveryRuleValet {
  id                  String            @id @default(cuid())
  valetDeliveryRuleId String
  valetId             String
  valetDeliveryRule   ValetDeliveryRule @relation(fields: [valetDeliveryRuleId], references: [id], onDelete: Cascade)
  valet               Valet             @relation(fields: [valetId], references: [id])

  @@unique([valetDeliveryRuleId, valetId])
}

model DeliveryRulePartner {
  id             String       @id @default(cuid())
  deliveryRuleId String
  partnerId      String
  deliveryRule   DeliveryRule @relation(fields: [deliveryRuleId], references: [id], onDelete: Cascade)
  partner        Partner      @relation(fields: [partnerId], references: [id])

  @@unique([deliveryRuleId, partnerId])
}

// ------------------------------------------------------------
// Stipendi valet
// Flusso: DRAFT -> SENT -> RECEIPT_PENDING (ricevuta da firmare)
//         -> APPROVED -> PAID
// documentType: PROFORMA_INVOICE (valet con P.IVA) | WITHHOLDING_RECEIPT
// cashDeductions: contanti incassati alla consegna, detratti
// ------------------------------------------------------------
model Salary {
  id             String    @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  valetId        String
  valet          Valet     @relation(fields: [valetId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  grossAmount    Float
  cashDeductions Float     @default(0)
  netAmount      Float
  documentType   String // PROFORMA_INVOICE | WITHHOLDING_RECEIPT
  status         String    @default("DRAFT")
  // Archiviato: lo stipendio inviato esce dalla lista attivi ed entra in Archivio.
  archived       Boolean   @default(false)
  sentAt         DateTime?
  approvedAt     DateTime?
  paidAt         DateTime?
  /// Le consegne pagate da questo stipendio, una riga ciascuna.
  ///
  /// Prima lo stipendio era un totale e basta: non si sapeva quali consegne
  /// contenesse, quindi non si poteva sapere quali fossero ancora da pagare —
  /// lo stesso buco che sulle fatture faceva rifatturare il gia' fatturato.
  lines          SalaryLine[]
  receipts       Receipt[]
  claims         Payment[] // reclami aperti dal valet su questo stipendio
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Ricevute (da firmare -> firmate)
/// Una consegna dentro uno stipendio: la fotografia di quanto le e' stato
/// riconosciuto, non un riflesso della consegna.
model SalaryLine {
  id          String   @id @default(cuid())
  salaryId    String
  salary      Salary   @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  /// ⚠️ `SetNull` e non `Cascade`: se la consegna sparisce, lo stipendio
  /// pagato resta con i suoi importi. Riscriverlo cambierebbe un documento
  /// gia' consegnato al valet.
  deliveryId  String?
  delivery    Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  date        DateTime
  description String?
  /// Da dove viene l'importo: `consegna` (deciso allora) o `listino`.
  origin      String   @default("consegna")
  amount      Float    @default(0)
  createdAt   DateTime @default(now())
}

model Receipt {
  id       String    @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  /// ⚠️ Facoltativo: nel database originario le ricevute del valet esistono da
  /// sole (documento + importo + stato), senza uno stipendio a cui agganciarsi.
  salaryId String?
  salary   Salary?   @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  /// Valet a cui appartiene la ricevuta (per quelle importate, che non hanno stipendio).
  valetId  String?
  valet    Valet?    @relation(fields: [valetId], references: [id])
  /// Importo della ricevuta.
  amount   Float?
  /// Secondo documento presente nel legacy (`fromReceipt`).
  fileUrlFrom String?
  /// Stato del legacy: pending | paid | …
  status   String?
  number   String?
  fileUrl  String?
  signed   Boolean   @default(false)
  signedAt DateTime?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// Pagamenti: rimborsi richiesti dai valet, reclami
// type: REIMBURSEMENT | CLAIM
// status: REQUESTED | APPROVED | REJECTED | PAID
// ------------------------------------------------------------
model Payment {
  id          String   @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  valetId     String
  valet       Valet    @relation(fields: [valetId], references: [id])
  // Reclamo aperto su una riga di stipendio (es. rimborso Area C). Facoltativo.
  salaryId    String?
  salary      Salary?  @relation(fields: [salaryId], references: [id], onDelete: SetNull)
  type        String
  amount      Float
  description String?
  status      String   @default("REQUESTED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------------
// Fatturazione partner: fattura periodica delle consegne "da fatturare".
// Somma di price + additionalPrice delle consegne billable ed effettuate.
// status: DRAFT (bozza) | ISSUED (emessa, va in storico) | PAID (pagata)
// ------------------------------------------------------------
model Invoice {
  id              String    @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id])
  number          String? // FAT-<anno>-<n>
  periodStart     DateTime
  periodEnd       DateTime
  /// Imponibile: la somma delle righe, IVA esclusa. È il numero che si
  /// ricostruisce sempre dalle consegne, ed è quello che il generatore
  /// calcolava (sbagliando) come totale.
  netAmount       Float     @default(0)
  /// Aliquota IVA applicata, in percento.
  vatRate         Float     @default(22)
  /// Totale del documento, IVA compresa.
  ///
  /// ⚠️ Nel legacy `invoiceAmount` è l'importo CON IVA: su 267
  /// fatture compilate, 194 sono esattamente la somma delle righe x 1,22. Le
  /// altre 291 non erano compilate affatto (uscivano a 0 €), e per quelle il
  /// totale è ricostruito dall'imponibile — non inventato: applicato con la
  /// stessa regola misurata sulle altre.
  totalAmount     Float     @default(0)
  /// Quello che diceva il documento originario, zeri compresi: serve a non
  /// perdere il dichiarato quando il totale è stato ricostruito.
  legacyTotalAmount Float?
  deliveriesCount Int       @default(0)
  status          String    @default("DRAFT")
  // Emettendo la fattura esce dalle bozze ed entra nello Storico.
  archived        Boolean   @default(false)
  issuedAt        DateTime?
  paidAt          DateTime?
  /// Il PDF della fattura, come lo teneva il sistema originario
  /// (`delivery-invoices.invoiceUrl`). Tutte e 559 le fatture storiche ne
  /// hanno uno: senza, l'archivio conserva un totale ma non il documento.
  documentUrl     String?
  /// Il pagamento Stripe, dove c'e' (`paymentIntentId`): nel legacy solo 2
  /// fatture su 559 — le altre sono state incassate fuori.
  paymentIntentId String?
  lines           InvoiceLine[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Riga di fattura: una consegna fatturata (snapshot al momento della generazione).
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// La consegna fatturata. Serve a sapere che cosa è già stato fatturato:
  /// senza, rigenerare un periodo lo fatturava una seconda volta.
  ///
  /// ⚠️ `SetNull` e non `Cascade`: la riga di fattura è la stampa di uno stato
  /// di fatto, non un riflesso della consegna. Se la consegna sparisce, la
  /// fattura emessa resta con i suoi importi — cancellarla riscriverebbe un
  /// documento già incassato.
  deliveryId  String?
  delivery    Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  date        DateTime
  recipient   String
  description String?
  amount      Float    @default(0)
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------------
// Vendite (da app.deluxy.it)
// Smistamento: prodotto UNICO -> partner della provincia se aperto;
// NON_UNICO -> lista priorita' partner per provincia+categoria.
// Sconto arrotondato a 0/5.
// ------------------------------------------------------------
model Sale {
  id              String    @id @default(cuid())
  /// Come per DeliveryProduct: la vendita è un fatto avvenuto, non un
  /// puntatore al catalogo di oggi.
  productId       String?
  productName     String?
  productSku      String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Variante scelta nell'ordine (es. la taglia M): senza, un ordine per la
  /// Cappelliera M entrava come «Cappelliera» e basta e i prezzi non tornavano.
  /// Fotografia come productName: il nome resta anche se la variante sparisce.
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  variantName      String?
  partnerId       String? // partner assegnato dallo smistamento
  partner         Partner?  @relation(fields: [partnerId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  provinceId      String
  province        Province  @relation(fields: [provinceId], references: [id])
  brand           String    @default("DELUXY")
  amount          Float
  discountPercent Float     @default(0)
  /// da_gestire | proposta | accettata | non_accettata | annullata
  status          String    @default("da_gestire")
  /// PERCHE' e' stato scelto quel partner: «lista priorita' 2a di 5»,
  /// «proprietario del prodotto unico», «nessuna lista per questa provincia».
  ///
  /// ⚠️ Fino al 24/08/2026 il motivo veniva calcolato dallo smistamento e
  /// BUTTATO VIA. Chi guardava una vendita vedeva un partner e basta, senza
  /// modo di sapere se era stato scelto da una lista o da un ripiego — e le
  /// due cose meritano fiducia diversa.
  assignmentReason String?
  source          String    @default("app") // app | woocommerce
  externalOrderId String? // id ordine WooCommerce

  /// Chi ha gia' rifiutato questa vendita (JSON array di partnerId).
  /// Serve al ri-smistamento: un partner che ha detto no non la rivede.
  refusedPartnerIds String?

  /// Dati dell'ordine che servono a creare la consegna quando il partner
  /// accetta. Arrivano da chi manda l'ordine (Deluxy Orders / Shopify):
  /// senza questi la vendita si accetta ma la consegna va scritta a mano.
  recipientFirstName String?
  recipientLastName  String?
  recipientAddress   String?
  recipientPhone     String?
  deliveryDate       DateTime?
  serviceTypeId      String?
  deliveryId         String?   @unique // consegna generata dall'accettazione
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Chiavi API per le ALTRE APP Deluxy (app-to-app, standard §4.3): header
// `x-api-key`, nel database vive SOLO lo SHA-256 — la chiave in chiaro si vede
// una volta alla creazione (scripts/crea-chiave-app.mjs) e poi mai più.
// È il canale con cui Orders legge lo stato delle vendite smistate
// (`GET /api/v1/app/vendite/by-ref/...`) per consegna e margine.
model AppApiKey {
  id        String    @id @default(cuid())
  nome      String    @unique // chi la usa: "deluxy-orders", "deluxy-messaging"
  hash      String    @unique // SHA-256 della chiave, mai il valore
  scrittura Boolean   @default(false)
  attiva    Boolean   @default(true)
  /// A che serve, scritto da chi la crea: fra un anno «deluxy-orders» da solo
  /// non dice se si può spegnere.
  note      String?
  /// SCADENZA (27/08/2026). Vuota = non scade.
  ///
  /// ⚠️ Prima non esisteva: una chiave data una volta valeva per sempre, e una
  /// chiave che nessuno ritira è una porta che nessuno chiude. Il guard la
  /// verifica a ogni chiamata, non solo alla creazione.
  scadeIl   DateTime?
  /// Chi l'ha creata: quando si ritrova una chiave viva e nessuno sa perché,
  /// serve un nome a cui chiedere.
  creataDa  String?
  ultimoUso DateTime?
  creataIl  DateTime  @default(now())
}

// Impostazioni applicative (chiave-valore) gestite dall'admin in Configurazione →
// Impostazioni: chiavi API di servizi esterni (es. Google Maps) e simili.
// I valori vivono SOLO nel database: mai in file di codice o commit (regola 3).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Staff d'ufficio. Il flag isProjectManager lo qualifica come Project Manager
// (come Operation ma senza Consegne e Attività).
model Operation {
  id               String   @id @default(cuid())
  /// id nel database originario MySQL: rende l'import ripetibile e tracciabile
  legacyId             Int?      @unique
  firstName        String
  lastName         String
  email            String   @unique
  phone            String?
  address          String?
  notifyWhatsapp   Boolean  @default(false)
  notifyMail       Boolean  @default(true)
  // Ruolo operatore (controlla la visibilità delle sezioni):
  //  operation        -> base (vede Operatività, non Amministrazione)
  //  finance          -> vede anche la sezione Amministrazione
  //  project_manager  -> NON vede la sezione Operatività
  //  customer_service -> NON vede la sezione Amministrazione
  operationRole    String   @default("operation")
  notes            String?
  active           Boolean  @default(true)
  user             User?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// TENTATIVI DI ACCESSO FALLITI (27/08/2026).
///
/// ⚠️ Serve una tabella e non un contatore in memoria: su Vercel ogni
/// invocazione può finire su un'istanza diversa, e un contatore per istanza
/// non conta niente — l'attaccante prende semplicemente un'altra istanza.
///
/// ⚠️ Si registra l'IMPRONTA dell'email, non l'email: questa tabella è un
/// elenco di indirizzi che qualcuno ha provato, e non deve diventare un
/// elenco leggibile di indirizzi validi.
model TentativoAccesso {
  id        String   @id @default(cuid())
  /// sha256 dell'email in minuscolo.
  chiave    String
  /// L'indirizzo di rete di chi prova, per distinguere un utente distratto da
  /// una macchina che tenta.
  ip        String?
  quando    DateTime @default(now())

  @@index([chiave, quando])
}

/// RICHIESTE DI CONSEGNA ARRIVATE DALLE ALTRE APP (28/08/2026, chiesto
/// dall'utente): «una sezione RICHIESTE dove arrivano da altre app richieste di
/// inserimento di servizi di consegna in modo TESTUALE».
///
/// Il punto è che il testo arriva **così com'è scritto**: chi lo manda (il
/// Customer Service, Scout, un fornitore) non deve compilare un modulo con
/// venti campi — scrive quello che sa, e qui qualcuno lo legge e decide.
///
/// ⚠️ Una richiesta NON è una consegna: è una domanda. Nasce `nuova` e diventa
/// una consegna solo quando una persona la accetta. Farla diventare consegna da
/// sola vorrebbe dire far entrare nel giro dei valet un testo che nessuno ha
/// letto.
model RichiestaConsegna {
  id        String   @id @default(cuid())
  /// Il testo come è arrivato. Non si riscrive mai: è la fonte.
  testo     String
  /// Chi l'ha mandata: il nome della chiave app, oppure «manuale».
  origine   String
  /// Il riferimento che usa CHI LA MANDA (numero ordine, id conversazione…),
  /// per poter richiedere l'esito senza tenersi il nostro id.
  riferimento String?
  /// A chi rispondere, se serve chiedere un chiarimento.
  contatto  String?
  /// nuova | in_lavorazione | accettata | rifiutata
  stato     String   @default("nuova")
  /// La consegna nata da questa richiesta, quando è stata accettata.
  deliveryId String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  /// Perché è stata rifiutata, o che cosa si è deciso. Lo legge anche chi
  /// l'ha mandata: un rifiuto senza motivo si trasforma in una seconda
  /// richiesta identica.
  note      String?
  decisaDa  String?
  decisaIl  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stato, createdAt])
  @@index([origine, riferimento])
}
