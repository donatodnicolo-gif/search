{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["fra1"],
  "git": { "deploymentEnabled": false },
  "builds": [
    {
      "src": "api/src/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "includeFiles": [
          "api/prisma/**",
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "web/dist/web/browser" }
    }
  ],
  "crons": [
    { "path": "/api/v1/cron/margini", "schedule": "30 2 * * *" }
  ],
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "/api/src/vercel.ts" },
    { "src": "/api/docs(.*)", "dest": "/api/src/vercel.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
