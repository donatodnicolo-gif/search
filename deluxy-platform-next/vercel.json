{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": false
  },
  "builds": [
    {
      "src": "api/src/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "includeFiles": [
          "api/prisma/**",
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "web/dist/web/browser"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/margini",
      "schedule": "30 2 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/docs(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://maps.gstatic.com https://maps.googleapis.com https://*.gstatic.com https://*.googleapis.com https://*.ggpht.com; connect-src 'self' https://maps.googleapis.com https://maps.gstatic.com; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=()"
      },
      "continue": true
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/src/vercel.ts"
    },
    {
      "src": "/api/docs(.*)",
      "dest": "/api/src/vercel.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
