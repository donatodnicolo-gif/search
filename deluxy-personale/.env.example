# Postgres condiviso delle app Deluxy (stesso cluster di hub/tasks/calendario), schema "personale".
# Genera questo file copiando le stringhe da un'altra app Deluxy:
#   npm run db:condiviso -- ../deluxy-calendario/.env
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1&schema=personale"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=personale"

# Password della UI (una per il team, come nelle altre app: ORDERS_APP_PASSWORD…).
# In produzione è OBBLIGATORIA: se manca, il middleware risponde 503 (fail-closed).
# PERSONALE_APP_PASSWORD="…"

# Firma del cookie di sessione (come HUB_SESSION_SECRET). In produzione obbligatoria.
# Se assente in sviluppo locale, la UI è aperta in vista admin.
# PERSONALE_SESSION_SECRET="stringa-lunga-e-casuale"

# Single Sign-On dal Deluxy Hub: stesso identico valore di HUB_SSO_SECRET nel Hub.
# Se manca, il salto dal Hub degrada al login con la password dell'app.
# HUB_SSO_SECRET="stesso-valore-del-hub"
