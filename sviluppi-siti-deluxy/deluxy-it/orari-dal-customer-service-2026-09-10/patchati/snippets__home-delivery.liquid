<script type="text/javascript">
	$('.modal-popup-toggle').on('click', function(e) {
		  e.preventDefault();
		  $('#occasion').toggleClass('is-visible');
	});
	$('.modal-popup-toggle1').on('click', function(e) {
		  e.preventDefault();
		  $('#dateselect').toggleClass('is-visible');
	});
</script>
<script>
  // Regole deluxy.it: dalle 20:00 (ora italiana) la prima data selezionabile e' domani
  var __dlxP = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Rome', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false }).formatToParts(new Date()).reduce(function (a, x) { a[x.type] = x.value; return a; }, {});
  var today = new Date(Number(__dlxP.year), Number(__dlxP.month) - 1, Number(__dlxP.day));
  if (Number(__dlxP.hour) >= 20) { today.setDate(today.getDate() + 1); }
  // ⭐ 10/09/2026: la prima data e i giorni chiusi li dice il Customer Service (subito se già in cache, poi appena risponde).
  if (window.DeluxyConsegna && DeluxyConsegna.primoGiornoDate()) { today = DeluxyConsegna.primoGiornoDate(); }
  if (window.DeluxyConsegna) { DeluxyConsegna.pronto.then(function () {
    var __p = DeluxyConsegna.primoGiornoDate(); if (!__p) { return; }
    try { $('#deliverydate').calendar('setting', 'minDate', __p); $('#deliverydate').calendar('setting', 'disabledDates', DeluxyConsegna.giorniSpenti()); $('#deliverydate').calendar('refresh'); } catch (e) {}
  }); }
  $('#deliverydate').calendar({
    type: 'date',
    minDate: new Date(today.getFullYear(), today.getMonth(), today.getDate()),
    disabledDates: (window.DeluxyConsegna ? DeluxyConsegna.giorniSpenti() : []),
    maxDate: new Date(today.getFullYear(), today.getMonth(), today.getDate() + 365),
    header: false,    
    onChange: function(date, text, mode) {
      var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      var d = new Date(text);
      var dayName = days[d.getDay()];
     // alert(dayName + ' ' + text);
      $('.delivery_date > span').html(dayName + ' ' + text);
      $('.date_input').val(dayName + ' ' + text);      
      $('#dateselect').toggleClass('is-visible');
    }
  });

 jQuery(".select-occasion li").click(function() {
    //alert($(this).text()); 
   var occasionValue = $(this).text();
   $('.occasion_name > span').html(occasionValue);   
   $('.occasion_input').val(occasionValue);     
   $('#occasion').toggleClass('is-visible');
});

jQuery('#submit_btn').click(function(){
  var dateVal = $('.date_input').val();
  var occasionVal = $('.occasion_input').val();
  sessionStorage.setItem("delivery_date_val", dateVal);
  //localStorage.setItem("delivery_date_val", dateVal);
  window.location.href = "/collections/" + occasionVal;
})

jQuery(document).ready(function(){
  //var localDate = localStorage.getItem("delivery_date_val");
  var localDate = sessionStorage.getItem("delivery_date_val");
  var todayDate = '{{- today_date | date: '%s' -}}';
  //alert(todayDate);
  if(localDate){
    $('.delivery_date > span').html(localDate);
      $('.date_input').val(localDate); 
      //$('#date_capt').text(localDate);
  }
})
  
</script>