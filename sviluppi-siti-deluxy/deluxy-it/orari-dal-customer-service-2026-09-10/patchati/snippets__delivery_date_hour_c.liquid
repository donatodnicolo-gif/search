function formatDate(dateString) {
  var parts = dateString.split('/');
  var day = parts[0];
  var month = parts[1];
  var year = parts[2];
  return year + '-' + month + '-' + day;
}

function fnCheckDate(tmpDate) {
    var div = document.getElementById('date_disp2');
    $('#divCheckDelivery').html('&nbsp;');

    // tmpDate arriva come YYYY-MM-DD dal datepicker -> DD/MM/YYYY
    tmpDate = tmpDate.substr(8, 2) + '/' + tmpDate.substr(5, 2) + '/' + tmpDate.substr(0, 4);

    // === Ora e date in fuso Italia (Europe/Rome) ===
    function romeParts() {
        var p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Rome', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false }).formatToParts(new Date()).reduce(function (a, x) { a[x.type] = x.value; return a; }, {});
        return { y: Number(p.year), m: Number(p.month), d: Number(p.day), h: Number(p.hour) };
    }
    var R = romeParts();
    var h = R.h;
    function fmt(dt) {
        return String(dt.getDate()).padStart(2, '0') + '/' + String(dt.getMonth() + 1).padStart(2, '0') + '/' + dt.getFullYear();
    }
    var today = fmt(new Date(R.y, R.m - 1, R.d));
    var tomorrow = fmt(new Date(R.y, R.m - 1, R.d + 1));

    // minimo orario di consegna richiesto dai prodotti nel carrello
    var ora_min = 0;
    var ora_min_def = 0;
    {% for item in cart.items %}
    ora_min = Number({{ item.product.metafields.custom.minimo_orario | json }}) || 8; // senza metafield: dalle 8
    if (ora_min > ora_min_def) { ora_min_def = ora_min; }
    {% endfor %}
    if (!ora_min_def) { ora_min_def = 8; }
    // Prima ora offerta nelle fasce orarie (10/9/2026): 8 di default, prima se TUTTI i prodotti
    // nel carrello lo consentono (es. colazioni Clivati con custom.minimo_orario = 7 -> 07:00-08:00).
    // Prima il ciclo partiva fisso da 8 e il metafield 7 non aveva effetto.
    var ora_inizio = Math.min(8, ora_min_def);

    function resetSlots() {
        $('#ddlFasciaOraria').children().remove();
        $('#ddlFasciaOraria').append(new Option("{{ 'cart.general.choosetime_slot' | t }}", ""));
    }
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function addRange(a, b) {
        $('#ddlFasciaOraria').append(new Option(pad(a) + ':00–' + pad(b) + ':00', pad(a) + '-' + pad(b)));
    }
    function enableCheckout() {
        $('#ddlFasciaOraria').css('visibility', 'visible');
        $('#bntCheckout').removeAttr('disabled');
    }
    function blockCheckout(msg) {
        resetSlots();
        $('#divCheckDelivery').text(msg);
        $('#ddlFasciaOraria').css('visibility', 'hidden');
        $('#bntCheckout').attr('disabled', 'true');
    }

    resetSlots();

    // Tempi di preparazione: #last_prod_date contiene oggi + il lead time piu' lungo fra i
    // prodotti nel carrello. Prima non veniva mai confrontato con la data scelta, quindi
    // passavano date impossibili (data vecchia in localStorage, oppure calendario della
    // scheda prodotto piu' permissivo perche' legge il metafield del prodotto invece di
    // quello della variante). Blocca anche le date nel passato.
    var minConsegna = (document.getElementById('last_prod_date') || {}).value || '';
    if (minConsegna) {
        var sceltaISO = tmpDate.substr(6, 4) + '-' + tmpDate.substr(3, 2) + '-' + tmpDate.substr(0, 2);
        if (sceltaISO < minConsegna) {
            var pz = minConsegna.split('-');
            var leggibile = pz[2] + '/' + pz[1] + '/' + pz[0];
            blockCheckout({% if request.locale.iso_code == 'it' %}'Per gli articoli nel carrello la prima consegna possibile è il ' + leggibile + '. Scegli quella data o una successiva.'{% else %}'The earliest possible delivery for the items in your cart is ' + leggibile + '. Please choose that date or a later one.'{% endif %});
            return;
        }
    }

    // ⭐ 10/09/2026 — LE FASCE LE DICE IL CUSTOMER SERVICE (pagina «Orari negozi»): giorni chiusi, ora limite,
    // fasce di oggi/domani/oltre, orario minimo e preavviso dei prodotti. Le regole cablate qui sotto restano
    // solo come ripiego quando l'API non ha risposto (o per una data oltre il suo orizzonte).
    if (window.DeluxyConsegna && DeluxyConsegna.attivo()) {
        var __iso = tmpDate.substr(6, 4) + '-' + tmpDate.substr(3, 2) + '-' + tmpDate.substr(0, 2);
        var __g = DeluxyConsegna.giorno(__iso);
        if (__g) {
            if (!__g.ok) { blockCheckout({% if request.locale.iso_code == 'it' %}__g.motivo{% else %}'Not available for delivery. ' + __g.motivo{% endif %}); return; }
            for (var __k = 0; __k < __g.fasce.length; __k++) {
                $('#ddlFasciaOraria').append(new Option(__g.fasce[__k].etichetta, __g.fasce[__k].valore));
            }
            enableCheckout();
            DeluxyConsegna.segnaFonte();
            __dlxSalvaData(tmpDate);
            return;
        }
    }

    if (window.DeluxyConsegna) { DeluxyConsegna.segnaFonte('tema'); }

    if (tmpDate == today) {
        // OGGI: fasce di 2 ore, anticipo minimo 2h; ultima fascia 20-22 ordinabile fino alle 20:00.
        // Notte (00:00-08:00): consegne solo dalle 10:00 in poi.
        var starts = [8, 10, 12, 14, 16, 18, 20];
        var added = 0;
        for (var i = 0; i < starts.length; i++) {
            var a = starts[i];
            if (h < 8 && a < 10) continue;      // notte: prima fascia 10-12
            if (a < ora_min_def) continue;      // rispetta minimo orario prodotto
            var ok = (a === 20) ? (h < 20) : (a >= h + 2);
            if (ok) { addRange(a, a + 2); added++; }
        }
        if (added === 0) { blockCheckout({% if request.locale.iso_code == 'it' %}"Per oggi non ci sono più fasce orarie disponibili: scegli la data di domani per completare l'ordine."{% else %}"No delivery slots left for today: please choose tomorrow's date to complete your order."{% endif %}); return; }
        enableCheckout();

    } else if (tmpDate == tomorrow) {
        // DOMANI: fasce di 1 ora da ora_inizio (8, o 7 se i prodotti lo consentono).
        // Se l'ordine e' fra le 20:00 e le 24:00 -> prima fascia 08-10 poi orarie (niente 07-08).
        if (h >= 20) {
            // ⭐ 10/09/2026 (regola dell'utente): la PRIMA fascia di domani dura 2 ore e parte dall'orario minimo
            // del carrello (08-10 senza vincoli, 09-11 se un prodotto è disponibile dalle 9), poi orarie.
            var __p = Math.max(ora_inizio, ora_min_def);
            if (__p + 2 <= 22) { addRange(__p, __p + 2); }
            for (var b = __p + 2; b <= 21; b++) { addRange(b, b + 1); }
        } else {
            for (var c = ora_inizio; c <= 21; c++) { if (c >= ora_min_def) addRange(c, c + 1); }
        }
        enableCheckout();

    } else {
        // DOPODOMANI e oltre: fasce di 1 ora da ora_inizio (8, o 7 se i prodotti lo consentono).
        for (var d = ora_inizio; d <= 21; d++) { if (d >= ora_min_def) addRange(d, d + 1); }
        enableCheckout();
    }

    __dlxSalvaData(tmpDate);
}

function __dlxSalvaData(tmpDate) {
    // Salva la data scelta (localStorage + campo hidden formato YYYY-MM-DD)
    if (!tmpDate.includes('/')) { return; }
    var pp = tmpDate.split('/');
    var dd_val = pp[0], mm_val = pp[1], yyyy_val = pp[2];
    var jsDate = new Date(yyyy_val, mm_val - 1, dd_val);
    var formatted_input_date = yyyy_val + '-' + String(mm_val).padStart(2, '0') + '-' + String(dd_val).padStart(2, '0');
    var parts = jsDate.toLocaleDateString('it-IT', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }).split(' ');
    var wd = parts[0].charAt(0).toUpperCase() + parts[0].slice(1);
    var mo = parts[2].charAt(0).toUpperCase() + parts[2].slice(1);
    localStorage.setItem('delivery_date_val', wd + ' ' + mo + ' ' + parts[1] + ', ' + parts[3]);
    document.getElementById('DeliveryDate_def').value = formatted_input_date;
}

                  /**********************************/
</script>



