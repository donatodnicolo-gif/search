function getQueryParameter(name) {
  var urlParams = new URLSearchParams(window.location.search);
  return urlParams.get(name);
}
  
function getDate(offset = 0) {
  var currdate = new Date();
  currdate.setDate(currdate.getDate() + offset);
  var dd = String(currdate.getDate()).padStart(2, '0');
  var mm = String(currdate.getMonth() + 1).padStart(2, '0'); // January is 0!
  var yyyy = currdate.getFullYear();
  return `${yyyy}-${mm}-${dd}`;
}
  
function changeDateFormat(delDate) {
  var monthAbbreviations = {
    'Gennaio': 'gen',
    'Febbraio': 'feb',
    'Marzo': 'mar',
    'Aprile': 'apr',
    'Maggio': 'mag',
    'Giugno': 'giu',
    'Luglio': 'lug',
    'Agosto': 'ago',
    'Settembre': 'set',
    'Ottobre': 'ott',
    'Novembre': 'nov',
    'Dicembre': 'dic'
  };

  var parts = delDate.split(' ');
  var dayOfWeek = parts[0].toLowerCase(); 
  var day = parts[2]; 
  var month = parts[1]; 
  var year = parts[3]; 
  var daysOfWeek = {
    'Lun': 'lun',
    'Mar': 'mar',
    'Mer': 'mer',
    'Gio': 'gio',
    'Ven': 'ven',
    'Sab': 'sab',
    'Dom': 'dom'
  };

  var shortDayOfWeek = daysOfWeek[dayOfWeek.charAt(0).toUpperCase() + dayOfWeek.slice(1)]; // "ven"
  var shortMonth = monthAbbreviations[month];
  return `${shortDayOfWeek} ${day} ${shortMonth} ${year}`.toLowerCase();  
}
  
function parseDate(dateStr) {
  const monthNames = {
    'gen': 0, // January
    'feb': 1, // February
    'mar': 2, // March
    'apr': 3, // April
    'mag': 4, // May
    'giu': 5, // June
    'lug': 6, // July
    'ago': 7, // August
    'set': 8, // September
    'ott': 9, // October
    'nov': 10, // November
    'dic': 11  // December
  };

  const parts = dateStr.split(' ');
  const day = parseInt(parts[1], 10);
  const month = monthNames[parts[2].slice(0, 3)];
  const year = parseInt(parts[3], 10);
  return new Date(year, month, day);
}
  
