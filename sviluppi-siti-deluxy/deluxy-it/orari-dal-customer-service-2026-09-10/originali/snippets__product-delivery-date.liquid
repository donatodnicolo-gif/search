function calenderForm(startNew = '', auto_delivery_date, formattedTodayDate, formattedTomorrow) {
    if (startNew) {
        start = new Date(startNew);
        $(".product-calendar").empty();
    }
    console.log('start' + start);
    // Regole deluxy.it: prima data selezionabile rispetta cutoff 20:00 (ora italiana) + lead time prodotto
  var __dlxMin = (function () {
      var p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Rome', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false }).formatToParts(new Date()).reduce(function (a, x) { a[x.type] = x.value; return a; }, {});
      var dd = new Date(Number(p.year), Number(p.month) - 1, Number(p.day));
      var lead = Number({{ product.metafields.prodotto.consegna | default: 0 | json }});
      if (isNaN(lead)) { lead = 0; }
      dd.setDate(dd.getDate() + lead);
      if (lead == 0 && Number(p.hour) >= 20) { dd.setDate(dd.getDate() + 1); }
      return dd;
  })();
  if (!(start instanceof Date) || isNaN(start.getTime()) || start < __dlxMin) { start = __dlxMin; }
  $(".product-calendar").calendar({
        inline: true,
        type: "date",
        firstDayOfWeek: 1,
        text: {
            days: ["Dom", "Lun", "Mar", "Mer", "Gio", "Ven", "Sab"],
            months: [
                "Gennaio",
                "Febbraio",
                "Marzo",
                "Aprile",
                "Maggio",
                "Giugno",
                "Luglio",
                "Agosto",
                "Settembre",
                "Ottobre",
                "Novembre",
                "Dicembre",
            ],
        },
    
        initialDate: new Date(
            start.getFullYear(),
            start.getMonth(),
            start.getDate()
        ), // Set initial date
        minDate: new Date(start.getFullYear(), start.getMonth(), start.getDate()),
        maxDate: new Date(
            start.getFullYear(),
            start.getMonth(),
            start.getDate() + 365
        ),
        onChange: function (date, text, mode) {
            var days = ["Dom", "Lun", "Mar", "Mer", "Gio", "Ven", "Sab"];
            var dmonth = [
                "Gennaio",
                "Febbraio",
                "Marzo",
                "Aprile",
                "Maggio",
                "Giugno",
                "Luglio",
                "Agosto",
                "Settembre",
                "Ottobre",
                "Novembre",
                "Dicembre",
            ];
            var d = new Date(text);
            var dayName = days[date.getDay()];
            var dateVal = dayName + " " + text;

            // The New Selected date is converted to dd-mm-yyyy format
            var dateObject = new Date(date);
            var formattedChangedDate = dateObject.getFullYear() + '-' + ("0" + (dateObject.getMonth() + 1)).slice(-2) + '-' + ("0" + dateObject.getDate()).slice(-2);
            // console.log('formattedChangedDate ' + formattedChangedDate);

            $(".newSelectedDate").text(dateVal).show();


            $(".estimated-time > span").html(dayName + " " + text);
            $(".prdt_date_input").val(dayName + " " + text);

            $(".future_del_date").attr("data-date", dateVal);
            $(".btn.add-to-cart.btn--primary").attr("product-data-date", dateVal);
            $(".btn.add-to-cart.btn--primary").removeAttr("disabled");
            $(".date_error_msg").text("");
            $(".savedDate").text(dateVal).hide();
            $(".AutoDate").text(auto_delivery_date).hide();
            console.log("DAT-today ", formattedTodayDate);
          
          if (!$('.product-section').hasClass('variant-product')) {
            if (formattedDelDate > formattedChangedDate) {

                $(".del_avil_or_not").text("{{ "general.new.is_not_available_for" | t }}");

            } else {
                $(".del_avil_or_not").text("{{ "general.new.delivery_available_for" | t }}");
            }
          }


            if (formattedChangedDate == formattedTodayDate) {
                $(".newSelectedDate").text("{{"general.new.today" | t}}").show();

            }
            else if (formattedChangedDate == formattedTomorrow) {

