      if (!$('.product-section').hasClass('variant-product')) {
        var parts = auto_delivery_date.split(' ');
        var day = parts[1];
        var month = parts[2];
        var year = parts[3];

        // Map Italian month abbreviations to English month names
        var months = {
          'gen': 'Jan',
          'feb': 'Feb',
          'mar': 'Mar',
          'apr': 'Apr',
          'mag': 'May',
          'giu': 'Jun',
          'lug': 'Jul',
          'ago': 'Aug',
          'set': 'Sep',
          'ott': 'Oct',
          'nov': 'Nov',
          'dic': 'Dec'
        };

        var englishMonth = months[month.toLowerCase()];
        // Construct a new date string in English format: "MMM DD YYYY"
        var englishDateString = englishMonth + ' ' + day + ' ' + year;

        console.log("Date=>>", englishDateString);
        var dateObject = new Date(englishDateString);
        var formattedAutoDate = dateObject.getFullYear() + '-' + ("0" + (dateObject.getMonth() + 1)).slice(-2) + '-' + ("0" + dateObject.getDate()).slice(-2);
        console.log('Formatted Auto date: ' + formattedAutoDate);
        //console.log('Formatted Today date: ' + formattedTodayDate);

        if (formattedDelDate > formattedAutoDate) {
            $(".del_avil_or_not").text("{{ "general.new.is_not_available_for" | t }}");
        } else {
            $(".del_avil_or_not").text("{{ "general.new.delivery_available_for" | t }}");
        }

        if (formattedAutoDate == formattedTodayDate) {
            $(".AutoDate").text("{{"general.new.today" | t}}").show();
        } else if (formattedAutoDate == formattedTomorrow) {
            $(".AutoDate").text("{{"general.new.tomorrow" | t}}").show();
        } else {
            $(".AutoDate").text(auto_delivery_date).show();
        }
      }
    }
});


