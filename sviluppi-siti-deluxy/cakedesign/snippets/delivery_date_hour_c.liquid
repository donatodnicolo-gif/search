    if (tmpDate == today) {

        if (currentHour < 8) {
            // Regola cakedesign.me: ordini notturni (20:00-08:00) -> consegna oggi dalle 12:00
            addSlots(["12-16", "16-20"]);

            $("#ddlFasciaOraria").css("visibility", "visible");
            $("#bntCheckout").removeAttr("disabled");

            if (check_cambio == 0) {
                div.innerHTML += 'dalle ore 12:00';
                check_cambio = 1;
            }

        } else if (currentHour < 14) {
            // Before 1 PM Italy time: today only 16:00-20:00
            addSlots(["16-20"]);

            $("#ddlFasciaOraria").css("visibility", "visible");
            $("#bntCheckout").removeAttr("disabled");

            if (check_cambio == 0) {
                div.innerHTML += 'dalle ore 16:00';
                check_cambio = 1;
            }

        } else {
            // After 1 PM Italy time: today not allowed
            resetSlots();

            $("#divCheckDelivery").text("{{ 'cart.general.greetings_next_day_available' | t }}");
            $("#ddlFasciaOraria").css("visibility", "hidden");
            $("#bntCheckout").attr("disabled", "true");
            return;
        }

    } else if (tmpDate == tomorrow) {

        if (currentHour >= 20) {
            // After 6 PM Italy time: tomorrow only 12:00-16:00 and 16:00-20:00
            addSlots(["12-16", "16-20"]);
        } else {
            // Tomorrow allowed normally
            addSlots(["08-12", "12-16", "16-20"]);
        }

        $("#ddlFasciaOraria").css("visibility", "visible");
        $("#bntCheckout").removeAttr("disabled");

    } else {

        // Day after tomorrow and future dates: all slots allowed
        addSlots(["08-12", "12-16", "16-20"]);

        $("#ddlFasciaOraria").css("visibility", "visible");
        $("#bntCheckout").removeAttr("disabled");
    }

    let dd_val, mm_val, yyyy_val;

    if (tmpDate.includes('/')) {
        [dd_val, mm_val, yyyy_val] = tmpDate.split('/');
    } else if (tmpDate.includes('-')) {
        [yyyy_val, mm_val, dd_val] = tmpDate.split('-');
    } else {
        console.error("Unknown date format:", tmpDate);
        return;
    }

    const jsDate_obj_1 = new Date(yyyy_val, mm_val - 1, dd_val);

    const formatted_input_date_1 =
        yyyy_val + '-' +
        String(mm_val).padStart(2, '0') + '-' +
        String(dd_val).padStart(2, '0');

    let locale_parts_arr_1 = jsDate_obj_1.toLocaleDateString('it-IT', {
        weekday: 'short',
        month: 'long',
        day: 'numeric',
        year: 'numeric'
    }).split(' ');

    const weekday_cap_1 = locale_parts_arr_1[0].charAt(0).toUpperCase() + locale_parts_arr_1[0].slice(1);
    const day_num_1 = locale_parts_arr_1[1];
    const month_cap_1 = locale_parts_arr_1[2].charAt(0).toUpperCase() + locale_parts_arr_1[2].slice(1);
    const year_num_1 = locale_parts_arr_1[3];

    const final_date_output_1 = `${weekday_cap_1} ${month_cap_1} ${day_num_1}, ${year_num_1}`;

    
    console.log("Saving into localStorage");
    console.log("final_date_output_1:", final_date_output_1);
    console.log("formatted_input_date_1:", formatted_input_date_1);

    localStorage.setItem("delivery_date_val", final_date_output_1);
    console.log("Setting DeliveryDate_def from fnCheckDate");
    console.log("Value:", formatted_input_date_1);

    document.getElementById("DeliveryDate_def").value = formatted_input_date_1;
}

/**********************************/
</script>



