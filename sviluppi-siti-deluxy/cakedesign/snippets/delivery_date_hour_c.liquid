    if (!/^\d{4}-\d{2}-\d{2}$/.test(String(tmpDate || ''))) {
        console.error("fnCheckDate: data non valida", tmpDate);
        return;
    }

    tmpDate = tmpDate.substr(8, 2) + '/' + tmpDate.substr(5, 2) + '/' + tmpDate.substr(0, 4);

    function getItalyHour() {
        return Number(
            new Intl.DateTimeFormat("en-GB", {
                timeZone: "Europe/Rome",
                hour: "2-digit",
                hour12: false
            }).format(new Date())
        );
    }

    var currentHour = getItalyHour();

    console.log("Your local India time:", new Date().toString());

    console.log(
      "Italy time:",
      new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Rome",
        dateStyle: "full",
        timeStyle: "medium"
      }).format(new Date())
    );

    console.log("Italy hour used for slot logic:", currentHour);

    var todayObj = new Date();

    var todayItaly = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Rome",
        day: "2-digit",
        month: "2-digit",
        year: "numeric"
    }).format(todayObj);

    var tomorrowObj = new Date(todayObj);
    tomorrowObj.setDate(tomorrowObj.getDate() + 1);

    var tomorrowItaly = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Rome",
        day: "2-digit",
        month: "2-digit",
        year: "numeric"
    }).format(tomorrowObj);

    var today = todayItaly;
    var tomorrow = tomorrowItaly;

