<script>
  // Deluxy 06/09/2026 - la data scelta dal cliente viene salvata nel browser come testo
  // ("Gio Settembre 11, 2026"). La home in inglese la salvava col mese inglese e il
  // carrello, che conosce solo i mesi italiani, produceva "2026-undefined-11".
  // Qui, prima di ogni altro script, si riporta il valore al formato italiano;
  // se non e' una data riconoscibile si azzera e il carrello ripropone la prima data utile.
  (function () {
    try {
      var IT = ['Gennaio','Febbraio','Marzo','Aprile','Maggio','Giugno','Luglio','Agosto','Settembre','Ottobre','Novembre','Dicembre'];
      var EN = ['january','february','march','april','may','june','july','august','september','october','november','december'];
      var GG = ['Dom','Lun','Mar','Mer','Gio','Ven','Sab'];
      ['delivery_date_val', 'saved_delivery_date'].forEach(function (chiave) {
        var v = localStorage.getItem(chiave);
        if (v === null) return;
        var m = String(v).match(/^\s*[A-Za-z]+\s+([A-Za-z]+)\s+(\d{1,2}),\s*(\d{4})\s*$/);
        if (!m) { localStorage.removeItem(chiave); return; }
        var nome = m[1].toLowerCase();
        var idx = EN.indexOf(nome);
        if (idx < 0) idx = IT.map(function (x) { return x.toLowerCase(); }).indexOf(nome);
        if (idx < 0) { localStorage.removeItem(chiave); return; }
        var g = Number(m[2]), a = Number(m[3]);
        var d = new Date(a, idx, g);
        if (d.getFullYear() !== a || d.getMonth() !== idx || d.getDate() !== g) { localStorage.removeItem(chiave); return; }
        var italiano = GG[d.getDay()] + ' ' + IT[idx] + ' ' + g + ', ' + a;
        if (italiano !== v) localStorage.setItem(chiave, italiano);
      });
    } catch (e) {}
  })();
</script>
