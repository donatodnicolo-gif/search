                          $(this).addClass('show').attr('data-label', '{{ 'general.new.is_not_available_for' | t}}' + selectedDate);
                          $(this).removeClass('hide');
                      } else {
                          $(this).removeClass('show');
                          $(this).addClass('hide');
                      }

                  } else {
                      $(this).hide();
                  }
              });
          }

