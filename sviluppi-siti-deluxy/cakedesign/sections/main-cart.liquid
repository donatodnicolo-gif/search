
<script>

    let allowCheckoutSubmit = false;
    async function fnCheckDelivery(event) {

        if (allowCheckoutSubmit) {
          return true;
        }

        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        
        $('#divCheckDelivery').html('&nbsp;');
        const dtConsegna = ($("#DeliveryDate_def").val() || "").trim();
        const fasciaOraria = ($("#ddlFasciaOraria").val() || "").trim();
        //var provincia = $("#ddlProvincia").val();
        /*
        if (provincia == ""){
            $('#divCheckDelivery').text('Selezionare la provincia di consegna');
            return false;
        }*/
        if (dtConsegna == "") {
            $('#divCheckDelivery').text('{{"general.new.select_delivery_date" | t}}');
            return false;
        }
        // Deluxy 06/09/2026: al checkout passa solo una data scelta dal calendario (AAAA-MM-GG)
        var dtParti = dtConsegna.match(/^(\d{4})-(\d{2})-(\d{2})$/);
        var dtOk = false;
        if (dtParti) {
            var dtObj = new Date(Number(dtParti[1]), Number(dtParti[2]) - 1, Number(dtParti[3]));
            dtOk = dtObj.getFullYear() === Number(dtParti[1]) && dtObj.getMonth() === Number(dtParti[2]) - 1 && dtObj.getDate() === Number(dtParti[3]);
        }
        if (!dtOk) {
            $("#DeliveryDate_def").val("");
            $('#divCheckDelivery').text('{{"general.new.select_delivery_date" | t}}');
            return false;
        }
        if (fasciaOraria == "") {
            $('#divCheckDelivery').text('Seleziona la fascia oraria di consegna');
            return false;
        } 

        if (fasciaOraria) {
          try {
            const response = await $.ajax({
              type: 'POST',
              url: '/cart/update.js',
              data: {
                  attributes: {
                      'Fascia_Oraria_Consegna': fasciaOraria,
                      'Data_Consegna': dtConsegna
                  }
              },
              dataType: 'json'
            });

            console.log('Items added into cart--> Proceed to checkout:', response);
            allowCheckoutSubmit = true;
            document.getElementById('bntCheckout').click();
          } catch (error) {
            console.error('Error adding Fascia_Oraria_Consegna:', error);
          }
        }

        $('#divCheckDelivery').html("<p style='color:green'>Attendi qualche secondo per completare il tuo acquisto!</p>");
        $("#bntCheckout").css("visibility", "hidden");

        return true;
    }


    function fnCheckTesto() {
        $('#divCheckDelivery').html('&nbsp;');
    }
</script>

