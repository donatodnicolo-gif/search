# Deluxy Scripts — variabili d'ambiente (SOLO i nomi: i valori stanno nella
# cassaforte del Hub, pagina /chiavi. Mai committare il .env vero.)

# Postgres condiviso delle app Deluxy, schema dedicato "scripts".
# Si compilano da soli con: npm run configura-db -- ../deluxy-orders/.env
DATABASE_URL=
DIRECT_URL=

# Password unica della UI (team interno). In locale si può lasciare vuota: senza
# password la UI è aperta. In produzione è OBBLIGATORIA (standard Deluxy §3.2).
SCRIPTS_APP_PASSWORD=
