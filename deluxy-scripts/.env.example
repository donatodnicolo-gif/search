# Deluxy Scripts — variabili d'ambiente (SOLO i nomi: i valori stanno nella
# cassaforte del Hub, pagina /chiavi. Mai committare il .env vero.)

# Postgres condiviso delle app Deluxy, schema dedicato "scripts".
# Si compilano da soli con: npm run configura-db -- ../deluxy-orders/.env
DATABASE_URL=
DIRECT_URL=

# Password unica della UI (team interno). In locale si può lasciare vuota: senza
# password la UI è aperta. In produzione è OBBLIGATORIA (standard Deluxy §3.2).
SCRIPTS_APP_PASSWORD=

# Single Sign-On dal Hub: STESSO valore impostato in deluxy-hub (minimo 32
# caratteri). Serve a leggere il token cifrato che il Hub passa su /api/sso, così
# chi entra dal portale non ridigita la password. Se manca o non combacia, si
# torna al login normale: non si rompe niente.
HUB_SSO_SECRET=

# AI che scrive e sistema i testi (stessa chiave delle altre app Deluxy).
# Senza chiave l'app funziona lo stesso: i riquadri AI restano spenti e i testi
# si scrivono a mano. Modello: se non impostato, gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=
